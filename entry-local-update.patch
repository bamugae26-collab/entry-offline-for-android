@@ -0,0 +1,65 @@
+package biz.softline.entrylocal;
+
+import android.content.ComponentName;
+import android.content.Intent;
+import android.content.pm.PackageInfo;
+import android.content.pm.PackageManager;
+import com.getcapacitor.JSObject;
+import com.getcapacitor.Plugin;
+import com.getcapacitor.PluginCall;
+import com.getcapacitor.PluginMethod;
+import com.getcapacitor.annotation.CapacitorPlugin;
+
+/**
+ * [entry-local 1.2] 연결 프로그램 앱(Entry Android Hardware, biz.softline.entryhw) 열기
+ *
+ * PC 엔트리는 'entryhw://?roomId:…' 주소로 하드웨어 연결 프로그램을 연다.
+ * 안드로이드에서는 그 앱을 직접 연다 (roomId 를 함께 넘김). 앱은 127.0.0.1:23518 에서 엔트리를 기다리고,
+ * 하드웨어가 연결되면 이 앱(Entry for Android)으로 다시 돌아온다.
+ * 앱이 설치되어 있는지 보려면 AndroidManifest 의 <queries> 에 패키지가 적혀 있어야 한다 (안드로이드 11+).
+ */
+@CapacitorPlugin(name = "EntryHwApp")
+public class EntryHwAppPlugin extends Plugin {
+
+    static final String HW_PACKAGE = "biz.softline.entryhw";
+    static final String HW_ACTIVITY = "biz.softline.entryhw.MainActivity";
+
+    @SuppressWarnings("deprecation")
+    private PackageInfo info() {
+        try {
+            return getContext().getPackageManager().getPackageInfo(HW_PACKAGE, 0);
+        } catch (PackageManager.NameNotFoundException e) {
+            return null;
+        }
+    }
+
+    @PluginMethod
+    public void isInstalled(PluginCall call) {
+        PackageInfo p = info();
+        JSObject r = new JSObject();
+        r.put("installed", p != null);
+        if (p != null) r.put("versionName", p.versionName);
+        call.resolve(r);
+    }
+
+    @PluginMethod
+    public void launch(PluginCall call) {
+        if (info() == null) {
+            call.reject("not installed", "NOT_INSTALLED");
+            return;
+        }
+        try {
+            Intent intent = new Intent(Intent.ACTION_MAIN);
+            intent.setComponent(new ComponentName(HW_PACKAGE, HW_ACTIVITY));
+            intent.addFlags(Intent.FLAG_ACTIVITY_NEW_TASK | Intent.FLAG_ACTIVITY_REORDER_TO_FRONT);
+            intent.putExtra("fromEntry", true);
+            intent.putExtra("entryPackage", getContext().getPackageName());
+            String roomId = call.getString("roomId", "");
+            if (roomId != null && !roomId.isEmpty()) intent.putExtra("roomId", roomId);
+            getActivity().startActivity(intent);
+            call.resolve();
+        } catch (Exception e) {
+            call.reject(e.getMessage(), "LAUNCH_FAILED");
+        }
+    }
+}
