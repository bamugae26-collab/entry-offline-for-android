diff --git a/src/web/hardwareApp.ts b/src/web/hardwareApp.ts
new file mode 100644
index 00000000..ba0451be
--- /dev/null
+++ b/src/web/hardwareApp.ts
@@ -0,0 +1,108 @@
+/**
+ * [entry-local 1.2] 연결 프로그램 앱 (Entry Android Hardware) 열기
+ *
+ * PC 엔트리는 하드웨어 연결 프로그램을 'entryhw://' 주소로 열고, 프로그램은 127.0.0.1:23518 에서 엔트리를 기다린다.
+ * 안드로이드에서는 같은 역할의 앱(biz.softline.entryhw)을 플러그인(EntryHwAppPlugin.java)으로 연다.
+ *  - 앱이 없으면: 엔트리의 '미설치 안내' 창 → [연결 프로그램 다운로드] = GitHub 릴리스 apk
+ *  - 앱을 열면: 그 앱에서 하드웨어를 고르고 연결 → 이 앱으로 돌아오면 소켓 연결 (127.0.0.1:23518)
+ */
+import { registerPlugin } from '@capacitor/core';
+import { App } from '@capacitor/app';
+import { isNative } from './platform';
+
+interface EntryHwAppPlugin {
+    isInstalled(): Promise<{ installed: boolean; versionName?: string }>;
+    launch(options: { roomId?: string }): Promise<void>;
+}
+
+const HwApp = registerPlugin<EntryHwAppPlugin>('EntryHwApp');
+
+const w = window as any;
+
+/** 시험용(PC 크롬): window.__EL_HW_APP_TEST__ = { installed, launched[] } */
+function testHook() {
+    return w.__EL_HW_APP_TEST__;
+}
+
+async function isInstalled() {
+    const test = testHook();
+    if (test) {
+        return !!test.installed;
+    }
+    try {
+        return (await HwApp.isInstalled()).installed;
+    } catch (e) {
+        return false;
+    }
+}
+
+async function launch(roomId?: string) {
+    const test = testHook();
+    if (test) {
+        (test.launched = test.launched || []).push(roomId || '');
+        return;
+    }
+    await HwApp.launch({ roomId });
+}
+
+let watchUntil = 0;
+
+/** 연결 프로그램 앱을 연 뒤 한동안: 이 앱으로 돌아올 때마다 연결 시도 */
+function connectSoon() {
+    const Entry = w.Entry;
+    if (!Entry || !Entry.hw || Entry.hw.programConnected) {
+        return;
+    }
+    try {
+        Entry.hw._initSocket();
+    } catch (e) {
+        // 다음에 다시
+    }
+}
+
+function watchReturn() {
+    watchUntil = Date.now() + 10 * 60 * 1000;
+}
+
+function onReturn() {
+    if (Date.now() < watchUntil) {
+        setTimeout(connectSoon, 300);
+        setTimeout(connectSoon, 2500);
+    }
+}
+
+document.addEventListener('visibilitychange', () => {
+    document.visibilityState === 'visible' && onReturn();
+});
+if (isNative()) {
+    App.addListener('resume', onReturn).catch(() => undefined);
+}
+
+/** [하드웨어 연결하기] · [연결 프로그램 열기] */
+export async function openHardwareApp() {
+    const Entry = w.Entry;
+    if (!(await isInstalled())) {
+        Entry && Entry.hw && Entry.hw.openHardwareDownloadPopup();
+        return;
+    }
+    let roomId: string | undefined;
+    try {
+        roomId = (Entry && Entry.hw && Entry.hw.sessionRoomId) || undefined;
+    } catch (e) {
+        roomId = undefined;
+    }
+    try {
+        await launch(roomId);
+    } catch (e) {
+        Entry && Entry.hw && Entry.hw.openHardwareDownloadPopup();
+        return;
+    }
+    watchReturn();
+    // 앱이 이미 켜져 있었다면 바로 연결된다
+    setTimeout(connectSoon, 1500);
+}
+
+/** 안드로이드 앱(또는 시험 모드)에서만 연결 프로그램 앱을 쓴다 */
+export function hardwareAppSupported() {
+    return isNative() || !!testHook();
+}
