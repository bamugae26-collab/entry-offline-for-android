diff --git a/src/renderer/helper/extensionHost.ts b/src/renderer/helper/extensionHost.ts
new file mode 100644
index 00000000..1e7bbdc2
--- /dev/null
+++ b/src/renderer/helper/extensionHost.ts
@@ -0,0 +1,1056 @@
+import { lt } from '../../common/localLang';
+import { DEFAULT_EXTENSION_ICON } from './extensionIcon';
+
+/**
+ * [entry-local 1.2] 확장 프로그램 — 크롬 웹 스토어의 '엔트리용 확장 프로그램'(.crx)을 앱에서 쓰기
+ *
+ * 엔트리용 확장 프로그램은 대부분 playentry.org 화면에 스크립트(content_scripts)를 넣어
+ * window.Entry 를 고치는 방식이다. 이 앱도 같은 Entry 를 쓰므로 그 스크립트를 그대로 넣으면 된다.
+ *  - .crx(크롬 확장 파일) = 머리말 + zip → manifest.json 의 content_scripts 중 playentry.org 에 붙는 것만 쓴다
+ *  - world: "MAIN" 스크립트는 그대로, 기본(ISOLATED) 스크립트는 chrome.* 대신(runtime·tabs·scripting·storage·i18n)과 함께 넣는다
+ *  - 백그라운드(서비스 워커)도 같은 화면 안에서 돌리고, 팝업 창(확장 아이콘 창)은 톱니바퀴 메뉴 안에 보여 준다
+ *  - 확장 스크립트에게는 주소(location)가 엔트리 만들기 화면(playentry.org/ws/new)으로 보인다
+ *  - 추가한 확장은 이 기기(IndexedDB)에 저장되어 앱을 켤 때마다 자동으로 켜진다
+ *  - 끄거나 지운 확장은 이미 들어간 스크립트를 되돌릴 수 없으므로 앱을 다시 시작해야 완전히 빠진다
+ * 크롬에만 있는 기능(새 탭·알림·다운로드 등)은 없으므로 그런 기능에 기대는 확장은 일부만 동작할 수 있다.
+ */
+
+type ContentScript = { world: 'MAIN' | 'ISOLATED'; js: string[]; css: string[] };
+
+export type ExtensionRecord = {
+    id: string;
+    name: string;
+    version: string;
+    description: string;
+    icon: string;
+    enabled: boolean;
+    addedAt: number;
+    scripts: ContentScript[];
+    /** 확장 안의 파일 (경로 → 내용) — 스크립트·스타일과 chrome.runtime.getURL 로 쓰는 그림 등 */
+    files: Record<string, ArrayBuffer>;
+    messages: Record<string, string>;
+    /** 백그라운드(서비스 워커) 스크립트 */
+    background?: string[];
+    /** 확장 아이콘을 누르면 뜨는 팝업 창 (html) */
+    popup?: string;
+    manifest?: any;
+};
+
+const MAX_SIZE = 30 * 1024 * 1024;
+const ENTRY_PAGES = ['https://playentry.org/ws/new', 'https://playentry.org/ws/', 'https://playentry.org/project/', 'https://playentry.org/'];
+
+// ── .crx 읽기 ──
+
+class ExtensionError extends Error {}
+
+/** 글 맨 앞의 BOM(보이지 않는 표시 글자) 빼기 */
+function stripBom(text: string) {
+    return text.charCodeAt(0) === 0xfeff ? text.slice(1) : text;
+}
+
+/** zip 의 deflate 묶음 풀기 — gzip 모양으로 감싸 브라우저의 DecompressionStream('gzip')으로 (크롬 80+, 안드로이드 웹뷰·Windows 둘 다) */
+async function inflateRaw(data: Uint8Array, crc: number, size: number) {
+    const DS = (window as any).DecompressionStream;
+    if (!DS) {
+        throw new ExtensionError(lt('이 기기에서는 압축을 풀 수 없습니다.', 'This device cannot unpack the file.'));
+    }
+    const gz = new Uint8Array(10 + data.length + 8);
+    gz.set([0x1f, 0x8b, 8, 0, 0, 0, 0, 0, 0, 0xff]);
+    gz.set(data, 10);
+    const view = new DataView(gz.buffer);
+    view.setUint32(10 + data.length, crc >>> 0, true);
+    view.setUint32(14 + data.length, size >>> 0, true);
+    const stream = new Blob([gz]).stream().pipeThrough(new DS('gzip'));
+    return new Uint8Array(await new Response(stream).arrayBuffer());
+}
+
+async function unzip(buf: Uint8Array) {
+    const view = new DataView(buf.buffer, buf.byteOffset, buf.byteLength);
+    let eocd = -1;
+    for (let i = buf.length - 22; i >= Math.max(0, buf.length - 65557); i--) {
+        if (view.getUint32(i, true) === 0x06054b50) {
+            eocd = i;
+            break;
+        }
+    }
+    if (eocd < 0) {
+        throw new ExtensionError(lt('확장 프로그램 파일이 손상되었습니다.', 'The extension file is damaged.'));
+    }
+    const count = view.getUint16(eocd + 10, true);
+    let p = view.getUint32(eocd + 16, true);
+    const decoder = new TextDecoder();
+    const files = new Map<string, Uint8Array>();
+    for (let n = 0; n < count; n++) {
+        if (view.getUint32(p, true) !== 0x02014b50) {
+            throw new ExtensionError(lt('확장 프로그램 파일이 손상되었습니다.', 'The extension file is damaged.'));
+        }
+        const method = view.getUint16(p + 10, true);
+        const crc = view.getUint32(p + 16, true);
+        const compSize = view.getUint32(p + 20, true);
+        const size = view.getUint32(p + 24, true);
+        const nameLen = view.getUint16(p + 28, true);
+        const extraLen = view.getUint16(p + 30, true);
+        const commentLen = view.getUint16(p + 32, true);
+        const local = view.getUint32(p + 42, true);
+        const name = decoder.decode(buf.subarray(p + 46, p + 46 + nameLen)).replace(/\\/g, '/');
+        p += 46 + nameLen + extraLen + commentLen;
+        if (name.endsWith('/')) {
+            continue;
+        }
+        const start = local + 30 + view.getUint16(local + 26, true) + view.getUint16(local + 28, true);
+        const raw = buf.subarray(start, start + compSize);
+        if (method === 0) {
+            files.set(name, raw.slice());
+        } else if (method === 8) {
+            files.set(name, await inflateRaw(raw, crc, size));
+        }
+    }
+    return files;
+}
+
+/** .crx = 'Cr24' + 판(2·3) + 서명 머리말 + zip */
+function zipFromCrx(buf: Uint8Array) {
+    const view = new DataView(buf.buffer, buf.byteOffset, buf.byteLength);
+    if (buf.length < 16 || view.getUint32(0, false) !== 0x43723234) {
+        throw new ExtensionError(lt('crx 형식의 확장 프로그램 파일이 아닙니다.', 'This is not a .crx extension file.'));
+    }
+    const version = view.getUint32(4, true);
+    const start = version === 2 ? 16 + view.getUint32(8, true) + view.getUint32(12, true) : 12 + view.getUint32(8, true);
+    return buf.subarray(start);
+}
+
+function globToRegExp(glob: string) {
+    return new RegExp(`^${glob.replace(/[.+?^${}()|[\]\\]/g, '\\$&').replace(/\*/g, '.*')}$`);
+}
+
+/** 확장의 matches 가 엔트리 만들기 화면(playentry.org)에 붙는가 */
+function matchesEntry(pattern: string) {
+    if (pattern === '<all_urls>') {
+        return true;
+    }
+    const m = /^(\*|https?):\/\/([^/]+)(\/.*)$/.exec(pattern);
+    if (!m) {
+        return false;
+    }
+    const host = m[2];
+    if (!(host === '*' || host === 'playentry.org' || host === '*.playentry.org')) {
+        return false;
+    }
+    const path = globToRegExp(m[3]);
+    return ENTRY_PAGES.some((url) => path.test(url.replace(/^https:\/\/playentry\.org/, '')));
+}
+
+function toBuffer(data: Uint8Array) {
+    return data.buffer.slice(data.byteOffset, data.byteOffset + data.byteLength) as ArrayBuffer;
+}
+
+function mimeOf(path: string) {
+    const ext = path.split('.').pop()!.toLowerCase();
+    return (
+        ({
+            png: 'image/png',
+            jpg: 'image/jpeg',
+            jpeg: 'image/jpeg',
+            gif: 'image/gif',
+            svg: 'image/svg+xml',
+            webp: 'image/webp',
+            js: 'text/javascript',
+            css: 'text/css',
+            json: 'application/json',
+            html: 'text/html',
+            mp3: 'audio/mpeg',
+            wav: 'audio/wav',
+            ogg: 'audio/ogg',
+            woff: 'font/woff',
+            woff2: 'font/woff2',
+            ttf: 'font/ttf',
+        } as Record<string, string>)[ext] || 'application/octet-stream'
+    );
+}
+
+async function toDataUrl(data: Uint8Array, mime: string) {
+    return new Promise<string>((resolve) => {
+        const r = new FileReader();
+        r.onload = () => resolve(String(r.result));
+        r.onerror = () => resolve('');
+        r.readAsDataURL(new Blob([data], { type: mime }));
+    });
+}
+
+/** 확장 프로그램 파일 → 기록 (엔트리에 붙는 스크립트가 없으면 거절) */
+export async function readExtensionFile(file: File): Promise<ExtensionRecord> {
+    if (file.size > MAX_SIZE) {
+        throw new ExtensionError(lt('파일이 너무 큽니다 (30MB 이하).', 'The file is too large (30 MB max).'));
+    }
+    const files = await unzip(zipFromCrx(new Uint8Array(await file.arrayBuffer())));
+    const text = (path: string) => stripBom(new TextDecoder().decode(files.get(path)!));
+    if (!files.has('manifest.json')) {
+        throw new ExtensionError(lt('확장 프로그램 정보(manifest.json)가 없습니다.', 'manifest.json is missing.'));
+    }
+    let manifest: any;
+    try {
+        manifest = JSON.parse(text('manifest.json'));
+    } catch (e) {
+        throw new ExtensionError(lt('확장 프로그램 정보(manifest.json)를 읽을 수 없습니다.', 'manifest.json cannot be read.'));
+    }
+    // 다국어 이름 (__MSG_이름__) — 한국어 → 기본 언어 → 영어
+    const messages: Record<string, string> = {};
+    const locales = [manifest.default_locale, 'en', lt('ko', 'en')].filter(Boolean);
+    locales.forEach((loc: string) => {
+        const path = `_locales/${loc}/messages.json`;
+        if (files.has(path)) {
+            try {
+                const json = JSON.parse(text(path));
+                Object.keys(json).forEach((k) => (messages[k.toLowerCase()] = json[k] && json[k].message));
+            } catch (e) {
+                // 무시
+            }
+        }
+    });
+    const msg = (s: any) => String(s || '').replace(/__MSG_(\w+)__/g, (all, key) => messages[key.toLowerCase()] ?? all);
+
+    const scripts: ContentScript[] = [];
+    (manifest.content_scripts || []).forEach((cs: any) => {
+        if (!(cs.matches || []).some(matchesEntry)) {
+            return;
+        }
+        const js = (cs.js || []).map((p: string) => p.replace(/^\//, '')).filter((p: string) => files.has(p));
+        const css = (cs.css || []).map((p: string) => p.replace(/^\//, '')).filter((p: string) => files.has(p));
+        if (js.length || css.length) {
+            scripts.push({ world: cs.world === 'MAIN' ? 'MAIN' : 'ISOLATED', js, css });
+        }
+    });
+    if (!scripts.length) {
+        throw new ExtensionError(
+            lt(
+                `'${msg(manifest.name) || file.name}'은(는) 엔트리에서 호환되지 않는 확장 프로그램입니다.\n(엔트리 화면에 붙는 기능이 없습니다)`,
+                `'${msg(manifest.name) || file.name}' is not compatible with Entry.\n(It has nothing that runs on the Entry editor.)`
+            )
+        );
+    }
+
+    // 아이콘: 128 → 가장 큰 것
+    let icon = '';
+    const icons = manifest.icons || {};
+    const iconPath = Object.keys(icons)
+        .sort((a, b) => Math.abs(128 - Number(a)) - Math.abs(128 - Number(b)))
+        .map((k) => String(icons[k]).replace(/^\//, ''))
+        .find((p) => files.has(p));
+    if (iconPath) {
+        icon = await toDataUrl(files.get(iconPath)!, mimeOf(iconPath));
+    }
+
+    // 백그라운드: MV3 service_worker / MV2 scripts · page(html 안의 script)
+    const bg = manifest.background || {};
+    let background: string[] = [];
+    if (bg.service_worker) {
+        background = [String(bg.service_worker)];
+    } else if (Array.isArray(bg.scripts)) {
+        background = bg.scripts.map(String);
+    } else if (bg.page && files.has(String(bg.page).replace(/^\//, ''))) {
+        const html = new DOMParser().parseFromString(text(String(bg.page).replace(/^\//, '')), 'text/html');
+        background = Array.from(html.querySelectorAll('script[src]')).map((s) => String(s.getAttribute('src')));
+    }
+    background = background.map((p) => p.replace(/^\.?\//, '')).filter((p) => files.has(p));
+    const act = manifest.action || manifest.browser_action || manifest.page_action || {};
+    const popupPath = act.default_popup ? String(act.default_popup).replace(/^\.?\//, '').split(/[?#]/)[0] : '';
+    const popup = popupPath && files.has(popupPath) ? popupPath : undefined;
+
+    const kept: Record<string, ArrayBuffer> = {};
+    files.forEach((data, path) => {
+        if (!path.startsWith('_metadata/')) {
+            kept[path] = toBuffer(data);
+        }
+    });
+    const name = msg(manifest.name) || file.name.replace(/\.crx$/i, '');
+    return {
+        id: `ext:${name}`,
+        name,
+        version: String(manifest.version || ''),
+        description: msg(manifest.description),
+        icon,
+        enabled: true,
+        addedAt: Date.now(),
+        scripts,
+        files: kept,
+        messages,
+        background,
+        popup,
+        manifest,
+    };
+}
+
+// ── 저장 (이 기기) ──
+
+const DB_NAME = 'entry-local-extensions';
+const STORE = 'extensions';
+
+function openDb(): Promise<IDBDatabase> {
+    return new Promise((resolve, reject) => {
+        const req = indexedDB.open(DB_NAME, 1);
+        req.onupgradeneeded = () => req.result.createObjectStore(STORE, { keyPath: 'id' });
+        req.onsuccess = () => resolve(req.result);
+        req.onerror = () => reject(req.error);
+    });
+}
+
+async function tx<T>(mode: IDBTransactionMode, fn: (s: IDBObjectStore) => IDBRequest<T> | void): Promise<T | undefined> {
+    const db = await openDb();
+    return new Promise((resolve, reject) => {
+        const t = db.transaction(STORE, mode);
+        const req = fn(t.objectStore(STORE));
+        t.oncomplete = () => {
+            db.close();
+            resolve(req ? req.result : undefined);
+        };
+        t.onerror = () => {
+            db.close();
+            reject(t.error);
+        };
+    });
+}
+
+export async function listExtensions(): Promise<ExtensionRecord[]> {
+    try {
+        const all = ((await tx('readonly', (s) => s.getAll())) || []) as ExtensionRecord[];
+        return all.sort((a, b) => a.addedAt - b.addedAt);
+    } catch (e) {
+        console.warn('extensions: list failed', e);
+        return [];
+    }
+}
+
+async function saveExtension(ext: ExtensionRecord) {
+    await tx('readwrite', (s) => s.put(ext));
+}
+
+async function removeExtension(id: string) {
+    await tx('readwrite', (s) => s.delete(id));
+}
+
+// ── 실행 ──
+// 크롬에서 확장은 세 곳에서 돈다: 백그라운드(서비스 워커) · 페이지에 넣는 스크립트(content) · 팝업 창.
+// 이 앱에서는 모두 같은 화면 안에서 돌리고, 셋 사이의 chrome.runtime/tabs 메시지·chrome.storage 를 여기서 이어 준다.
+
+type Ctx = 'background' | 'content' | 'popup';
+type Listener = (...args: any[]) => any;
+
+/** 확장 하나의 연락망 (메시지·저장소 변경을 받는 함수들) */
+type Bus = {
+    ext: ExtensionRecord;
+    getURL: (p: string) => string;
+    rawURL: (p: string) => string;
+    message: Record<Ctx, Set<Listener>>;
+    storage: Set<Listener>;
+};
+
+const running = new Map<string, string>(); // id → 켠 판(version)
+const buses = new Map<string, Bus>();
+const api: Record<string, any> = ((window as any).__entryLocalExtensions = (window as any).__entryLocalExtensions || {});
+
+/** 이 앱의 주소는 playentry.org 가 아니다 → 확장 스크립트에게는 엔트리 만들기 화면 주소로 보이게 */
