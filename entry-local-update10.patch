+
+    /**
+     * 내보낸 파일을 기기의 다운로드 폴더에 바로 저장 (안드로이드 10+, 권한 필요 없음).
+     * 같은 이름이 있으면 안드로이드가 "이름 (1).ent" 처럼 바꿔 저장한다. 결과: { name, folder }
+     */
+    @PluginMethod
+    public void saveDownload(final PluginCall call) {
+        final String name = call.getString("name", "entry");
+        final String data = call.getString("data", "");
+        final String mime = call.getString("mime", "application/octet-stream");
+        if (android.os.Build.VERSION.SDK_INT < android.os.Build.VERSION_CODES.Q) {
+            call.reject("Android 10+ only", "UNSUPPORTED");
+            return;
+        }
+        new Thread(() -> {
+            final android.content.ContentResolver cr = getContext().getContentResolver();
+            android.net.Uri uri = null;
+            try {
+                android.content.ContentValues v = new android.content.ContentValues();
+                v.put(android.provider.MediaStore.MediaColumns.DISPLAY_NAME, name);
+                v.put(android.provider.MediaStore.MediaColumns.MIME_TYPE, mime);
+                v.put(android.provider.MediaStore.MediaColumns.RELATIVE_PATH, android.os.Environment.DIRECTORY_DOWNLOADS);
+                v.put(android.provider.MediaStore.MediaColumns.IS_PENDING, 1);
+                uri = cr.insert(android.provider.MediaStore.Downloads.EXTERNAL_CONTENT_URI, v);
+                if (uri == null) throw new java.io.IOException("cannot create file");
+                try (java.io.OutputStream out = cr.openOutputStream(uri)) {
+                    if (out == null) throw new java.io.IOException("cannot open file");
+                    out.write(Base64.decode(data, Base64.DEFAULT));
+                }
+                android.content.ContentValues done = new android.content.ContentValues();
+                done.put(android.provider.MediaStore.MediaColumns.IS_PENDING, 0);
+                cr.update(uri, done, null, null);
+                String saved = name;
+                try (android.database.Cursor c = cr.query(uri, new String[] { android.provider.MediaStore.MediaColumns.DISPLAY_NAME }, null, null, null)) {
+                    if (c != null && c.moveToFirst() && c.getString(0) != null) saved = c.getString(0);
+                }
+                JSObject r = new JSObject();
+                r.put("name", saved);
+                r.put("folder", android.os.Environment.DIRECTORY_DOWNLOADS);
+                call.resolve(r);
+            } catch (Exception e) {
+                if (uri != null) {
+                    try { cr.delete(uri, null, null); } catch (Exception ignored) { /* 반쯤 쓴 파일 지우기 실패 */ }
+                }
+                call.reject(String.valueOf(e.getMessage()), "FAILED");
+            }
+        }).start();
+    }
 }
