+/**
+ * 앞 판(2026.11.07-b)에서 추가한 확장은 백그라운드·팝업 정보 없이 저장되어 있다
+ * → 함께 저장해 둔 manifest.json 에서 다시 읽어 채운다 (다시 올리지 않아도 팝업·백그라운드가 켜지게)
+ */
+function completeRecord(ext: ExtensionRecord): ExtensionRecord {
+    if (ext.manifest || !ext.files || !ext.files['manifest.json']) {
+        return ext;
+    }
+    try {
+        const has = (p: string) => !!ext.files[p];
+        const text = (p: string) => stripBom(new TextDecoder().decode(new Uint8Array(ext.files[p])));
+        const manifest = JSON.parse(text('manifest.json'));
+        const bg = manifest.background || {};
+        let background: string[] = [];
+        if (bg.service_worker) {
+            background = [String(bg.service_worker)];
+        } else if (Array.isArray(bg.scripts)) {
+            background = bg.scripts.map(String);
+        } else if (bg.page && has(String(bg.page).replace(/^\//, ''))) {
+            const html = new DOMParser().parseFromString(text(String(bg.page).replace(/^\//, '')), 'text/html');
+            background = Array.from(html.querySelectorAll('script[src]')).map((s) => String(s.getAttribute('src')));
+        }
+        background = background.map((p) => p.replace(/^\.?\//, '')).filter(has);
+        const act = manifest.action || manifest.browser_action || manifest.page_action || {};
+        const popupPath = act.default_popup ? String(act.default_popup).replace(/^\.?\//, '').split(/[?#]/)[0] : '';
+        return { ...ext, manifest, background, popup: popupPath && has(popupPath) ? popupPath : undefined };
+    } catch (e) {
+        return ext;
+    }
+}
