diff --git a/src/main/localProjectStore.ts b/src/main/localProjectStore.ts
new file mode 100644
index 00000000..00f51ec9
--- /dev/null
+++ b/src/main/localProjectStore.ts
@@ -0,0 +1,230 @@
+import { lt } from '../common/localLang';
+import { app, ipcMain, IpcMainInvokeEvent } from 'electron';
+import path from 'path';
+import fs from 'fs-extra';
+import MainUtils from './mainUtils';
+import CommonUtils from './commonUtils';
+import createLogger from './utils/functions/createLogger';
+
+/**
+ * [entry-local] 내부 저장소 (내 작품)
+ *
+ * 작품은 파일 대화상자 없이 앱 데이터 폴더 안에 보관한다.
+ *   Windows: %APPDATA%\EntryLocal\projects\<id>.ent
+ *   index.json 에 이름·수정시각·썸네일을 함께 기록한다.
+ *
+ * .ent 포맷은 공식 엔트리와 같으므로 내보내기한 파일은 다른 엔트리에서도 열린다.
+ */
+
+const logger = createLogger('main/localProjectStore.ts');
+
+export type LocalProjectMeta = {
+    id: string;
+    name: string;
+    createdAt: number;
+    updatedAt: number;
+    thumbnail?: string; // 작은 PNG data URL
+};
+
+type SaveOptions = {
+    id?: string;
+    name: string;
+    thumbnail?: string;
+};
+
+const ID_PATTERN = /^[a-z0-9]+$/i;
+
+class LocalProjectStore {
+    // 저장 작업은 temp 폴더를 공유하므로 한 번에 하나씩만 실행한다.
+    private queue: Promise<unknown> = Promise.resolve();
+
+    get rootDir() {
+        return path.join(app.getPath('userData'), 'projects');
+    }
+
+    private get indexPath() {
+        return path.join(this.rootDir, 'index.json');
+    }
+
+    filePathOf(id: string) {
+        if (!ID_PATTERN.test(id)) {
+            throw new Error(`invalid project id: ${id}`);
+        }
+        return path.join(this.rootDir, `${id}.ent`);
+    }
+
+    private enqueue<T>(job: () => Promise<T>): Promise<T> {
+        const next = this.queue.then(job, job);
+        this.queue = next.catch(() => undefined);
+        return next;
+    }
+
+    private async readIndex(): Promise<LocalProjectMeta[]> {
+        try {
+            await fs.ensureDir(this.rootDir);
+            if (!(await fs.pathExists(this.indexPath))) {
+                return [];
+            }
+            const list = (await fs.readJson(this.indexPath)) as LocalProjectMeta[];
+            return Array.isArray(list) ? list : [];
+        } catch (e) {
+            logger.error(`index read failed: ${(e as Error).message}`);
+            // 인덱스가 깨졌으면 폴더의 .ent 파일로 복구한다.
+            return this.rebuildIndex();
+        }
+    }
+
+    private async writeIndex(list: LocalProjectMeta[]) {
+        await fs.ensureDir(this.rootDir);
+        const tmp = `${this.indexPath}.tmp`;
+        await fs.writeJson(tmp, list);
+        await fs.move(tmp, this.indexPath, { overwrite: true });
+    }
+
+    private async rebuildIndex(): Promise<LocalProjectMeta[]> {
+        const files = (await fs.readdir(this.rootDir)).filter((f) => f.endsWith('.ent'));
+        const list: LocalProjectMeta[] = [];
+        for (const file of files) {
+            const stat = await fs.stat(path.join(this.rootDir, file));
+            list.push({
+                id: file.replace(/\.ent$/, ''),
+                name: file.replace(/\.ent$/, ''),
+                createdAt: stat.birthtimeMs,
+                updatedAt: stat.mtimeMs,
+            });
+        }
+        await this.writeIndex(list);
+        return list;
+    }
+
+    async list() {
+        const list = await this.readIndex();
+        // 파일이 지워진 항목은 목록에서 뺀다.
+        const alive = list.filter((meta) => fs.existsSync(this.filePathOf(meta.id)));
+        if (alive.length !== list.length) {
+            await this.writeIndex(alive);
+        }
+        return alive.sort((a, b) => b.updatedAt - a.updatedAt);
+    }
+
+    save(project: ObjectLike, options: SaveOptions) {
+        return this.enqueue(async () => {
+            const list = await this.readIndex();
+            const id = options.id && ID_PATTERN.test(options.id) ? options.id : CommonUtils.createFileId();
+            const target = this.filePathOf(id);
+            const tmp = `${target}.tmp.ent`;
+
+            await fs.ensureDir(this.rootDir);
+            await MainUtils.saveProject(project, tmp);
+            await fs.move(tmp, target, { overwrite: true });
+
+            const now = Date.now();
+            const prev = list.find((meta) => meta.id === id);
+            const meta: LocalProjectMeta = {
+                id,
+                name: options.name || prev?.name || id,
+                createdAt: prev?.createdAt || now,
+                updatedAt: now,
+                thumbnail: options.thumbnail || prev?.thumbnail,
+            };
+            await this.writeIndex([meta, ...list.filter((m) => m.id !== id)]);
+            logger.info(`saved ${id} (${meta.name})`);
+            return meta;
+        });
+    }
+
+    load(id: string) {
+        return this.enqueue(async () => {
+            const project = await MainUtils.loadProject(this.filePathOf(id));
+            const meta = (await this.readIndex()).find((m) => m.id === id);
+            project.localProjectId = id;
+            if (meta) {
+                project.name = meta.name;
+            }
+            return project;
+        });
+    }
+
+    remove(id: string) {
+        return this.enqueue(async () => {
+            await fs.remove(this.filePathOf(id));
+            await this.writeIndex((await this.readIndex()).filter((m) => m.id !== id));
+        });
+    }
+
+    rename(id: string, name: string) {
+        return this.enqueue(async () => {
+            const list = await this.readIndex();
+            const meta = list.find((m) => m.id === id);
+            if (meta) {
+                meta.name = name;
+                await this.writeIndex(list);
+            }
+            return meta;
+        });
+    }
+
+    duplicate(id: string) {
+        return this.enqueue(async () => {
+            const list = await this.readIndex();
+            const source = list.find((m) => m.id === id);
+            if (!source) {
+                throw new Error(`project not found: ${id}`);
+            }
+            const newId = CommonUtils.createFileId();
+            await fs.copy(this.filePathOf(id), this.filePathOf(newId));
+            const now = Date.now();
+            const meta: LocalProjectMeta = {
+                ...source,
+                id: newId,
+                name: lt(`${source.name} 복사본`, `${source.name} copy`),
+                createdAt: now,
+                updatedAt: now,
+            };
+            await this.writeIndex([meta, ...list]);
+            return meta;
+        });
+    }
+
+    async exportTo(id: string, destination: string) {
+        if (!destination.endsWith('.ent')) {
+            destination += '.ent';
+        }
+        await fs.copy(this.filePathOf(id), destination, { overwrite: true });
+    }
+}
+
+const store = new LocalProjectStore();
+
+ipcMain.handle('localStore:dir', () => store.rootDir);
+// [entry-local] 파일에서 연 작품의 원래 .ent 파일에 덮어쓸 수 있는지 (내부 저장소 파일·없는 파일은 아님)
+ipcMain.handle('localFile:canOverwrite', async (event: IpcMainInvokeEvent, filePath: string) => {
+    if (!filePath || typeof filePath !== 'string' || !path.isAbsolute(filePath) || !/\.ent$/i.test(filePath)) {
+        return false;
+    }
+    const inStore = path.relative(store.rootDir, filePath);
+    if (!inStore.startsWith('..') && !path.isAbsolute(inStore)) {
+        return false;
+    }
+    return fs.pathExists(filePath);
+});
+ipcMain.handle('localStore:list', () => store.list());
+ipcMain.handle(
+    'localStore:save',
+    (event: IpcMainInvokeEvent, project: ObjectLike, options: SaveOptions) =>
+        store.save(project, options)
+);
+ipcMain.handle('localStore:load', (event: IpcMainInvokeEvent, id: string) => store.load(id));
+ipcMain.handle('localStore:remove', (event: IpcMainInvokeEvent, id: string) => store.remove(id));
+ipcMain.handle('localStore:rename', (event: IpcMainInvokeEvent, id: string, name: string) =>
+    store.rename(id, name)
+);
+ipcMain.handle('localStore:duplicate', (event: IpcMainInvokeEvent, id: string) =>
+    store.duplicate(id)
+);
+ipcMain.handle(
+    'localStore:export',
+    (event: IpcMainInvokeEvent, id: string, destination: string) => store.exportTo(id, destination)
+);
+
+export default store;
