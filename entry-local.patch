+/**
+ * [entry-local] 앱 정보 — 앱 정보 창(? 메뉴 → 앱 정보)과 내 작품 창 아래에 표시된다.
+ *
+ * ★ 패치를 낼 때마다 APP_VERSION 과 ENTRY_LOCAL_BUILD 를 올린다.
+ *   - APP_VERSION: 사용자에게 보이는 버전 (v1.0.0 → v1.0.1 → … 큰 변경은 v1.1.0)
+ *   - ENTRY_LOCAL_BUILD: 같은 버전 안에서 어떤 패치로 빌드됐는지 구별하는 날짜 번호
+ */
+export const APP_VERSION = '1.2.0';
+export const ENTRY_LOCAL_BUILD = '2026.10.30-a'; // 하드웨어 칸: PC 연결 프로그램 버튼이 다시 나오던 문제
+
+/** 앱 이름 (안드로이드 / Windows) */
+export const APP_NAME_ANDROID = 'Entry for Android';
+export const APP_NAME_WINDOWS = '엔트리 로컬 (Entry Local)';
+export const APP_NAME_WINDOWS_EN = 'Entry Local'; // 영어 화면
+
+/** 개발자 (앱 정보 창과 저작권 줄에 쓰인다) */
+export const APP_DEVELOPER = '머류 (feat. Claude)';
+export const APP_DEVELOPER_EN = 'Meoryu (feat. Claude)'; // 영어 화면 (닉네임 로마자 표기)
+/** 저작권자 (개인) — 저작권 줄에는 사람 이름만 쓴다 */
+export const COPYRIGHT_HOLDER = '머류';
+export const COPYRIGHT_HOLDER_EN = 'Meoryu'; // 영어 화면
+export const COPYRIGHT_YEAR = '2026';
