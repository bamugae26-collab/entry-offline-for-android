+/**
+ * [entry-local] 화면 언어(한국어 / English) 선택 도우미
+ *
+ * 엔트리 코어가 가진 문구(Lang)는 그대로 쓰고, 엔트리 로컬이 새로 넣은 문구만
+ * lt('한국어', 'English') 로 한 번에 두 언어를 적어 둔다.
+ *  - 화면(렌더러·웹·안드로이드): window.Lang.type 을 따라간다 (언어를 바꾸면 Lang 이 바뀐다)
+ *  - 메인 프로세스(Windows): window 가 없으므로 렌더러가 알려 준 값(setMainLang)을 쓴다
+ * 한국어가 아닌 언어(en, jp, vn …)는 모두 English 문구를 쓴다.
+ */
+export type LocalLang = 'ko' | 'en';
+
+let mainLang: LocalLang = 'ko';
+// 앱 설정(언어 선택)이 알려진 뒤에는 그 값을 최우선으로 쓴다 (window.Lang 은 다시 불러오기 전까지 이전 언어일 수 있다)
+let explicit = false;
+
+export function setMainLang(lang?: string) {
+    mainLang = lang === 'ko' || !lang ? 'ko' : 'en';
+    explicit = true;
+}
+
+export function currentLang(): LocalLang {
+    if (explicit) {
+        return mainLang;
+    }
+    const w: any = typeof window !== 'undefined' ? window : undefined;
+    const type = w && w.Lang && (w.Lang.type || w.Lang.fallbackType);
+    if (type) {
+        return type === 'ko' ? 'ko' : 'en';
+    }
+    return mainLang;
+}
+
+export function isEnglish() {
+    return currentLang() === 'en';
+}
+
+/** 현재 언어에 맞는 문구를 고른다 */
+export function lt(ko: string, en: string): string {
+    return currentLang() === 'en' ? en : ko;
+}
