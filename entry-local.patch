+import java.util.UUID;
+import android.webkit.WebResourceRequest;
+import android.webkit.WebSettings;
+import android.webkit.WebStorage;
+import android.webkit.WebView;
+import android.webkit.WebViewClient;
+import android.widget.Button;
+import android.widget.ProgressBar;
+import android.widget.LinearLayout;
+import android.widget.TextView;
+import com.getcapacitor.JSObject;
+import com.getcapacitor.Plugin;
+import com.getcapacitor.PluginCall;
+import com.getcapacitor.PluginMethod;
+import com.getcapacitor.annotation.CapacitorPlugin;
+import org.json.JSONObject;
+import org.json.JSONTokener;
+
+/**
+ * [entry-local] 엔트리(playentry.org) 계정 로그인 — 안드로이드
+ *
+ * 엔트리 공식 로그인 페이지를 전체 화면 웹뷰 창에 띄운다. 로그인 후 엔트리 페이지로 이동하면
+ * 페이지에 들어 있는 사용자 정보(id, 아이디, 닉네임)만 읽고 창을 닫는다.
+ * 비밀번호·토큰은 앱이 읽거나 저장하지 않는다. 로그인 세션 쿠키는 앱 전용 웹뷰 저장소에 남는다.
+ * 사용자 정보를 읽는 스크립트(USER_SCRIPT)는 Windows판(src/common/entryAccount.ts)과 같은 내용.
+ */
+@CapacitorPlugin(name = "EntryAccount")
+public class EntryAccountPlugin extends Plugin {
+
+    private static final String ORIGIN = "https://playentry.org";
+    // 사용자 정보 읽기 (Promise) — src/common/entryAccount.ts 의 USER_SCRIPT 와 같은 내용
+    private static final String USER_SCRIPT =
+        "(async () => { " +
+        "  const pick = (d) => { " +
+        "    try { " +
+        "      const p = (d && d.props) || {}; " +
+        "      const s = (x) => x && x.common && x.common.user; " +
+        "      const u = s(p.pageProps && p.pageProps.initialState) || s(p.initialState); " +
+        "      const id = u && (u.id || u._id); " +
+        "      if (!id) return null; " +
+        "      // 웹판과 같은 기준: 이메일 인증 + 학생 계정 아님 → 저장 완료 창에 [작품 공유하기] " +
+        "      return { id: String(id), username: String(u.username || ''), nickname: String(u.nickname || u.username || ''), canShare: !!(u.isEmailAuth && u.role !== 'student') }; " +
+        "    } catch (e) { return null; } " +
+        "  }; " +
+        "  try { " +
+        "    const el = document.getElementById('__NEXT_DATA__'); " +
+        "    const d = el ? JSON.parse(el.textContent || '{}') : null; " +
+        "    if (d && d.page !== '/signin') { const u = pick(d); if (u) return u; } " +
+        "  } catch (e) {} " +
+        "  try { " +
+        "    const res = await fetch('/', { credentials: 'include', cache: 'no-store' }); " +
+        "    const html = await res.text(); " +
+        "    const m = /<script id=\"__NEXT_DATA__\"[^>]*>([\\s\\S]*?)<\\/script>/.exec(html); " +
+        "    return m ? pick(JSON.parse(m[1])) : null; " +
+        "  } catch (e) { return null; } " +
+        "})()";
+
+    /**
+     * 로그인 화면에서 엔트리·네이버 커넥트 머리말(로고, 생각하기/만들기/… 메뉴, 검색, 로그인 버튼)과
+     * 바닥글을 숨긴다. 로그인 창을 벗어나 엔트리 사이트를 돌아다니는 것(탈주)을 막기 위한 것.
+     * 클래스 이름에 기대지 않고, 비밀번호 칸과 메뉴 글자 위치만으로 머리말 덩어리를 찾는다.
+     * 화면이 다시 그려져도 계속 숨기도록 MutationObserver 를 한 번만 붙인다.
+     */
+    private static final String HIDE_CHROME_SCRIPT =
+        "(() => {" +
+        " if (window.__elHideChrome) return window.__elHideChrome();" +
+        " const NAV = ['생각하기', '만들기', '공유하기', '챌린지', '커뮤니티'];" +
+        " const hide = (el) => { if (el && el.style.display !== 'none') el.style.setProperty('display', 'none', 'important'); };" +
+        " const run = () => {" +
+        "  if (location.pathname.indexOf('/signin') !== 0) return true;" +
+        "  const pw = document.querySelector('input[type=password], input[autocomplete*=password]');" +
+        "  if (!pw) return false;" +
+        "  document.querySelectorAll('header, footer').forEach((el) => {" +
