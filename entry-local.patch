+import { lt } from '../common/localLang';
+import { app, BrowserWindow, ipcMain, net, safeStorage, shell } from 'electron';
+import http from 'http';
+import crypto from 'crypto';
+import path from 'path';
+import fs from 'fs-extra';
+import MainUtils from './mainUtils';
+import createLogger from './utils/functions/createLogger';
+import {
+    DriveClient,
+    DRIVE_SCOPES,
+    GOOGLE_DEFAULTS,
+    GoogleConfig,
+    HttpFn,
+    base64UrlEncode,
+    decodeText,
+    formBody,
+    randomString,
+} from '../common/driveClient';
+
+/**
+ * [entry-local] 구글 드라이브 연동 — Windows(Electron) 메인 프로세스
+ *
+ * 로그인: 구글 권장 '설치형 앱' 방식. 기본 브라우저로 구글 로그인 페이지를 열고,
+ *         127.0.0.1 임시 포트로 돌아온 인증 코드를 PKCE 로 교환한다.
+ *         앱은 비밀번호를 보거나 저장하지 않는다.
+ * 토큰  : 갱신 토큰만 Windows 사용자 암호화(safeStorage, DPAPI)로 userData 에 저장.
+ * 설정  : config/google.json (빌드 때 GitHub Secrets 등으로 생성). 없으면 기능 숨김.
+ */
+
+const logger = createLogger('main/cloudDrive.ts');
+
+type Account = { email?: string; name?: string; picture?: string };
+type Stored = { refreshToken: string } & Account;
+
+function loadConfig(): GoogleConfig {
+    try {
+        const file = path.join(app.getAppPath(), 'config', 'google.json');
+        if (fs.existsSync(file)) {
+            return fs.readJsonSync(file);
+        }
+    } catch (e) {
+        logger.warn(`google.json 읽기 실패: ${(e as Error).message}`);
+    }
+    return {};
+}
+
+const config = loadConfig();
+const endpoint = {
+    auth: config.authUrl || GOOGLE_DEFAULTS.authUrl,
+    token: config.tokenUrl || GOOGLE_DEFAULTS.tokenUrl,
+    revoke: config.revokeUrl || GOOGLE_DEFAULTS.revokeUrl,
+    userInfo: config.userInfoUrl || GOOGLE_DEFAULTS.userInfoUrl,
+};
+const configured = !!config.desktopClientId;
+
+/* ---------------- HTTP (Electron net) ---------------- */
+const httpFn: HttpFn = (req) =>
+    new Promise((resolve, reject) => {
+        const request = net.request({ method: req.method, url: req.url, redirect: 'follow' });
+        Object.keys(req.headers || {}).forEach((k) => request.setHeader(k, (req.headers as any)[k]));
+        request.on('response', (res) => {
+            const chunks: Buffer[] = [];
+            res.on('data', (c: Buffer) => chunks.push(c));
+            res.on('end', () => {
+                const headers: { [k: string]: string } = {};
+                Object.keys(res.headers).forEach((k) => {
+                    const v = (res.headers as any)[k];
+                    headers[k.toLowerCase()] = Array.isArray(v) ? v[0] : v;
+                });
+                resolve({ status: res.statusCode, headers, body: new Uint8Array(Buffer.concat(chunks)) });
+            });
+            res.on('error', reject);
+        });
+        request.on('error', reject);
+        if (req.body !== undefined) {
+            request.write(typeof req.body === 'string' ? req.body : Buffer.from(req.body));
+        }
+        request.end();
+    });
+
+/* ---------------- 토큰 저장 ---------------- */
+const storePath = () => path.join(app.getPath('userData'), 'google-account.dat');
+let stored: Stored | undefined;
+let storedLoaded = false;
+/** safeStorage 는 앱 준비 뒤에 써야 하므로 처음 필요할 때 읽는다 */
+function ensureLoaded() {
+    if (!storedLoaded) {
+        storedLoaded = true;
+        stored = loadStored();
+    }
+}
+let accessToken: { token: string; expiresAt: number; margin: number } | undefined;
+let refreshPromise: Promise<string> | undefined;
+const tokenFrom = (body: any) => {
+    const ttl = (Number(body.expires_in) || 3600) * 1000;
+    return { token: body.access_token as string, expiresAt: Date.now() + ttl, margin: Math.min(60000, ttl / 4) };
+};
+
+function saveStored(value?: Stored) {
+    stored = value;
+    accessToken = value ? accessToken : undefined;
+    if (!value) {
+        fs.removeSync(storePath());
+        return;
+    }
+    const json = JSON.stringify(value);
+    const data = safeStorage.isEncryptionAvailable()
+        ? Buffer.concat([Buffer.from('ENC1'), safeStorage.encryptString(json)])
+        : Buffer.from(`RAW1${json}`);
+    fs.outputFileSync(storePath(), data);
+}
+
+function loadStored(): Stored | undefined {
+    try {
+        if (!fs.existsSync(storePath())) {
+            return undefined;
+        }
+        const data = fs.readFileSync(storePath());
+        const tag = data.subarray(0, 4).toString();
+        const json = tag === 'ENC1' ? safeStorage.decryptString(data.subarray(4)) : data.subarray(4).toString();
+        return JSON.parse(json);
+    } catch (e) {
+        logger.warn(`저장된 로그인 정보를 읽지 못함: ${(e as Error).message}`);
+        return undefined;
+    }
+}
+
+async function tokenRequest(params: { [k: string]: string | undefined }) {
+    const res = await httpFn({
+        method: 'POST',
+        url: endpoint.token,
+        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
+        body: formBody({ client_id: config.desktopClientId, client_secret: config.desktopClientSecret, ...params }),
+    });
+    const body = JSON.parse(decodeText(res.body) || '{}');
+    if (res.status !== 200) {
+        const err: any = new Error(body.error_description || body.error || `token ${res.status}`);
+        err.code = body.error;
+        throw err;
+    }
+    return body;
+}
+
+async function getAccessToken(forceRefresh = false): Promise<string> {
+    ensureLoaded();
+    if (!stored) {
+        throw new Error(lt('로그인이 필요합니다.', 'Login is required.'));
+    }
+    if (!forceRefresh && accessToken && accessToken.expiresAt - accessToken.margin > Date.now()) {
+        return accessToken.token;
+    }
+    // 동시에 여러 요청이 만료를 만나도 갱신은 한 번만
+    if (!refreshPromise) {
+        const refreshToken = stored.refreshToken;
+        refreshPromise = tokenRequest({ grant_type: 'refresh_token', refresh_token: refreshToken })
+            .then((body) => {
+                accessToken = tokenFrom(body);
+                return accessToken.token;
+            })
+            .catch((e) => {
+                if ((e as any).code === 'invalid_grant') {
+                    // 사용자가 구글 계정에서 접근 권한을 해제함 → 로그아웃 상태로
+                    saveStored(undefined);
+                    notifyStatus();
+                    throw new Error(lt('구글 계정 연결이 해제되었습니다. 다시 로그인해 주세요.', 'Your Google account was disconnected. Please log in again.'));
+                }
+                throw e;
+            })
+            .finally(() => {
+                refreshPromise = undefined;
+            });
+    }
+    return refreshPromise;
+}
+
+const drive = new DriveClient(httpFn, getAccessToken, config);
+
+/* ---------------- 로그인 (루프백 + PKCE) ---------------- */
+let loginInProgress: Promise<Account> | undefined;
+
+function focusMainWindow() {
+    const win = BrowserWindow.getAllWindows().find((w) => !w.isDestroyed() && w.isVisible()) || BrowserWindow.getAllWindows()[0];
+    if (win) {
+        if (win.isMinimized()) {
+            win.restore();
+        }
+        win.show();
+        win.focus();
+    }
+}
+
+const RESULT_PAGE = (ok: boolean, message: string) => `<!doctype html><html lang="${lt('ko', 'en')}"><head><meta charset="utf-8">
+<title>${lt('엔트리 로컬', 'Entry Local')}</title><style>body{font-family:sans-serif;display:flex;align-items:center;justify-content:center;height:100vh;margin:0;background:#f4f6fb;color:#2c313d}
+div{background:#fff;padding:32px 40px;border-radius:12px;box-shadow:0 4px 20px rgba(0,0,0,.08);text-align:center}h1{font-size:20px;margin:0 0 8px;color:${ok ? '#4f80ff' : '#e0473e'}}</style></head>
+<body><div><h1>${ok ? lt('로그인 완료', 'Logged in') : lt('로그인 실패', 'Login failed')}</h1><p>${message}</p><p>${lt('이 창을 닫고 엔트리 로컬로 돌아가세요.', 'Close this window and return to Entry Local.')}</p></div></body></html>`;
+
+function login(): Promise<Account> {
+    if (!configured) {
+        return Promise.reject(new Error(lt('구글 연동이 설정되지 않은 빌드입니다.', 'Google integration is not set up in this build.')));
+    }
+    if (loginInProgress) {
+        return loginInProgress;
+    }
+    loginInProgress = new Promise<Account>((resolve, reject) => {
+        const verifier = randomString(crypto.randomBytes(64));
+        const challenge = base64UrlEncode(crypto.createHash('sha256').update(verifier).digest());
+        const state = randomString(crypto.randomBytes(24));
+        let timer: ReturnType<typeof setTimeout>;
+
+        const server = http.createServer(async (req, res) => {
+            const url = new URL(req.url || '/', 'http://127.0.0.1');
+            if (url.pathname !== '/') {
+                res.writeHead(404);
+                res.end();
+                return;
+            }
+            const finish = (ok: boolean, message: string) => {
+                res.writeHead(ok ? 200 : 400, { 'Content-Type': 'text/html; charset=utf-8' });
+                res.end(RESULT_PAGE(ok, message));
+                clearTimeout(timer);
+                server.close();
+                focusMainWindow();
+            };
+            if (url.searchParams.get('state') !== state) {
+                finish(false, lt('요청이 올바르지 않습니다.', 'Invalid request.'));
+                reject(new Error('state mismatch'));
+                return;
+            }
+            const error = url.searchParams.get('error');
+            if (error) {
+                finish(false, error === 'access_denied' ? lt('로그인을 취소했습니다.', 'Login was cancelled.') : error);
+                reject(new Error(error === 'access_denied' ? lt('로그인을 취소했습니다.', 'Login was cancelled.') : error));
+                return;
+            }
+            try {
+                const address = server.address() as any;
+                const body = await tokenRequest({
+                    grant_type: 'authorization_code',
+                    code: url.searchParams.get('code') || '',
+                    code_verifier: verifier,
+                    redirect_uri: `http://127.0.0.1:${address.port}`,
+                });
+                if (!body.refresh_token) {
+                    throw new Error(lt('갱신 토큰을 받지 못했습니다.', 'Could not get a refresh token.'));
+                }
+                accessToken = tokenFrom(body);
+                let account: Account = {};
+                try {
+                    const info = await httpFn({ method: 'GET', url: endpoint.userInfo, headers: { Authorization: `Bearer ${body.access_token}` } });
+                    const j = JSON.parse(decodeText(info.body));
+                    account = { email: j.email, name: j.name, picture: j.picture };
+                } catch (e) {
+                    // 프로필은 없어도 동작
+                }
+                saveStored({ refreshToken: body.refresh_token, ...account });
+                drive.resetCache();
+                finish(true, account.email ? lt(`${account.email} 계정으로 로그인했습니다.`, `Logged in as ${account.email}.`) : lt('로그인했습니다.', 'Logged in.'));
+                resolve(account);
+            } catch (e) {
+                finish(false, (e as Error).message);
+                reject(e);
+            }
+        });
+
+        server.listen(0, '127.0.0.1', () => {
+            const port = (server.address() as any).port;
+            const authUrl =
+                `${endpoint.auth}?` +
+                formBody({
+                    client_id: config.desktopClientId,
+                    redirect_uri: `http://127.0.0.1:${port}`,
+                    response_type: 'code',
+                    scope: DRIVE_SCOPES.join(' '),
+                    code_challenge: challenge,
+                    code_challenge_method: 'S256',
+                    state,
+                    access_type: 'offline',
+                    prompt: 'consent select_account',
+                });
+            timer = setTimeout(() => {
+                server.close();
+                reject(new Error(lt('로그인 시간이 지났습니다. 다시 시도해 주세요.', 'The login timed out. Please try again.')));
+            }, 5 * 60 * 1000);
+            if (process.env.ENTRY_LOCAL_AUTH_AUTOFOLLOW) {
+                // 자동 시험용: 브라우저 대신 직접 따라간다 (가짜 구글 서버가 바로 redirect)
+                httpFn({ method: 'GET', url: authUrl }).catch(() => undefined);
+            } else {
+                shell.openExternal(authUrl);
+            }
+        });
+    }).finally(() => {
+        loginInProgress = undefined;
+        notifyStatus();
+    });
+    return loginInProgress;
+}
+
+async function logout() {
+    ensureLoaded();
+    const token = stored && stored.refreshToken;
+    saveStored(undefined);
+    drive.resetCache();
+    notifyStatus();
+    if (token) {
+        httpFn({
+            method: 'POST',
+            url: endpoint.revoke,
+            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
+            body: formBody({ token }),
+        }).catch(() => undefined);
+    }
+}
+
+function status() {
+    ensureLoaded();
+    return {
+        configured,
+        loggedIn: !!stored,
+        email: stored && stored.email,
+        name: stored && stored.name,
+    };
+}
+
+function notifyStatus() {
+    BrowserWindow.getAllWindows().forEach((w) => {
+        if (!w.isDestroyed()) {
+            w.webContents.send('cloud:status', status());
+        }
+    });
+}
+
+/* ---------------- 작품 저장·불러오기 ---------------- */
+const tmpDir = () => path.join(app.getPath('userData'), 'cloud-tmp');
+
+async function saveToDrive(project: ObjectLike, options: { fileId?: string; name: string; thumbnail?: string }) {
+    const tmp = path.join(tmpDir(), `${Date.now()}.ent`);
+    await fs.ensureDir(tmpDir());
+    try {
+        await MainUtils.saveProject(project, tmp);
+        const bytes = new Uint8Array(await fs.readFile(tmp));
+        try {
+            return await drive.upload(bytes, options);
+        } catch (e) {
+            // 덮어쓸 파일이 드라이브에서 지워졌으면 새로 만든다
+            if (options.fileId && (e as any).status === 404) {
+                return await drive.upload(bytes, { ...options, fileId: undefined });
+            }
+            throw e;
+        }
+    } finally {
+        fs.remove(tmp).catch(() => undefined);
+    }
+}
+
+async function loadFromDrive(fileId: string) {
+    const [bytes, name] = await Promise.all([drive.download(fileId), drive.getName(fileId)]);
+    const tmp = path.join(tmpDir(), `${fileId.replace(/[^a-z0-9_-]/gi, '')}.ent`);
+    await fs.outputFile(tmp, Buffer.from(bytes));
+    try {
+        const project = await MainUtils.loadProject(tmp);
+        project.cloudFileId = fileId;
+        project.name = name || project.name;
+        delete project.savedPath;
+        return project;
+    } finally {
+        fs.remove(tmp).catch(() => undefined);
+    }
+}
+
+async function exportFromDrive(fileId: string, destination: string) {
+    const bytes = await drive.download(fileId);
+    await fs.outputFile(destination.endsWith('.ent') ? destination : `${destination}.ent`, Buffer.from(bytes));
+}
+
+/* ---------------- IPC ---------------- */
+const wrap = (fn: (...args: any[]) => any) => async (event: any, ...args: any[]) => {
+    try {
+        return await fn(...args);
+    } catch (e) {
+        logger.warn(`cloud 오류: ${(e as Error).message}`);
+        throw new Error((e as Error).message);
+    }
+};
+
+ipcMain.handle('cloud:status', wrap(() => status()));
+ipcMain.handle('cloud:login', wrap(() => login()));
+ipcMain.handle('cloud:logout', wrap(() => logout()));
+ipcMain.handle('cloud:list', wrap(() => drive.list()));
+ipcMain.handle('cloud:save', wrap((project, options) => saveToDrive(project, options)));
+ipcMain.handle('cloud:load', wrap((fileId) => loadFromDrive(fileId)));
+ipcMain.handle('cloud:rename', wrap((fileId, name) => drive.rename(fileId, name)));
+ipcMain.handle('cloud:remove', wrap((fileId) => drive.trash(fileId)));
+ipcMain.handle('cloud:thumbnail', wrap((link) => drive.thumbnail(link)));
+ipcMain.handle('cloud:folderUrl', wrap(async () => `https://drive.google.com/drive/folders/${await drive.ensureFolder()}`));
+ipcMain.handle('cloud:export', wrap((fileId, destination) => exportFromDrive(fileId, destination)));
