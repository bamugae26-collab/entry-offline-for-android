+    /** run(keepWarm): 계정 작품 받아 오기 등을 작업 화면 웹뷰(warm)에서 하고 웹뷰는 그대로 둔다 */
+    private void runWarm(final PluginCall call, final String url, final String script, final int timeoutMs) {
+        main.post(() -> {
+            if (currentSaveCancel != null || warmListener != null) {
+                runFresh(call, url, script, timeoutMs);
+                return;
+            }
+            final boolean[] finished = { false };
+            final String token = UUID.randomUUID().toString();
+            final WebView web = warmWeb();
+            warmActive();
+            final Runnable timeout = () -> {
+                if (finished[0]) return;
+                finished[0] = true;
+                destroyWarm();
+                call.reject(tr("엔트리 응답이 없습니다. 인터넷 연결을 확인해 주세요.", "No response from Entry. Please check your internet connection."), "TIMEOUT");
+            };
+            warmRuns.put(token, (payload) -> {
+                if (finished[0]) return;
+                finished[0] = true;
+                main.removeCallbacks(timeout);
+                warmIdle();
+                try {
+                    JSONObject o = new JSONObject(payload);
+                    if (o.optBoolean("ok")) {
+                        JSObject r = new JSObject();
+                        r.put("json", o.optString("json", "null"));
+                        call.resolve(r);
+                    } else {
+                        call.reject(o.optString("error", tr("엔트리 처리 중 오류", "Error while processing in Entry")));
+                    }
+                } catch (Exception e) {
+                    call.reject(tr("엔트리 응답을 읽지 못했습니다.", "Could not read the response from Entry."));
+                }
+            });
+            final Runnable start = () -> web.evaluateJavascript(
+                "Promise.resolve().then(() => " + script + ")" +
+                ".then((v) => EntryLocalBridge.done('" + token + "', JSON.stringify({ ok: true, json: JSON.stringify(v === undefined ? null : v) })))" +
+                ".catch((e) => EntryLocalBridge.done('" + token + "', JSON.stringify({ ok: false, error: String((e && e.message) || e) })));",
+                null
+            );
+            warmListener = new WarmListener() {
+                @Override
+                public void onUrl(String visited) {
+                    if (!finished[0] && isEntrySignin(visited)) {
+                        finished[0] = true;
+                        main.removeCallbacks(timeout);
+                        destroyWarm();
+                        call.reject(tr("엔트리 로그인이 만료되었습니다. 다시 로그인해 주세요.", "Your Entry login has expired. Please log in again."), "SIGNED_OUT");
+                    }
+                }
+
+                @Override
+                public void onLoaded(String loaded) {
+                    if (finished[0]) return;
+                    if (isEntrySignin(loaded)) {
+                        onUrl(loaded);
+                        return;
+                    }
+                    warmListener = null;
+                    start.run();
+                }
+            };
+            main.postDelayed(timeout, timeoutMs);
+            if (warmReadyFor(url)) {
+                warmListener = null;
+                start.run();
+            } else if (!(warmLoadingUrl != null && sameWs(warmLoadingUrl, url))) {
+                loadWarm(url);
+            }
+        });
+    }
+
+    /** 진행 중인 엔트리 계정 저장 (대기 창의 [취소]) */
+    private static Runnable currentSaveCancel;
+    private static volatile boolean cancelPending = false;
+
+    @PluginMethod
+    public void cancelSave(PluginCall call) {
+        cancelPending = true;
+        main.post(() -> {
+            Runnable cancel = currentSaveCancel;
+            currentSaveCancel = null;
+            if (cancel != null) {
+                cancelPending = false;
+                cancel.run();
+            }
+            call.resolve();
+        });
+    }
+
+    /**
+     * [작품 공유하기] — 웹판 저장 완료 창의 버튼과 같은 동작.
+     * 작품의 엔트리 작업 화면을 전체 화면 창에 열고 script(SHARE_SCRIPT)로 엔트리의 '작품 공유하기' 패널을 띄운다.
+     * 공유를 마치면(엔트리가 작업 화면을 떠남) 또는 취소하면 창을 닫는다. 결과 { shared }
+     */
+    @PluginMethod
+    public void share(final PluginCall call) {
+        final String url = call.getString("url", "");
+        final String script = call.getString("script", "");
+        Uri target = Uri.parse(url);
+        if (!"https".equals(target.getScheme()) || !isEntryHost(target)) {
+            call.reject(tr("엔트리 주소가 아닙니다.", "This is not an Entry address."));
+            return;
+        }
+        main.post(() -> {
+            final boolean[] shared = { false };
+            final boolean[] closed = { false };
+            final boolean[] started = { false };
+            Dialog dialog = new Dialog(getActivity(), android.R.style.Theme_Material_Light_NoActionBar);
