index 00000000..e50cfc19
--- /dev/null
+++ b/src/renderer/helper/editorLabels.ts
@@ -0,0 +1,74 @@
+/**
+ * [entry-local] 모양 편집기(entry-paint)·소리 편집기에 한국어로 박혀 있는 도구 이름을 화면 언어에 맞춘다.
+ * (편집기 꾸러미가 언어 설정을 따르지 않고 한국어 이름을 그대로 쓴다 — 마우스를 올리면·화면 읽기에 나온다)
+ */
+import { currentLang } from '../../common/localLang';
+
+const PAIRS: Array<[string, string]> = [
+    // 모양 편집기 도구
+    ['이동', 'Move'],
+    ['선택', 'Select'],
+    ['패스', 'Path'],
+    ['붓', 'Brush'],
+    ['선', 'Line'],
+    ['사각', 'Rectangle'],
+    ['문자', 'Text'],
+    ['채우기', 'Fill'],
+    ['지우개', 'Eraser'],
+    // 소리 편집기 (화면 읽기용 이름)
+    ['선택됨', 'Selected'],
+    ['재생하기', 'Play'],
+    ['소리길이', 'Sound length'],
+    ['감소', 'Decrease'],
+    ['증가', 'Increase'],
+    ['남기기', 'Keep'],
+    ['자르기', 'Cut'],
+];
+const TO_EN = new Map(PAIRS);
+const TO_KO = new Map(PAIRS.map(([ko, en]) => [en, ko] as [string, string]));
+
+/** 바꿔도 되는 곳: 모양 편집기 도구 버튼, 소리 편집기 안 */
+function inEditor(el: Element | null) {
+    return !!(el && el.closest && el.closest('[class*="ToolButtonWrapper"], #entrySoundEdit, .entryPlaygroundSoundEdit'));
+}
+
+function fix(root: Node) {
+    const map = currentLang() === 'en' ? TO_EN : TO_KO;
+    const walker = document.createTreeWalker(root, NodeFilter.SHOW_TEXT);
+    let node: Node | null;
+    while ((node = walker.nextNode())) {
+        const text = (node.textContent || '').trim();
+        const to = text && map.get(text);
+        if (to && inEditor(node.parentElement)) {
+            node.textContent = to;
+        }
+    }
+}
+
+let started = false;
+let pending = false;
+
+/** 앱이 켜질 때 한 번 부른다 */
+export function startEditorLabels() {
+    if (started || typeof MutationObserver === 'undefined') {
+        return;
+    }
+    started = true;
+    const run = () => {
+        pending = false;
+        try {
+            // 편집기 영역 안만 살핀다 (블록을 끄는 동안에도 가볍게)
+            document.querySelectorAll('[class*="ToolButtonWrapper"], #entrySoundEdit').forEach((el) => fix(el));
+        } catch (e) {
+            // 이름을 못 바꿔도 편집에는 영향 없음
+        }
+    };
+    new MutationObserver(() => {
+        if (!pending) {
+            pending = true;
+            // 화면이 바뀐 직후 한 번에 처리 (자주 바뀌어도 가볍게)
+            setTimeout(run, 50);
+        }
+    }).observe(document.body, { childList: true, subtree: true });
+    run();
+}
diff --git a/src/renderer/helper/entry/engineBoost.ts b/src/renderer/helper/entry/engineBoost.ts
new file mode 100644
index 00000000..977846cd
--- /dev/null
+++ b/src/renderer/helper/entry/engineBoost.ts
@@ -0,0 +1,270 @@
+import { fastCalc } from './fastMath';
+
+/**
+ * [entry-local] 엔트리 엔진 최적화 (계산 결과는 원본과 동일)
+ *
+ * 무거운 작품(3D 등)을 측정해 보면 시간의 대부분이 블록 해석기 자체에 쓰인다.
+ *  1) 변수·리스트 찾기   : 매번 lodash _.find 로 전체 목록을 훑는다 → id 위치를 기억해 바로 찾기
+ *  2) 사칙연산(calc_basic): 매번 BigNumber 객체 생성 → 결과가 같다고 보장되는 경우만 일반 연산 (fastMath.ts)
+ *  3) 함수 호출           : 매번 지역변수를 cloneDeep → 값이 단순하면 얕은 복사
+ *  4) 블록 값 계산(Scope)  : map/some 클로저 할당 → 단순 반복문
+ *
+ * 원본 함수는 보관해 두고, 확신할 수 없는 경우는 항상 원본으로 넘긴다.
+ */
+
+let prototypesPatched = false;
+
+/** 작품을 불러올 때마다 호출 (Entry.reloadBlock 이 블록 정의를 새로 만들 수 있으므로) */
+export function installEngineBoost() {
+    const w = window as any;
+    const Entry = w.Entry;
+    if (!Entry || !Entry.block || !Entry.Scope || !Entry.VariableContainer) {
+        return;
+    }
+    if (!prototypesPatched) {
+        prototypesPatched = true;
+        patchLookups(Entry);
+        patchScope(Entry);
+        console.log('[entry-local] 엔진 최적화 적용');
+    }
+    patchCalcBasic(Entry);
+    patchFunctionCall(Entry, w._);
+}
+
+/* ---------------- 1) 변수·리스트 찾기 ---------------- */
+const indexCache = new WeakMap<any[], Map<string, number>>();
+
+function findById(arr: any[] | undefined, id: string) {
+    if (!arr) {
+        return undefined;
+    }
+    let cache = indexCache.get(arr);
+    if (cache) {
+        const i = cache.get(id);
+        if (i !== undefined) {
+            const item = arr[i];
+            // 목록이 바뀌었으면(추가·삭제·순서 변경) 아래에서 다시 찾는다
+            if (item && item.id_ === id) {
+                // _.find 는 "처음" 일치를 돌려주므로 앞쪽에 같은 id 가 끼어들지 않았는지는
+                // 목록 변경 때 캐시를 다시 만드는 것으로 보장한다 (길이 확인)
+                if ((cache as any).__len === arr.length) {
+                    return item;
+                }
+            }
+        }
+    }
+    for (let i = 0; i < arr.length; i++) {
+        const item = arr[i];
+        if (item && item.id_ === id) {
+            if (!cache || (cache as any).__len !== arr.length) {
+                cache = new Map();
+                (cache as any).__len = arr.length;
+                indexCache.set(arr, cache);
+            }
+            cache.set(id, i);
+            return item;
+        }
+    }
+    return undefined;
+}
+
+function patchLookups(Entry: any) {
+    const proto = Entry.VariableContainer.prototype;
+    proto.getVariable = function(id_: string, entity: any = {}) {
+        let variable = findById(this.variables_, id_);
+        if (entity.isClone && variable.object_) {
+            variable = findById(entity.variables, id_);
+        }
+        return variable;
+    };
+    proto.getList = function(listId: string, options: any = {}) {
+        const { isClone, lists } = options || {};
+        let list = findById(this.lists_, listId);
+        if (isClone && list.object_) {
+            list = findById(lists, listId);
+        }
+        return list;
+    };
+}
+
+/* ---------------- 2) 사칙연산 ---------------- */
+function patchCalcBasic(Entry: any) {
+    const schema = Entry.block.calc_basic;
+    if (!schema || typeof schema.func !== 'function' || schema.func.__entryLocal) {
+        return;
+    }
+    const original = schema.func;
+    const isNumber = Entry.Utils.isNumber;
+    schema.func = function(sprite: any, script: any) {
+        const operator = script.getField('OPERATOR', script);
+        if (operator === 'PLUS') {
+            // 문자열 이어붙이기 경우는 원본 처리
+            if (!isNumber(script.getValue('LEFTHAND', script)) || !isNumber(script.getValue('RIGHTHAND', script))) {
+                return original.call(this, sprite, script);
+            }
+        }
+        const r = fastCalc(
+            operator,
+            script.getNumberValue('LEFTHAND', script),
+            script.getNumberValue('RIGHTHAND', script)
+        );
+        return r !== undefined ? r : original.call(this, sprite, script);
+    };
+    schema.func.__entryLocal = true;
+}
+
+/* ---------------- 3) 함수 호출 ---------------- */
+function cloneLocalVariables(vars: any, lodash: any) {
+    if (Array.isArray(vars)) {
+        let simple = true;
+        for (let i = 0; i < vars.length; i++) {
+            const v = vars[i];
+            if (
+                !v ||
+                Object.getPrototypeOf(v) !== Object.prototype ||
+                (v.value !== null && typeof v.value === 'object')
+            ) {
+                simple = false;
+                break;
+            }
+        }
+        if (simple) {
+            const out = new Array(vars.length);
+            for (let i = 0; i < vars.length; i++) {
+                out[i] = { ...vars[i] };
+            }
+            return out;
+        }
+    }
+    return lodash.cloneDeep(vars);
+}
+
+function patchFunctionCall(Entry: any, lodash: any) {
+    if (!lodash || typeof lodash.cloneDeep !== 'function') {
+        return;
+    }
+    const general = Entry.block.function_general;
+    if (general && typeof general.func === 'function' && !general.func.__entryLocal) {
+        // 원본(entry.js function_general.func)과 같고 cloneDeep 만 교체
+        general.func = function(entity: any, script: any) {
+            if (!this.initiated) {
+                this.initiated = true;
+                Entry.callStackLength++;
+                const func = Entry.variableContainer.getFunction(this.block.getFuncId());
+                this.funcCode = func.content;
+                this.funcExecutor = this.funcCode.raiseEvent('funcDef', entity)[0];
+                this.funcExecutor.register.params = this.values;
+                this.funcExecutor.register.paramMap = func.paramMap;
+                this.funcExecutor.parentExecutor = this.executor;
+                this.funcExecutor.parentScope = script;
+                this.funcExecutor.isFuncExecutor = true;
+                this.funcExecutor.localVariables = cloneLocalVariables(func.localVariables, lodash);
+            }
+            const { promises } = this.funcExecutor.execute();
+            if (!this.funcExecutor.isEnd()) {
+                if (promises.length) {
+                    return Entry.Code.funcAsyncExecute(this.funcCode, this.funcExecutor, promises);
+                } else {
+                    this.funcCode.removeExecutor(this.funcExecutor);
+                    return Entry.STATIC.BREAK;
+                }
+            } else {
+                this.funcCode.removeExecutor(this.funcExecutor);
+            }
+            Entry.callStackLength--;
+        };
+        general.func.__entryLocal = true;
+    }
+    const value = Entry.block.function_value;
+    if (value && typeof value.func === 'function' && !value.func.__entryLocal) {
+        value.func = function(entity: any, script: any) {
+            if (!this.initiated) {
+                this.initiated = true;
+                Entry.callStackLength++;
+                const func = Entry.variableContainer.getFunction(this.block.getFuncId());
+                this.funcCode = func.content;
+                this.funcExecutor = this.funcCode.raiseEvent('funcDef', entity)[0];
+                this.funcExecutor.register.params = this.values;
+                this.funcExecutor.register.paramMap = func.paramMap;
+                this.funcExecutor.parentExecutor = this.executor;
+                this.funcExecutor.parentScope = script;
+                this.funcExecutor.isFuncExecutor = true;
+                this.funcExecutor.localVariables = cloneLocalVariables(func.localVariables, lodash);
+            }
+            this.funcExecutor.result = this.funcExecutor.scope;
+            const fe = this.funcExecutor;
+            const firstBlock =
+                fe && fe.scope && fe.scope.block && fe.scope.block.statements[0]
+                    ? fe.scope.block.statements[0].getFirstBlock()
+                    : undefined;
+            if (firstBlock) {
+                this.funcExecutor.scope = new Entry.Scope(firstBlock, this.funcExecutor);
+            }
+            const { promises } = this.funcExecutor.execute();
+            if (!this.funcExecutor.isEnd()) {
+                if (promises.length) {
+                    return Entry.Code.funcValueAsyncExecute(this.funcCode, this.funcExecutor, promises);
+                } else {
+                    return Entry.Code.funcRestExecute(this.funcCode, this.funcExecutor);
+                }
+            } else {
+                this.funcCode.removeExecutor(this.funcExecutor);
+            }
+            Entry.callStackLength--;
+            const scope = this.funcExecutor.result;
+            scope.values = scope.getParams();
+            return scope.getValue('VALUE', scope);
+        };
+        value.func.__entryLocal = true;
+    }
+}
+
+/* ---------------- 4) 블록 값 계산 ---------------- */
+function patchScope(Entry: any) {
+    const proto = Entry.Scope.prototype;
+    const Block = Entry.Block;
+    const Scope = Entry.Scope;
+
+    proto.getParams = function() {
+        const params = this.block.params;
+        const n = params.length;
+        const out = new Array(n);
+        for (let i = 0; i < n; i++) {
+            const param = params[i];
+            if (param instanceof Block) {
+                out[i] = new Scope(param, this.executor).run(this.entity, true);
+            } else {
+                out[i] = this.filterReservedKeywords(param);
+            }
+        }
+        return out;
+    };
+
+    proto.run = function(entity: any) {
+        const schema = this.block.getSchema();
+        if (this.isCondition) {
+            return schema.func.call(this, entity, this);
+        }
+        const values = this.getParams();
+        let isPromise = false;
+        for (let i = 0; i < values.length; i++) {
+            if (values[i] instanceof Promise) {
+                isPromise = true;
+                break;
+            }
+        }
+        if (!schema.func) {
+            return;
+        }
+        if (!isPromise) {
+            this.values = values;
+            return schema.func.call(this, entity, this);
+        }
+        return Promise.all(values).then(async (resolved: any[]) => {
+            if (Entry.engine.state !== 'stop' && this.block) {
+                this.values = resolved;
+                return await schema.func.call(this, entity, this);
+            }
+        });
+    };
+}
