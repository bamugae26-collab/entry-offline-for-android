@@ -0,0 +1,122 @@
+/**
+ * [entry-local] 로컬 전용 동작 모음
+ *
+ * - 공유 변수/리스트(isCloud), 실시간 변수/리스트(isRealTime)는 서버(소켓)를 써야 하므로
+ *   불러올 때 일반 변수로 바꿔서 모두 이 PC 메모리 안에서만 동작하게 한다.
+ * - 변수·리스트 추가 패널의 '공유/실시간' 선택지를 숨긴다.
+ * - 신호(message)는 원래 엔진 내부 이벤트라 별도 처리 없이 로컬에서 동작한다.
+ */
+
+const STYLE_ID = 'entry-local-style';
+
+export function localizeProject<T>(project: T): T {
+    if (!project || typeof project !== 'object') {
+        return project;
+    }
+    const target = project as any;
+
+    if (Array.isArray(target.variables)) {
+        target.variables.forEach((variable: any) => {
+            if (!variable) {
+                return;
+            }
+            variable.isCloud = false;
+            variable.isRealTime = false;
+            delete variable.cloudDate;
+        });
+    }
+
+    // 서버에 저장돼 있던 공유 변수 값 묶음. 로컬에서는 쓰지 않는다.
+    delete target.cloudVariable;
+    return project;
+}
+
+/**
+ * 하드웨어 연결 프로그램 주소를 이 PC(127.0.0.1)로만 제한한다.
+ * 엔트리 코어는 https://hw.playentry.org:23518 (클라우드 중계)부터 시도하므로 Entry.init 전에 막는다.
+ */
+export function patchHardwareAddress() {
+    const HW = (window as any).Entry && (window as any).Entry.HW;
+    if (!HW || HW.prototype.__entryLocalPatched) {
+        return;
+    }
+    ['httpsServerAddress', 'httpsServerAddress2'].forEach((key) => {
+        Object.defineProperty(HW.prototype, key, {
+            configurable: true,
+            get: () => 'http://127.0.0.1:23518',
+        });
+    });
+    HW.prototype.__entryLocalPatched = true;
+}
+
+export function injectLocalStyle() {
+    if (document.getElementById(STYLE_ID)) {
+        return;
+    }
+    const style = document.createElement('style');
+    style.id = STYLE_ID;
+    style.textContent = `
+        /* 변수/리스트 만들기: 공유·실시간 선택지 숨김 (항상 일반) */
+        .entryVariableTypeBoxWrapper { display: none !important; }
+        /* 입력칸 글자 거꾸로 입력 방지 (안드로이드): 오브젝트 목록 등은 끌기 때문에 user-select:none 이 입력칸까지 물려
+           내려온다. 안드로이드 웹뷰는 이런 입력칸에서 커서가 앞으로 안 가서 right → thgir 처럼 거꾸로 써진다. */
+        input, textarea, [contenteditable='true'] {
+            -webkit-user-select: text !important;
+            user-select: text !important;
+        }
+        /* 글자를 치는 동안에는 말줄임(…) 끔 — 안드로이드에서 말줄임 입력칸은 커서 위치가 어긋날 수 있음 */
+        input:focus, textarea:focus {
+            text-overflow: clip !important;
+        }
+        /* 모양 편집기(그림판): 태블릿처럼 화면 높이가 낮으면 왼쪽 도구 줄 아래쪽(지우개 등)이 잘려 누를 수 없었다
+           → 그림판 최소 높이(600px)를 풀어 남은 높이에 맞추고, 도구 줄은 손가락으로 위아래로 밀 수 있게 */
+        .entryPlaygroundPainter .MainContainer { min-height: 0 !important; }
+        .entryPlaygroundPainter .MainContainer .side_area {
+            overflow-y: auto;
+            overflow-x: hidden;
+            scrollbar-width: none;
+        }
+        .entryPlaygroundPainter .MainContainer .side_area::-webkit-scrollbar { display: none; }
+        /* 로딩·저장 중 창: 말풍선 폭을 넓히면(긴 문구) 엔트리봇이 왼쪽에 고정돼 있어 말풍선 꼬리와 어긋났다
+           → 상자 폭을 말풍선 최소 폭(215px) 이상으로 두고 엔트리봇을 가운데(말풍선 꼬리 아래)로 */
+        [class*="modal_progress__"] > [class*="progress__"] { min-width: 215px; }
+        [class*="modal_progress__"] [class*="progressEntryBot__"] {
+            margin-left: auto !important;
+            margin-right: auto !important;
+        }
+        /* 신호 이름 입력칸: 앱 기본 스타일(input = content-box) 때문에 오른쪽으로 삐져나옴 → 리스트 이름 칸과 같게 */
+        .entryVariableListWorkspace .msdAddSpaceWrapper input[type='text'] {
+            box-sizing: border-box;
+            width: 100%;
+            height: 24px;
+            padding: 6px 8px;
+        }
+    `;
+    document.head.appendChild(style);
+}
+
+/**
+ * 실행 화면을 작은 PNG 로 만든다. 실패하면 undefined (썸네일 없이 저장).
+ */
+export function makeStageThumbnail(width = 192, height = 108): string | undefined {
+    try {
+        const source: HTMLCanvasElement | undefined = (Entry as any)?.stage?.canvas?.canvas;
+        if (!source || !source.width || !source.height) {
+            return undefined;
+        }
+        const canvas = document.createElement('canvas');
+        canvas.width = width;
+        canvas.height = height;
+        const context = canvas.getContext('2d');
+        if (!context) {
+            return undefined;
+        }
+        context.fillStyle = '#ffffff';
+        context.fillRect(0, 0, width, height);
+        context.drawImage(source, 0, 0, width, height);
+        return canvas.toDataURL('image/png');
+    } catch (e) {
+        console.warn('thumbnail failed', e);
+        return undefined;
+    }
+}
diff --git a/src/renderer/helper/entry/performance.ts b/src/renderer/helper/entry/performance.ts
