+/**
+ * [entry-local] 출력하기 — 웹판(playentry.org/print)의 출력 화면과 같은 구성으로
+ * 작품 이름, 작품 전체 무대, 장면별 무대, 오브젝트 표(그림 · 속성 · 코드)를 한 화면에 모아 보여 주고 인쇄한다.
+ *
+ * - 서버와 통신하지 않는다. 지금 열려 있는 작품(Entry)에서 바로 읽는다.
+ * - 코드 그림은 코드 화면(블록 SVG)을 그대로 떠서 넣는다. 블록 모양은 지금 화면과 같다.
+ * - 인쇄: Windows 는 window.print(), 안드로이드는 앱 안 플러그인(EntryAccount.printPage)으로 시스템 인쇄 창을 띄운다.
+ */
+
+import { lt } from '../../common/localLang';
+
+const OVERLAY_ID = 'entry-local-print';
+const STYLE_ID = 'entry-local-print-style';
+
+const entry = (): any => (window as any).Entry;
+const wait = (ms: number) => new Promise<void>((resolve) => setTimeout(resolve, ms));
+
+function esc(value: any): string {
+    const map: { [key: string]: string } = { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' };
+    return String(value === undefined || value === null ? '' : value).replace(/[&<>"']/g, (c) => map[c]);
+}
+
+function num(value: any, digits = 0): string {
+    const n = Number(value);
+    return isFinite(n) ? n.toFixed(digits) : '0';
+}
+
+function trimmed(value: any): string {
+    const n = Number(value);
+    return isFinite(n) ? String(Number(n.toFixed(1))) : '0';
+}
+
+/** 지금 보이는 장면의 무대를 그림(JPEG)으로 */
+function stageImage(): string | undefined {
+    try {
+        const stage = entry().stage;
+        if (stage && stage.handle && stage.handle.setVisible) {
+            stage.handle.setVisible(false);
+        }
+        if (stage && stage.update) {
+            stage.update();
+        }
+        const source: HTMLCanvasElement | undefined = stage && stage.canvas && stage.canvas.canvas;
+        if (!source || !source.width || !source.height) {
+            return undefined;
+        }
+        const canvas = document.createElement('canvas');
+        canvas.width = source.width;
+        canvas.height = source.height;
+        const context = canvas.getContext('2d');
+        if (!context) {
+            return undefined;
+        }
+        context.fillStyle = '#ffffff';
+        context.fillRect(0, 0, canvas.width, canvas.height);
+        context.drawImage(source, 0, 0);
+        return canvas.toDataURL('image/jpeg', 0.85);
+    } catch (e) {
+        console.warn('stage image failed', e);
+        return undefined;
+    }
+}
+
+/** 오브젝트 목록에 보이는 그림을 그대로 가져오고, 안 되면 그림 파일 주소로 */
+function objectThumb(object: any): string | undefined {
+    try {
+        const view: HTMLElement | undefined = object.view_;
+        if (view && view.querySelector) {
+            const canvas = view.querySelector('canvas') as HTMLCanvasElement | null;
+            if (canvas && canvas.width) {
+                return canvas.toDataURL('image/png');
+            }
+            const img = view.querySelector('img') as HTMLImageElement | null;
+            if (img && img.src) {
+                return img.src;
+            }
+            const nodes = view.querySelectorAll('div');
+            for (let i = 0; i < nodes.length; i += 1) {
+                const bg = getComputedStyle(nodes[i]).backgroundImage;
+                const found = bg && /url\(["']?(.*?)["']?\)/.exec(bg);
+                if (found && found[1]) {
+                    return found[1];
+                }
+            }
+        }
+        if (object.thumbUrl) {
+            return object.thumbUrl;
+        }
+        const picture =
+            (object.entity && object.entity.picture) ||
+            object.selectedPicture ||
+            (object.pictures && object.pictures[0]);
+        if (picture) {
+            if (picture.fileurl) {
+                return picture.fileurl;
+            }
+            if (picture.filename) {
+                const f: string = picture.filename;
+                const ext = picture.imageType === 'svg' ? 'svg' : 'png';
+                return `${entry().defaultPath || ''}/uploads/${f.substring(0, 2)}/${f.substring(2, 4)}/image/${f}.${ext}`;
+            }
+        }
+    } catch (e) {
+        console.warn('thumbnail failed', e);
+    }
+    return undefined;
+}
+
+const COPY_STYLES = [
+    'fill',
+    'fill-opacity',
+    'stroke',
+    'stroke-width',
+    'stroke-opacity',
+    'font-family',
+    'font-size',
+    'font-weight',
+    'opacity',
+    'display',
+    'visibility',
+];
+
+/** 코드 화면(블록 SVG)을 잘라서 하나의 SVG 문자열로. 지금 선택된 오브젝트의 코드가 대상 */
+function codeSvg(): string | undefined {
+    try {
+        const workspace = entry().getMainWS && entry().getMainWS();
+        const board = workspace && (workspace.board || (workspace.getBoard && workspace.getBoard()));
+        const group: SVGGraphicsElement | undefined = board && (board.svgBlockGroup || board.svgGroup);
+        if (!group || !group.firstChild || !group.getBBox) {
+            return undefined;
+        }
+        const box = group.getBBox();
+        if (!box || !box.width || !box.height) {
+            return undefined;
+        }
+        const clone = group.cloneNode(true) as SVGGraphicsElement;
+        const originals = group.querySelectorAll('*');
+        const copies = clone.querySelectorAll('*');
+        for (let i = 0; i < originals.length && i < copies.length; i += 1) {
+            const computed = getComputedStyle(originals[i]);
+            const target = copies[i] as unknown as HTMLElement;
+            COPY_STYLES.forEach((name) => {
+                const value = computed.getPropertyValue(name);
+                if (value && target.style) {
+                    target.style.setProperty(name, value);
+                }
+            });
+        }
+        clone.removeAttribute('transform');
+        const pad = 8;
+        const width = Math.ceil(box.width + pad * 2);
+        const height = Math.ceil(box.height + pad * 2);
+        return (
+            `<svg xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" ` +
+            `viewBox="${box.x - pad} ${box.y - pad} ${width} ${height}" width="${width}" height="${height}">` +
+            new XMLSerializer().serializeToString(clone) +
+            '</svg>'
+        );
+    } catch (e) {
+        console.warn('code capture failed', e);
+        return undefined;
+    }
+}
+
+interface PrintObject {
+    name: string;
+    thumb?: string;
+    x: string;
+    y: string;
+    size: string;
+    rotation: string;
+    direction: string;
+    code?: string;
+}
+
+interface PrintScene {
+    name: string;
+    image?: string;
+    objects: PrintObject[];
+}
+
+/** 작품 전체를 읽는다. 장면·오브젝트를 하나씩 선택해 그림을 뜨고, 끝나면 원래 선택으로 되돌린다. */
+async function collect(): Promise<{ projectImage?: string; scenes: PrintScene[] }> {
+    const E = entry();
+    const sceneApi = E.scene;
+    const scenes: any[] = (sceneApi && sceneApi.getScenes && sceneApi.getScenes()) || [];
+    const objects: any[] = (E.container && E.container.getAllObjects && E.container.getAllObjects()) || [];
+    const originalScene = sceneApi && sceneApi.selectedScene;
+    const originalObject = E.playground && E.playground.object;
+
+    const projectImage = stageImage();
+    const result: PrintScene[] = [];
+
+    const readObject = async (object: any): Promise<PrintObject> => {
+        let code: string | undefined;
+        try {
+            E.container.selectObject(object.id, true);
+            await wait(180);
+            code = codeSvg();
+        } catch (e) {
+            console.warn('select object failed', e);
+        }
+        const entity = object.entity || {};
+        const get = (fn: string, fallback = 0) => (entity[fn] ? entity[fn]() : fallback);
+        return {
+            name: object.name || '',
+            thumb: objectThumb(object),
+            x: trimmed(get('getX')),
+            y: trimmed(get('getY')),
+            size: num(get('getSize', 100), 1),
+            rotation: `${num(get('getRotation'))}°`,
+            direction: `${num(get('getDirection', 90))}°`,
+            code,
+        };
+    };
+
+    if (scenes.length === 0) {
+        const list: PrintObject[] = [];
+        for (const object of objects) {
+            list.push(await readObject(object));
+        }
+        result.push({ name: lt('장면 1', 'Scene 1'), image: projectImage, objects: list });
+    } else {
+        for (const scene of scenes) {
+            try {
+                if (sceneApi.selectedScene !== scene) {
+                    sceneApi.selectScene(scene);
+                    await wait(350);
+                }
+            } catch (e) {
+                console.warn('select scene failed', e);
+            }
+            const image = stageImage();
+            const list: PrintObject[] = [];
+            for (const object of objects.filter((o) => o.scene && o.scene.id === scene.id)) {
+                list.push(await readObject(object));
+            }
+            result.push({ name: scene.name || lt('장면', 'Scene'), image, objects: list });
+        }
+    }
+
+    try {
+        if (originalScene && sceneApi.selectedScene !== originalScene) {
+            sceneApi.selectScene(originalScene);
+            await wait(200);
+        }
+        if (originalObject) {
+            E.container.selectObject(originalObject.id, true);
+        }
+    } catch (e) {
+        console.warn('restore selection failed', e);
+    }
+    return { projectImage, scenes: result };
+}
+
+const PRINT_ICON =
+    '<svg viewBox="0 0 36 36"><path d="M6 2.4A2.4 2.4 0 0 1 8.4 0H27.6A2.4 2.4 0 0 1 30 2.4V7.54A2.4 2.4 0 0 1 27.6 9.94H8.4A2.4 2.4 0 0 1 6 7.54ZM4 12H32A4 4 0 0 1 36 16V22.94A3 3 0 0 1 33 25.94H29.88V22A4 4 0 0 0 25.88 18H10.12A4 4 0 0 0 6.12 22V25.94H3A3 3 0 0 1 0 22.94V16A4 4 0 0 1 4 12ZM7.9 23.64A3.7 3.7 0 0 1 11.6 19.94H24.4A3.7 3.7 0 0 1 28.1 23.64V32.24A3.7 3.7 0 0 1 24.4 35.94H11.6A3.7 3.7 0 0 1 7.9 32.24Z"/></svg>';
+
+const STYLE = `
+#${OVERLAY_ID}{position:fixed;left:0;top:0;right:0;bottom:0;z-index:2147483000;background:#fff;overflow:auto;font-family:'NanumGothic','Nanum Gothic',sans-serif;color:#222;-webkit-overflow-scrolling:touch}
+#${OVERLAY_ID} .elp-bar{position:sticky;top:0;z-index:2;display:flex;align-items:center;height:52px;padding:0 20px;background:#4f80ff;color:#fff}
+#${OVERLAY_ID} .elp-bar .elp-dot{width:5px;height:5px;border-radius:50%;background:#fff;margin-right:14px}
+#${OVERLAY_ID} .elp-bar .elp-title{flex:1;font-size:22px;font-weight:bold}
+#${OVERLAY_ID} .elp-bar button{display:inline-flex;align-items:center;justify-content:center;border:0;cursor:pointer;margin-left:12px}
+#${OVERLAY_ID} .elp-print{width:38px;height:38px;border-radius:50%;background:#fff}
+#${OVERLAY_ID} .elp-print svg{width:19px;height:19px;fill:#4f80ff}
+#${OVERLAY_ID} .elp-close{height:34px;padding:0 14px;border-radius:17px;background:rgba(255,255,255,.2);color:#fff;font-size:15px}
+#${OVERLAY_ID} .elp-page{padding:24px 40px 60px;max-width:1100px}
+#${OVERLAY_ID} h1{font-size:26px;margin:12px 0 14px}
+#${OVERLAY_ID} h2{font-size:21px;margin:30px 0 12px}
+#${OVERLAY_ID} h2:before{content:'';display:inline-block;width:6px;height:6px;border-radius:50%;background:#4f80ff;margin-right:12px;vertical-align:top}
+#${OVERLAY_ID} .elp-stage{border:1px solid #cdeee8;background:#fff;display:flex;align-items:center;justify-content:center}
+#${OVERLAY_ID} .elp-stage.big{width:100%;max-width:960px;aspect-ratio:16/9}
+#${OVERLAY_ID} .elp-stage.small{width:70%;max-width:700px;aspect-ratio:16/9}
+#${OVERLAY_ID} .elp-stage img{max-width:100%;max-height:100%;display:block}
+#${OVERLAY_ID} .elp-note{color:#888;font-size:14px}
+#${OVERLAY_ID} hr{border:0;border-top:2px solid #d5e6f3;margin:34px 0 0}
+#${OVERLAY_ID} .elp-table{margin-top:26px;border:1px solid #b9d3e8;border-radius:22px;overflow:hidden}
+#${OVERLAY_ID} .elp-row{display:grid;grid-template-columns:22% 24% 54%;border-top:1px solid #b9d3e8;break-inside:avoid;page-break-inside:avoid}
+#${OVERLAY_ID} .elp-row.head{background:#d6e6f4;border-top:0;font-weight:bold;text-align:center;font-size:17px}
+#${OVERLAY_ID} .elp-row.head div{padding:16px 6px}
+#${OVERLAY_ID} .elp-cell{padding:18px 14px;border-left:1px solid #b9d3e8;min-width:0}
+#${OVERLAY_ID} .elp-cell:first-child{border-left:0;text-align:center}
+#${OVERLAY_ID} .elp-thumb{display:inline-block;width:110px;border:1px solid #d5e6f3;border-radius:10px;overflow:hidden;background:#fff}
+#${OVERLAY_ID} .elp-thumb .img{height:90px;display:flex;align-items:center;justify-content:center}
+#${OVERLAY_ID} .elp-thumb img{max-width:90%;max-height:85px}
+#${OVERLAY_ID} .elp-thumb .name{background:#d6e6f4;font-size:13px;padding:6px 4px;word-break:break-all}
+#${OVERLAY_ID} .elp-prop{display:flex;font-size:15px;line-height:2.1}
+#${OVERLAY_ID} .elp-prop b{width:52%}
+#${OVERLAY_ID} .elp-code svg{max-width:100%;height:auto;display:block}
+@media print{
+  body > *:not(#${OVERLAY_ID}){display:none !important}
+  html,body{height:auto !important;overflow:visible !important;background:#fff !important}
+  #${OVERLAY_ID}{position:static !important;overflow:visible !important;height:auto !important}
+  #${OVERLAY_ID} .elp-bar{display:none !important}
+  #${OVERLAY_ID} .elp-page{padding:0;max-width:none}
+  @page{margin:12mm}
+}`;
+
+function ensureStyle() {
+    if (!document.getElementById(STYLE_ID)) {
+        const style = document.createElement('style');
+        style.id = STYLE_ID;
+        style.textContent = STYLE;
+        document.head.appendChild(style);
+    }
+}
+
+async function doPrint(title: string) {
+    const cap = (window as any).Capacitor;
+    const plugin = cap && cap.Plugins && cap.Plugins.EntryAccount;
+    if (cap && cap.isNativePlatform && cap.isNativePlatform() && plugin && plugin.printPage) {
+        try {
+            await plugin.printPage({ title });
+            return;
+        } catch (e) {
+            console.warn('native print failed', e);
+        }
+    }
+    window.print();
+}
+
+function closeOverlay() {
+    const old = document.getElementById(OVERLAY_ID);
+    if (old && old.parentNode) {
+        old.parentNode.removeChild(old);
+    }
+}
+
+function render(title: string, data: { projectImage?: string; scenes: PrintScene[] }) {
+    const stage = (image: string | undefined, cls: string) =>
+        `<div class="elp-stage ${cls}">${image ? `<img src="${image}">` : `<span class="elp-note">${lt('무대 그림을 가져오지 못했습니다.', 'Could not get the stage image.')}</span>`}</div>`;
+
+    const rows = (objects: PrintObject[]) =>
+        objects
+            .map(
+                (o) => `
+<div class="elp-row">
+  <div class="elp-cell"><div class="elp-thumb"><div class="img">${o.thumb ? `<img src="${esc(o.thumb)}">` : ''}</div><div class="name">${esc(o.name)}</div></div></div>
+  <div class="elp-cell">
+    <div class="elp-prop"><b>X</b><span>${esc(o.x)}</span></div>
+    <div class="elp-prop"><b>Y</b><span>${esc(o.y)}</span></div>
+    <div class="elp-prop"><b>${lt('크기', 'Size')}</b><span>${esc(o.size)}</span></div>
+    <div class="elp-prop"><b>${lt('이동 방향(°)', 'Moving direction (°)')}</b><span>${esc(o.direction)}</span></div>
+    <div class="elp-prop"><b>${lt('방향(°)', 'Direction (°)')}</b><span>${esc(o.rotation)}</span></div>
+  </div>
+  <div class="elp-cell elp-code">${o.code || `<span class="elp-note">${lt('코드를 가져오지 못했습니다. (블록 코딩 화면에서 출력해 주세요)', 'Could not get the code. (Please print from the block coding screen.)')}</span>`}</div>
+</div>`
+            )
+            .join('');
+
+    const sections = data.scenes
+        .map(
+            (scene) => `
+<h2>${esc(scene.name)}</h2>
+${stage(scene.image, 'small')}
+<div class="elp-table">
+  <div class="elp-row head"><div>${lt('오브젝트', 'Object')}</div><div>${lt('속성', 'Properties')}</div><div>${lt('코드', 'Code')}</div></div>
+  ${rows(scene.objects)}
+</div>`
+        )
+        .join('');
+
+    const overlay = document.getElementById(OVERLAY_ID);
+    if (!overlay) {
+        return;
+    }
+    const page = overlay.querySelector('.elp-page');
+    if (page) {
+        page.innerHTML = `<h1>${esc(title)}</h1>${stage(data.projectImage, 'big')}<hr>${sections}`;
+    }
+}
+
+/** 출력 화면을 열고 작품 내용을 채운다 */
+export async function openPrintView(projectName?: string) {
+    const E = entry();
+    if (!E || !E.container) {
+        return;
+    }
+    if (E.engine && E.engine.isState && E.engine.isState('run')) {
+        try {
+            E.toast.warning(lt('출력하기', 'Print'), lt('작품 실행을 멈춘 뒤에 출력해 주세요.', 'Please stop the project before printing.'));
+        } catch (e) {
+            alert(lt('작품 실행을 멈춘 뒤에 출력해 주세요.', 'Please stop the project before printing.'));
+        }
+        return;
+    }
+    ensureStyle();
+    closeOverlay();
+    const title = projectName || lt('엔트리 작품', 'Entry project');
+    const overlay = document.createElement('div');
+    overlay.id = OVERLAY_ID;
+    overlay.innerHTML =
+        `<div class="elp-bar"><span class="elp-dot"></span><span class="elp-title">${lt('출력하기', 'Print')}</span>` +
+        `<button class="elp-close" type="button">${lt('닫기', 'Close')}</button>` +
+        `<button class="elp-print" type="button" title="${lt('인쇄', 'Print')}">${PRINT_ICON}</button></div>` +
+        `<div class="elp-page"><p class="elp-note">${lt('출력 화면을 만드는 중입니다…', 'Preparing the print view…')}</p></div>`;
+    document.body.appendChild(overlay);
+    (overlay.querySelector('.elp-close') as HTMLElement).onclick = closeOverlay;
+    (overlay.querySelector('.elp-print') as HTMLElement).onclick = () => {
+        doPrint(title);
+    };
+
+    try {
+        render(title, await collect());
+    } catch (e) {
+        console.error(e);
+        const page = overlay.querySelector('.elp-page');
+        if (page) {
+            page.innerHTML = `<p class="elp-note">${lt('출력 화면을 만들지 못했습니다.', 'Could not create the print view.')}</p>`;
+        }
+    }
+}
diff --git a/src/renderer/helper/saveDoneAlert.ts b/src/renderer/helper/saveDoneAlert.ts
