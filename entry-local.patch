+    }
+    if (needDrive && !t.scope.includes('https://www.googleapis.com/auth/drive.file')) {
+        send(res, 403, { error: { code: 403, message: 'Insufficient Permission: drive.file scope required' } });
+        return null;
+    }
+    return t;
+}
+
+function issueAccess(scope, email) {
+    const token = `ya29.${id()}`;
+    db.access[token] = { expires: Date.now() + TOKEN_TTL * 1000, scope, email };
+    return token;
+}
+
+function fileJson(f) {
+    return {
+        kind: 'drive#file',
+        id: f.id,
+        name: f.name,
+        mimeType: f.mimeType,
+        parents: f.parents,
+        appProperties: f.appProperties || {},
+        trashed: !!f.trashed,
+        createdTime: new Date(f.created).toISOString(),
+        modifiedTime: new Date(f.modified).toISOString(),
+        size: f.content ? String(f.content.length) : undefined,
+        thumbnailLink: f.thumb ? `${BASE}/thumb/${f.id}?sz=s220` : undefined,
+    };
+}
+
+function query(q) {
+    // 앱이 쓰는 형태만 해석: name='..', mimeType='..', mimeType!='..', trashed=false, 'X' in parents
+    const conds = [];
+    const re = /(name|mimeType)\s*(!=|=)\s*'((?:\\'|[^'])*)'|trashed\s*=\s*false|'((?:\\'|[^'])*)'\s+in\s+parents/g;
+    let m;
+    while ((m = re.exec(q))) {
+        if (m[1]) {
+            const v = m[3].replace(/\\'/g, "'").replace(/\\\\/g, '\\');
+            conds.push((f) => (m[2] === '=' ? f[m[1]] === v : f[m[1]] !== v));
+            const field = m[1], op = m[2];
+            conds[conds.length - 1] = (f) => (op === '=' ? f[field] === v : f[field] !== v);
+        } else if (m[4] !== undefined) {
+            const parent = m[4];
+            conds.push((f) => (f.parents || []).includes(parent));
+        } else {
+            conds.push((f) => !f.trashed);
+        }
+    }
+    return Object.values(db.files).filter((f) => conds.every((c) => c(f)));
+}
+
+const server = http.createServer(async (req, res) => {
+    const url = new URL(req.url, BASE);
+    const p = url.pathname;
+    db.log.push(`${req.method} ${p}${url.search.length > 120 ? url.search.slice(0, 120) + '…' : url.search}`);
+    if (req.method === 'OPTIONS') {
+        res.writeHead(204, {
+            'Access-Control-Allow-Origin': '*',
+            'Access-Control-Allow-Methods': 'GET,POST,PUT,PATCH,DELETE,OPTIONS',
+            'Access-Control-Allow-Headers': 'Authorization, Content-Type, X-Upload-Content-Type',
+            'Access-Control-Expose-Headers': 'Location',
+            'Access-Control-Max-Age': '600',
+        });
+        return res.end();
+    }
+    try {
+        /* ---------- 시험 도구 ---------- */
+        if (p === '/_mock/state') {
+            return send(res, 200, {
+                files: Object.values(db.files).map((f) => ({ ...fileJson(f), hasThumb: !!f.thumb, bytes: f.content ? f.content.length : 0 })),
+                counters: db.counters,
+                refreshTokens: Object.keys(db.refresh).length,
+                log: db.log.slice(-60),
+            });
+        }
+        if (p === '/_mock/reset') {
+            reset();
+            return send(res, 200, { ok: true });
+        }
+        if (p === '/_mock/expire-all') {
+            Object.values(db.access).forEach((t) => (t.expires = 0));
+            return send(res, 200, { ok: true });
+        }
+
+        /* ---------- OAuth ---------- */
+        if (p === '/o/oauth2/v2/auth') {
+            const q = Object.fromEntries(url.searchParams);
+            const client = CLIENTS[q.client_id];
+            if (!client) {
+                return send(res, 400, '<h1>Error 401: invalid_client</h1>');
+            }
+            if (q.response_type === 'code') {
+                if (client.type !== 'desktop' || !/^http:\/\/127\.0\.0\.1:\d+$/.test(q.redirect_uri)) {
+                    return send(res, 400, '<h1>redirect_uri_mismatch</h1>');
+                }
+                if (q.code_challenge_method !== 'S256' || !q.code_challenge) {
+                    return send(res, 400, '<h1>PKCE required</h1>');
+                }
+                const code = `4/${id()}`;
+                db.codes[code] = { client: q.client_id, redirect: q.redirect_uri, challenge: q.code_challenge, scope: q.scope };
+                res.writeHead(302, { Location: `${q.redirect_uri}?state=${encodeURIComponent(q.state)}&code=${encodeURIComponent(code)}&scope=${encodeURIComponent(q.scope)}` });
+                return res.end();
+            }
+            if (q.response_type === 'token') {
+                if (client.type !== 'web') {
+                    return send(res, 400, '<h1>unauthorized_client</h1>');
+                }
+                const token = issueAccess(q.scope, USER.email);
+                res.writeHead(302, {
+                    Location: `${q.redirect_uri}#access_token=${token}&token_type=Bearer&expires_in=${TOKEN_TTL}&scope=${encodeURIComponent(q.scope)}&state=${encodeURIComponent(q.state)}`,
+                });
+                return res.end();
+            }
+            return send(res, 400, '<h1>unsupported_response_type</h1>');
+        }
+        if (p === '/token' && req.method === 'POST') {
+            const body = Object.fromEntries(new URLSearchParams((await readBody(req)).toString()));
+            const client = CLIENTS[body.client_id];
+            if (!client || client.secret !== body.client_secret) {
+                return send(res, 401, { error: 'invalid_client', error_description: 'The OAuth client was not found.' });
+            }
+            if (body.grant_type === 'authorization_code') {
+                const c = db.codes[body.code];
+                delete db.codes[body.code];
+                if (!c || c.client !== body.client_id) {
+                    return send(res, 400, { error: 'invalid_grant', error_description: 'Malformed auth code.' });
+                }
+                if (c.redirect !== body.redirect_uri) {
+                    return send(res, 400, { error: 'redirect_uri_mismatch' });
+                }
+                const challenge = b64url(crypto.createHash('sha256').update(body.code_verifier || '').digest());
+                if (challenge !== c.challenge) {
+                    return send(res, 400, { error: 'invalid_grant', error_description: 'Invalid code verifier.' });
+                }
+                const refresh = `1//${id()}`;
+                db.refresh[refresh] = { client: body.client_id, scope: c.scope, email: USER.email };
+                return send(res, 200, {
+                    access_token: issueAccess(c.scope, USER.email),
+                    expires_in: TOKEN_TTL,
+                    refresh_token: refresh,
+                    scope: c.scope,
+                    token_type: 'Bearer',
+                });
+            }
+            if (body.grant_type === 'refresh_token') {
+                const r = db.refresh[body.refresh_token];
+                if (!r || r.client !== body.client_id) {
+                    return send(res, 400, { error: 'invalid_grant', error_description: 'Token has been expired or revoked.' });
+                }
+                db.counters.tokenRefresh++;
+                return send(res, 200, { access_token: issueAccess(r.scope, r.email), expires_in: TOKEN_TTL, scope: r.scope, token_type: 'Bearer' });
+            }
+            return send(res, 400, { error: 'unsupported_grant_type' });
+        }
+        if (p === '/revoke' && req.method === 'POST') {
+            const body = Object.fromEntries(new URLSearchParams((await readBody(req)).toString()));
+            delete db.refresh[body.token];
+            delete db.access[body.token];
+            return send(res, 200, {});
+        }
+        if (p === '/oauth2/v3/userinfo') {
+            if (!auth(req, res, false)) return;
+            return send(res, 200, { sub: '1234', ...USER });
+        }
+
+        /* ---------- Drive ---------- */
+        if (p === '/drive/v3/files' && req.method === 'GET') {
+            if (!auth(req, res)) return;
+            let list = query(url.searchParams.get('q') || '');
+            if ((url.searchParams.get('orderBy') || '').startsWith('modifiedTime desc')) {
+                list.sort((a, b) => b.modified - a.modified);
+            }
+            const size = Math.min(Number(url.searchParams.get('pageSize') || 100), PAGE_SIZE_CAP);
+            const start = Number(url.searchParams.get('pageToken') || 0);
+            const page = list.slice(start, start + size);
+            return send(res, 200, {
+                files: page.map(fileJson),
+                nextPageToken: start + size < list.length ? String(start + size) : undefined,
+            });
+        }
+        if (p === '/drive/v3/files' && req.method === 'POST') {
+            if (!auth(req, res)) return;
+            const meta = JSON.parse((await readBody(req)).toString() || '{}');
+            const f = { id: id(), name: meta.name, mimeType: meta.mimeType, parents: (meta.parents || ['root']).map((x) => (x === 'root' ? 'root' : x)), appProperties: meta.appProperties, created: Date.now(), modified: Date.now() };
+            db.files[f.id] = f;
+            return send(res, 200, { id: f.id });
+        }
+        let m = /^\/drive\/v3\/files\/([^/]+)$/.exec(p);
+        if (m) {
+            if (!auth(req, res)) return;
+            const f = db.files[m[1]];
+            if (!f) return send(res, 404, { error: { code: 404, message: `File not found: ${m[1]}.` } });
+            if (req.method === 'GET') {
+                if (url.searchParams.get('alt') === 'media') return send(res, 200, f.content || Buffer.alloc(0));
+                return send(res, 200, fileJson(f));
+            }
+            if (req.method === 'PATCH') {
+                const meta = JSON.parse((await readBody(req)).toString() || '{}');
+                if (meta.name) f.name = meta.name;
+                if (meta.appProperties) f.appProperties = { ...(f.appProperties || {}), ...meta.appProperties };
+                if (meta.trashed !== undefined) f.trashed = !!meta.trashed;
+                f.modified = Date.now();
+                return send(res, 200, { id: f.id });
+            }
+            if (req.method === 'DELETE') {
+                delete db.files[f.id];
+                return send(res, 204, '');
+            }
+        }
+        if (p === '/upload/drive/v3/files' && req.method === 'POST' && url.searchParams.get('uploadType') === 'resumable') {
+            if (!auth(req, res)) return;
+            const meta = JSON.parse((await readBody(req)).toString() || '{}');
+            const sid = id();
+            db.sessions[sid] = { fileId: null, meta };
+            return send(res, 200, '', { Location: `${BASE}/upload/session/${sid}`, 'Content-Type': 'text/plain' });
+        }
+        m = /^\/upload\/drive\/v3\/files\/([^/]+)$/.exec(p);
+        if (m && req.method === 'PATCH' && url.searchParams.get('uploadType') === 'resumable') {
+            if (!auth(req, res)) return;
+            if (!db.files[m[1]]) return send(res, 404, { error: { code: 404, message: `File not found: ${m[1]}.` } });
+            const meta = JSON.parse((await readBody(req)).toString() || '{}');
+            const sid = id();
+            db.sessions[sid] = { fileId: m[1], meta };
+            return send(res, 200, '', { Location: `${BASE}/upload/session/${sid}`, 'Content-Type': 'text/plain' });
+        }
+        m = /^\/upload\/session\/([^/]+)$/.exec(p);
+        if (m && req.method === 'PUT') {
+            if (!auth(req, res)) return;
+            const s = db.sessions[m[1]];
+            if (!s) return send(res, 404, { error: { code: 404, message: 'session' } });
+            delete db.sessions[m[1]];
+            const content = await readBody(req);
+            db.counters.uploads++;
+            let f = s.fileId ? db.files[s.fileId] : null;
+            const now = Date.now();
+            if (!f) {
+                f = { id: id(), parents: s.meta.parents || ['root'], created: now };
+                db.files[f.id] = f;
+            }
+            f.name = s.meta.name || f.name;
+            f.mimeType = s.meta.mimeType || f.mimeType;
+            f.appProperties = { ...(f.appProperties || {}), ...(s.meta.appProperties || {}) };
+            f.content = content;
+            f.modified = now;
+            if (s.meta.contentHints && s.meta.contentHints.thumbnail) {
+                f.thumb = Buffer.from(s.meta.contentHints.thumbnail.image, 'base64url');
+            }
+            return send(res, s.fileId ? 200 : 200, fileJson(f));
+        }
+        m = /^\/thumb\/([^/]+)$/.exec(p);
+        if (m) {
+            if (!auth(req, res, false)) return;
+            const f = db.files[m[1]];
+            if (!f || !f.thumb) return send(res, 404, { error: 'no thumb' });
+            return send(res, 200, f.thumb, { 'Content-Type': 'image/png' });
+        }
+        send(res, 404, { error: { code: 404, message: `mock: no route ${req.method} ${p}` } });
+    } catch (e) {
+        send(res, 500, { error: { code: 500, message: String(e && e.stack) } });
+    }
+});
+
+server.listen(PORT, '127.0.0.1', () => console.log(`가짜 구글 서버: ${BASE}`));
