+                w.setSoftInputMode(WindowManager.LayoutParams.SOFT_INPUT_ADJUST_RESIZE);
+            }
+            dialog.show();
+            web.loadUrl(url);
+        });
+    }
+
+    /** 엔트리 프로필·구글 드라이브 페이지를 기기의 기본 브라우저로 */
+    /** [entry-local] 출력하기: 지금 웹 화면(출력용 화면)을 안드로이드 인쇄 창으로 보낸다 */
+    @PluginMethod
+    public void printPage(final PluginCall call) {
+        final String title = call.getString("title", tr("엔트리 작품", "Entry project"));
+        getActivity().runOnUiThread(new Runnable() {
+            @Override
+            public void run() {
+                try {
+                    WebView web = getBridge().getWebView();
+                    PrintManager manager = (PrintManager) getActivity().getSystemService(Context.PRINT_SERVICE);
+                    PrintDocumentAdapter adapter = web.createPrintDocumentAdapter(title);
+                    manager.print(title, adapter, new PrintAttributes.Builder().build());
+                    call.resolve();
+                } catch (Exception e) {
+                    call.reject(tr("인쇄를 시작하지 못했습니다.", "Could not start printing."));
+                }
+            }
+        });
+    }
+
+    @PluginMethod
+    public void setLang(PluginCall call) {
+        lang = "ko".equals(call.getString("lang", "ko")) ? "ko" : "en";
+        call.resolve();
+    }
+
+    @PluginMethod
+    public void openUrl(PluginCall call) {
+        String url = call.getString("url", "");
+        Uri uri = Uri.parse(url);
+        String host = uri.getHost() == null ? "" : uri.getHost();
+        boolean allowed = "https".equals(uri.getScheme()) &&
+            (host.equals("playentry.org") || host.equals("www.playentry.org") || host.equals("drive.google.com") || host.equals("myaccount.google.com"));
+        if (!allowed) {
+            call.reject(tr("열 수 없는 주소입니다.", "This address cannot be opened."));
+            return;
+        }
+        try {
+            Intent intent = new Intent(Intent.ACTION_VIEW, uri);
+            intent.addFlags(Intent.FLAG_ACTIVITY_NEW_TASK);
+            getActivity().startActivity(intent);
+            call.resolve();
+        } catch (ActivityNotFoundException e) {
+            call.reject(tr("브라우저를 열 수 없습니다.", "Could not open the browser."));
+        }
+    }
+}
