diff --git a/src/renderer/helper/entry/fastMath.ts b/src/renderer/helper/entry/fastMath.ts
new file mode 100644
index 00000000..af572b2e
--- /dev/null
+++ b/src/renderer/helper/entry/fastMath.ts
@@ -0,0 +1,177 @@
+/**
+ * [entry-local] 엔트리 계산 블록(calc_basic)의 빠른 경로
+ *
+ * 엔트리는 0.1 + 0.2 = 0.3 처럼 "사람이 보는 십진수" 결과를 내려고 모든 사칙연산을 BigNumber 로 한다.
+ *   BigNumber(a).plus(b).toNumber()  ==  (a, b 의 최단 십진 표기를 정확히 더한 값)에 가장 가까운 double
+ * 여기서는 같은 결과가 수학적으로 보장되는 경우에만 일반 연산으로 계산하고, 나머지는 undefined 를 돌려줘
+ * 원래 BigNumber 경로를 타게 한다.
+ *
+ *  - 정수끼리 덧셈/뺄셈/곱셈, 나누어떨어지는 나눗셈 : 결과가 2^53 미만이면 일반 연산도 정확
+ *  - 소수 덧셈/뺄셈 : 결과의 십진 자릿수(d)가 두 수 중 큰 쪽 자릿수를 넘지 않으므로
+ *                     일반 연산 결과를 d 자리로 반올림(toFixed)하면 정확한 십진 합이 복원된다.
+ *                     일반 연산 오차가 0.5 * 10^-d 보다 충분히 작을 때만 사용.
+ *  - 소수 곱셈 : 자릿수가 da + db 로 늘어나 같은 방법이 성립하는 범위가 좁으므로 그 범위에서만 사용.
+ *  - 위 조건을 못 맞추는 경우 : BigInt 로 십진수를 정확히 계산 (BigNumber 와 같은 정의)
+ *      + - × : 정확한 십진 결과 → 가장 가까운 double (BigNumber.toNumber 와 동일)
+ *      ÷     : BigNumber 기본 설정(소수 20자리, ROUND_HALF_UP)과 같은 반올림 후 → double
+ *  - 결과가 0 이면 부호(+0/-0) 규칙까지 맞추기 위해 원래 BigNumber 로 넘긴다.
+ */
+
+const MAX_SAFE = 9007199254740991;
+/** 일반 연산 1회의 상대 오차 상한(여유 포함) */
+const REL_ERR = 1e-15;
+
+/** 최단 십진 표기의 소수 자릿수. 지수 표기면 -1 */
+function decimals(x: number): number {
+    if (Number.isInteger(x)) {
+        return Math.abs(x) <= MAX_SAFE ? 0 : -1;
+    }
+    const s = String(x);
+    if (s.indexOf('e') !== -1) {
+        return -1;
+    }
+    const dot = s.indexOf('.');
+    return dot === -1 ? 0 : s.length - dot - 1;
+}
+
+function roundTo(value: number, d: number, magnitude: number): number | undefined {
+    // 일반 연산 오차 < 0.5 * 10^-d 이어야 toFixed 가 정확한 십진값을 돌려준다 (여유 10배)
+    if (d > 20 || magnitude * REL_ERR * 10 >= 0.5 * Math.pow(10, -d)) {
+        return undefined;
+    }
+    const r = Number(value.toFixed(d));
+    return r === 0 ? undefined : r; // 0 의 부호는 BigNumber 에 맡긴다
+}
+
+const HAS_BIGINT = typeof BigInt === 'function';
+const DECIMAL_PLACES = 20; // bignumber.js 기본값 (엔트리는 ERRORS 만 바꾼다)
+const pow10Cache: bigint[] = [];
+function pow10(k: number): bigint {
+    let v = pow10Cache[k];
+    if (v === undefined) {
+        v = BigInt(10) ** BigInt(k);
+        pow10Cache[k] = v;
+    }
+    return v;
+}
+
+/** x 의 최단 십진 표기를 정수 C × 10^e 로 (BigNumber(number) 와 같은 표기 사용) */
+function parseDecimal(x: number): [bigint, number] {
+    let t = String(x);
+    let neg = false;
+    if (t.charCodeAt(0) === 45) {
+        neg = true;
+        t = t.slice(1);
+    }
+    let e = 0;
+    const ei = t.indexOf('e');
+    if (ei !== -1) {
+        e = Number(t.slice(ei + 1));
+        t = t.slice(0, ei);
+    }
+    const dot = t.indexOf('.');
+    if (dot !== -1) {
+        e -= t.length - dot - 1;
+        t = t.slice(0, dot) + t.slice(dot + 1);
+    }
+    const c = BigInt(t);
+    return [neg ? -c : c, e];
+}
+
+function toDouble(c: bigint, e: number): number | undefined {
+    if (c === BigInt(0)) {
+        return undefined; // 0 의 부호는 BigNumber 에 맡긴다
+    }
+    return Number(`${c}e${e}`);
+}
+
+function exactCalc(op: string, a: number, b: number): number | undefined {
+    if (!HAS_BIGINT) {
+        return undefined;
+    }
+    const [ca, ea] = parseDecimal(a);
+    const [cb, eb] = parseDecimal(b);
+    if (op === 'PLUS' || op === 'MINUS') {
+        const e = Math.min(ea, eb);
+        const x = ca * pow10(ea - e);
+        const y = cb * pow10(eb - e);
+        return toDouble(op === 'PLUS' ? x + y : x - y, e);
+    }
+    if (op === 'MULTI') {
+        return toDouble(ca * cb, ea + eb);
+    }
+    // DIVIDE: (ca·10^ea) / (cb·10^eb) 를 소수 DECIMAL_PLACES 자리로 ROUND_HALF_UP
+    const zero = BigInt(0);
+    if (cb === zero || ca === zero) {
+        return undefined;
+    }
+    const shift = ea - eb + DECIMAL_PLACES;
+    let num = ca < zero ? -ca : ca;
+    let den = cb < zero ? -cb : cb;
+    if (shift >= 0) {
+        num *= pow10(shift);
+    } else {
+        den *= pow10(-shift);
+    }
+    let q = num / den;
+    const r = num - q * den;
+    if (r * BigInt(2) >= den) {
+        q += BigInt(1);
+    }
+    const negative = (ca < zero) !== (cb < zero);
+    return toDouble(negative ? -q : q, -DECIMAL_PLACES);
+}
+
+/**
+ * @returns 계산 결과, 또는 BigNumber 로 계산해야 하면 undefined
+ */
+export function fastCalc(op: string, a: number, b: number): number | undefined {
+    const r = quickCalc(op, a, b);
+    if (r !== undefined) {
+        return r;
+    }
+    if (!isFinite(a) || !isFinite(b)) {
+        return undefined;
+    }
+    return exactCalc(op, a, b);
+}
+
+function quickCalc(op: string, a: number, b: number): number | undefined {
+    if (!isFinite(a) || !isFinite(b)) {
+        return undefined;
+    }
+    const da = decimals(a);
+    const db = decimals(b);
+    if (da < 0 || db < 0) {
+        return undefined;
+    }
+
+    if (da === 0 && db === 0) {
+        let r: number;
+        if (op === 'PLUS') {
+            r = a + b;
+        } else if (op === 'MINUS') {
+            r = a - b;
+        } else if (op === 'MULTI') {
+            r = a * b;
+        } else {
+            if (b === 0 || a % b !== 0) {
+                return undefined;
+            }
+            r = a / b;
+        }
+        if (r === 0 || Math.abs(r) > MAX_SAFE || !Number.isInteger(r)) {
+            return undefined;
+        }
+        return r;
+    }
+
+    if (op === 'PLUS' || op === 'MINUS') {
+        const raw = op === 'PLUS' ? a + b : a - b;
+        return roundTo(raw, Math.max(da, db), Math.abs(a) + Math.abs(b));
+    }
+    if (op === 'MULTI') {
+        return roundTo(a * b, da + db, Math.abs(a * b) + 1);
+    }
+    return undefined;
+}
