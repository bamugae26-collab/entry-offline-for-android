@@ -0,0 +1,71 @@
+/**
+ * [entry-local] 엔트리 계정 저장 완료 창 — 웹판 엔트리의 저장 완료 창과 같은 모양·동작
+ *   머리띠 "저장" + "작품을 마이 페이지에 저장했습니다." + [작품 공유하기] [확인]
+ * 웹판처럼 [작품 공유하기]는 공유할 수 있는 계정(이메일 인증 · 학생 계정 아님)일 때만 보인다.
+ * 결과: 'share' | 'ok'
+ */
+import { lt } from '../../common/localLang';
+const OVERLAY_ID = 'entry-local-save-done';
+const STYLE_ID = 'entry-local-save-done-style';
+
+const CSS = `
+#${OVERLAY_ID}{position:fixed;inset:0;z-index:100000;display:flex;align-items:center;justify-content:center;background:rgba(0,0,0,.6);font-family:inherit}
+#${OVERLAY_ID} .esd-box{width:388px;max-width:calc(100vw - 32px);background:#fff;border-radius:6px;overflow:hidden;box-shadow:0 6px 24px rgba(0,0,0,.25)}
+#${OVERLAY_ID} .esd-head{position:relative;display:flex;align-items:center;height:54px;padding:0 26px;background:#4f80ff;color:#fff;font-size:20px;font-weight:bold}
+#${OVERLAY_ID} .esd-close{position:absolute;top:50%;right:26px;width:26px;height:26px;margin-top:-13px;padding:0;border:0;background:none;cursor:pointer}
+#${OVERLAY_ID} .esd-close:before,#${OVERLAY_ID} .esd-close:after{content:"";position:absolute;top:50%;left:50%;width:24px;height:3px;margin:-1.5px 0 0 -12px;background:#fff;border-radius:2px}
+#${OVERLAY_ID} .esd-close:before{transform:rotate(45deg)}
+#${OVERLAY_ID} .esd-close:after{transform:rotate(-45deg)}
+#${OVERLAY_ID} .esd-body{padding:40px 24px 38px;text-align:center}
+#${OVERLAY_ID} .esd-msg{margin:0 0 36px;color:#333;font-size:17px;font-weight:bold;line-height:1.4}
+#${OVERLAY_ID} .esd-buttons{display:flex;justify-content:center;gap:10px}
+#${OVERLAY_ID} .esd-buttons button{width:146px;height:48px;border-radius:4px;font:inherit;font-size:15px;font-weight:bold;cursor:pointer}
+#${OVERLAY_ID} .esd-share{border:1px solid #4f80ff;background:#fff;color:#4f80ff}
+#${OVERLAY_ID} .esd-ok{border:1px solid #4f80ff;background:#4f80ff;color:#fff}
+#${OVERLAY_ID} .esd-ok:active{background:#3f6fe8}
+`;
+
+function ensureStyle() {
+    if (!document.getElementById(STYLE_ID)) {
+        const style = document.createElement('style');
+        style.id = STYLE_ID;
+        style.textContent = CSS;
+        document.head.appendChild(style);
+    }
+}
+
+export function showSaveDoneAlert(options: { canShare: boolean }): Promise<'share' | 'ok'> {
+    ensureStyle();
+    document.getElementById(OVERLAY_ID)?.remove();
+    return new Promise((resolve) => {
+        const overlay = document.createElement('div');
+        overlay.id = OVERLAY_ID;
+        overlay.innerHTML =
+            '<div class="esd-box" role="alertdialog" aria-modal="true" aria-label="' + lt('저장', 'Save') + '">' +
+            '<div class="esd-head">' + lt('저장', 'Save') + '<button class="esd-close" type="button" aria-label="' + lt('닫기', 'Close') + '"></button></div>' +
+            '<div class="esd-body"><p class="esd-msg">' + lt('작품을 마이 페이지에 저장했습니다.', 'Your project was saved to My Page.') + '</p>' +
+            '<div class="esd-buttons">' +
+            (options.canShare ? '<button class="esd-share" type="button">' + lt('작품 공유하기', 'Share project') + '</button>' : '') +
+            '<button class="esd-ok" type="button">' + lt('확인', 'OK') + '</button></div></div></div>';
+        const close = (result: 'share' | 'ok') => {
+            document.removeEventListener('keydown', onKey, true);
+            overlay.remove();
+            resolve(result);
+        };
+        const onKey = (e: KeyboardEvent) => {
+            if (e.key === 'Escape' || e.key === 'Enter') {
+                e.stopPropagation();
+                close('ok');
+            }
+        };
+        (overlay.querySelector('.esd-close') as HTMLElement).onclick = () => close('ok');
+        (overlay.querySelector('.esd-ok') as HTMLElement).onclick = () => close('ok');
+        const share = overlay.querySelector('.esd-share') as HTMLElement | null;
+        if (share) {
+            share.onclick = () => close('share');
+        }
+        document.addEventListener('keydown', onKey, true);
+        document.body.appendChild(overlay);
+        (overlay.querySelector('.esd-ok') as HTMLElement).focus();
+    });
+}
