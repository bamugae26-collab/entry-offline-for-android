+/** 이름 칸을 입력칸으로 바꿔 이름 바꾸기 */
+function inlineRename(nameEl: HTMLElement, current: string, commit: (next: string) => Promise<void>, done: () => void) {
+    const input = el('input');
+    input.value = current;
+    nameEl.innerHTML = '';
+    nameEl.appendChild(input);
+    input.focus();
+    input.select();
+    let finished = false;
+    const finish = async (apply: boolean) => {
+        if (finished) {
+            return;
+        }
+        finished = true;
+        const next = input.value.trim();
+        if (apply && next && next !== current) {
+            try {
+                await commit(next);
+            } catch (e) {
+                EntryModalHelper.getAlertModal(lt(`이름을 바꾸지 못했습니다.\n${cloudErrorMessage(e)}`, `Could not rename.\n${cloudErrorMessage(e)}`));
+            }
+        }
+        done();
+    };
+    input.onkeydown = (e) => {
+        e.stopPropagation();
+        if (e.key === 'Enter') {
+            finish(true);
+        } else if (e.key === 'Escape') {
+            finish(false);
+        }
+    };
+    input.onblur = () => finish(true);
+}
