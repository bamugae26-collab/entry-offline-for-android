index 00000000..39d66a6a
--- /dev/null
+++ b/src/web/media.ts
@@ -0,0 +1,234 @@
+/**
+ * [entry-local/web] 이미지·소리 처리
+ * Electron 판의 nativeImage(리사이즈), image-size, music-metadata, ffmpeg 를 브라우저 API 로 대신한다.
+ */
+
+export type Dimension = { width: number; height: number };
+
+export const ImageResizeSize: { [key: string]: Dimension } = {
+    thumbnail: { width: 96, height: 96 },
+    picture: { width: 960, height: 540 },
+};
+
+export function createFileId(): string {
+    const chars = 'abcdefghijklmnopqrstuvwxyz0123456789';
+    const random = new Uint8Array(32);
+    crypto.getRandomValues(random);
+    let id = '';
+    random.forEach((v) => {
+        id += chars[v % chars.length];
+    });
+    return id;
+}
+
+export function generateHash() {
+    return Math.random()
+        .toString(36)
+        .substr(2, 4);
+}
+
+export function sanitizeExtension(extension: string | undefined, defaultExtension?: string) {
+    let ext = extension || defaultExtension;
+    if (!ext) {
+        return extension || '';
+    }
+    if (!ext.startsWith('.')) {
+        ext = `.${ext}`;
+    }
+    return ext;
+}
+
+const MIME: { [ext: string]: string } = {
+    '.png': 'image/png',
+    '.jpg': 'image/jpeg',
+    '.jpeg': 'image/jpeg',
+    '.gif': 'image/gif',
+    '.bmp': 'image/bmp',
+    '.webp': 'image/webp',
+    '.svg': 'image/svg+xml',
+    '.mp3': 'audio/mpeg',
+    '.wav': 'audio/wav',
+    '.ogg': 'audio/ogg',
+    '.m4a': 'audio/mp4',
+};
+
+export function mimeOf(name: string) {
+    const i = name.lastIndexOf('.');
+    return (i >= 0 && MIME[name.substring(i).toLowerCase()]) || 'application/octet-stream';
+}
+
+export function loadImage(src: string): Promise<HTMLImageElement> {
+    return new Promise((resolve, reject) => {
+        const img = new Image();
+        img.onload = () => resolve(img);
+        img.onerror = () => reject(new Error(`image load failed: ${src.substring(0, 80)}`));
+        img.src = src;
+    });
+}
+
+export async function bytesToImage(bytes: Uint8Array, mime: string) {
+    const url = URL.createObjectURL(new Blob([bytes], { type: mime }));
+    try {
+        return await loadImage(url);
+    } finally {
+        // 이미지 디코딩이 끝난 뒤 해제
+        setTimeout(() => URL.revokeObjectURL(url), 0);
+    }
+}
+
+function canvasToPng(canvas: HTMLCanvasElement): Promise<Uint8Array> {
+    return new Promise((resolve, reject) => {
+        canvas.toBlob(async (blob) => {
+            if (!blob) {
+                reject(new Error('canvas toBlob failed'));
+                return;
+            }
+            resolve(new Uint8Array(await blob.arrayBuffer()));
+        }, 'image/png');
+    });
+}
+
+/**
+ * nativeImage.resize 와 같은 동작: width/height 둘 다 주면 그 크기로, 비율은 유지하지 않는다.
+ * (원본 offline 은 썸네일을 96x96 으로 늘려 저장한다)
+ */
+export async function resizeToPng(
+    img: HTMLImageElement | HTMLCanvasElement,
+    size: Dimension
+): Promise<Uint8Array> {
+    const canvas = document.createElement('canvas');
+    canvas.width = Math.max(1, Math.round(size.width));
+    canvas.height = Math.max(1, Math.round(size.height));
+    const ctx = canvas.getContext('2d')!;
+    ctx.imageSmoothingQuality = 'high';
+    ctx.drawImage(img, 0, 0, canvas.width, canvas.height);
+    return canvasToPng(canvas);
+}
+
+export function imageDimension(img: HTMLImageElement): Dimension {
+    return { width: img.naturalWidth || img.width, height: img.naturalHeight || img.height };
+}
+
+export function getDimensionFromSvg(svg: string) {
+    const result = /viewBox=['"](\d+(?:\s)?)?(\d+(?:\s)?)?(\d+(?:\s)?)?(\d+(?:\s)?)?['"]/.exec(svg);
+    if (result && result.length === 5) {
+        return {
+            x: Number(result[1]),
+            y: Number(result[2]),
+            width: Number(result[3]),
+            height: Number(result[4]),
+        };
+    }
+}
+
+/**
+ * 업로드한 그림(jpg, gif, svg 등)을 png 로 바꾼다. (Electron 판 convertPng 과 같은 처리)
+ */
+export async function convertToPng(bytes: Uint8Array, mime: string): Promise<Uint8Array> {
+    if (mime === 'image/png') {
+        return bytes;
+    }
+    const img = await bytesToImage(bytes, mime);
+    const canvas = document.createElement('canvas');
+    let { width, height } = imageDimension(img);
+    let x = 0;
+    let y = 0;
+    if (mime.includes('svg')) {
+        const dim = getDimensionFromSvg(new TextDecoder().decode(bytes));
+        if (dim) {
+            ({ width, height } = dim);
+            x = dim.x || 0;
+            y = dim.y || 0;
+        }
+    }
+    canvas.width = (width || 1) + x;
+    canvas.height = (height || 1) + y;
+    canvas.getContext('2d')!.drawImage(img, x, y, canvas.width, canvas.height);
+    return canvasToPng(canvas);
+}
+
+/** 소리 길이(초, 소수 1자리) */
+export async function soundDuration(bytes: Uint8Array, mime: string): Promise<number> {
+    const url = URL.createObjectURL(new Blob([bytes], { type: mime }));
+    try {
+        const seconds = await new Promise<number>((resolve) => {
+            const audio = new Audio();
+            const done = (v: number) => {
+                audio.src = '';
+                resolve(v);
+            };
+            audio.preload = 'metadata';
+            audio.onloadedmetadata = () => done(isFinite(audio.duration) ? audio.duration : 0);
+            audio.onerror = () => done(0);
+            setTimeout(() => done(0), 8000);
+            audio.src = url;
+        });
+        if (seconds) {
+            return Math.round(seconds * 10) / 10;
+        }
+        // 메타데이터가 없으면 디코딩해서 계산
+        const Ctx = (window as any).AudioContext || (window as any).webkitAudioContext;
+        const ctx = new Ctx();
+        try {
+            const buffer = await ctx.decodeAudioData(bytes.slice().buffer);
+            return Math.round(buffer.duration * 10) / 10;
+        } finally {
+            ctx.close && ctx.close();
+        }
+    } catch (e) {
+        return 0;
+    } finally {
+        URL.revokeObjectURL(url);
+    }
+}
+
+/**
+ * 소리 편집기 결과(wav)를 mp3 로 인코딩한다. (Electron 판은 ffmpeg 사용)
+ */
+export async function wavToMp3(wav: ArrayBuffer): Promise<{ mp3: Uint8Array; duration: number }> {
+    const Ctx = (window as any).AudioContext || (window as any).webkitAudioContext;
+    const ctx = new Ctx();
+    let audio: AudioBuffer;
+    try {
+        audio = await ctx.decodeAudioData(wav.slice(0));
+    } finally {
+        ctx.close && ctx.close();
+    }
+    const lame: any = await import(/* webpackMode: "eager" */ '@breezystack/lamejs');
+    const Mp3Encoder = lame.Mp3Encoder || (lame.default && lame.default.Mp3Encoder);
+    const channels = Math.min(2, audio.numberOfChannels);
+    const encoder = new Mp3Encoder(channels, audio.sampleRate, 128);
+
+    const toInt16 = (data: Float32Array) => {
+        const out = new Int16Array(data.length);
+        for (let i = 0; i < data.length; i++) {
+            const s = Math.max(-1, Math.min(1, data[i]));
+            out[i] = s < 0 ? s * 0x8000 : s * 0x7fff;
+        }
+        return out;
+    };
+    const left = toInt16(audio.getChannelData(0));
+    const right = channels > 1 ? toInt16(audio.getChannelData(1)) : undefined;
+
+    const parts: Uint8Array[] = [];
+    const block = 1152;
+    for (let i = 0; i < left.length; i += block) {
+        const l = left.subarray(i, i + block);
+        const chunk = right ? encoder.encodeBuffer(l, right.subarray(i, i + block)) : encoder.encodeBuffer(l);
+        if (chunk.length) {
+            parts.push(new Uint8Array(chunk));
+        }
+    }
+    const end = encoder.flush();
+    if (end.length) {
+        parts.push(new Uint8Array(end));
+    }
+    const total = parts.reduce((n, p) => n + p.length, 0);
+    const mp3 = new Uint8Array(total);
+    let offset = 0;
+    parts.forEach((p) => {
+        mp3.set(p, offset);
+        offset += p.length;
+    });
+    return { mp3, duration: Math.round(audio.duration * 10) / 10 };
+}
diff --git a/src/web/platform.ts b/src/web/platform.ts
new file mode 100644
index 00000000..8ad53ede
--- /dev/null
+++ b/src/web/platform.ts
@@ -0,0 +1,174 @@
+import { Filesystem, Directory } from '@capacitor/filesystem';
+import { Share } from '@capacitor/share';
+import { bytesToBase64 } from './vfs';
+import { mimeOf } from './media';
+
+/**
+ * [entry-local/web] Electron 의 파일 대화상자와 File.path 를 대신한다.
+ *
+ * 렌더러 코드는 "파일 경로(string)" 로 주고받도록 짜여 있으므로 가상 경로를 쓴다.
+ *   pick://<id>/<원래이름>  : 사용자가 고른 파일 (File 객체를 메모리에 보관)
+ *   save://<파일이름>       : 저장 대화상자 결과. 여기에 쓰면 공유 시트(안드로이드) / 다운로드(PC) 로 내보낸다.
+ */
+
+export const PICK = 'pick://';
+export const SAVE = 'save://';
+
+const picked = new Map<string, File>();
+const fileToPath = new WeakMap<File, string>();
+let pickSeq = 0;
+
+export function isNative() {
+    const cap = (window as any).Capacitor;
+    return !!(cap && cap.isNativePlatform && cap.isNativePlatform());
+}
+
+export function registerFile(file: File): string {
+    const existing = fileToPath.get(file);
+    if (existing) {
+        return existing;
+    }
+    const path = `${PICK}${++pickSeq}/${file.name}`;
+    picked.set(path, file);
+    fileToPath.set(file, path);
+    return path;
+}
+
+export function getPickedFile(path: string): File | undefined {
+    return picked.get(path);
+}
+
+export async function readPicked(path: string): Promise<{ bytes: Uint8Array; name: string; type: string }> {
+    const file = picked.get(path);
+    if (!file) {
+        throw new Error(`picked file not found: ${path}`);
+    }
+    return {
+        bytes: new Uint8Array(await file.arrayBuffer()),
+        name: file.name,
+        type: file.type || mimeOf(file.name),
+    };
+}
+
+/**
+ * Electron 이 File 에 붙여 주던 .path 를 흉내낸다.
+ * 업로드 팝업·드래그앤드롭 코드가 value.path 를 그대로 쓰기 때문.
+ */
+export function installFilePathPolyfill() {
+    if (Object.getOwnPropertyDescriptor(File.prototype, 'path')) {
+        return;
+    }
+    Object.defineProperty(File.prototype, 'path', {
+        configurable: true,
+        get(this: File) {
+            return registerFile(this);
+        },
+    });
+}
+
+type DialogFilter = { name: string; extensions: string[] };
+
+function acceptOf(filters?: DialogFilter[]) {
+    if (!filters || !filters.length) {
+        return '';
+    }
+    const exts = filters.reduce<string[]>((all, f) => all.concat(f.extensions || []), []);
+    if (exts.includes('*')) {
+        return '';
+    }
+    // 안드로이드 파일 선택기는 모르는 확장자(.ent, .eo)를 걸러 버리므로 MIME 을 알 때만 지정
+    const known = exts.map((e) => mimeOf(`.${e}`)).filter((m) => m !== 'application/octet-stream');
+    if (isNative() && known.length !== exts.length) {
+        return '';
+    }
+    return exts.map((e) => `.${e}`).concat(known).join(',');
+}
+
+export function showOpenDialog(options: any = {}): Promise<{ canceled: boolean; filePaths: string[] }> {
+    return new Promise((resolve) => {
+        const properties: string[] = options.properties || [];
+        if (properties.includes('openDirectory')) {
+            // 폴더 선택은 '내보내기' 용도로만 쓰인다 (블록 이미지 저장). 공유/다운로드로 처리.
+            resolve({ canceled: false, filePaths: [`${SAVE}`] });
+            return;
+        }
+        const input = document.createElement('input');
+        input.type = 'file';
+        input.multiple = properties.includes('multiSelections');
+        const accept = acceptOf(options.filters);
+        if (accept) {
+            input.accept = accept;
+        }
+        input.style.display = 'none';
+        let settled = false;
+        const finish = (paths: string[]) => {
+            if (settled) {
+                return;
+            }
+            settled = true;
+            input.remove();
+            resolve({ canceled: paths.length === 0, filePaths: paths });
+        };
+        input.onchange = () => finish(Array.from(input.files || []).map(registerFile));
+        // 취소 감지 (지원하는 WebView 에서)
+        input.addEventListener('cancel', () => finish([]));
+        document.body.appendChild(input);
+        input.click();
+    });
+}
+
+function saveName(options: any = {}) {
+    const raw = String(options.defaultPath || 'entry').replace(/\\/g, '/');
+    let name = raw.substring(raw.lastIndexOf('/') + 1) || 'entry';
+    const ext = options.filters && options.filters[0] && options.filters[0].extensions && options.filters[0].extensions[0];
+    if (ext && ext !== '*' && !name.toLowerCase().endsWith(`.${ext}`)) {
+        name += `.${ext}`;
+    }
+    return name.replace(/[\\/:*?"<>|]/g, '_');
+}
+
+export function showSaveDialogSync(options: any = {}): string {
+    return `${SAVE}${saveName(options)}`;
+}
+
+export async function showSaveDialog(options: any = {}) {
+    return { canceled: false, filePath: showSaveDialogSync(options) };
+}
+
+export function isSavePath(path: string) {
+    return typeof path === 'string' && path.startsWith(SAVE);
+}
+
+/**
+ * 만든 파일을 기기 밖으로 내보낸다.
+ * 안드로이드: 캐시에 쓰고 공유 시트(드라이브, 파일 앱, 메신저 등)를 연다.
+ * PC 브라우저: 다운로드.
+ */
+export async function deliverToUser(name: string, data: Uint8Array | Blob, mime?: string) {
+    const type = mime || mimeOf(name);
+    const bytes = data instanceof Uint8Array ? data : new Uint8Array(await data.arrayBuffer());
+    if (isNative()) {
+        const path = `export/${name}`;
+        const { uri } = await Filesystem.writeFile({
+            path,
+            directory: Directory.Cache,
+            data: bytesToBase64(bytes),
+            recursive: true,
+        });
+        await Share.share({ title: name, files: [uri], dialogTitle: name });
+        return;
+    }
+    const url = URL.createObjectURL(new Blob([bytes], { type }));
+    const a = document.createElement('a');
+    a.href = url;
+    a.download = name;
+    document.body.appendChild(a);
+    a.click();
+    a.remove();
+    setTimeout(() => URL.revokeObjectURL(url), 30000);
+}
+
+export function saveTargetName(path: string, fallback = 'file') {
+    const name = path.substring(SAVE.length);
+    return name || fallback;
+}
