+#${OVERLAY_ID} .eai-copy{margin:14px 0 18px;text-align:center;color:#888;font-size:12px}
+#${OVERLAY_ID} .eai-buttons{flex:none;display:flex;justify-content:center;padding:14px 24px 24px}
+#${OVERLAY_ID} .eai-ok{width:146px;height:48px;border:1px solid #4f80ff;border-radius:4px;background:#4f80ff;color:#fff;font:inherit;font-size:15px;font-weight:bold;cursor:pointer}
+`;
+
+function ensureStyle() {
+    if (!document.getElementById(STYLE_ID)) {
+        const style = document.createElement('style');
+        style.id = STYLE_ID;
+        style.textContent = CSS;
+        document.head.appendChild(style);
+    }
+}
+
+function esc(text: string) {
+    return text.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c] as string));
+}
+
+function isAndroid() {
+    const cap = (window as any).Capacitor;
+    return !!(cap && cap.isNativePlatform && cap.isNativePlatform() && cap.getPlatform && cap.getPlatform() === 'android');
+}
+
+export function showAppInfo() {
+    ensureStyle();
+    document.getElementById(OVERLAY_ID)?.remove();
+    const android = isAndroid();
+    const appName = android ? APP_NAME_ANDROID : lt(APP_NAME_WINDOWS, APP_NAME_WINDOWS_EN);
+    const runtime = android
+        ? lt('안드로이드 시스템 웹뷰', 'Android System WebView')
