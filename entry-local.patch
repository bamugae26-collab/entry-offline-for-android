new file mode 100644
index 00000000..2eaa272f
--- /dev/null
+++ b/mobile/scripts/make-icons.py
@@ -0,0 +1,65 @@
+"""[entry-local] 앱 아이콘 생성 (블록 3개를 쌓은 단순한 자체 디자인). 사용: python3 scripts/make-icons.py"""
+import os
+from PIL import Image, ImageDraw
+
+RES = os.path.join(os.path.dirname(__file__), '..', 'android', 'app', 'src', 'main', 'res')
+BG = (79, 128, 255)
+BLOCKS = [(255, 255, 255), (255, 214, 102), (120, 220, 160)]
+
+
+def draw_blocks(img, box):
+    """box = (x0, y0, x1, y1) 안에 끼움 홈이 있는 블록 3개"""
+    d = ImageDraw.Draw(img)
+    x0, y0, x1, y1 = box
+    w, h = x1 - x0, y1 - y0
+    bh = h / 3.4
+    r = bh * 0.22
+    for i, color in enumerate(BLOCKS):
+        indent = w * 0.12 * i
+        top = y0 + i * (bh * 1.15)
+        left, right = x0 + indent, x1 - w * 0.12 * (2 - i) * 0.5
+        d.rounded_rectangle([left, top, right, top + bh], radius=r, fill=color)
+        # 아래쪽 돌기
+        nx = left + bh * 0.45
+        d.rounded_rectangle([nx, top + bh - 1, nx + bh * 0.6, top + bh + bh * 0.18], radius=r * 0.4, fill=color)
+
+
+def make(size, round_=False, foreground=False):
+    scale = 4
+    S = size * scale
+    img = Image.new('RGBA', (S, S), (0, 0, 0, 0))
+    d = ImageDraw.Draw(img)
+    if foreground:
+        pad = S * 0.30  # 적응형 아이콘 안전 영역
+    else:
+        if round_:
+            d.ellipse([0, 0, S - 1, S - 1], fill=BG)
+        else:
+            d.rounded_rectangle([0, 0, S - 1, S - 1], radius=S * 0.2, fill=BG)
+        pad = S * 0.22
+    draw_blocks(img, (pad, pad, S - pad, S - pad))
+    return img.resize((size, size), Image.LANCZOS)
+
+
+dens = {'mdpi': 1, 'hdpi': 1.5, 'xhdpi': 2, 'xxhdpi': 3, 'xxxhdpi': 4}
+for name, k in dens.items():
+    folder = os.path.join(RES, f'mipmap-{name}')
+    os.makedirs(folder, exist_ok=True)
+    make(int(48 * k)).save(os.path.join(folder, 'ic_launcher.png'))
+    make(int(48 * k), round_=True).save(os.path.join(folder, 'ic_launcher_round.png'))
+    make(int(108 * k), foreground=True).save(os.path.join(folder, 'ic_launcher_foreground.png'))
+
+with open(os.path.join(RES, 'values', 'ic_launcher_background.xml'), 'w') as f:
+    f.write('<?xml version="1.0" encoding="utf-8"?>\n<resources>\n    <color name="ic_launcher_background">#4F80FF</color>\n</resources>\n')
+print('icons done')
+
+# 스플래시 화면 (Capacitor 기본 로고 대체)
+import glob
+for path in glob.glob(os.path.join(RES, 'drawable*', 'splash.png')):
+    w, h = Image.open(path).size
+    img = Image.new('RGBA', (w, h), BG + (255,))
+    s = int(min(w, h) * 0.35)
+    icon = make(s, foreground=True)
+    img.paste(icon, ((w - s) // 2, (h - s) // 2), icon)
+    img.convert('RGB').save(path)
+print('splash done')
