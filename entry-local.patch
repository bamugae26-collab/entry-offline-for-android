index 00000000..f34724f9
--- /dev/null
+++ b/src/main/backpackStore.ts
@@ -0,0 +1,96 @@
+/**
+ * [entry-local] 나의 보관함 (백팩) — 이 기기에 저장 (Windows)
+ * 웹판 엔트리는 서버(/rest/backpack)에 저장한다. 여기서는 앱 저장소(userData/backpack)에 저장한다.
+ *   index.json           : [{ _id, type, title, imgPath, created }]  (imgPath = 작은 미리보기 data URL)
+ *   <id>.json            : 블록 { script, variables, messages, functions, tables, ... }
+ *   <id>.eo              : 오브젝트 (오브젝트 내보내기와 같은 형식 — 모양·소리 파일 포함)
+ * 꺼낼 때 오브젝트는 '오브젝트 가져오기'와 같은 방법으로 모양·소리를 지금 작품에 복사한다.
+ */
+import { app, ipcMain } from 'electron';
+import path from 'path';
+import fs from 'fs-extra';
+import crypto from 'crypto';
+import MainUtils from './mainUtils';
+
+type BackpackMeta = { _id: string; type: 'block' | 'object'; title: string; imgPath?: string; created: number };
+
+const dir = () => path.join(app.getPath('userData'), 'backpack');
+const indexPath = () => path.join(dir(), 'index.json');
+
+let queue: Promise<unknown> = Promise.resolve();
+function enqueue<T>(job: () => Promise<T>): Promise<T> {
+    const next = queue.then(job, job);
+    queue = next.catch(() => undefined);
+    return next;
+}
+
+async function readIndex(): Promise<BackpackMeta[]> {
+    try {
+        const list = await fs.readJson(indexPath());
+        return Array.isArray(list) ? list : [];
+    } catch (e) {
+        return [];
+    }
+}
+
+async function writeIndex(list: BackpackMeta[]) {
+    await fs.ensureDir(dir());
+    const tmp = `${indexPath()}.tmp`;
+    await fs.writeJson(tmp, list);
+    await fs.move(tmp, indexPath(), { overwrite: true });
+}
+
+const fileOf = (id: string, type: string) => path.join(dir(), `${id.replace(/[^a-z0-9]/gi, '')}.${type === 'object' ? 'eo' : 'json'}`);
+
+ipcMain.handle('backpack:list', () => enqueue(readIndex));
+
+ipcMain.handle('backpack:add', (event, meta: { type: 'block' | 'object'; title: string; imgPath?: string }, item: any) =>
+    enqueue(async () => {
+        await fs.ensureDir(dir());
+        const id = crypto.randomBytes(12).toString('hex');
+        if (meta.type === 'object') {
+            await MainUtils.exportObject(fileOf(id, 'object'), item);
+        } else {
+            await fs.writeJson(fileOf(id, 'block'), item);
+        }
+        const entry: BackpackMeta = { _id: id, type: meta.type, title: meta.title || '', imgPath: meta.imgPath, created: Date.now() };
+        await writeIndex([entry, ...(await readIndex())]);
+        return entry;
+    })
+);
+
+ipcMain.handle('backpack:get', (event, id: string) =>
+    enqueue(async () => {
+        const meta = (await readIndex()).find((m) => m._id === id);
+        if (!meta) {
+            return undefined;
+        }
+        if (meta.type === 'object') {
+            const [item] = (await MainUtils.importObjects([fileOf(id, 'object')])) as any[];
+            return { type: meta.type, item };
+        }
+        return { type: meta.type, item: await fs.readJson(fileOf(id, 'block')) };
+    })
+);
+
+ipcMain.handle('backpack:rename', (event, id: string, title: string) =>
+    enqueue(async () => {
+        const list = await readIndex();
+        const meta = list.find((m) => m._id === id);
+        if (meta) {
+            meta.title = String(title || '').slice(0, 45);
+            await writeIndex(list);
+        }
+    })
+);
+
+ipcMain.handle('backpack:remove', (event, id: string) =>
+    enqueue(async () => {
+        const list = await readIndex();
+        const meta = list.find((m) => m._id === id);
+        if (meta) {
+            await fs.remove(fileOf(id, meta.type)).catch(() => undefined);
+            await writeIndex(list.filter((m) => m._id !== id));
+        }
+    })
+);
