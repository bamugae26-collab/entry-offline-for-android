diff --git a/src/renderer/helper/cloudState.ts b/src/renderer/helper/cloudState.ts
new file mode 100644
index 00000000..11a7b7c3
--- /dev/null
+++ b/src/renderer/helper/cloudState.ts
@@ -0,0 +1,203 @@
+/**
+ * [entry-local] 구글 드라이브·엔트리 계정 로그인 상태 + 인터넷 연결 상태
+ * 상단 메뉴·내 작품 창·저장 메뉴가 같이 쓴다.
+ */
+
+import { lt } from '../../common/localLang';
+export type EntryUser = { id: string; username: string; nickname: string; canShare?: boolean };
+export type EntryStatus = { loggedIn: boolean; user?: EntryUser };
+
+export type CloudStatus = {
+    configured: boolean; // 이 빌드에 구글 설정이 들어 있는가
+    loggedIn: boolean;
+    email?: string;
+    name?: string;
+};
+
+type Listener = (state: CloudState) => void;
+export type CloudState = CloudStatus & { online: boolean; busy: boolean; entry?: EntryUser; entryBusy: boolean };
+
+let state: CloudState = {
+    configured: false,
+    loggedIn: false,
+    online: typeof navigator === 'undefined' ? true : navigator.onLine !== false,
+    busy: false,
+    entryBusy: false,
+};
+const listeners: Listener[] = [];
+let started = false;
+
+function set(patch: Partial<CloudState>) {
+    state = { ...state, ...patch };
+    listeners.slice().forEach((fn) => fn(state));
+}
+
+export function getCloudState() {
+    return state;
+}
+
+/** 계정 기능을 보여줄지: 설정되어 있고 인터넷이 연결되어 있을 때 */
+export function cloudAvailable() {
+    return state.configured && state.online;
+}
+
+export function cloudReady() {
+    return cloudAvailable() && state.loggedIn;
+}
+
+/** 상단 로그인 버튼을 보일지: 인터넷이 연결되어 있을 때 (엔트리 로그인은 설정 없이 가능) */
+export function accountsAvailable() {
+    return state.online;
+}
+
+/** 상단에 보일 계정 이름: 엔트리 닉네임 → 구글 이름 → 구글 메일 */
+export function accountLabel() {
+    if (state.entry) {
+        return state.entry.nickname || state.entry.username || lt('엔트리 계정', 'Entry account');
+    }
+    if (state.loggedIn) {
+        return state.name || state.email || lt('구글 계정', 'Google account');
+    }
+    return '';
+}
+
+// 구글 설정이 빠진 빌드면 예전에 로그인한 기록이 있어도 로그아웃 상태로 본다
+const cloudPatch = (status: CloudStatus): Partial<CloudState> =>
+    status ? { ...status, loggedIn: !!(status.configured && status.loggedIn) } : {};
+
+const setEntry = (status?: EntryStatus) => set({ entry: status && status.loggedIn ? status.user : undefined });
+
+export function subscribeCloud(fn: Listener) {
+    listeners.push(fn);
+    return () => {
+        const i = listeners.indexOf(fn);
+        if (i >= 0) {
+            listeners.splice(i, 1);
+        }
+    };
+}
+
+export function startCloudState() {
+    if (started) {
+        return;
+    }
+    started = true;
+    window.addEventListener('online', () => {
+        set({ online: true });
+        entryVerify();
+    });
+    window.addEventListener('offline', () => set({ online: false }));
+    if (window.ipcListen) {
+        window.ipcListen('cloud:status', (_event: any, status: CloudStatus) => set(cloudPatch(status)));
+        window.ipcListen('entry:status', (_event: any, status: EntryStatus) => setEntry(status));
+    }
+    window
+        .ipcInvoke<EntryStatus>('entry:status')
+        .then(setEntry)
+        .catch(() => undefined);
+    // 저장된 엔트리 로그인이 아직 유효한지 잠시 뒤 조용히 확인
+    setTimeout(entryVerify, 4000);
+    window
+        .ipcInvoke<CloudStatus>('cloud:status')
+        .then((status) => status && set(cloudPatch(status)))
+        .catch(() => undefined);
+}
+
+export async function cloudLogin() {
+    set({ busy: true });
+    try {
+        await window.ipcInvoke('cloud:login');
+        const status = await window.ipcInvoke<CloudStatus>('cloud:status');
+        set(cloudPatch(status));
+        return status;
+    } finally {
+        set({ busy: false });
+    }
+}
+
+export async function cloudLogout() {
+    await window.ipcInvoke('cloud:logout');
+    const status = await window.ipcInvoke<CloudStatus>('cloud:status');
+    set(cloudPatch(status));
+}
+
+function entryVerify() {
+    if (!state.entry || !state.online) {
+        return;
+    }
+    window
+        .ipcInvoke<EntryStatus>('entry:verify')
+        .then(setEntry)
+        .catch(() => undefined);
+}
+
+export async function entryLogin() {
+    set({ entryBusy: true });
+    try {
+        const user = await window.ipcInvoke<EntryUser>('entry:login');
+        setEntry({ loggedIn: true, user });
+        return user;
+    } finally {
+        set({ entryBusy: false });
+    }
+}
+
+export async function entryLogout() {
+    await window.ipcInvoke('entry:logout');
+    setEntry({ loggedIn: false });
+}
+
+export type EntryProjectMeta = { id: string; name: string; thumb?: string; created?: string; updated?: string; isopen?: boolean };
+
+export const entryApi = {
+    base: () => window.ipcInvoke<string>('entry:base'),
+    projects: (start = 0, display = 60) =>
+        window.ipcInvoke<{ total: number; list: EntryProjectMeta[] }>('entry:projects', start, display),
+    load: (projectId: string, name: string) => window.ipcInvoke<any>('entry:load', projectId, name),
+    saveViaSite: (project: any, options: { entryProjectId?: string; name: string }) =>
+        window.ipcInvoke<{ projectId?: string; saved?: boolean; failed?: boolean }>('entry:saveViaSite', project, options),
+    share: (projectId: string) => window.ipcInvoke<{ shared?: boolean }>('entry:share', projectId),
+    cancelSave: () => window.ipcInvoke<void>('entry:cancelSave'),
+    // [1.1] 엔트리 작업 화면을 미리 불러 둔다 (계정 저장을 빠르게)
+    prewarm: (projectId?: string) => window.ipcInvoke<void>('entry:prewarm', projectId),
+};
+
+export const accountApi = {
+    driveFolderUrl: () => window.ipcInvoke<string>('cloud:folderUrl'),
+    entryProfileUrl: () => window.ipcInvoke<string>('entry:profileUrl'),
+    openExternal: (url: string) => window.ipcInvoke<void>('app:openExternal', url),
+};
+
+export type CloudFileMeta = {
+    id: string;
+    name: string;
+    fileName: string;
+    modifiedTime: number;
+    createdTime: number;
+    size: number;
+    thumbnailLink?: string;
+};
+
+export const cloudApi = {
+    list: () => window.ipcInvoke<CloudFileMeta[]>('cloud:list'),
+    save: (project: any, options: { fileId?: string; name: string; thumbnail?: string }) =>
+        window.ipcInvoke<CloudFileMeta>('cloud:save', project, options),
+    load: (fileId: string) => window.ipcInvoke<any>('cloud:load', fileId),
+    rename: (fileId: string, name: string) => window.ipcInvoke<void>('cloud:rename', fileId, name),
+    remove: (fileId: string) => window.ipcInvoke<void>('cloud:remove', fileId),
+    thumbnail: (link?: string) => window.ipcInvoke<string | undefined>('cloud:thumbnail', link),
+    exportTo: (fileId: string, destination: string) => window.ipcInvoke<void>('cloud:export', fileId, destination),
+};
+
+/** 오류 메시지를 사람이 읽을 문장으로 */
+export function cloudErrorMessage(e: any) {
+    const raw = String((e && e.message) || e || '');
+    const msg = raw.replace(/^Error invoking remote method '[^']+':\s*(Error:\s*)?/, '');
+    if (/Failed to fetch|NetworkError|net::|ENOTFOUND|ECONN|ETIMEDOUT/i.test(msg)) {
+        return lt('인터넷에 연결할 수 없습니다.', 'Cannot connect to the internet.');
+    }
+    if (/insufficient|storageQuotaExceeded/i.test(msg)) {
+        return lt('구글 드라이브 저장 공간이 부족합니다.', 'Google Drive storage is full.');
+    }
+    return msg || lt('알 수 없는 오류', 'Unknown error');
+}
diff --git a/src/renderer/helper/editorLabels.ts b/src/renderer/helper/editorLabels.ts
