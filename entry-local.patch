+#!/usr/bin/env node
+/**
+ * [entry-local] 구글 드라이브 연동 설정 파일(config/google.json) 생성
+ *
+ * 환경변수(로컬 빌드는 PowerShell $env:..., GitHub Actions 는 Secrets)에서 읽는다.
+ *   GOOGLE_DESKTOP_CLIENT_ID      Windows(Electron)용 '데스크톱 앱' 클라이언트 ID
+ *   GOOGLE_DESKTOP_CLIENT_SECRET  위 클라이언트의 보안 비밀 (설치형 앱은 비밀로 취급되지 않음 — 구글 문서 기준)
+ *   GOOGLE_WEB_CLIENT_ID          안드로이드용 '웹 애플리케이션' 클라이언트 ID
+ *   GOOGLE_MOCK_BASE              (시험용) 가짜 구글 서버 주소. 지정하면 모든 주소를 그쪽으로
+ *
+ * 아무 값도 없으면 파일을 지운다 → 앱에서 구글 로그인이 숨겨진다 (엔트리 계정 로그인은 별개).
+ */
+const fs = require('fs');
+const path = require('path');
+
+const file = path.resolve(__dirname, '..', 'config', 'google.json');
+const env = process.env;
+const config = {};
+if (env.GOOGLE_DESKTOP_CLIENT_ID) config.desktopClientId = env.GOOGLE_DESKTOP_CLIENT_ID.trim();
+if (env.GOOGLE_DESKTOP_CLIENT_SECRET) config.desktopClientSecret = env.GOOGLE_DESKTOP_CLIENT_SECRET.trim();
+if (env.GOOGLE_WEB_CLIENT_ID) config.webClientId = env.GOOGLE_WEB_CLIENT_ID.trim();
+if (env.GOOGLE_MOCK_BASE) {
+    const b = env.GOOGLE_MOCK_BASE.replace(/\/$/, '');
+    Object.assign(config, {
+        authUrl: `${b}/o/oauth2/v2/auth`,
+        tokenUrl: `${b}/token`,
+        revokeUrl: `${b}/revoke`,
+        userInfoUrl: `${b}/oauth2/v3/userinfo`,
+        apiBase: `${b}/drive/v3`,
+        uploadBase: `${b}/upload/drive/v3`,
+    });
+}
+
+if (!config.desktopClientId && !config.webClientId) {
+    if (fs.existsSync(file)) {
+        fs.unlinkSync(file);
+    }
+    console.log('구글 드라이브 연동: 설정 없음 (구글 로그인 숨김, 엔트리 로그인은 그대로)');
+} else {
+    fs.mkdirSync(path.dirname(file), { recursive: true });
+    fs.writeFileSync(file, `${JSON.stringify(config, null, 2)}\n`);
+    console.log(
+        `구글 드라이브 연동: 설정함 (Windows ${config.desktopClientId ? 'O' : 'X'}, 안드로이드 ${config.webClientId ? 'O' : 'X'}${
+            env.GOOGLE_MOCK_BASE ? ', 시험 서버' : ''
+        })`
+    );
+}
