diff --git a/mobile/scripts/apply-branding.js b/mobile/scripts/apply-branding.js
new file mode 100644
index 00000000..bbadfd79
--- /dev/null
+++ b/mobile/scripts/apply-branding.js
@@ -0,0 +1,156 @@
+#!/usr/bin/env node
+/**
+ * [entry-local] 앱 이름·아이콘 바꾸기 (안드로이드)
+ *
+ * 사용: node scripts/apply-branding.js <branding 폴더>
+ *   branding/app-name.txt  홈 화면에 보일 앱 이름 (한 줄)          — 없으면 이름 유지
+ *   branding/icon.png      정사각형 아이콘 (512×512 이상 권장)      — 없으면 아이콘 유지
+ *   branding/icon-bg.txt   (선택) 적응형 아이콘 배경색 #RRGGBB      — 없으면 아이콘 모서리 색
+ *
+ * 패키지 ID(biz.softline.entrylocal)는 바꾸지 않는다 → 기존 앱 위에 업데이트 설치·구글 로그인 설정 유지.
+ * 순수 JS(jimp)라 Windows·GitHub Actions 어디서든 Python 없이 동작한다.
+ */
+const fs = require('fs');
+const path = require('path');
+const { Jimp } = require('jimp');
+
+const MOBILE = path.resolve(__dirname, '..');
+const RES = path.join(MOBILE, 'android', 'app', 'src', 'main', 'res');
+const dir = path.resolve(process.argv[2] || path.join(MOBILE, '..', '..', 'branding'));
+
+function readText(name) {
+    const file = path.join(dir, name);
+    return fs.existsSync(file) ? fs.readFileSync(file, 'utf8').replace(/^\uFEFF/, '').trim() : '';
+}
+
+function xmlEscape(s) {
+    return s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/'/g, "\\'").replace(/"/g, '\\"');
+}
+
+function applyName(name) {
+    const strings = path.join(RES, 'values', 'strings.xml');
+    let xml = fs.readFileSync(strings, 'utf8');
+    for (const key of ['app_name', 'title_activity_main']) {
+        xml = xml.replace(new RegExp(`(<string name="${key}">)[^<]*(</string>)`), `$1${xmlEscape(name)}$2`);
+    }
+    fs.writeFileSync(strings, xml);
+    const capFile = path.join(MOBILE, 'capacitor.config.json');
+    const cap = JSON.parse(fs.readFileSync(capFile, 'utf8'));
+    cap.appName = name;
+    fs.writeFileSync(capFile, `${JSON.stringify(cap, null, 2)}\n`);
+    console.log(`앱 이름: ${name}`);
+}
+
+/** 모양 바깥을 투명하게 (shape: 'rounded' | 'circle') — 4배 크기에서 잘라 줄이므로 가장자리가 부드럽다 */
+function maskShape(img, shape) {
+    const { width: w, height: h, data } = img.bitmap;
+    const r = shape === 'circle' ? w / 2 : w * 0.2;
+    for (let y = 0; y < h; y++) {
+        for (let x = 0; x < w; x++) {
+            let inside;
+            if (shape === 'circle') {
+                inside = (x + 0.5 - w / 2) ** 2 + (y + 0.5 - h / 2) ** 2 <= r * r;
+            } else {
+                const cx = Math.min(Math.max(x + 0.5, r), w - r);
+                const cy = Math.min(Math.max(y + 0.5, r), h - r);
+                inside = (x + 0.5 - cx) ** 2 + (y + 0.5 - cy) ** 2 <= r * r;
+            }
+            if (!inside) {
+                data[(y * w + x) * 4 + 3] = 0;
+            }
+        }
+    }
+    return img;
+}
+
+function hex(rgb) {
+    return `#${rgb.map((v) => v.toString(16).padStart(2, '0')).join('').toUpperCase()}`;
+}
+
+async function applyIcon(file) {
+    const src = await Jimp.read(file);
+    const { width, height, data } = src.bitmap;
+    if (width !== height) {
+        console.warn(`경고: 아이콘이 정사각형이 아닙니다 (${width}×${height}) — 가운데를 정사각형으로 자릅니다.`);
+        const s = Math.min(width, height);
+        src.crop({ x: Math.floor((width - s) / 2), y: Math.floor((height - s) / 2), w: s, h: s });
+    }
+    if (src.bitmap.width < 192) {
+        console.warn(`경고: 아이콘이 작습니다 (${src.bitmap.width}px) — 흐리게 보일 수 있습니다. 512px 이상 권장.`);
+    }
+    // 배경색: 지정값 → 아이콘 왼쪽 위 모서리 색(투명이면 흰색)
+    let bg = readText('icon-bg.txt');
+    if (!/^#[0-9a-fA-F]{6}$/.test(bg)) {
+        const a = data[3];
+        bg = a < 128 ? '#FFFFFF' : hex([data[0], data[1], data[2]]);
+    }
+    const bgNum = parseInt(bg.slice(1) + 'FF', 16) >>> 0;
+
+    const resized = (size) => src.clone().resize({ w: size, h: size });
+    const flatten = (img) => {
+        // 투명한 부분은 배경색으로 채운 정사각형
+        const base = new Jimp({ width: img.bitmap.width, height: img.bitmap.height, color: bgNum });
+        return base.composite(img, 0, 0);
+    };
+
+    const dens = { mdpi: 1, hdpi: 1.5, xhdpi: 2, xxhdpi: 3, xxxhdpi: 4 };
+    for (const [name, k] of Object.entries(dens)) {
+        const folder = path.join(RES, `mipmap-${name}`);
+        fs.mkdirSync(folder, { recursive: true });
+        const legacy = Math.round(48 * k);
+        // 안드로이드 7 이하용: 둥근 사각형 / 원
+        for (const [out, shape] of [['ic_launcher.png', 'rounded'], ['ic_launcher_round.png', 'circle']]) {
+            const big = maskShape(flatten(resized(legacy * 4)), shape);
+            await big.resize({ w: legacy, h: legacy }).write(path.join(folder, out));
+        }
+        // 안드로이드 8 이상 적응형: 108dp 캔버스의 보이는 영역(가운데 72dp)에 아이콘
+        const full = Math.round(108 * k);
+        const inner = Math.round(72 * k);
+        const fg = new Jimp({ width: full, height: full, color: 0x00000000 });
+        fg.composite(resized(inner), Math.round((full - inner) / 2), Math.round((full - inner) / 2));
+        await fg.write(path.join(folder, 'ic_launcher_foreground.png'));
+    }
+    fs.writeFileSync(
+        path.join(RES, 'values', 'ic_launcher_background.xml'),
+        `<?xml version="1.0" encoding="utf-8"?>\n<resources>\n    <color name="ic_launcher_background">${bg}</color>\n</resources>\n`
+    );
+
+    // 시작 화면(스플래시): 배경색 + 가운데 아이콘
+    const splashes = [];
+    for (const d of fs.readdirSync(RES)) {
+        const p = path.join(RES, d, 'splash.png');
+        if (d.startsWith('drawable') && fs.existsSync(p)) {
+            splashes.push(p);
+        }
+    }
+    for (const p of splashes) {
+        const old = await Jimp.read(p);
+        const { width: w, height: h } = old.bitmap;
+        const s = Math.round(Math.min(w, h) * 0.3);
+        const img = new Jimp({ width: w, height: h, color: bgNum });
+        img.composite(maskShape(flatten(resized(s)), 'rounded'), Math.round((w - s) / 2), Math.round((h - s) / 2));
+        await img.write(p);
+    }
+    console.log(`아이콘: ${path.basename(file)} → 런처 아이콘 15개, 시작 화면 ${splashes.length}개 (배경 ${bg})`);
+}
+
+(async () => {
+    if (!fs.existsSync(dir)) {
+        console.log('branding 폴더 없음 — 기본 이름·아이콘 사용');
+        return;
+    }
+    const name = readText('app-name.txt').split(/\r?\n/)[0].trim();
+    if (name) {
+        applyName(name);
+    }
+    const icon = path.join(dir, 'icon.png');
+    if (fs.existsSync(icon)) {
+        await applyIcon(icon);
+    }
+    if (!name && !fs.existsSync(icon)) {
+        console.log('branding 폴더가 비어 있음 — 기본 이름·아이콘 사용');
+    }
+})().catch((e) => {
+    console.error(`앱 이름·아이콘 적용 실패: ${e.message}`);
+    process.exit(1);
+});
diff --git a/mobile/scripts/assemble-www.js b/mobile/scripts/assemble-www.js
new file mode 100644
index 00000000..e1ed5da6
--- /dev/null
+++ b/mobile/scripts/assemble-www.js
@@ -0,0 +1,140 @@
+#!/usr/bin/env node
+/**
+ * [entry-local/web] 안드로이드 앱에 들어갈 웹 자산(www)을 모은다.
+ *
+ * Electron 판과 같은 폴더 구조를 유지해야 렌더러 안의 상대경로(../../renderer/resources/...,
+ * ../../../node_modules/...)가 그대로 동작한다.
+ *
+ *   www/index.html                       -> src/main/views/main.html 로 이동
+ *   www/src/main/views/main.html         (= src/main/views/main.web.html)
+ *   www/src/renderer_build_web/          (npm run build:web 결과)
+ *   www/src/renderer/resources/          (오브젝트·모양·소리 라이브러리 포함)
+ *   www/node_modules/{entry-js,entry-tool,...}
+ *
+ * 사용: node scripts/assemble-www.js [--link]   (--link: 복사 대신 하드링크, 개발용)
+ */
+const fs = require('fs');
+const path = require('path');
+
+const root = path.resolve(__dirname, '..', '..'); // entry-offline
+const www = path.resolve(__dirname, '..', 'www');
+const link = process.argv.includes('--link');
+
+function copy(rel, opts = {}) {
+    const from = path.join(root, rel);
+    const to = path.join(www, opts.to || rel);
+    if (!fs.existsSync(from)) {
+        throw new Error(`없음: ${rel}  (먼저 entry-offline 에서 yarn install / npm run build:web 를 했는지 확인)`);
+    }
+    const filter = opts.filter || (() => true);
+    const walk = (src, dst) => {
+        const stat = fs.statSync(src);
+        if (stat.isDirectory()) {
+            fs.mkdirSync(dst, { recursive: true });
+            for (const name of fs.readdirSync(src)) {
+                const child = path.join(src, name);
+                if (filter(path.relative(root, child), name)) {
+                    walk(child, path.join(dst, name));
+                }
+            }
+        } else {
+            fs.mkdirSync(path.dirname(dst), { recursive: true });
+            if (link) {
+                try {
+                    fs.linkSync(src, dst);
+                    return;
+                } catch (e) {
+                    /* 다른 드라이브면 복사 */
+                }
+            }
+            fs.copyFileSync(src, dst);
+        }
+    };
+    walk(from, to);
+    console.log(`  + ${opts.to || rel}`);
+}
+
+console.log(`www 조립: ${www}`);
+fs.rmSync(www, { recursive: true, force: true });
+fs.mkdirSync(www, { recursive: true });
+
+// 앱 화면
+copy('src/main/views/main.web.html', { to: 'src/main/views/main.html' });
+copy('src/main/static/source');
+copy('src/main/static/icon.png');
+copy('src/renderer_build_web');
+copy('src/renderer/resources', { filter: (rel, name) => !name.endsWith('.scss') });
+
+// 라이브러리
+copy('node_modules/entry-js', {
+    filter: (rel, name) =>
+        !/^node_modules[\\/]entry-js[\\/](src|node_modules|test|example)([\\/]|$)/.test(rel) &&
+        !/^node_modules[\\/]entry-js[\\/]dist[\\/]entry\.js(\.map)?$/.test(rel) &&
+        !name.endsWith('.map'),
+});
+copy('node_modules/entry-tool/dist');
+copy('node_modules/lodash/lodash.min.js');
+copy('node_modules/jquery/dist/jquery.min.js');
+copy('node_modules/literallycanvas-mobile/lib');
+copy('node_modules/@entrylabs/legacy-video/dist');
+copy('node_modules/@entrylabs/modal/dist');
+
+// 소리 라이브러리는 uploads/ab/cd/<파일> 과 uploads/ab/cd/sound/<파일> 두 배치가 섞여 있다.
+// 안드로이드 로컬 서버는 HEAD 요청으로 존재 확인을 하기 어려워 미리 목록을 만들어 둔다.
+{
+    const uploads = path.join(www, 'src/renderer/resources/uploads');
+    const flat = [];
+    for (const a of fs.readdirSync(uploads)) {
+        const da = path.join(uploads, a);
+        if (!fs.statSync(da).isDirectory()) continue;
+        for (const b of fs.readdirSync(da)) {
+            const db = path.join(da, b);
+            if (!fs.statSync(db).isDirectory()) continue;
+            for (const name of fs.readdirSync(db)) {
+                if (/\.(mp3|wav|ogg)$/i.test(name)) flat.push(name);
+            }
+        }
+    }
+    fs.writeFileSync(path.join(uploads, 'flat-sounds.json'), JSON.stringify(flat));
+    console.log(`  + flat-sounds.json (${flat.length})`);
+}
+
+// 구글 드라이브 설정 (scripts/write-google-config.js 가 만든 파일). 없으면 기능이 숨겨진다.
+if (fs.existsSync(path.join(root, 'config', 'google.json'))) {
+    copy('config/google.json');
+}
+// 브라우저에서 구글 로그인 팝업이 돌아올 페이지
+fs.writeFileSync(
+    path.join(www, 'oauth-callback.html'),
+    `<!DOCTYPE html><html><head><meta charset="utf-8"><title>Entry Local</title></head><body>
+<script>
+if (window.opener) { window.opener.postMessage({ type: 'entry-local-oauth', hash: location.hash.slice(1) }, location.origin); }
+window.close();
+var ko = /^ko/i.test(navigator.language || '');
+document.title = ko ? '로그인' : 'Login';
+document.write(ko ? '로그인 처리 중…' : 'Signing in…');
+</script></body></html>\n`
+);
+
+fs.writeFileSync(
+    path.join(www, 'index.html'),
+    `<!DOCTYPE html><html lang="ko"><head><meta charset="utf-8"><title>엔트리 로컬</title>
+<script>location.replace('src/main/views/main.html');</script></head><body></body></html>\n`
+);
+
+// 크기 보고
+let bytes = 0;
+let files = 0;
+const count = (dir) => {
+    for (const name of fs.readdirSync(dir)) {
+        const p = path.join(dir, name);
+        const s = fs.statSync(p);
+        if (s.isDirectory()) count(p);
+        else {
+            bytes += s.size;
+            files++;
+        }
+    }
+};
+count(www);
+console.log(`완료: 파일 ${files}개, ${(bytes / 1024 / 1024).toFixed(0)} MB`);
diff --git a/mobile/scripts/dev-server.js b/mobile/scripts/dev-server.js
new file mode 100644
index 00000000..c1805d0d
--- /dev/null
+++ b/mobile/scripts/dev-server.js
@@ -0,0 +1,112 @@
+#!/usr/bin/env node
+/**
+ * [entry-local/web] PC 브라우저에서 안드로이드판 화면을 띄워 보는 개발용 서버 (APK 에는 들어가지 않음)
+ *   - www/ 정적 파일
+ *   - /_devfs/...      : 앱 내부 저장소 흉내 (mobile/.devfs 폴더)
+ *   - /_devfs_api/...  : 쓰기·삭제·목록
+ * 사용: node scripts/dev-server.js [포트=8100]
+ */
+const http = require('http');
+const fs = require('fs');
+const path = require('path');
+
+const www = path.resolve(__dirname, '..', 'www');
+const store = path.resolve(__dirname, '..', '.devfs');
+const port = Number(process.argv[2] || 8100);
+fs.mkdirSync(store, { recursive: true });
+
+const types = {
+    '.html': 'text/html; charset=utf-8', '.js': 'application/javascript', '.mjs': 'application/javascript',
+    '.css': 'text/css', '.json': 'application/json', '.png': 'image/png', '.jpg': 'image/jpeg',
+    '.gif': 'image/gif', '.svg': 'image/svg+xml', '.mp3': 'audio/mpeg', '.wav': 'audio/wav',
+    '.woff': 'font/woff', '.woff2': 'font/woff2', '.ttf': 'font/ttf', '.wasm': 'application/wasm',
+};
+
+const safe = (base, rel) => {
+    const p = path.resolve(base, rel || '');
+    if (p !== base && !p.startsWith(base + path.sep)) throw new Error('bad path');
+    return p;
+};
+
+function listFiles(dir, base) {
+    if (!fs.existsSync(dir)) return [];
+    const out = [];
+    for (const name of fs.readdirSync(dir)) {
+        const p = path.join(dir, name);
+        if (fs.statSync(p).isDirectory()) out.push(...listFiles(p, base));
+        else out.push(path.relative(base, p).split(path.sep).join('/'));
+    }
+    return out;
+}
+
+function body(req) {
+    return new Promise((resolve) => {
+        const chunks = [];
+        req.on('data', (c) => chunks.push(c));
+        req.on('end', () => resolve(Buffer.concat(chunks)));
+    });
+}
+
+function serveFile(res, file, method) {
+    fs.stat(file, (err, stat) => {
+        if (err || !stat.isFile()) {
+            res.writeHead(404);
+            return res.end('not found');
+        }
+        res.writeHead(200, {
+            'content-type': types[path.extname(file).toLowerCase()] || 'application/octet-stream',
+            'content-length': stat.size,
+            'cache-control': 'no-store',
+        });
+        if (method === 'HEAD') return res.end();
+        fs.createReadStream(file).pipe(res);
+    });
+}
+
+http.createServer(async (req, res) => {
+    try {
+        const url = new URL(req.url, `http://${req.headers.host}`);
+        const pathname = decodeURIComponent(url.pathname);
+
+        if (pathname.startsWith('/_devfs_api/')) {
+            const op = pathname.substring('/_devfs_api/'.length);
+            if (op === 'write') {
+                const file = safe(store, url.searchParams.get('path'));
+                fs.mkdirSync(path.dirname(file), { recursive: true });
+                fs.writeFileSync(file, await body(req));
+                return res.end('{}');
+            }
+            const args = JSON.parse((await body(req)).toString() || '{}');
+            let result = {};
+            if (op === 'exists') result = { exists: fs.existsSync(safe(store, args.path)) };
+            else if (op === 'remove') fs.rmSync(safe(store, args.path), { recursive: true, force: true });
+            else if (op === 'list') result = { files: listFiles(safe(store, args.path), store) };
+            else if (op === 'copy') {
+                const to = safe(store, args.to);
+                fs.mkdirSync(path.dirname(to), { recursive: true });
+                fs.cpSync(safe(store, args.from), to, { recursive: true });
+            } else if (op === 'move') {
+                const to = safe(store, args.to);
+                fs.rmSync(to, { recursive: true, force: true });
+                fs.mkdirSync(path.dirname(to), { recursive: true });
+                fs.renameSync(safe(store, args.from), to);
+            } else {
+                res.writeHead(400);
+                return res.end('unknown op');
+            }
+            res.writeHead(200, { 'content-type': 'application/json' });
+            return res.end(JSON.stringify(result));
+        }
+
+        if (pathname.startsWith('/_devfs/')) {
+            return serveFile(res, safe(store, pathname.substring('/_devfs/'.length)), req.method);
+        }
+
+        let file = safe(www, pathname.substring(1));
+        if (fs.existsSync(file) && fs.statSync(file).isDirectory()) file = path.join(file, 'index.html');
+        return serveFile(res, file, req.method);
+    } catch (e) {
+        res.writeHead(500);
+        res.end(String(e && e.message));
+    }
+}).listen(port, () => console.log(`엔트리 로컬(웹) 개발 서버: http://localhost:${port}/`));
