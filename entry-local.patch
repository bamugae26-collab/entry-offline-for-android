+            }
+        } catch (Exception ignored) {
+            // 권한 없음
+        }
+        return list;
+    }
+
+    @SuppressWarnings("MissingPermission")
+    private static String btName(BluetoothDevice d) {
+        String n = null;
+        try {
+            n = d.getName();
+        } catch (Exception ignored) {
+            // 권한 없음
+        }
+        return n == null || n.trim().isEmpty() ? d.getAddress() : n;
+    }
+
+    private static JSObject btInfo(BluetoothDevice d) {
+        JSObject r = new JSObject();
+        r.put("portId", BT_PREFIX + d.getAddress());
+        r.put("name", btName(d));
+        r.put("usbVendorId", 0);
+        r.put("usbProductId", 0);
+        r.put("bluetooth", true);
+        return r;
+    }
+
+    /** 기기 고르기: USB 기기 + 등록된 블루투스 기기 (하나뿐이면 바로) → 권한 → 포트 정보 */
+    @PluginMethod
+    public void requestPort(final PluginCall call) {
+        BluetoothAdapter adapter = btAdapter();
+        boolean btOn = false;
+        try {
+            btOn = adapter != null && adapter.isEnabled();
+        } catch (Exception ignored) {
+            // 권한 없음
+        }
+        // 블루투스가 켜져 있으면 등록된 기기를 보여 주기 위해 '근처 기기' 권한을 먼저 묻는다 (거절해도 USB 는 됨)
+        if (btOn && !btAllowed()) {
+            requestPermissionForAlias("btConnect", call, "afterBtPermission");
+            return;
+        }
+        choosePort(call);
+    }
+
+    @PermissionCallback
+    private void afterBtPermission(PluginCall call) {
+        choosePort(call);
+    }
+
+    private void choosePort(final PluginCall call) {
+        final List<UsbSerialDriver> drivers = UsbSerialProber.getDefaultProber().findAllDrivers(usb());
+        final List<BluetoothDevice> bts = bondedSerialDevices();
+        final boolean hasBt = btAdapter() != null;
+        if (drivers.size() == 1 && bts.isEmpty()) {
+            askPermission(call, drivers.get(0).getDevice());
+            return;
+        }
+        if (drivers.isEmpty() && bts.isEmpty() && !hasBt) {
+            call.reject(tr(
+                "연결된 USB 하드웨어를 찾지 못했습니다.\nUSB OTG 젠더(또는 C타입 선)로 하드웨어를 태블릿에 꽂았는지 확인해 주세요.",
+                "No USB hardware was found.\nCheck that the hardware is plugged into the tablet with a USB OTG adapter (or USB-C cable)."
+            ), "NOT_FOUND");
+            return;
+        }
+        main.post(() -> {
+            final List<String> names = new ArrayList<>();
+            for (UsbSerialDriver d : drivers) names.add("USB · " + label(d.getDevice()));
+            for (BluetoothDevice d : bts) names.add(tr("블루투스 · ", "Bluetooth · ") + btName(d));
+            if (hasBt) names.add(tr("＋ 블루투스 기기 등록하기 (설정 열기)", "+ Pair a Bluetooth device (open Settings)"));
+            final boolean[] done = { false };
+            String title = drivers.isEmpty() && bts.isEmpty()
+                ? tr("USB 하드웨어가 없습니다", "No USB hardware")
+                : tr("연결할 하드웨어 선택", "Choose hardware to connect");
+            new AlertDialog.Builder(getActivity())
+                .setTitle(title)
+                .setItems(names.toArray(new String[0]), (dialog, which) -> {
+                    done[0] = true;
+                    if (which < drivers.size()) {
+                        askPermission(call, drivers.get(which).getDevice());
+                    } else if (which < drivers.size() + bts.size()) {
+                        call.resolve(btInfo(bts.get(which - drivers.size())));
+                    } else {
+                        try {
+                            getActivity().startActivity(new Intent(Settings.ACTION_BLUETOOTH_SETTINGS));
+                        } catch (Exception ignored) {
+                            // 설정 화면 없음
+                        }
+                        call.reject(tr(
+                            "블루투스 설정에서 하드웨어(HC-05·HC-06 등)를 등록한 뒤 다시 연결해 주세요.",
+                            "Pair the hardware (HC-05, HC-06, …) in Bluetooth settings, then connect again."
+                        ), "PAIR_FIRST");
+                    }
+                })
+                .setOnDismissListener((dialog) -> {
+                    if (!done[0]) call.reject(tr("하드웨어 선택을 취소했습니다.", "Hardware selection was cancelled."), "CANCELLED");
+                })
+                .show();
+        });
+    }
+
+    private void askPermission(final PluginCall call, final UsbDevice device) {
+        final UsbManager manager = usb();
+        if (manager.hasPermission(device)) {
+            call.resolve(portInfo(device));
+            return;
+        }
+        final Context ctx = getContext();
+        final BroadcastReceiver receiver = new BroadcastReceiver() {
+            @Override
+            public void onReceive(Context context, Intent intent) {
+                if (!ACTION_USB_PERMISSION.equals(intent.getAction())) return;
+                try {
+                    ctx.unregisterReceiver(this);
+                } catch (Exception ignored) {
+                    // 이미 해제됨
+                }
+                boolean granted = intent.getBooleanExtra(UsbManager.EXTRA_PERMISSION_GRANTED, false);
+                if (granted || manager.hasPermission(device)) {
+                    call.resolve(portInfo(device));
+                } else {
+                    call.reject(tr("USB 사용 권한을 허용하지 않았습니다.", "USB permission was not granted."), "DENIED");
+                }
+            }
+        };
+        IntentFilter filter = new IntentFilter(ACTION_USB_PERMISSION);
+        if (Build.VERSION.SDK_INT >= 33) {
+            ctx.registerReceiver(receiver, filter, Context.RECEIVER_NOT_EXPORTED);
+        } else {
+            ctx.registerReceiver(receiver, filter);
+        }
+        Intent intent = new Intent(ACTION_USB_PERMISSION).setPackage(ctx.getPackageName());
+        int flags = Build.VERSION.SDK_INT >= 31 ? PendingIntent.FLAG_MUTABLE : 0;
+        PendingIntent pi = PendingIntent.getBroadcast(ctx, 0, intent, flags);
+        manager.requestPermission(device, pi);
+    }
+
+    @PluginMethod
+    public void open(final PluginCall call) {
+        final String portId = call.getString("portId", "");
+        final int baudRate = call.getInt("baudRate", 9600);
+        final int dataBits = call.getInt("dataBits", 8);
+        final int stopBits = call.getInt("stopBits", 1);
+        final String parity = call.getString("parity", "none");
+        if (portId.startsWith(BT_PREFIX)) {
+            openBluetooth(call, portId);
+            return;
+        }
+        UsbSerialDriver driver = findDriver(portId);
+        if (driver == null) {
+            call.reject(tr("하드웨어가 빠졌습니다. 다시 꽂아 주세요.", "The hardware was unplugged. Please plug it in again."), "NOT_FOUND");
+            return;
+        }
+        if (open.containsKey(portId)) closePort(portId);
+        UsbDeviceConnection connection = usb().openDevice(driver.getDevice());
+        if (connection == null) {
+            call.reject(tr("USB 사용 권한이 없습니다. 다시 연결해 주세요.", "No USB permission. Please connect again."), "DENIED");
+            return;
+        }
+        final OpenPort op = new OpenPort();
+        try {
+            op.port = driver.getPorts().get(0);
+            op.port.open(connection);
+            int p = "even".equals(parity) ? UsbSerialPort.PARITY_EVEN : "odd".equals(parity) ? UsbSerialPort.PARITY_ODD : UsbSerialPort.PARITY_NONE;
+            int sb = stopBits == 2 ? UsbSerialPort.STOPBITS_2 : UsbSerialPort.STOPBITS_1;
+            op.port.setParameters(baudRate, dataBits, sb, p);
+            // 웹 시리얼처럼 열 때 DTR·RTS 를 켠다 (일부 기기는 DTR 이 있어야 데이터를 보낸다)
+            try {
+                op.port.setDTR(true);
+                op.port.setRTS(true);
+            } catch (Exception ignored) {
+                // 지원하지 않는 칩
+            }
+            op.io = new SerialInputOutputManager(op.port, new SerialInputOutputManager.Listener() {
+                @Override
+                public void onNewData(byte[] data) {
+                    JSObject r = new JSObject();
+                    r.put("portId", portId);
+                    r.put("data", Base64.encodeToString(data, Base64.NO_WRAP));
+                    notifyListeners("data", r);
+                }
+
+                @Override
+                public void onRunError(Exception e) {
+                    if (open.remove(portId) != null) {
+                        try {
+                            op.port.close();
+                        } catch (Exception ignored) {
+                            // 이미 닫힘
+                        }
+                        notifyDisconnect(portId);
+                    }
+                }
+            });
+            op.io.start();
+            open.put(portId, op);
+            call.resolve();
+        } catch (Exception e) {
+            try {
+                if (op.port != null) op.port.close();
+            } catch (Exception ignored) {
+                // 이미 닫힘
+            }
+            call.reject(tr("하드웨어를 열지 못했습니다: ", "Could not open the hardware: ") + e.getMessage(), "OPEN_FAILED");
+        }
+    }
+
+    @PluginMethod
+    public void write(final PluginCall call) {
+        final String portId = call.getString("portId", "");
+        final String data = call.getString("data", "");
+        final OpenPort op = open.get(portId);
+        if (op == null) {
+            call.reject(tr("하드웨어가 연결되어 있지 않습니다.", "The hardware is not connected."), "NOT_OPEN");
+            return;
+        }
+        writer.execute(() -> {
+            try {
+                op.write(Base64.decode(data, Base64.DEFAULT));
+                call.resolve();
+            } catch (Exception e) {
+                call.reject(tr("하드웨어에 보내지 못했습니다: ", "Could not send to the hardware: ") + e.getMessage(), "WRITE_FAILED");
+            }
+        });
+    }
+
+    @PluginMethod
+    public void setSignals(PluginCall call) {
+        OpenPort op = open.get(call.getString("portId", ""));
+        if (op == null || op.port == null) {
+            call.resolve();
+            return;
+        }
+        try {
+            Boolean dtr = call.getBoolean("dataTerminalReady", null);
+            Boolean rts = call.getBoolean("requestToSend", null);
+            if (dtr != null) op.port.setDTR(dtr);
+            if (rts != null) op.port.setRTS(rts);
+        } catch (Exception ignored) {
+            // 지원하지 않는 칩
+        }
+        call.resolve();
+    }
+
+    @PluginMethod
+    public void close(PluginCall call) {
+        closePort(call.getString("portId", ""));
+        call.resolve();
+    }
+
+    private void closePort(String portId) {
+        OpenPort op = open.remove(portId);
+        if (op == null) return;
+        try {
+            if (op.io != null) op.io.stop();
+        } catch (Exception ignored) {
+            // 이미 멈춤
+        }
+        try {
+            if (op.port != null) op.port.close();
+        } catch (Exception ignored) {
+            // 이미 닫힘
+        }
+        try {
+            if (op.socket != null) op.socket.close();
+        } catch (Exception ignored) {
+            // 이미 닫힘
+        }
+    }
+
+    /** 블루투스 시리얼(SPP) 열기 — 연결에 몇 초 걸리므로 따로 실행. 통신 속도는 블루투스 모듈 설정을 따른다 */
+    @SuppressWarnings("MissingPermission")
+    private void openBluetooth(final PluginCall call, final String portId) {
+        final BluetoothAdapter adapter = btAdapter();
+        if (adapter == null || !btAllowed()) {
+            call.reject(tr("블루투스를 쓸 수 없습니다. '근처 기기' 권한을 허용해 주세요.", "Bluetooth is not available. Please allow the 'Nearby devices' permission."), "DENIED");
+            return;
+        }
+        if (open.containsKey(portId)) closePort(portId);
+        new Thread(() -> {
+            BluetoothSocket socket = null;
+            try {
+                if (!adapter.isEnabled()) {
+                    call.reject(tr("블루투스가 꺼져 있습니다. 켠 뒤 다시 연결해 주세요.", "Bluetooth is off. Turn it on and connect again."), "BT_OFF");
+                    return;
+                }
+                BluetoothDevice device = adapter.getRemoteDevice(portId.substring(BT_PREFIX.length()));
+                try {
+                    adapter.cancelDiscovery();
+                } catch (Exception ignored) {
+                    // 찾는 중 아님
+                }
+                try {
+                    socket = device.createRfcommSocketToServiceRecord(SPP_UUID);
+                    socket.connect();
+                } catch (Exception first) {
+                    // 일부 모듈은 보안 연결을 받지 않는다 → 한 번 더
+                    try {
+                        if (socket != null) socket.close();
+                    } catch (Exception ignored) {
+                        // 이미 닫힘
+                    }
+                    socket = device.createInsecureRfcommSocketToServiceRecord(SPP_UUID);
+                    socket.connect();
+                }
+                final OpenPort op = new OpenPort();
+                op.socket = socket;
+                op.out = socket.getOutputStream();
+                final InputStream in = socket.getInputStream();
+                op.reader = new Thread(() -> {
+                    byte[] buf = new byte[1024];
+                    try {
+                        while (true) {
+                            int n = in.read(buf);
+                            if (n < 0) break;
+                            if (n == 0) continue;
+                            byte[] chunk = new byte[n];
+                            System.arraycopy(buf, 0, chunk, 0, n);
+                            JSObject r = new JSObject();
+                            r.put("portId", portId);
+                            r.put("data", Base64.encodeToString(chunk, Base64.NO_WRAP));
+                            notifyListeners("data", r);
+                        }
+                    } catch (Exception ignored) {
+                        // 끊김
+                    }
+                    if (open.get(portId) == op) {
+                        closePort(portId);
+                        notifyDisconnect(portId);
+                    }
+                }, "EntryBtSerial");
+                open.put(portId, op);
+                op.reader.start();
+                call.resolve();
+            } catch (Exception e) {
+                try {
+                    if (socket != null) socket.close();
+                } catch (Exception ignored) {
+                    // 이미 닫힘
+                }
+                call.reject(tr(
+                    "블루투스 하드웨어에 연결하지 못했습니다.\n하드웨어 전원이 켜져 있는지, 다른 기기와 연결되어 있지 않은지 확인해 주세요.",
+                    "Could not connect to the Bluetooth hardware.\nCheck that it is powered on and not connected to another device."
+                ), "OPEN_FAILED");
+            }
+        }, "EntryBtConnect").start();
+    }
+
+    private void notifyDisconnect(String portId) {
+        JSObject r = new JSObject();
+        r.put("portId", portId);
+        notifyListeners("disconnect", r);
+    }
+}
diff --git a/mobile/android/app/src/main/java/biz/softline/entrylocal/MainActivity.java b/mobile/android/app/src/main/java/biz/softline/entrylocal/MainActivity.java
