index 00000000..d0f164c5
--- /dev/null
+++ b/src/renderer/helper/inputCaretFix.ts
@@ -0,0 +1,77 @@
+/**
+ * [entry-local] 안드로이드 입력칸 커서 고침 (right → thgir / ght ir 처럼 글자 순서가 뒤섞이는 문제)
+ *
+ * 엔트리 오브젝트 목록 등은 끌어서 옮기는 곳이라 바깥 상자들에 "글자 선택 안 됨(user-select:none)"이 걸려 있다.
+ * 안드로이드 웹뷰는 이런 상자 안의 입력칸에서 키보드(IME)에 커서 위치를 제대로 알려주지 못해
+ * 키보드가 글자를 엉뚱한 자리(맨 앞 등)에 끼워 넣는다.
+ * 입력칸 자체만 풀어서는 부족해서(2026.10.23-k), 입력칸에 커서가 들어가 있는 동안은
+ * 바깥 상자들의 user-select:none 도 잠깐 풀고, 커서가 나가면 원래대로 되돌린다.
+ */
+let installed = false;
+
+const TEXT_TYPES = /^(text|search|number|tel|url|email|password|)$/i;
+
+function isTextField(el: EventTarget | null): el is HTMLInputElement | HTMLTextAreaElement {
+    if (el instanceof HTMLTextAreaElement) {
+        return true;
+    }
+    return el instanceof HTMLInputElement && TEXT_TYPES.test(el.type || '');
+}
+
+export function installInputCaretFix() {
+    if (installed || typeof document === 'undefined') {
+        return;
+    }
+    installed = true;
+    let restore: Array<() => void> = [];
+
+    const release = () => {
+        restore.forEach((fn) => fn());
+        restore = [];
+    };
+
+    document.addEventListener(
+        'focusin',
+        (e) => {
+            const target = e.target;
+            if (!isTextField(target)) {
+                return;
+            }
+            release();
+            let el: HTMLElement | null = target;
+            while (el && el !== document.documentElement) {
+                const cs = getComputedStyle(el);
+                if (cs.userSelect === 'none' || (cs as any).webkitUserSelect === 'none' || el === target) {
+                    const node = el;
+                    const prev = node.style.getPropertyValue('user-select');
+                    const prevPriority = node.style.getPropertyPriority('user-select');
+                    const prevWk = node.style.getPropertyValue('-webkit-user-select');
+                    const prevWkPriority = node.style.getPropertyPriority('-webkit-user-select');
+                    node.style.setProperty('user-select', 'text', 'important');
+                    node.style.setProperty('-webkit-user-select', 'text', 'important');
+                    restore.push(() => {
+                        node.style.setProperty('user-select', prev, prevPriority);
+                        node.style.setProperty('-webkit-user-select', prevWk, prevWkPriority);
+                        if (!prev) {
+                            node.style.removeProperty('user-select');
+                        }
+                        if (!prevWk) {
+                            node.style.removeProperty('-webkit-user-select');
+                        }
+                    });
+                }
+                el = el.parentElement;
+            }
+        },
+        true
+    );
+    document.addEventListener(
+        'focusout',
+        (e) => {
+            if (isTextField(e.target)) {
+                release();
+            }
+        },
+        true
+    );
+}
