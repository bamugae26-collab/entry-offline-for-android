+            } else if (warmLoadingUrl != null && sameWs(warmLoadingUrl, url)) {
+                // 미리 불러오는 중 → 다 불러오면 onLoaded 에서 시작
+            } else {
+                loadWarm(url);
+            }
+        });
+    }
