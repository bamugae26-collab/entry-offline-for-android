diff --git a/scripts/mock-entry.js b/scripts/mock-entry.js
new file mode 100644
index 00000000..f746e5ef
--- /dev/null
+++ b/scripts/mock-entry.js
@@ -0,0 +1,297 @@
+#!/usr/bin/env node
+/**
+ * [entry-local] 시험용 가짜 엔트리(playentry.org) 서버
+ * - /signin : 아이디·비밀번호 폼 → 로그인하면 세션 쿠키 + / 로 이동
