diff --git a/src/web/bus.ts b/src/web/bus.ts
new file mode 100644
index 00000000..2695dcad
--- /dev/null
+++ b/src/web/bus.ts
@@ -0,0 +1,20 @@
+/**
+ * [entry-local/web] Electron 의 ipcRenderer.on(…) 대체.
+ * 메인 프로세스가 보내던 알림(예: 'cloud:status')을 웹 구현에서 같은 모양으로 보낸다.
+ */
+type Listener = (event: any, ...args: any[]) => void;
+const listeners: { [channel: string]: Listener[] } = {};
+
+export function listen(channel: string, fn: Listener) {
+    (listeners[channel] = listeners[channel] || []).push(fn);
+}
+
+export function emit(channel: string, ...args: any[]) {
+    (listeners[channel] || []).forEach((fn) => {
+        try {
+            fn({}, ...args);
+        } catch (e) {
+            console.error(e);
+        }
+    });
+}
diff --git a/src/web/cloudWeb.ts b/src/web/cloudWeb.ts
new file mode 100644
index 00000000..211f9e78
--- /dev/null
+++ b/src/web/cloudWeb.ts
@@ -0,0 +1,296 @@
+import { lt } from '../common/localLang';
+import { SocialLogin } from '@capgo/capacitor-social-login';
+import {
+    DriveClient,
+    DRIVE_SCOPES,
+    GOOGLE_DEFAULTS,
+    GoogleConfig,
+    HttpFn,
+    formBody,
+} from '../common/driveClient';
+import { isNative } from './platform';
+import { emit } from './bus';
+
+/**
+ * [entry-local/web] 구글 드라이브 연동 — 안드로이드(Capacitor)·브라우저
+ *
+ * 안드로이드: 기기에 등록된 구글 계정으로 시스템 로그인 창(Credential Manager).
+ *             액세스 토큰은 운영체제가 관리하고, 만료되면 getAuthorizationCode 로 새로 받는다.
+ * 브라우저  : 팝업으로 구글 로그인 → oauth-callback.html 이 토큰을 돌려준다 (1시간 유효, 만료되면 다시 로그인).
+ */
+
+type Account = { email?: string; name?: string };
+const ACCOUNT_KEY = 'entryLocalGoogleAccount';
+const TOKEN_KEY = 'entryLocalGoogleToken';
+
+let config: GoogleConfig | undefined;
+let configPromise: Promise<GoogleConfig> | undefined;
+let account: Account | undefined;
+let token: { token: string; expiresAt: number; margin?: number } | undefined;
+let loginPromise: Promise<Account> | undefined;
+let nativeReady: Promise<void> | undefined;
+
+function readJson(key: string, storage: Storage) {
+    try {
+        return JSON.parse(storage.getItem(key) || 'null') || undefined;
+    } catch (e) {
+        return undefined;
+    }
+}
+
+function writeJson(key: string, value: any, storage: Storage) {
+    try {
+        if (value === undefined) {
+            storage.removeItem(key);
+        } else {
+            storage.setItem(key, JSON.stringify(value));
+        }
+    } catch (e) {
+        // 저장이 막힌 환경
+    }
+}
+
+export function loadConfig(): Promise<GoogleConfig> {
+    if (!configPromise) {
+        configPromise = fetch(new URL('../../../config/google.json', location.href).toString(), { cache: 'no-store' })
+            .then((res) => (res.ok ? res.json() : {}))
+            .catch(() => ({}))
+            .then((c: GoogleConfig) => {
+                config = c || {};
+                account = readJson(ACCOUNT_KEY, localStorage);
+                token = readJson(TOKEN_KEY, sessionStorage);
+                return config;
+            });
+    }
+    return configPromise;
+}
+
+function isConfigured() {
+    return !!(config && config.webClientId);
+}
+
+async function ensureNative() {
+    if (!nativeReady) {
+        nativeReady = SocialLogin.initialize({ google: { webClientId: config!.webClientId, mode: 'online' } }).then(() => undefined);
+    }
+    return nativeReady;
+}
+
+const httpFn: HttpFn = async (req) => {
+    const res = await fetch(req.url, {
+        method: req.method,
+        headers: req.headers,
+        body: req.body as any,
+        cache: 'no-store',
+    });
+    const headers: { [k: string]: string } = {};
+    res.headers.forEach((v: string, k: string) => {
+        headers[k.toLowerCase()] = v;
+    });
+    return { status: res.status, headers, body: new Uint8Array(await res.arrayBuffer()) };
+};
+
+function setToken(value: string, expiresInSec = 3600) {
+    // 만료 직전 여유: 보통 1분, 아주 짧은 토큰이면 그 1/4
+    const margin = Math.min(60000, (expiresInSec * 1000) / 4);
+    token = { token: value, expiresAt: Date.now() + expiresInSec * 1000, margin };
+    writeJson(TOKEN_KEY, token, sessionStorage);
+}
+
+function setAccount(value?: Account) {
+    account = value;
+    writeJson(ACCOUNT_KEY, value, localStorage);
+    if (!value) {
+        token = undefined;
+        writeJson(TOKEN_KEY, undefined, sessionStorage);
+    }
+}
+
+async function getAccessToken(forceRefresh = false): Promise<string> {
+    await loadConfig();
+    if (!account) {
+        throw new Error(lt('로그인이 필요합니다.', 'Login is required.'));
+    }
+    if (!forceRefresh && token && token.expiresAt - (token.margin || 60000) > Date.now()) {
+        return token.token;
+    }
+    if (isNative()) {
+        await ensureNative();
+        const current = async () => {
+            try {
+                const res: any = await SocialLogin.getAuthorizationCode({ provider: 'google' });
+                return res && res.accessToken;
+            } catch (e) {
+                return undefined;
+            }
+        };
+        let access = forceRefresh ? undefined : await current();
+        if (!access) {
+            // 만료: 운영체제 계정으로 조용히 다시 받기 (필요하면 계정 선택 창이 뜬다)
+            try {
+                await SocialLogin.refresh({ provider: 'google', options: { scopes: DRIVE_SCOPES } } as any);
+            } catch (e) {
+                // 아래에서 처리
+            }
+            access = await current();
+        }
+        if (!access) {
+            setAccount(undefined);
+            emit('cloud:status', status());
+            throw new Error(lt('구글 로그인이 만료되었습니다. 다시 로그인해 주세요.', 'Your Google login has expired. Please log in again.'));
+        }
+        setToken(access, 3000);
+        return access;
+    }
+    // 브라우저: 사용자 클릭 없이 로그인 창을 띄우면 차단되므로 다시 로그인하도록 안내
+    setAccount(undefined);
+    emit('cloud:status', status());
+    throw new Error(lt('로그인 시간이 지났습니다. 상단의 [로그인]을 눌러 다시 로그인해 주세요.', 'The login has timed out. Press [Log in] at the top to log in again.'));
+}
+
+/* ---------------- 브라우저 팝업 로그인 ---------------- */
+function browserLogin(): Promise<Account> {
+    const authUrl = config!.authUrl || GOOGLE_DEFAULTS.authUrl;
+    const redirect = new URL('/oauth-callback.html', location.href).toString();
+    const state = Math.random()
+        .toString(36)
+        .slice(2);
+    const url = `${authUrl}?${formBody({
+        client_id: config!.webClientId,
+        redirect_uri: redirect,
+        response_type: 'token',
+        scope: DRIVE_SCOPES.join(' '),
+        state,
+        prompt: 'select_account',
+        include_granted_scopes: 'true',
+    })}`;
+    return new Promise((resolve, reject) => {
+        const popup = window.open(url, 'entry-local-google', 'width=500,height=650');
+        if (!popup) {
+            reject(new Error(lt('팝업이 차단되었습니다. 팝업을 허용해 주세요.', 'The pop-up was blocked. Please allow pop-ups.')));
+            return;
+        }
+        const onMessage = async (e: MessageEvent) => {
+            if (e.origin !== location.origin || !e.data || e.data.type !== 'entry-local-oauth') {
+                return;
+            }
+            window.removeEventListener('message', onMessage);
+            clearInterval(closed);
+            const p = new URLSearchParams(e.data.hash || '');
+            if (p.get('state') !== state || !p.get('access_token')) {
+                reject(new Error(p.get('error') === 'access_denied' ? lt('로그인을 취소했습니다.', 'Login was cancelled.') : lt('로그인에 실패했습니다.', 'Login failed.')));
+                return;
+            }
+            setToken(p.get('access_token')!, Number(p.get('expires_in')) || 3600);
+            try {
+                const info = await httpFn({
+                    method: 'GET',
+                    url: config!.userInfoUrl || GOOGLE_DEFAULTS.userInfoUrl,
+                    headers: { Authorization: `Bearer ${token!.token}` },
+                });
+                const j = JSON.parse(new TextDecoder().decode(info.body));
+                setAccount({ email: j.email, name: j.name });
+            } catch (err) {
+                setAccount({});
+            }
+            resolve(account!);
+        };
+        window.addEventListener('message', onMessage);
+        const closed = setInterval(() => {
+            if (popup.closed) {
+                clearInterval(closed);
+                window.removeEventListener('message', onMessage);
+                reject(new Error(lt('로그인 창이 닫혔습니다.', 'The login window was closed.')));
+            }
+        }, 500);
+    });
+}
+
+/* ---------------- 공개 함수 ---------------- */
+export function status() {
+    return {
+        configured: isConfigured(),
+        loggedIn: !!account,
+        email: account && account.email,
+        name: account && account.name,
+    };
+}
+
+export async function cloudStatus() {
+    await loadConfig();
+    return status();
+}
+
+export async function cloudLogin(): Promise<Account> {
+    await loadConfig();
+    if (!isConfigured()) {
+        throw new Error(lt('구글 연동이 설정되지 않은 빌드입니다.', 'Google integration is not set up in this build.'));
+    }
+    try {
+        if (isNative()) {
+            await ensureNative();
+            const res: any = await SocialLogin.login({
+                provider: 'google',
+                options: { scopes: DRIVE_SCOPES, forceRefreshToken: true },
+            } as any);
+            const result = res && res.result;
+            const access = result && result.accessToken && result.accessToken.token;
+            if (!access) {
+                throw new Error(lt('드라이브 사용 권한을 받지 못했습니다. 권한 요청에서 허용을 눌러 주세요.', 'Drive permission was not granted. Please tap Allow in the permission request.'));
+            }
+            setToken(access);
+            setAccount({ email: result.profile && result.profile.email, name: result.profile && result.profile.name });
+            return account!;
+        }
+        if (!loginPromise) {
+            loginPromise = browserLogin().finally(() => {
+                loginPromise = undefined;
+            });
+        }
+        return await loginPromise;
+    } finally {
+        drive.resetCache();
+        emit('cloud:status', status());
+    }
+}
+
+export async function cloudLogout() {
+    await loadConfig();
+    const t = token && token.token;
+    setAccount(undefined);
+    drive.resetCache();
+    emit('cloud:status', status());
+    if (isNative()) {
+        try {
+            await ensureNative();
+            await SocialLogin.logout({ provider: 'google' });
+        } catch (e) {
+            // 이미 로그아웃된 상태
+        }
+    } else if (t) {
+        httpFn({
+            method: 'POST',
+            url: config!.revokeUrl || GOOGLE_DEFAULTS.revokeUrl,
+            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
+            body: formBody({ token: t }),
+        }).catch(() => undefined);
+    }
+}
+
+let driveInstance: DriveClient | undefined;
+export const drive = {
+    get client() {
+        if (!driveInstance) {
+            driveInstance = new DriveClient(httpFn, getAccessToken, config || {});
+        }
+        return driveInstance;
+    },
+    resetCache() {
+        driveInstance = undefined;
+    },
+};
+
+export async function driveClient() {
+    await loadConfig();
+    return drive.client;
+}
diff --git a/src/web/entryAccountWeb.ts b/src/web/entryAccountWeb.ts
new file mode 100644
index 00000000..ce767b48
--- /dev/null
+++ b/src/web/entryAccountWeb.ts
@@ -0,0 +1,251 @@
+import { lt } from '../common/localLang';
+import { registerPlugin } from '@capacitor/core';
+import {
+    EntryStatus,
+    EntryUser,
+    ENTRY_HOME_URL,
+    ENTRY_ORIGIN,
+    autoImportScript,
+    SHARE_SCRIPT,
+    entryProfileUrl,
+    entryWorkspaceUrl,
+    exportProjectScript,
+    isAllowedExternalUrl,
+    listProjectsScript,
+    normalizeEntryUser,
+    overwriteScript,
+} from '../common/entryAccount';
+import { isNative } from './platform';
+import { emit } from './bus';
+
+/**
+ * [entry-local/web] 엔트리 계정 — 안드로이드는 앱 안 플러그인(EntryAccountPlugin.java)이
+ * 엔트리 공식 로그인 페이지를 띄운다. 브라우저 미리보기에서는 지원하지 않는다(다른 사이트 정보를 읽을 수 없음).
+ */
+
+interface EntryAccountPlugin {
+    login(): Promise<{ user: EntryUser }>;
+    check(): Promise<{ user?: EntryUser | null; error?: string }>;
+    logout(): Promise<void>;
+    openUrl(options: { url: string }): Promise<void>;
+    setLang(options: { lang: string }): Promise<void>;
+    run(options: { url: string; script: string; timeoutMs?: number; keepWarm?: boolean }): Promise<{ json: string }>;
+    prewarm(options: { url: string }): Promise<void>;
+    openWorkspace(options: {
+        url: string;
+        ent: string;
+        fileName: string;
+        help: string;
+        projectId?: string;
+        importScript?: string;
+        overwriteScript?: string;
+        newUrl?: string;
+        texts?: { [key: string]: string };
+    }): Promise<{ projectId?: string; saved?: boolean; failed?: boolean }>;
+    share(options: { url: string; script: string }): Promise<{ shared?: boolean }>;
+    cancelSave(): Promise<void>;
+}
+
+const EntryAccount = registerPlugin<EntryAccountPlugin>('EntryAccount');
+
+/** 계정 저장 중 보여 주는 문구 (한 번 누르면 자동으로 끝까지 진행) */
+const savingText = () => lt('엔트리 계정에 저장하는 중…', 'Saving to your Entry account…');
+const saveTexts = () => ({
+    start: savingText(),
+    importing: savingText(),
+    saving: savingText(),
+    done: lt('저장했습니다.', 'Saved.'),
+});
+const KEY = 'entryLocalEntryAccount';
+
+let user: EntryUser | undefined = (() => {
+    try {
+        return normalizeEntryUser(JSON.parse(localStorage.getItem(KEY) || 'null'));
+    } catch (e) {
+        return undefined;
+    }
+})();
+
+function save(value?: EntryUser) {
+    user = value;
+    try {
+        if (value) {
+            localStorage.setItem(KEY, JSON.stringify(value));
+        } else {
+            localStorage.removeItem(KEY);
+        }
+    } catch (e) {
+        // 저장이 막힌 환경
+    }
+    emit('entry:status', entryStatus());
+}
+
+export function entryStatus(): EntryStatus {
+    return { loggedIn: !!user, user };
+}
+
+export async function entryLogin(): Promise<EntryUser> {
+    if (!isNative()) {
+        throw new Error(lt('엔트리 로그인은 설치한 앱(안드로이드·Windows)에서만 됩니다.', 'Entry login only works in the installed app (Android · Windows).'));
+    }
+    const res = await EntryAccount.login();
+    const found = normalizeEntryUser(res && res.user);
+    if (!found) {
+        throw new Error(lt('엔트리 계정 정보를 읽지 못했습니다.', 'Could not read the Entry account information.'));
+    }
+    save(found);
+    return found;
+}
+
+export async function entryLogout() {
+    save(undefined);
+    if (isNative()) {
+        await EntryAccount.logout().catch(() => undefined);
+    }
+}
+
+/** 앱 시작 후 한 번: 엔트리 세션이 아직 유효한지 조용히 확인 */
+let verified = false;
+export async function entryVerify(): Promise<EntryStatus> {
+    if (verified || !user || !isNative()) {
+        return entryStatus();
+    }
+    verified = true;
+    try {
+        const res = await EntryAccount.check();
+        if (res.error) {
+            verified = false; // 인터넷 문제: 상태 유지, 다음에 다시
+        } else {
+            save(normalizeEntryUser(res.user));
+        }
+    } catch (e) {
+        verified = false;
+    }
+    return entryStatus();
+}
+
+export function entryProfile() {
+    return user ? entryProfileUrl(user) : ENTRY_HOME_URL;
+}
+
+export async function openExternal(url: string) {
+    if (!isAllowedExternalUrl(url)) {
+        throw new Error(lt('열 수 없는 주소입니다.', 'This address cannot be opened.'));
+    }
+    if (isNative()) {
+        await EntryAccount.openUrl({ url });
+    } else {
+        window.open(url, '_blank', 'noopener');
+    }
+}
+
+/* ---------------- 엔트리 계정 작품 ---------------- */
+function requireUser(): EntryUser {
+    if (!isNative()) {
+        throw new Error(lt('엔트리 계정 기능은 설치한 앱(안드로이드·Windows)에서만 됩니다.', 'Entry account features only work in the installed app (Android · Windows).'));
+    }
+    if (!user) {
+        throw new Error(lt('엔트리 계정으로 로그인해 주세요.', 'Please log in with your Entry account.'));
+    }
+    return user;
+}
+
+async function run<T>(url: string, script: string, timeoutMs?: number, keepWarm?: boolean): Promise<T> {
+    try {
+        const res = await EntryAccount.run({ url, script, timeoutMs, keepWarm });
+        return JSON.parse(res.json) as T;
+    } catch (e) {
+        if ((e as any) && (e as any).code === 'SIGNED_OUT') {
+            save(undefined);
+        }
+        throw e;
+    }
+}
+
+export function entryListProjects(start = 0, display = 60) {
+    const me = requireUser();
+    return run<{ total: number; list: any[] }>(`${ENTRY_ORIGIN}/`, listProjectsScript(me.id, start, display), 30000);
+}
+
+/** 계정 작품을 .ent 로 받아 온다 → { name, bytes } */
+export async function entryDownloadProject(projectId: string, name: string) {
+    requireUser();
+    // [1.1] keepWarm: 받아 온 작업 화면을 앱 뒤에 그대로 두었다가 이 작품을 계정에 저장할 때 바로 쓴다
+    const r = await run<{ name: string; base64: string }>(entryWorkspaceUrl(projectId), exportProjectScript(name || lt('엔트리 작품', 'Entry project')), undefined, true);
+    const bin = atob(r.base64);
+    const bytes = new Uint8Array(bin.length);
+    for (let i = 0; i < bin.length; i++) {
+        bytes[i] = bin.charCodeAt(i);
+    }
+    return { name: r.name, bytes };
+}
+
+const ENT_FROM_APP = { expr: "(window.EntryLocalSave && EntryLocalSave.getEnt()) || ''" };
+
+/** 바이트 → base64 (큰 작품도 빠르게: 브라우저 내장 변환) */
+function toBase64(bytes: Uint8Array): Promise<string> {
+    return new Promise((resolve, reject) => {
+        const reader = new FileReader();
+        reader.onload = () => {
+            const url = String(reader.result || '');
+            resolve(url.slice(url.indexOf(',') + 1));
+        };
+        reader.onerror = () => reject(reader.error);
+        reader.readAsDataURL(new Blob([bytes]));
+    });
+}
+
+/** [1.1] 저장 메뉴를 열었을 때: 엔트리 작업 화면을 앱 뒤에 미리 불러 둔다 (저장을 빠르게) */
+export async function entryPrewarm(projectId?: string) {
+    if (!isNative() || !user) {
+        return;
+    }
+    const id = projectId && /^[0-9a-f]{24}$/i.test(projectId) ? projectId : undefined;
+    await EntryAccount.prewarm({ url: entryWorkspaceUrl(id) }).catch(() => undefined);
+}
+
+/** 반자동 저장 창 (엔트리 작업 화면 + 파일 선택 자동 입력) */
+export async function entrySaveViaSite(bytes: Uint8Array, options: { entryProjectId?: string; name: string }) {
+    requireUser();
+    const b64 = await toBase64(bytes);
+    // 계정에서 불러온(또는 이미 계정에 저장한) 작품이면 먼저 그 작품에 덮어쓰기를 시도한다
+    const target = options.entryProjectId && /^[0-9a-f]{24}$/i.test(options.entryProjectId) ? options.entryProjectId : '';
+    const res = await EntryAccount.openWorkspace({
+        url: target ? entryWorkspaceUrl(target) : entryWorkspaceUrl(),
+        newUrl: entryWorkspaceUrl(), // 덮어쓸 수 없으면: 오프라인 작품 불러오기로 계정에 새 작품을 만든다
+        ent: b64,
+        fileName: 'entry-local-project.ent', // 영문 이름 (작품 이름은 .ent 안에 들어 있음)
+        help: savingText(),
+        projectId: target || undefined,
+        // [1.1] 작품 파일은 한 번만 보낸다 — 스크립트는 페이지 안에서 EntryLocalSave.getEnt() 로 받아 간다
+        overwriteScript: target ? overwriteScript(ENT_FROM_APP, target) : '',
+        importScript: autoImportScript(ENT_FROM_APP),
+        texts: saveTexts(),
+    });
+    return {
+        projectId: (res && res.projectId) || options.entryProjectId || undefined,
+        saved: !!(res && res.saved),
+        failed: !!(res && res.failed),
+    };
+}
+
+/** 진행 중인 계정 저장 멈추기 (대기 창의 [취소]) */
+export async function entryCancelSave() {
+    if (isNative()) {
+        await EntryAccount.cancelSave().catch(() => undefined);
+    }
+}
+
+/** 화면 언어를 안드로이드 플러그인에 알림 (창 제목·오류 문구용) */
+export async function entrySetLang(lang?: string) {
+    if (isNative()) {
+        await EntryAccount.setLang({ lang: lang === 'ko' || !lang ? 'ko' : 'en' }).catch(() => undefined);
+    }
+}
+
+/** [작품 공유하기] — 엔트리 작업 화면에서 엔트리 자체의 '작품 공유하기' 패널을 연다 */
+export async function entryShare(projectId: string) {
+    requireUser();
+    const res = await EntryAccount.share({ url: entryWorkspaceUrl(projectId), script: SHARE_SCRIPT });
+    return { shared: !!(res && res.shared) };
+}
