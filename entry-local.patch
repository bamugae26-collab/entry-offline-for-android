+
+type ReplaceStrategy = (fileUrl: string) => string | undefined;
+
+const replaceStrategy: { [key: string]: ReplaceStrategy } = {
+    fromExternal(fileUrl) {
+        let result = fileUrl.replace(/%5C/gi, '\\').replace(/\\/g, '/');
+        const asTemp = vfs().relFromUrl(result);
+        if (asTemp) {
+            return vfs().url(asTemp);
+        }
+        result = result.replace(/.*\/\//, ''); // 외부 접속 프로토콜 스키마 보안 대응 (원본과 동일)
+        if (result.startsWith('./bower_components')) {
+            result = result.replace('./bower_components', '../../../node_modules').replace('entryjs', 'entry-js');
+        } else if (result.startsWith('/lib')) {
+            result = result.replace('/lib', '../../../node_modules');
+        } else if (result.indexOf('temp') > -1) {
+            result = vfs().url(normalize(result.substring(result.indexOf('temp'))));
+        } else if (result.match('/node_modules/@entrylabs/entry') !== null) {
+            result = result.replace('/node_modules/@entrylabs/entry', '../../../node_modules/entry-js');
+        }
+        return result;
+    },
+    toExternal(fileUrl) {
+        const rel = vfs().relFromUrl(fileUrl);
+        if (rel) {
+            return rel;
+        }
+        let result = fileUrl;
+        if (result.startsWith('renderer')) {
+            result = result.replace('renderer', '.');
+        } else if (result.startsWith('../../../node_modules')) {
+            result = result.replace('../../../node_modules', './bower_components');
+        } else if (result.match('/node_modules/@entrylabs/entry') !== null) {
+            result = result.replace('/node_modules/@entrylabs/entry', './bower_components');
+        }
+        return result
+            .substring(result.indexOf('temp'))
+            .replace(/\\/gi, '/')
+            .replace(/.*\/\//, '');
+    },
+    toExternalDeleteUrl(fileUrl) {
+        let result: string | undefined = fileUrl;
+        if (vfs().relFromUrl(fileUrl)) {
+            return undefined;
+        }
+        result = result.replace(/.*\/\//, '');
+        if (result.startsWith('renderer')) {
+            result = result.replace('renderer', '.');
+        } else if (result.startsWith('../../../node_modules')) {
+            result = result.replace('../../../node_modules', './bower_components');
+        } else {
+            result = undefined;
+        }
+        return result;
+    },
+};
+
+function changeObjectsPath(objects: any[] = [], strategy: ReplaceStrategy) {
+    objects.forEach((object) => {
+        if (!object.sprite) {
+            return;
+        }
+        const { pictures = [], sounds = [] } = object.sprite;
+        pictures.forEach((picture: any) => {
+            if (!picture.fileurl) {
+                return;
+            }
+            picture.fileurl = strategy(picture.fileurl);
+            if (picture.thumbUrl) {
+                picture.thumbUrl = strategy(picture.thumbUrl);
+            }
+        });
+        sounds.forEach((sound: any) => {
+            if (!sound.fileurl) {
+                return;
+            }
+            sound.fileurl = strategy(sound.fileurl);
+        });
+    });
+}
+
+/* ------------------------------------------------------------------ */
+/* 공용 입출력                                                         */
+/* ------------------------------------------------------------------ */
+async function fetchBytes(url: string): Promise<Uint8Array> {
+    const res = await fetch(new URL(url, location.href).toString(), { cache: 'no-store' });
+    if (!res.ok) {
+        throw new Error(`not found: ${url}`);
+    }
+    return new Uint8Array(await res.arrayBuffer());
+}
+
+async function urlExists(url: string) {
+    try {
+        const res = await fetch(new URL(url, location.href).toString(), { method: 'HEAD' });
+        return res.ok;
+    } catch (e) {
+        return false;
+    }
+}
+
+/** '경로 문자열' 을 읽는다: pick://(사용자 파일), VFS URL, temp/…(VFS), 그 밖은 앱 안 URL */
+async function readAnyPath(path: string): Promise<{ bytes: Uint8Array; name: string; type: string }> {
+    if (path.startsWith(PICK)) {
+        return readPicked(path);
+    }
+    const name = basename(path);
+    const rel = vfs().relFromUrl(path) || (/^(temp|projects|uploads|backpack)\//.test(normalize(path)) ? normalize(path) : '');
+    const bytes = rel ? await vfs().read(rel) : await fetchBytes(path);
+    return { bytes, name, type: mimeOf(name) };
+}
+
+/** 저장 대상 경로에 쓴다: save://(사용자에게 내보내기) 또는 VFS 상대경로 */
+async function writeTarget(target: string, data: Uint8Array, mime?: string) {
+    if (isSavePath(target)) {
+        await deliverToUser(saveTargetName(target), data, mime);
+    } else {
+        await vfs().write(normalize(target), data);
+    }
+}
+
+let saveQueue: Promise<unknown> = Promise.resolve();
+function serialize<T>(job: () => Promise<T>): Promise<T> {
+    const next = saveQueue.then(job, job);
+    saveQueue = next.catch(() => undefined);
+    return next;
+}
+
+/* ------------------------------------------------------------------ */
+/* 프로젝트 (.ent)                                                     */
+/* ------------------------------------------------------------------ */
+async function resetSaveDirectory() {
+    await vfs().remove('temp');
+}
+
+async function packProject(project: any): Promise<Uint8Array> {
+    changeObjectsPath(project.objects, replaceStrategy.toExternal);
+    await vfs().write('temp/project.json', JSON.stringify(project));
+    const files = await vfs().listFiles('temp');
+    const entries: TarEntry[] = [];
+    for (const file of files) {
+        entries.push({ path: file, data: await vfs().read(file) });
+    }
+    return packTarGz(entries);
+}
+
+async function saveProject(project: any, destination: string) {
+    if (!/\.ent$/i.test(destination)) {
+        throw new Error('.ent only accepted');
+    }
+    const bytes = await packProject(project);
+    await writeTarget(destination, bytes, 'application/octet-stream');
+}
+
+async function loadProjectBytes(bytes: Uint8Array, savedPath: string) {
+    const entries = unpackTarGz(bytes);
+    const projectEntry = entries.find((e) => normalize(e.path) === 'temp/project.json');
+    if (!projectEntry) {
+        throw new Error('project.json not found');
+    }
+    const project = JSON.parse(new TextDecoder().decode(projectEntry.data));
+    if (project.objects && project.objects[0] && String(project.objects[0].script).substr(0, 4) === '<xml') {
+        throw new Error(lt('아주 오래된(XML) 엔트리 작품은 안드로이드판에서 열 수 없습니다. PC판에서 한 번 저장한 뒤 열어 주세요.', 'Very old (XML) Entry projects cannot be opened in the Android version. Please save it once in the PC version, then open it.'));
+    }
+
+    await resetSaveDirectory();
+    for (const entry of entries) {
+        const path = normalize(entry.path);
+        if (path.startsWith('temp/')) {
+            await vfs().write(path, entry.data);
+        }
+    }
+    changeObjectsPath(project.objects, replaceStrategy.fromExternal);
+    project.savedPath = savedPath;
+    return project;
+}
+
+async function loadProject(filePath: string) {
+    const { bytes } = await readAnyPath(filePath);
+    return loadProjectBytes(bytes, filePath);
+}
+
+/* ------------------------------------------------------------------ */
+/* 그림                                                                */
+/* ------------------------------------------------------------------ */
+type ImageSource = { bytes: Uint8Array; name: string; ext: string };
+
+async function importPictureToTemp(
+    source: ImageSource,
+    extra: { thumbnail?: Uint8Array; svg?: Uint8Array } = {}
+) {
+    const ext = source.ext || '.png';
+    const originalName = basename(source.name, extname(source.name));
+    const newFileId = createFileId();
+    let imageType = 'png';
+
+    const img = await bytesToImage(source.bytes, mimeOf(`x${ext}`));
+    const dimension = imageDimension(img);
+    const picturePath = join(P.tempImage(newFileId), `${newFileId}${ext}`);
+    await vfs().write(picturePath, source.bytes);
+
+    const thumbPath = join(P.tempThumb(newFileId), `${newFileId}${ext}`);
+    await vfs().write(thumbPath, extra.thumbnail || (await resizeToPng(img, ImageResizeSize.thumbnail)));
+
+    if (extra.svg) {
+        imageType = 'svg';
+        await vfs().write(join(P.tempImage(newFileId), `${newFileId}.svg`), extra.svg);
+    }
+
+    return {
+        _id: generateHash(),
+        id: generateHash(),
+        type: 'user',
+        name: originalName,
+        filename: newFileId,
+        fileurl: vfs().url(picturePath),
+        extension: ext,
+        dimension,
+        imageType,
+    };
+}
+
+async function importPicturesToTemp(filePaths: string[]) {
+    const results = [];
+    for (const filePath of filePaths) {
+        const { bytes, name, type } = await readAnyPath(filePath);
+        const isSvg = type.includes('svg');
+        const png = await convertToPng(bytes, type);
+        const pngName = `${basename(name, extname(name))}.png`;
+        results.push(
+            await importPictureToTemp(
+                { bytes: png, name: pngName, ext: '.png' },
+                isSvg ? { svg: bytes } : {}
+            )
+        );
+    }
+    return results;
+}
+
+async function importPicturesFromResource(pictures: any[]) {
+    return Promise.all(
+        pictures.map(async (picture) => {
+            const ext = picture.ext || '.png';
+            const fileName = picture.filename + ext;
+            const image = await fetchBytes(P.resImage(picture.filename) + fileName);
+            let thumbnail: Uint8Array | undefined;
+            try {
+                thumbnail = await fetchBytes(P.resThumb(picture.filename) + fileName);
+            } catch (e) {
+                thumbnail = undefined;
+            }
+            let svg: Uint8Array | undefined;
+            if (picture.imageType === 'svg') {
+                svg = await fetchBytes(`${P.resImage(picture.filename)}${picture.filename}.svg`);
+            }
+            const created = await importPictureToTemp({ bytes: image, name: fileName, ext }, { thumbnail, svg });
+            picture.filename = created.filename;
+            picture.fileurl = created.fileurl;
+            return picture;
+        })
+    );
+}
+
+async function importPictureFromCanvas(data: any) {
+    const { file, image } = data;
+    const { prevFilename, mode, svg, ext = 'png' } = file;
+    const pictureId = createFileId();
+    const bytes: Uint8Array = image instanceof Uint8Array ? image : new Uint8Array(image);
+
+    const imagePath = join(P.tempImage(pictureId), `${pictureId}.png`);
+    const thumbnailPath = join(P.tempThumb(pictureId), `${pictureId}.png`);
+    const img = await bytesToImage(bytes, 'image/png');
+
+    await vfs().write(imagePath, bytes);
+    await vfs().write(thumbnailPath, await resizeToPng(img, ImageResizeSize.thumbnail));
+    if (svg) {
+        await vfs().write(join(P.tempImage(pictureId), `${pictureId}.svg`), svg);
+    }
+
+    if (prevFilename && mode === 'edit') {
+        await Promise.all([
+            vfs().remove(join(P.tempImage(prevFilename), `${prevFilename}.${ext}`)),
+            vfs().remove(join(P.tempThumb(prevFilename), `${prevFilename}.png`)),
+            svg ? vfs().remove(join(P.tempImage(prevFilename), `${prevFilename}.png`)) : undefined,
+        ]);
+    }
+
+    return {
+        type: 'user',
+        name: pictureId,
+        filename: pictureId,
+        fileurl: vfs().url(imagePath),
+        dimension: imageDimension(img),
+        imageType: ext,
+    };
+}
+
+/* ------------------------------------------------------------------ */
+/* 소리                                                                */
+/* ------------------------------------------------------------------ */
+async function importSoundBytesToTemp(bytes: Uint8Array, name: string) {
+    const ext = extname(name) || '.mp3';
+    const originalName = basename(name, ext);
+    const newFileId = createFileId();
+    const soundPath = join(P.tempSound(newFileId), `${newFileId}${ext}`);
+    await vfs().write(soundPath, bytes);
+    const url = vfs().url(soundPath);
+    return {
+        _id: generateHash(),
+        type: 'user',
+        name: originalName,
+        filename: newFileId,
+        ext,
+        fileurl: url,
+        path: url,
+        duration: await soundDuration(bytes, mimeOf(name)),
+    };
+}
+
+async function importSoundsToTemp(filePaths: string[]) {
+    const results = [];
+    for (const filePath of filePaths) {
+        const { bytes, name } = await readAnyPath(filePath);
+        results.push(await importSoundBytesToTemp(bytes, name));
+    }
+    return results;
+}
+
+/** uploads/ab/cd/ 바로 아래에 있는 소리 파일 목록 (assemble-www.js 가 만든다) */
+let flatSounds: Promise<Set<string> | undefined> | undefined;
+function getFlatSounds() {
+    if (!flatSounds) {
+        flatSounds = fetchBytes(`${RESOURCE_UPLOADS}flat-sounds.json`)
+            .then((bytes) => new Set<string>(JSON.parse(new TextDecoder().decode(bytes))))
+            .catch(() => undefined);
+    }
+    return flatSounds;
+}
+
+async function resourceSoundUrl(sound: { filename: string; ext?: string }) {
+    const fileName = sound.filename + (sound.ext || '.mp3');
+    const primary = P.resSound(sound.filename) + fileName;
+    const alternative = `${P.resSound(sound.filename)}sound/${fileName}`;
+    const flat = await getFlatSounds();
+    if (flat) {
+        return flat.has(fileName) ? primary : alternative;
+    }
+    return (await urlExists(primary)) ? primary : alternative;
+}
+
+async function importSoundsFromResource(sounds: any[]) {
+    return Promise.all(
+        sounds.map(async (sound) => {
+            const url = await resourceSoundUrl(sound);
+            const created = await importSoundBytesToTemp(await fetchBytes(url), basename(url));
+            sound.filename = created.filename;
+            sound.fileurl = created.fileurl;
+            return sound;
+        })
+    );
+}
+
+async function saveSoundBuffer(buffer: ArrayBuffer, prevFileUrl: string) {
+    if (buffer.byteLength > 30 * 1024 * 1024) {
+        throw new Error('413: too large buffer size');
+    }
+    const { mp3, duration } = await wavToMp3(buffer);
+    const filename = createFileId();
+    const filePath = join(P.tempSound(filename), `${filename}.mp3`);
+    await vfs().write(filePath, mp3);
+    try {
+        const prev = prevFileUrl && (vfs().relFromUrl(prevFileUrl) || (normalize(prevFileUrl).startsWith('temp/') ? normalize(prevFileUrl) : ''));
+        if (prev) {
+            await vfs().remove(prev);
+        }
+    } catch (e) {
+        console.warn('sound file unlink fail', e);
+    }
+    return { duration: duration.toFixed(1), filename, filePath: vfs().url(filePath) };
+}
+
+/* ------------------------------------------------------------------ */
+/* 오브젝트 (.eo)                                                      */
+/* ------------------------------------------------------------------ */
+async function exportObject(filePath: string, object: any) {
+    const { objects } = object;
+    changeObjectsPath(objects, replaceStrategy.toExternalDeleteUrl);
+    const entries: TarEntry[] = [];
+
+    for (const obj of object.objects) {
+        for (const sound of obj.sprite.sounds) {
+            if (defaultSoundPath.includes(sound.fileurl)) {
+                continue;
+            }
+            const ext = sanitizeExtension(sound.ext, '.mp3');
+            const newId = createFileId();
+            const data = await vfs().read(join(P.tempSound(sound.filename), `${sound.filename}${ext}`));
+            entries.push({ path: join('object', sub(newId), 'sound', `${newId}${ext}`), data });
+            sound.filename = newId;
+        }
+        for (const picture of obj.sprite.pictures) {
+            if (defaultPicturePath.includes(picture.fileurl)) {
+                continue;
+            }
+            const ext = sanitizeExtension(picture.ext, '.png');
+            const id = picture.filename;
+            const newId = createFileId();
+            entries.push({
+                path: join('object', sub(newId), 'image', `${newId}${ext}`),
+                data: await vfs().read(join(P.tempImage(id), `${id}${ext}`)),
+            });
+            entries.push({
+                path: join('object', sub(newId), 'thumb', `${newId}${ext}`),
+                data: await vfs().read(join(P.tempThumb(id), `${id}${ext}`)),
+            });
+            if (picture.imageType === 'svg') {
+                entries.push({
+                    path: join('object', sub(newId), 'image', `${newId}.svg`),
+                    data: await vfs().read(join(P.tempImage(id), `${id}.svg`)),
+                });
+            }
+            picture.filename = newId;
+        }
+    }
+    entries.unshift({ path: 'object/object.json', data: new TextEncoder().encode(JSON.stringify(object)) });
+    await writeTarget(filePath, packTarGz(entries));
+    return filePath;
+}
+
+async function importObject(objectPath: string) {
+    const { bytes } = await readAnyPath(objectPath);
+    const files = new Map<string, Uint8Array>();
+    unpackTarGz(bytes).forEach((e) => files.set(normalize(e.path), e.data));
+    const json = files.get('object/object.json');
+    if (!json) {
+        throw new Error('object.json not found');
+    }
+    const objectResult = JSON.parse(new TextDecoder().decode(json));
+    const get = (path: string) => files.get(normalize(path));
+
+    for (const object of objectResult.objects) {
+        const { sprite = {} } = object;
+        const { pictures = [], sounds = [] } = sprite;
+
+        const newPictures = [];
+        for (const picture of pictures) {
+            if (defaultPicturePath.includes(picture.fileurl)) {
+                if (picture.id === object.selectedPictureId) {
+                    object.selectedPicture = picture;
+                }
+                newPictures.push(picture);
+                continue;
+            }
+            const ext = sanitizeExtension(picture.ext, '.png');
+            const base = join('object', sub(picture.filename));
+            const image = get(join(base, 'image', `${picture.filename}${ext}`));
+            if (!image) {
+                continue;
+            }
+            const newPicture: any = await importPictureToTemp(
+                { bytes: image, name: `${picture.filename}${ext}`, ext },
+                {
+                    thumbnail: get(join(base, 'thumb', `${picture.filename}${ext}`)),
+                    svg: picture.imageType === 'svg' ? get(join(base, 'image', `${picture.filename}.svg`)) : undefined,
+                }
+            );
+            newPicture.name = picture.name;
+            newPicture.id = picture.id;
+            if (picture.id === object.selectedPictureId) {
+                object.selectedPicture = newPicture;
+                object.selectedPictureId = newPicture.id;
+            }
+            newPictures.push(newPicture);
+        }
+
+        const newSounds = [];
+        for (const sound of sounds) {
+            if (defaultSoundPath.includes(sound.fileurl)) {
+                newSounds.push(sound);
+                continue;
+            }
+            const ext = sanitizeExtension(sound.ext, '.mp3');
+            const data = get(join('object', sub(sound.filename), 'sound', `${sound.filename}${ext}`));
+            if (!data) {
+                continue;
+            }
+            const newSound: any = await importSoundBytesToTemp(data, `${sound.filename}${ext}`);
+            newSound.name = sound.name;
+            newSound.id = sound.id;
+            newSounds.push(newSound);
+        }
+
+        object.sprite.pictures = newPictures;
+        object.sprite.sounds = newSounds;
+        changeObjectsPath([object], replaceStrategy.fromExternal);
+    }
+    return objectResult;
+}
+
+async function importObjectsFromResource(objects: any[]) {
+    return Promise.all(
+        objects.map(async (object) => {
+            const { pictures = [], sounds = [] } = object;
+            object.pictures = await importPicturesFromResource(pictures);
+            object.sounds = await importSoundsFromResource(sounds);
+            return object;
+        })
+    );
+}
+
+/* ------------------------------------------------------------------ */
+/* 데이터 테이블 (csv, xlsx)                                           */
+/* ------------------------------------------------------------------ */
+const tables: { [hash: string]: any } = {};
+
+async function makeTableInfo(filePath: string) {
+    try {
+        const { bytes, name } = await readAnyPath(filePath);
+        const ext = extname(name).replace('.', '').toLowerCase();
+        if (!['csv', 'xlsx', 'xls'].includes(ext)) {
+            throw new Error(`invalid type: ${ext}`);
+        }
+        const workbook =
+            ext === 'csv'
+                ? XLSX.read(new TextDecoder().decode(bytes), { type: 'string', raw: true })
+                : XLSX.read(bytes, { type: 'array' });
+        const sheet = workbook.Sheets[workbook.SheetNames[0]];
+        const rows: string[][] = (XLSX.utils.sheet_to_json(sheet, { header: 1, raw: false, defval: '' }) as any[][]).map(
+            (row) => row.map((cell) => (cell === undefined || cell === null ? '' : String(cell)))
+        );
+        const hashId = createFileId();
+        tables[hashId] = {
+            chart: [],
+            fields: rows.shift() || [],
+            rows: rows.length,
+            data: rows,
+            name,
+        };
+        return { id: hashId, name };
+    } catch (e) {
+        console.warn('getTable error', e);
+    }
+}
+
+function saveExcel(filePath: string, array: any[]) {
+    const sheet = XLSX.utils.aoa_to_sheet(array.map((v) => [String(v)]));
+    const book = XLSX.utils.book_new();
+    XLSX.utils.book_append_sheet(book, sheet, 'sheet1');
+    const out = XLSX.write(book, { type: 'array', bookType: 'xlsx' });
+    return writeTarget(filePath, new Uint8Array(out), 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet');
+}
+
+/* ------------------------------------------------------------------ */
+/* 내보내기·다운로드                                                   */
+/* ------------------------------------------------------------------ */
+async function tempResourceDownload(entryObject: any, type: string, targetFilePath: string) {
+    let source = '';
+    if (entryObject.fileurl) {
+        source = entryObject.fileurl;
+        if (source.startsWith('renderer')) {
+            source = `../../${source}`;
+        }
+    } else if (type === 'image') {
+        source = join(P.tempImage(entryObject.filename), `${entryObject.filename}${sanitizeExtension(entryObject.ext || entryObject.extension, 'png')}`);
+    } else if (type === 'sound') {
+        source = join(P.tempSound(entryObject.filename), `${entryObject.filename}${sanitizeExtension(entryObject.ext || entryObject.extension, 'mp3')}`);
+    }
+    if (!source) {
+        throw new Error('invalid Type');
+    }
+    const { bytes } = await readAnyPath(source);
+    await writeTarget(targetFilePath, bytes);
+}
+
+async function staticDownload(unresolved: string[], targetFilePath: string) {
+    try {
+        const bytes = await fetchBytes(`${APP_ROOT}src/main/static/${unresolved.join('/')}`);
+        await writeTarget(targetFilePath, bytes);
+    } catch (e) {
+        console.error(e);
+    }
+}
+
+async function writeFile(data: any, filePath: string) {
+    const bytes =
+        typeof data === 'string'
+            ? new TextEncoder().encode(data)
+            : data instanceof Uint8Array
+            ? data
+            : new Uint8Array(data);
+    await writeTarget(filePath, bytes);
+}
+
+async function captureBlockImage(images: any[], filePath: string) {
+    const FREE_SPACE = 25;
+    for (let index = 0; index < images.length; index++) {
+        const { width, height, data } = images[index];
+        const svgUrl = URL.createObjectURL(new Blob([data], { type: 'image/svg+xml' }));
+        try {
+            const img = await loadImage(svgUrl);
+            const canvas = document.createElement('canvas');
+            canvas.width = Math.ceil(width) + FREE_SPACE;
+            canvas.height = Math.ceil(height) + FREE_SPACE;
+            canvas.getContext('2d')!.drawImage(img, 0, 0);
+            const blob: Blob = await new Promise((r) => canvas.toBlob((b) => r(b!), 'image/png'));
+            const name = isSavePath(filePath) ? `block${index}.png` : `${filePath}${index}.png`;
+            await deliverToUser(basename(name), blob, 'image/png');
+        } finally {
+            URL.revokeObjectURL(svgUrl);
+        }
+    }
+}
+
+/* ------------------------------------------------------------------ */
+/* 내부 저장소 (내 작품) — main/localProjectStore.ts 이식               */
+/* ------------------------------------------------------------------ */
+const ID_PATTERN = /^[a-z0-9]+$/i;
+const STORE = 'projects';
+const INDEX = 'projects/index.json';
+
+const storeFile = (id: string) => {
+    if (!ID_PATTERN.test(id)) {
+        throw new Error(`invalid project id: ${id}`);
+    }
+    return `${STORE}/${id}.ent`;
+};
+
+async function readIndex(): Promise<LocalProjectMeta[]> {
+    try {
+        if (!(await vfs().exists(INDEX))) {
+            return [];
+        }
+        const list = JSON.parse(await vfs().readText(INDEX));
+        return Array.isArray(list) ? list : [];
+    } catch (e) {
+        console.error('index read failed', e);
+        const files = (await vfs().listFiles(STORE)).filter((f) => f.endsWith('.ent'));
+        const now = Date.now();
+        const list = files.map((f) => {
+            const id = basename(f, '.ent');
+            return { id, name: id, createdAt: now, updatedAt: now };
+        });
+        await writeIndex(list);
+        return list;
+    }
+}
+
+async function writeIndex(list: LocalProjectMeta[]) {
+    await vfs().write(`${INDEX}.tmp`, JSON.stringify(list));
+    await vfs().move(`${INDEX}.tmp`, INDEX);
+}
+
+const store = {
+    dir: () => lt('앱 내부 저장소 (다른 앱에서 접근 불가)', 'App internal storage (not accessible by other apps)'),
+    async list() {
+        const list = await readIndex();
+        const files = new Set(await vfs().listFiles(STORE));
+        const alive = list.filter((m) => files.has(storeFile(m.id)));
+        if (alive.length !== list.length) {
+            await writeIndex(alive);
+        }
+        return alive.sort((a, b) => b.updatedAt - a.updatedAt);
+    },
+    save(project: any, options: { id?: string; name: string; thumbnail?: string }) {
+        return serialize(async () => {
+            const list = await readIndex();
+            const id = options.id && ID_PATTERN.test(options.id) ? options.id : createFileId();
+            const target = storeFile(id);
+            const tmp = `${target}.tmp.ent`;
+            await saveProject(project, tmp);
+            await vfs().move(tmp, target);
+            const now = Date.now();
+            const prev = list.find((m) => m.id === id);
+            const meta: LocalProjectMeta = {
+                id,
+                name: options.name || (prev && prev.name) || id,
+                createdAt: (prev && prev.createdAt) || now,
+                updatedAt: now,
+                thumbnail: options.thumbnail || (prev && prev.thumbnail),
+            };
+            await writeIndex([meta, ...list.filter((m) => m.id !== id)]);
+            return meta;
+        });
+    },
+    load(id: string) {
+        return serialize(async () => {
+            const project = await loadProjectBytes(await vfs().read(storeFile(id)), storeFile(id));
+            const meta = (await readIndex()).find((m) => m.id === id);
+            project.localProjectId = id;
+            if (meta) {
+                project.name = meta.name;
+            }
+            return project;
+        });
+    },
+    remove(id: string) {
+        return serialize(async () => {
+            await vfs().remove(storeFile(id));
+            await writeIndex((await readIndex()).filter((m) => m.id !== id));
+        });
+    },
+    rename(id: string, name: string) {
+        return serialize(async () => {
+            const list = await readIndex();
+            const meta = list.find((m) => m.id === id);
+            if (meta) {
+                meta.name = name;
+                await writeIndex(list);
+            }
+            return meta;
+        });
+    },
+    duplicate(id: string) {
+        return serialize(async () => {
+            const list = await readIndex();
+            const source = list.find((m) => m.id === id);
+            if (!source) {
+                throw new Error(`project not found: ${id}`);
+            }
+            const newId = createFileId();
+            await vfs().copy(storeFile(id), storeFile(newId));
+            const now = Date.now();
+            const meta = { ...source, id: newId, name: lt(`${source.name} 복사본`, `${source.name} copy`), createdAt: now, updatedAt: now };
+            await writeIndex([meta, ...list]);
+            return meta;
+        });
+    },
+    async exportTo(id: string, destination: string) {
+        await writeTarget(destination.endsWith('.ent') ? destination : `${destination}.ent`, await vfs().read(storeFile(id)));
+    },
+};
+
+/* ------------------------------------------------------------------ */
+/* 구글 드라이브 (cloudWeb.ts 의 로그인 + 공용 DriveClient)            */
+/* ------------------------------------------------------------------ */
+const cloud = {
+    save(project: any, options: { fileId?: string; name: string; thumbnail?: string }) {
+        return serialize(async () => {
+            const bytes = await packProject(project);
+            const client = await driveClient();
+            try {
+                return await client.upload(bytes, options);
+            } catch (e) {
+                if (options.fileId && (e as any).status === 404) {
+                    return client.upload(bytes, { ...options, fileId: undefined });
+                }
+                throw e;
+            }
+        });
+    },
+    load(fileId: string) {
+        return serialize(async () => {
+            const client = await driveClient();
+            const [bytes, name] = await Promise.all([client.download(fileId), client.getName(fileId)]);
+            const project = await loadProjectBytes(bytes, `drive:${fileId}`);
+            project.cloudFileId = fileId;
+            project.name = name || project.name;
+            delete project.savedPath;
+            return project;
+        });
+    },
+    async exportTo(fileId: string, destination: string) {
+        const client = await driveClient();
+        await writeTarget(destination.endsWith('.ent') ? destination : `${destination}.ent`, await client.download(fileId));
+    },
+};
+
+/* ------------------------------------------------------------------ */
+/* 채널 등록                                                           */
+/* ------------------------------------------------------------------ */
+Object.assign(handlers, {
+    saveProject: (project: any, targetPath: string) => serialize(() => saveProject(project, targetPath)),
+    loadProject: (filePath: string) => serialize(() => loadProject(filePath)),
+    resetDirectory: () => serialize(resetSaveDirectory),
+    exportObject,
+    importObjects: async (paths: string[]) => (paths && paths.length ? Promise.all(paths.map(importObject)) : []),
+    importObjectsFromResource: (objects: any[]) => (objects && objects.length ? importObjectsFromResource(objects) : []),
+    importPictures: (paths: string[]) => (paths && paths.length ? importPicturesToTemp(paths) : []),
+    importPicturesFromResource,
+    importPictureFromCanvas,
+    captureBlockImage,
+    importSounds: (paths: string[]) => (paths && paths.length ? importSoundsToTemp(paths) : []),
+    importSoundsFromResource,
+    createTableInfo: (paths: string[]) => Promise.all(paths.map(makeTableInfo)),
+    getTable: (hashId: string) => tables[hashId],
+    staticDownload,
+    tempResourceDownload,
+    saveExcel,
+    writeFile,
+    openUrl: (url: string) => window.open(url, '_blank'),
+    checkUpdate: () => ['', { hasNewVersion: false, version: '0.0.0' }],
+    quit: () => undefined,
+    checkPermission: () => undefined,
+    getOpenSourceText: () => '',
+    isValidAsarFile: () => true,
+    saveSoundBuffer,
+    getExistSoundFilePath: resourceSoundUrl,
+    getPapagoHeaderInfo: () => null,
+    'localStore:dir': store.dir,
+    'localStore:list': () => store.list(),
+    'localStore:save': (project: any, options: any) => store.save(project, options),
+    'localStore:load': (id: string) => store.load(id),
+    'localStore:remove': (id: string) => store.remove(id),
+    'localStore:rename': (id: string, name: string) => store.rename(id, name),
+    'localStore:duplicate': (id: string) => store.duplicate(id),
+    'localStore:export': (id: string, destination: string) => store.exportTo(id, destination),
+    'cloud:status': () => cloudStatus(),
+    'cloud:login': () => cloudLogin(),
+    'cloud:logout': () => cloudLogout(),
+    'cloud:list': async () => (await driveClient()).list(),
+    'cloud:save': (project: any, options: any) => cloud.save(project, options),
+    'cloud:load': (fileId: string) => cloud.load(fileId),
+    'cloud:rename': async (fileId: string, name: string) => (await driveClient()).rename(fileId, name),
+    'cloud:remove': async (fileId: string) => (await driveClient()).trash(fileId),
+    'cloud:thumbnail': async (link: string) => (await driveClient()).thumbnail(link),
+    'cloud:export': (fileId: string, destination: string) => cloud.exportTo(fileId, destination),
+    'cloud:folderUrl': async () => `https://drive.google.com/drive/folders/${await (await driveClient()).ensureFolder()}`,
+    // [entry-local] 엔트리 계정
+    'entry:status': () => entryStatus(),
+    'entry:verify': () => entryVerify(),
+    'entry:login': () => entryLogin(),
+    'entry:logout': () => entryLogout(),
+    'entry:profileUrl': () => entryProfile(),
+    'app:openExternal': (url: string) => openExternal(url),
+    'entry:base': () => 'https://playentry.org',
+    'entry:projects': (start: number, display: number) => entryListProjects(start, display),
+    'entry:load': (projectId: string, name: string) =>
+        serialize(async () => {
+            const { name: realName, bytes } = await entryDownloadProject(projectId, name);
+            const project = await loadProjectBytes(bytes, `entry:${projectId}`);
+            project.entryProjectId = projectId;
+            project.name = realName || name || project.name;
+            delete project.savedPath;
+            delete project.cloudFileId;
+            return project;
+        }),
+    'entry:share': (projectId: string) => entryShare(projectId),
+    'entry:cancelSave': () => entryCancelSave(),
+    'entry:prewarm': (projectId?: string) => entryPrewarm(projectId),
+    // [entry-local] 나의 보관함 (앱 저장소 backpack/ 에 저장 — Windows 의 backpackStore.ts 와 같은 형식)
+    'backpack:list': () => serialize(backpackIndex),
+    'backpack:add': (meta: { type: 'block' | 'object'; title: string; imgPath?: string }, item: any) =>
+        serialize(async () => {
+            const id = createFileId();
+            if (meta.type === 'object') {
+                await exportObject(backpackFile(id, 'object'), item);
+            } else {
+                await vfs().write(backpackFile(id, 'block'), JSON.stringify(item));
+            }
+            const entry = { _id: id, type: meta.type, title: meta.title || '', imgPath: meta.imgPath, created: Date.now() };
+            await vfs().write(BACKPACK_INDEX, JSON.stringify([entry, ...(await backpackIndex())]));
+            return entry;
+        }),
+    'backpack:get': (id: string) =>
+        serialize(async () => {
+            const meta = (await backpackIndex()).find((m: any) => m._id === id);
+            if (!meta) {
+                return undefined;
+            }
+            if (meta.type === 'object') {
+                return { type: meta.type, item: await importObject(backpackFile(id, 'object')) };
+            }
+            return { type: meta.type, item: JSON.parse(await vfs().readText(backpackFile(id, 'block'))) };
+        }),
+    'backpack:rename': (id: string, title: string) =>
+        serialize(async () => {
+            const list = await backpackIndex();
+            const meta = list.find((m: any) => m._id === id);
+            if (meta) {
+                meta.title = String(title || '').slice(0, 45);
+                await vfs().write(BACKPACK_INDEX, JSON.stringify(list));
+            }
+        }),
+    'backpack:remove': (id: string) =>
+        serialize(async () => {
+            const list = await backpackIndex();
+            const meta = list.find((m: any) => m._id === id);
+            if (meta) {
+                await vfs().remove(backpackFile(id, meta.type)).catch(() => undefined);
+                await vfs().write(BACKPACK_INDEX, JSON.stringify(list.filter((m: any) => m._id !== id)));
+            }
+        }),
+    'entryLocal:setLang': (lang: string) => {
+        setSerialLang(lang);
+        setBluetoothLang(lang);
+        return entrySetLang(lang);
+    },
+    'entry:saveViaSite': async (project: any, options: { entryProjectId?: string; name: string }) =>
+        entrySaveViaSite(await serialize(() => packProject(project)), options),
+});
+
+/* ---------------- 나의 보관함 ---------------- */
+const BACKPACK_INDEX = 'backpack/index.json';
+const backpackFile = (id: string, type: string) => `backpack/${id.replace(/[^a-z0-9]/gi, '')}.${type === 'object' ? 'eo' : 'json'}`;
+async function backpackIndex(): Promise<any[]> {
+    try {
+        if (!(await vfs().exists(BACKPACK_INDEX))) {
+            return [];
+        }
+        const list = JSON.parse(await vfs().readText(BACKPACK_INDEX));
+        return Array.isArray(list) ? list : [];
+    } catch (e) {
+        return [];
+    }
+}
+
+/** Electron IPC 는 인자를 복제해서 넘긴다. 같은 동작을 해야 렌더러 객체가 바뀌지 않는다. */
+function cloneArg(value: any) {
+    if (value === null || typeof value !== 'object') {
+        return value;
+    }
+    if (value instanceof ArrayBuffer || ArrayBuffer.isView(value)) {
+        return value;
+    }
+    try {
+        return (window as any).structuredClone ? (window as any).structuredClone(value) : JSON.parse(JSON.stringify(value));
+    } catch (e) {
+        return JSON.parse(JSON.stringify(value));
+    }
+}
+
+export async function invoke(channel: string, ...args: any[]) {
+    const handler = handlers[channel];
+    if (!handler) {
+        console.warn(`[entry-local/web] unhandled ipc channel: ${channel}`);
+        return undefined;
+    }
+    try {
+        return await handler(...args.map(cloneArg));
+    } catch (e) {
+        console.error(`[entry-local/web] ${channel} failed`, e);
+        throw e;
+    }
+}
