new file mode 100644
index 00000000..a9e3d40f
--- /dev/null
+++ b/src/web/shim.ts
@@ -0,0 +1,143 @@
+import { lt } from '../common/localLang';
+import { App } from '@capacitor/app';
+import { initVFS } from './vfs';
+import { invoke } from './webMain';
+import { installAndroidSerial } from './webSerial';
+import { installAndroidBluetooth } from './webBluetooth';
+import { listen } from './bus';
+import {
+    installFilePathPolyfill,
+    showOpenDialog,
+    showSaveDialog,
+    showSaveDialogSync,
+    isNative,
+} from './platform';
+
+/**
+ * [entry-local/web] Electron preload(src/preload/preload.ts) 대체
+ *
+ * 엔트리 로컬 렌더러(React 화면, 저장/내 작품 로직)는 그대로 두고,
+ * preload 가 window 에 붙여 주던 함수들만 브라우저/안드로이드 구현으로 바꿔 끼운다.
+ * 이 스크립트는 main.html 에서 다른 번들보다 먼저 실행된다.
+ */
+
+const APP_VERSION = '2.1.36';
+const w = window as any;
+
+/* 화면 크기: 엔트리 작업 화면은 가로 1024px 이상을 전제로 만들어져 있다. */
+(function setViewport() {
+    const meta = document.createElement('meta');
+    meta.name = 'viewport';
+    const shortSide = Math.min(screen.width, screen.height);
+    const longSide = Math.max(screen.width, screen.height);
+    // [1.1] 휴대폰: 엔트리 편집기는 가로 1024 · 세로 590 보다 작아지지 않는다.
+    //  예전에는 늘 가로 1280 으로 맞춰서, 세로가 짧은 휴대폰에서는 아래쪽(오브젝트 정보·블록 꾸러미)이 잘렸다.
+    //  → 화면 비율에 맞춰 세로 590 이 꼭 들어가는 가로 폭을 고른다 (가로는 최소 1024). 앱은 휴대폰에서 상태·탐색 막대를 숨겨 화면을 다 쓴다.
+    const phoneWidth = Math.max(1024, Math.ceil((longSide * 590) / Math.max(1, shortSide)));
+    meta.content =
+        longSide >= 1024 && shortSide >= 600
+            ? 'width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no'
+            : `width=${phoneWidth}, user-scalable=yes`;
+    document.head.appendChild(meta);
+})();
+
+installFilePathPolyfill();
+// [entry-local 1.2] 안드로이드: 하드웨어 웹 연결용 navigator.serial (USB OTG)
+installAndroidSerial();
+installAndroidBluetooth();
+
+const sharedObject: any = {
+    roomIds: [],
+    appName: 'entry',
+    version: APP_VERSION,
+    file: undefined,
+};
+
+w.isOffline = true;
+// 경로 구분자를 '/' 로 쓰게 한다 (renderer/helper/constants.ts 가 isOsx 로 판단)
+w.isOsx = true;
+
+w.dialog = { showOpenDialog, showSaveDialog, showSaveDialogSync };
+w.getSharedObject = () => sharedObject;
+w.initNativeMenu = () => undefined;
+w.getLang = (key: string) => {
+    const lang = w.Lang || {};
+    return key.split('.').reduce((o: any, k: string) => (o ? o[k] : undefined), lang) || key;
+};
+w.ipcInvoke = (channel: string, ...args: any[]) => invoke(channel, ...args);
+w.ipcSend = (channel: string, ...args: any[]) => {
+    invoke(channel, ...args);
+};
+w.ipcListen = (channel: string, fn: (event: any, ...args: any[]) => void) => listen(channel, fn);
+w.sendSync = () => undefined;
+w.openEntryWebPage = () => undefined;
+w.openHardwarePage = () => {
+    const message = lt('안드로이드판에서는 하드웨어 연결을 지원하지 않습니다.', 'Hardware connection is not supported in the Android version.');
+    if (w.EntryModal) {
+        w.EntryModal.alert(message);
+    } else {
+        alert(message);
+    }
+};
+w.onLoadProjectFromMain = () => undefined;
+// 안드로이드에는 하드웨어 연결 프로그램이 없으므로 하드웨어 카테고리와 연결 시도를 끈다.
+w.entryLocalInitOptions = { hardwareEnable: false };
+w.checkPermission = async () => undefined;
+w.getPapagoHeaderInfo = async () => null;
+
+const appRoot = new URL('../../../', location.href).toString().replace(/\/$/, '');
+w.weightsPath = () => `${appRoot}/node_modules/entry-js/weights`;
+w.getEntryjsPath = () => `${appRoot}/node_modules/entry-js`;
+w.getAppPathWithParams = (...params: string[]) => `${appRoot}/${params.join('/')}`;
+
+/* 엔트리 코어 보정: 웹에서는 /lib/entry-js 를 찾으므로 앱 안 경로로 돌린다 */
+function patchEntryCore() {
+    const Entry = w.Entry;
+    if (Entry && Entry.Utils && !Entry.Utils.__entryLocalPatched) {
+        Entry.Utils.getEntryjsPath = () => w.getEntryjsPath();
+        Entry.Utils.__entryLocalPatched = true;
+    }
+}
+
+/* 렌더러가 화면을 그리기 시작하는 시점: 파일시스템 준비 + 모든 스크립트 실행 후 */
+const ready = new Promise<void>((resolve) => {
+    const domReady = new Promise<void>((r) => {
+        if (document.readyState === 'loading') {
+            document.addEventListener('DOMContentLoaded', () => r());
+        } else {
+            r();
+        }
+    });
+    Promise.all([initVFS(), domReady])
+        .then(() => {
+            patchEntryCore();
+            resolve();
+        })
+        .catch((e) => {
+            console.error('[entry-local/web] init failed', e);
+            document.body.innerHTML = `<pre style="padding:20px">${/^ko/i.test(navigator.language || '') ? '저장소 초기화 실패' : 'Storage initialization failed'}: ${e && e.message}</pre>`;
+        });
+});
+
+w.onPageLoaded = (callback: () => void) => {
+    ready.then(callback);
+};
+
+/* 안드로이드 뒤로가기: 열린 창을 닫고, 없으면 종료 확인 */
+if (isNative()) {
+    App.addListener('backButton', async () => {
+        const myProjects = document.getElementById('entry-local-projects');
+        if (myProjects) {
+            myProjects.remove();
+            return;
+        }
+        const ok = w.EntryModal
+            ? await w.EntryModal.confirm(lt('엔트리를 종료할까요?\n저장하지 않은 내용은 다음에 실행할 때 복구할 수 있습니다.', 'Quit Entry?\nUnsaved changes can be recovered the next time you run it.'))
+            : confirm(lt('엔트리를 종료할까요?', 'Quit Entry?'));
+        if (ok) {
+            App.exitApp();
+        }
+    });
+}
+
+console.log('[entry-local/web] shim ready', isNative() ? '(android)' : '(browser)');
diff --git a/src/web/tar.ts b/src/web/tar.ts
new file mode 100644
index 00000000..1f39261a
--- /dev/null
+++ b/src/web/tar.ts
@@ -0,0 +1,187 @@
+import { gzipSync, gunzipSync } from 'fflate';
+
+/**
+ * [entry-local/web] .ent / .eo 파일 = tar.gz
+ * Electron 판은 node-tar(gzip, portable) 로 만든다. 같은 형식(USTAR)을 브라우저에서 읽고 쓴다.
+ * 공식 엔트리에서 만든 파일의 PAX('x') / GNU 긴 이름('L') 헤더도 읽는다.
+ */
+
+export type TarEntry = { path: string; data: Uint8Array };
+
+const encoder = new TextEncoder();
+const decoder = new TextDecoder();
+
+function writeString(buf: Uint8Array, offset: number, length: number, value: string) {
+    const bytes = encoder.encode(value);
+    buf.set(bytes.subarray(0, length), offset);
+}
+
+function writeOctal(buf: Uint8Array, offset: number, length: number, value: number) {
+    const str = value.toString(8).padStart(length - 1, '0');
+    writeString(buf, offset, length - 1, str);
+    buf[offset + length - 1] = 0;
+}
+
+function splitName(name: string): { prefix: string; short: string } | undefined {
+    if (encoder.encode(name).length <= 100) {
+        return { prefix: '', short: name };
+    }
+    // ustar: prefix(155) + '/' + name(100)
+    for (let cut = name.indexOf('/'); cut > 0; cut = name.indexOf('/', cut + 1)) {
+        const prefix = name.substring(0, cut);
+        const short = name.substring(cut + 1);
+        if (encoder.encode(prefix).length <= 155 && encoder.encode(short).length <= 100) {
+            return { prefix, short };
+        }
+    }
+    return undefined;
+}
+
+function header(name: string, size: number, type: '0' | '5' | 'x', mtime: number) {
+    const buf = new Uint8Array(512);
+    const split = splitName(name) || { prefix: '', short: name.substring(name.length - 99) };
+    writeString(buf, 0, 100, split.short);
+    writeOctal(buf, 100, 8, type === '5' ? 0o755 : 0o644);
+    writeOctal(buf, 108, 8, 0);
+    writeOctal(buf, 116, 8, 0);
+    writeOctal(buf, 124, 12, size);
+    writeOctal(buf, 136, 12, mtime);
+    buf.fill(0x20, 148, 156); // checksum 자리는 공백으로 계산
+    buf[156] = type.charCodeAt(0);
+    writeString(buf, 257, 6, 'ustar');
+    writeString(buf, 263, 2, '00');
+    writeString(buf, 345, 155, split.prefix);
+    let sum = 0;
+    for (let i = 0; i < 512; i++) {
+        sum += buf[i];
+    }
+    writeString(buf, 148, 6, sum.toString(8).padStart(6, '0'));
+    buf[154] = 0;
+    buf[155] = 0x20;
+    return buf;
+}
+
+function paxRecord(key: string, value: string) {
+    // "<len> key=value\n" : len 은 레코드 전체 바이트 수(자기 자신 포함)
+    const body = ` ${key}=${value}\n`;
+    const bodyBytes = encoder.encode(body).length;
+    let len = bodyBytes + 1;
+    while (String(len).length + bodyBytes !== len) {
+        len = String(len).length + bodyBytes;
+    }
+    return encoder.encode(`${len}${body}`);
+}
+
+export function createTar(entries: TarEntry[]): Uint8Array {
+    const mtime = Math.floor(Date.now() / 1000);
+    const chunks: Uint8Array[] = [];
+    const dirs = new Set<string>();
+
+    const pushFile = (name: string, data: Uint8Array, type: '0' | '5' | 'x') => {
+        chunks.push(header(name, data.length, type, mtime));
+        chunks.push(data);
+        const pad = (512 - (data.length % 512)) % 512;
+        if (pad) {
+            chunks.push(new Uint8Array(pad));
+        }
+    };
+
+    for (const entry of entries) {
+        // 상위 폴더 항목 (node-tar 와 같은 모양)
+        const parts = entry.path.split('/');
+        for (let i = 1; i < parts.length; i++) {
+            const dir = `${parts.slice(0, i).join('/')}/`;
+            if (!dirs.has(dir)) {
+                dirs.add(dir);
+                pushFile(dir, new Uint8Array(0), '5');
+            }
+        }
+        if (!splitName(entry.path)) {
+            pushFile('PaxHeader', paxRecord('path', entry.path), 'x');
+        }
+        pushFile(entry.path, entry.data, '0');
+    }
+    chunks.push(new Uint8Array(1024)); // 끝 표시
+
+    const total = chunks.reduce((n, c) => n + c.length, 0);
+    const out = new Uint8Array(total);
+    let offset = 0;
+    for (const c of chunks) {
+        out.set(c, offset);
+        offset += c.length;
+    }
+    return out;
+}
+
+function readString(buf: Uint8Array, offset: number, length: number) {
+    let end = offset;
+    while (end < offset + length && buf[end] !== 0) {
+        end++;
+    }
+    return decoder.decode(buf.subarray(offset, end));
+}
+
+function readOctal(buf: Uint8Array, offset: number, length: number) {
+    const str = readString(buf, offset, length).trim();
+    return str ? parseInt(str, 8) : 0;
+}
+
+export function parseTar(tar: Uint8Array): TarEntry[] {
+    const entries: TarEntry[] = [];
+    let offset = 0;
+    let longName: string | undefined;
+    let paxPath: string | undefined;
+
+    while (offset + 512 <= tar.length) {
+        const block = tar.subarray(offset, offset + 512);
+        if (block.every((b) => b === 0)) {
+            break;
+        }
+        let name = readString(block, 0, 100);
+        const size = readOctal(block, 124, 12);
+        const type = String.fromCharCode(block[156] || 48);
+        const magic = readString(block, 257, 6);
+        const prefix = magic.startsWith('ustar') ? readString(block, 345, 155) : '';
+        if (prefix) {
+            name = `${prefix}/${name}`;
+        }
+        const dataStart = offset + 512;
+        const data = tar.subarray(dataStart, dataStart + size);
+        offset = dataStart + Math.ceil(size / 512) * 512;
+
+        if (type === 'L') {
+            longName = readString(data, 0, data.length);
+            continue;
+        }
+        if (type === 'x' || type === 'g') {
+            const text = decoder.decode(data);
+            const match = /\d+ path=([^\n]*)\n/.exec(text);
+            if (match && type === 'x') {
+                paxPath = match[1];
+            }
+            continue;
+        }
+        const path = (paxPath || longName || name).replace(/^\.\//, '');
+        paxPath = undefined;
+        longName = undefined;
+
+        if (type === '0' || type === '\0' || type === '7') {
+            // 경로 조작 방지
+            if (path.split('/').some((p) => p === '..')) {
+                continue;
+            }
+            entries.push({ path, data: data.slice() });
+        }
+    }
+    return entries;
+}
+
+export function packTarGz(entries: TarEntry[]): Uint8Array {
+    return gzipSync(createTar(entries), { level: 6, mem: 9 });
+}
+
+export function unpackTarGz(bytes: Uint8Array): TarEntry[] {
+    // gzip 이 아니면(일부 오래된 파일) 그대로 tar 로 읽는다.
+    const isGzip = bytes[0] === 0x1f && bytes[1] === 0x8b;
+    return parseTar(isGzip ? gunzipSync(bytes) : bytes);
+}
