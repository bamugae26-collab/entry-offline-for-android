new file mode 100644
index 00000000..9bd437ca
--- /dev/null
+++ b/src/web/vfs.ts
@@ -0,0 +1,310 @@
+import { Filesystem, Directory } from '@capacitor/filesystem';
+
+/**
+ * [entry-local/web] 앱 내부 저장소 파일시스템
+ *
+ * Electron 판의 userData 폴더(app.getPath('userData'))를 대신한다.
+ * 경로는 모두 상대경로이며 '/' 로 구분한다. 예) temp/ab/cd/image/abcd1234.png, projects/index.json
+ *
+ *  - CapacitorFS : 안드로이드 앱. Filesystem(Directory.Data) = /data/data/<패키지>/files (앱 전용, 다른 앱 접근 불가)
+ *                  파일 URL 은 Capacitor 로컬 서버(https://localhost/_capacitor_file_/...) 로 바로 읽힌다.
+ *  - DevFS       : PC 브라우저 개발·검증용. dev-server.js 가 디스크에 저장하고 /_devfs/ 로 제공한다.
+ *
+ * 엔트리 코어가 fileurl 문자열을 직접 가공(image→thumb, .png→.svg)하므로
+ * blob: URL 이 아니라 폴더 구조가 살아 있는 URL 이 필요해서 이렇게 나눴다.
+ */
+
+export interface VFS {
+    readonly kind: 'capacitor' | 'dev';
+    /** 파일의 URL (img src, fetch 에 그대로 사용). 동기 함수여야 한다. */
+    url(rel: string): string;
+    /** url() 로 만든 URL 이면 상대경로를, 아니면 undefined */
+    relFromUrl(url: string): string | undefined;
+    write(rel: string, data: Uint8Array | Blob | string): Promise<void>;
+    read(rel: string): Promise<Uint8Array>;
+    readText(rel: string): Promise<string>;
+    exists(rel: string): Promise<boolean>;
+    /** 파일 또는 폴더(하위 포함) 삭제. 없어도 오류 없음 */
+    remove(rel: string): Promise<void>;
+    /** 폴더 아래 모든 파일의 상대경로 (재귀) */
+    listFiles(dirRel: string): Promise<string[]>;
+    copy(fromRel: string, toRel: string): Promise<void>;
+    move(fromRel: string, toRel: string): Promise<void>;
+}
+
+export const normalize = (rel: string) =>
+    rel
+        .replace(/\\/g, '/')
+        .replace(/\/+/g, '/')
+        .replace(/^\.?\//, '')
+        .replace(/\/$/, '');
+
+export const join = (...parts: string[]) => normalize(parts.filter(Boolean).join('/'));
+
+export const dirname = (rel: string) => {
+    const n = normalize(rel);
+    const i = n.lastIndexOf('/');
+    return i < 0 ? '' : n.substring(0, i);
+};
+
+export const basename = (rel: string, ext?: string) => {
+    const n = normalize(rel.split('?')[0]);
+    const b = n.substring(n.lastIndexOf('/') + 1);
+    return ext && b.endsWith(ext) ? b.substring(0, b.length - ext.length) : b;
+};
+
+export const extname = (rel: string) => {
+    const b = basename(rel);
+    const i = b.lastIndexOf('.');
+    return i <= 0 ? '' : b.substring(i);
+};
+
+async function toBytes(data: Uint8Array | Blob | string): Promise<Uint8Array> {
+    if (data instanceof Uint8Array) {
+        return data;
+    }
+    if (typeof data === 'string') {
+        return new TextEncoder().encode(data);
+    }
+    return new Uint8Array(await data.arrayBuffer());
+}
+
+export function bytesToBase64(bytes: Uint8Array): string {
+    let binary = '';
+    const chunk = 0x8000;
+    for (let i = 0; i < bytes.length; i += chunk) {
+        binary += String.fromCharCode.apply(null, bytes.subarray(i, i + chunk) as any);
+    }
+    return btoa(binary);
+}
+
+export function base64ToBytes(base64: string): Uint8Array {
+    const clean = base64.replace(/^data:[^;]*;base64,/, '');
+    const binary = atob(clean);
+    const bytes = new Uint8Array(binary.length);
+    for (let i = 0; i < binary.length; i++) {
+        bytes[i] = binary.charCodeAt(i);
+    }
+    return bytes;
+}
+
+/* ------------------------------------------------------------------ */
+/* PC 브라우저 개발용                                                   */
+/* ------------------------------------------------------------------ */
+class DevFS implements VFS {
+    readonly kind = 'dev';
+    private readonly base = `${location.origin}/_devfs/`;
+
+    url(rel: string) {
+        return this.base + normalize(rel);
+    }
+
+    relFromUrl(url: string) {
+        return url.startsWith(this.base) ? decodeURI(url.substring(this.base.length)) : undefined;
+    }
+
+    private async call(op: string, body: any) {
+        const res = await fetch(`/_devfs_api/${op}`, {
+            method: 'POST',
+            headers: { 'content-type': 'application/json' },
+            body: JSON.stringify(body),
+        });
+        if (!res.ok) {
+            throw new Error(`devfs ${op} failed: ${await res.text()}`);
+        }
+        return res.json();
+    }
+
+    async write(rel: string, data: Uint8Array | Blob | string) {
+        const bytes = await toBytes(data);
+        const res = await fetch(`/_devfs_api/write?path=${encodeURIComponent(normalize(rel))}`, {
+            method: 'POST',
+            body: bytes,
+        });
+        if (!res.ok) {
+            throw new Error(`devfs write failed: ${rel}`);
+        }
+    }
+
+    async read(rel: string) {
+        const res = await fetch(this.url(rel), { cache: 'no-store' });
+        if (!res.ok) {
+            throw new Error(`file not found: ${rel}`);
+        }
+        return new Uint8Array(await res.arrayBuffer());
+    }
+
+    async readText(rel: string) {
+        return new TextDecoder().decode(await this.read(rel));
+    }
+
+    async exists(rel: string) {
+        return (await this.call('exists', { path: normalize(rel) })).exists;
+    }
+
+    async remove(rel: string) {
+        await this.call('remove', { path: normalize(rel) });
+    }
+
+    async listFiles(dirRel: string) {
+        return (await this.call('list', { path: normalize(dirRel) })).files as string[];
+    }
+
+    async copy(fromRel: string, toRel: string) {
+        await this.call('copy', { from: normalize(fromRel), to: normalize(toRel) });
+    }
+
+    async move(fromRel: string, toRel: string) {
+        await this.call('move', { from: normalize(fromRel), to: normalize(toRel) });
+    }
+}
+
+/* ------------------------------------------------------------------ */
+/* 안드로이드 (Capacitor Filesystem, Directory.Data)                    */
+/* ------------------------------------------------------------------ */
+class CapacitorFS implements VFS {
+    readonly kind = 'capacitor';
+    private base = '';
+
+    constructor(private readonly fs: any, private readonly directory: string) {}
+
+    async init(convertFileSrc: (uri: string) => string) {
+        const { uri } = await this.fs.getUri({ path: '', directory: this.directory });
+        // file:///data/user/0/<pkg>/files  ->  https://localhost/_capacitor_file_/data/user/0/<pkg>/files
+        this.base = `${convertFileSrc(uri).replace(/\/$/, '')}/`;
+    }
+
+    url(rel: string) {
+        return this.base + normalize(rel);
+    }
+
+    relFromUrl(url: string) {
+        return url.startsWith(this.base) ? decodeURI(url.substring(this.base.length)) : undefined;
+    }
+
+    async write(rel: string, data: Uint8Array | Blob | string) {
+        const bytes = await toBytes(data);
+        await this.fs.writeFile({
+            path: normalize(rel),
+            directory: this.directory,
+            data: bytesToBase64(bytes),
+            recursive: true,
+        });
+    }
+
+    async read(rel: string) {
+        // 로컬 서버로 바로 읽는 쪽이 base64 왕복보다 빠르다. 실패하면 플러그인으로.
+        try {
+            const res = await fetch(this.url(rel), { cache: 'no-store' });
+            if (res.ok) {
+                return new Uint8Array(await res.arrayBuffer());
+            }
+        } catch (e) {
+            // fall through
+        }
+        const { data } = await this.fs.readFile({ path: normalize(rel), directory: this.directory });
+        return base64ToBytes(data as string);
+    }
+
+    async readText(rel: string) {
+        return new TextDecoder().decode(await this.read(rel));
+    }
+
+    async stat(rel: string) {
+        try {
+            return await this.fs.stat({ path: normalize(rel), directory: this.directory });
+        } catch (e) {
+            return undefined;
+        }
+    }
+
+    async exists(rel: string) {
+        return !!(await this.stat(rel));
+    }
+
+    async remove(rel: string) {
+        const info = await this.stat(rel);
+        if (!info) {
+            return;
+        }
+        if (info.type === 'directory') {
+            await this.fs.rmdir({ path: normalize(rel), directory: this.directory, recursive: true });
+        } else {
+            await this.fs.deleteFile({ path: normalize(rel), directory: this.directory });
+        }
+    }
+
+    async listFiles(dirRel: string): Promise<string[]> {
+        const dir = normalize(dirRel);
+        const result: string[] = [];
+        let entries: any[] = [];
+        try {
+            entries = (await this.fs.readdir({ path: dir, directory: this.directory })).files;
+        } catch (e) {
+            return result;
+        }
+        for (const entry of entries) {
+            const child = join(dir, entry.name);
+            if (entry.type === 'directory') {
+                result.push(...(await this.listFiles(child)));
+            } else {
+                result.push(child);
+            }
+        }
+        return result;
+    }
+
+    async copy(fromRel: string, toRel: string) {
+        const info = await this.stat(fromRel);
+        if (info?.type === 'directory') {
+            for (const file of await this.listFiles(fromRel)) {
+                await this.copy(file, join(toRel, file.substring(normalize(fromRel).length)));
+            }
+            return;
+        }
+        await this.write(toRel, await this.read(fromRel));
+    }
+
+    async move(fromRel: string, toRel: string) {
+        await this.remove(toRel);
+        try {
+            const parent = dirname(toRel);
+            if (parent) {
+                await this.fs.mkdir({ path: parent, directory: this.directory, recursive: true }).catch(() => undefined);
+            }
+            await this.fs.rename({
+                from: normalize(fromRel),
+                to: normalize(toRel),
+                directory: this.directory,
+                toDirectory: this.directory,
+            });
+        } catch (e) {
+            await this.copy(fromRel, toRel);
+            await this.remove(fromRel);
+        }
+    }
+}
+
+let instance: VFS | undefined;
+
+export async function initVFS(): Promise<VFS> {
+    if (instance) {
+        return instance;
+    }
+    const cap = (window as any).Capacitor;
+    if (cap && cap.isNativePlatform && cap.isNativePlatform()) {
+        const fs = new CapacitorFS(Filesystem, Directory.Data);
+        await fs.init((uri: string) => cap.convertFileSrc(uri));
+        instance = fs;
+    } else {
+        instance = new DevFS();
+    }
+    return instance;
+}
+
+export function vfs(): VFS {
+    if (!instance) {
+        throw new Error('VFS not initialized');
+    }
+    return instance;
+}
diff --git a/src/web/webBluetooth.ts b/src/web/webBluetooth.ts
new file mode 100644
index 00000000..434658e2
--- /dev/null
+++ b/src/web/webBluetooth.ts
@@ -0,0 +1,358 @@
+/**
+ * [entry-local 1.2] 안드로이드: 웹 블루투스(navigator.bluetooth) 대신
+ *
+ * 엔트리의 '하드웨어 웹 연결'은 블루투스 LE 하드웨어(마이크로비트 BLE)와 크롬의 Web Bluetooth 로 통신한다.
+ * 안드로이드 웹뷰에는 Web Bluetooth 가 없어서, 같은 모양의 navigator.bluetooth 를 만들고
+ * 실제 통신은 앱 플러그인(EntryBlePlugin.java)에 맡긴다.
+ * 엔트리가 쓰는 부분만 만든다:
+ *   requestDevice → device.gatt.connect / disconnect / getPrimaryServices(getPrimaryService)
+ *   service.getCharacteristics / getCharacteristic
+ *   characteristic.readValue / writeValue(WithResponse/WithoutResponse) / startNotifications / stopNotifications
+ *   'characteristicvaluechanged'(event.target.value = DataView) · 'gattserverdisconnected'
+ */
+import { registerPlugin, PluginListenerHandle } from '@capacitor/core';
+import { isNative } from './platform';
+
+type CharInfo = { uuid: string; properties: Record<string, boolean> };
+type ServiceInfo = { uuid: string; characteristics: CharInfo[] };
+
+interface EntryBlePlugin {
+    requestDevice(options: { filters?: any[]; acceptAllDevices?: boolean }): Promise<{ deviceId: string; name: string }>;
+    connect(options: { deviceId: string }): Promise<{ services: ServiceInfo[] }>;
+    disconnect(options: { deviceId: string }): Promise<void>;
+    read(options: { deviceId: string; service: string; characteristic: string }): Promise<{ value?: string }>;
+    write(options: { deviceId: string; service: string; characteristic: string; value: string; withResponse: boolean }): Promise<void>;
+    startNotifications(options: { deviceId: string; service: string; characteristic: string }): Promise<void>;
+    stopNotifications(options: { deviceId: string; service: string; characteristic: string }): Promise<void>;
+    getAvailability(): Promise<{ available: boolean }>;
+    setLang(options: { lang: string }): Promise<void>;
+    addListener(event: 'notify', fn: (e: { deviceId: string; service: string; characteristic: string; value: string }) => void): Promise<PluginListenerHandle>;
+    addListener(event: 'disconnected', fn: (e: { deviceId: string }) => void): Promise<PluginListenerHandle>;
+}
+
+const Ble = registerPlugin<EntryBlePlugin>('EntryBle');
+
+const BASE_UUID = '-0000-1000-8000-00805f9b34fb';
+
+/** 0x180a · '180a' · 'e95d…' → 128비트 소문자 (웹 블루투스와 같은 규칙) */
+export function canonicalUUID(u: string | number): string {
+    if (typeof u === 'number') {
+        return `${(u >>> 0).toString(16).padStart(8, '0')}${BASE_UUID}`;
+    }
+    const s = String(u).toLowerCase();
+    if (/^[0-9a-f]{4}$/.test(s) || /^[0-9a-f]{8}$/.test(s)) {
+        return `${s.padStart(8, '0')}${BASE_UUID}`;
+    }
+    return s;
+}
+
+function toBase64(bytes: Uint8Array) {
+    let bin = '';
+    for (let i = 0; i < bytes.length; i += 0x8000) {
+        bin += String.fromCharCode.apply(null, Array.from(bytes.subarray(i, i + 0x8000)));
+    }
+    return btoa(bin);
+}
+
+function toDataView(b64?: string) {
+    const bin = atob(b64 || '');
+    const out = new Uint8Array(bin.length);
+    for (let i = 0; i < bin.length; i++) {
+        out[i] = bin.charCodeAt(i);
+    }
+    return new DataView(out.buffer);
+}
+
+function toBytes(v: any): Uint8Array {
+    if (v instanceof Uint8Array) {
+        return v;
+    }
+    if (v instanceof ArrayBuffer) {
+        return new Uint8Array(v);
+    }
+    if (ArrayBuffer.isView(v)) {
+        return new Uint8Array(v.buffer, v.byteOffset, v.byteLength);
+    }
+    if (Array.isArray(v)) {
+        return Uint8Array.from(v);
+    }
+    return new Uint8Array(0);
+}
+
+class Characteristic extends EventTarget {
+    value: DataView | null = null;
+    readonly uuid: string;
+    readonly properties: Record<string, boolean>;
+
+    constructor(readonly service: Service, info: CharInfo) {
+        super();
+        this.uuid = info.uuid;
+        this.properties = info.properties || {};
+    }
+
+    private get ids() {
+        return { deviceId: this.service.device.id, service: this.service.uuid, characteristic: this.uuid };
+    }
+
+    async readValue() {
+        const r = await Ble.read(this.ids);
+        this.value = toDataView(r.value);
+        return this.value;
+    }
+
+    async writeValueWithResponse(value: BufferSource) {
+        await Ble.write({ ...this.ids, value: toBase64(toBytes(value)), withResponse: true });
+    }
+
+    async writeValueWithoutResponse(value: BufferSource) {
+        await Ble.write({ ...this.ids, value: toBase64(toBytes(value)), withResponse: false });
+    }
+
+    /** 예전 방식: 기기가 응답 쓰기를 지원하면 응답 쓰기, 아니면 응답 없는 쓰기 */
+    async writeValue(value: BufferSource) {
+        if (this.properties.write || !this.properties.writeWithoutResponse) {
+            return this.writeValueWithResponse(value);
+        }
+        return this.writeValueWithoutResponse(value);
+    }
+
+    async startNotifications() {
+        await Ble.startNotifications(this.ids);
+        return this;
+    }
+
+    async stopNotifications() {
+        await Ble.stopNotifications(this.ids);
+        return this;
+    }
+
+    /** 플러그인이 알려 준 새 값 */
+    receive(b64: string) {
+        this.value = toDataView(b64);
+        this.dispatchEvent(new Event('characteristicvaluechanged'));
+    }
+
+    async getDescriptor(): Promise<never> {
+        throw new DOMException('Descriptors are not supported.', 'NotSupportedError');
+    }
+
+    async getDescriptors(): Promise<never> {
+        throw new DOMException('Descriptors are not supported.', 'NotSupportedError');
+    }
+}
+
+class Service extends EventTarget {
+    readonly uuid: string;
+    readonly isPrimary = true;
+    readonly chars: Characteristic[];
+
+    constructor(readonly device: Device, info: ServiceInfo) {
+        super();
+        this.uuid = info.uuid;
+        this.chars = (info.characteristics || []).map((c) => new Characteristic(this, c));
+    }
+
+    async getCharacteristic(uuid: string | number) {
+        const id = canonicalUUID(uuid);
+        const c = this.chars.find((x) => x.uuid === id);
+        if (!c) {
+            throw new DOMException(`No Characteristics matching UUID ${id} found in Service.`, 'NotFoundError');
+        }
+        return c;
+    }
+
+    async getCharacteristics(uuid?: string | number) {
+        if (uuid === undefined) {
+            return this.chars.slice();
+        }
+        const id = canonicalUUID(uuid);
+        const list = this.chars.filter((x) => x.uuid === id);
+        if (!list.length) {
+            throw new DOMException(`No Characteristics matching UUID ${id} found in Service.`, 'NotFoundError');
+        }
+        return list;
+    }
+}
+
+class GattServer {
+    connected = false;
+    services: Service[] = [];
+
+    constructor(readonly device: Device) {}
+
+    async connect() {
+        const r = await Ble.connect({ deviceId: this.device.id });
+        const allowed = this.device.allowedServices;
+        this.services = (r.services || [])
+            .filter((s) => !allowed || allowed.has(s.uuid))
+            .map((s) => new Service(this.device, s));
+        this.connected = true;
+        return this;
+    }
+
+    disconnect() {
+        if (!this.connected) {
+            return;
+        }
+        Ble.disconnect({ deviceId: this.device.id }).catch(() => undefined);
+        this.device.lost();
+    }
+
+    private ensure() {
+        if (!this.connected) {
+            throw new DOMException('GATT Server is disconnected.', 'NetworkError');
+        }
+    }
+
+    async getPrimaryService(uuid: string | number) {
+        this.ensure();
+        const id = canonicalUUID(uuid);
+        const s = this.services.find((x) => x.uuid === id);
+        if (!s) {
+            throw new DOMException(`No Services matching UUID ${id} found in Device.`, 'NotFoundError');
+        }
+        return s;
+    }
+
+    async getPrimaryServices(uuid?: string | number) {
+        this.ensure();
+        if (uuid === undefined) {
+            return this.services.slice();
+        }
+        const id = canonicalUUID(uuid);
+        return this.services.filter((x) => x.uuid === id);
+    }
+}
+
+class Device extends EventTarget {
+    readonly gatt: GattServer;
+
+    constructor(readonly id: string, readonly name: string, readonly allowedServices: Set<string> | null) {
+        super();
+        this.gatt = new GattServer(this);
+    }
+
+    /** 연결이 끊김 */
+    lost() {
+        if (!this.gatt.connected) {
+            return;
+        }
+        this.gatt.connected = false;
+        this.dispatchEvent(new Event('gattserverdisconnected'));
+    }
+
+    find(service: string, characteristic: string) {
+        const s = this.gatt.services.find((x) => x.uuid === service);
+        return s && s.chars.find((c) => c.uuid === characteristic);
+    }
+}
+
+const devices = new Map<string, Device>();
+let listening: Promise<void> | null = null;
+
+function listen() {
+    if (!listening) {
+        listening = (async () => {
+            await Ble.addListener('notify', (e) => {
+                const d = devices.get(e.deviceId);
+                const c = d && d.find(e.service, e.characteristic);
+                c && c.receive(e.value);
+            });
+            await Ble.addListener('disconnected', (e) => {
+                const d = devices.get(e.deviceId);
+                d && d.lost();
+            });
+        })();
+    }
+    return listening;
+}
+
+/** 실패 이유를 엔트리 알림으로 (취소는 조용히) */
+function toastError(e: any) {
+    const code = e && e.code;
+    const message = e && e.message;
+    const Entry = (window as any).Entry;
+    if (!message || code === 'CANCELLED' || !Entry || !Entry.toast) {
+        return;
+    }
+    const ko = (window as any).Lang && (window as any).Lang.type === 'ko';
+    Entry.toast.alert(ko ? '블루투스 하드웨어' : 'Bluetooth hardware', message);
+}
+
+class AndroidBluetooth extends EventTarget {
+    async getAvailability() {
+        try {
+            return (await Ble.getAvailability()).available;
+        } catch (e) {
+            return false;
+        }
+    }
+
+    async getDevices() {
+        return Array.from(devices.values());
+    }
+
+    async requestDevice(options: { filters?: any[]; optionalServices?: any[]; acceptAllDevices?: boolean } = {}) {
+        await listen();
+        const filters = (options.filters || []).map((f: any) => {
+            const out: any = {};
+            f.name && (out.name = f.name);
+            f.namePrefix && (out.namePrefix = f.namePrefix);
+            f.services && (out.services = f.services.map(canonicalUUID));
+            return out;
+        });
+        let picked;
+        try {
+            picked = await Ble.requestDevice({ filters, acceptAllDevices: !!options.acceptAllDevices });
+        } catch (e) {
+            toastError(e);
+            throw new DOMException((e && (e as any).message) || 'User cancelled the requestDevice() chooser.', 'NotFoundError');
+        }
+        // 웹 블루투스처럼: 필터·optionalServices 에 적은 서비스만 쓸 수 있다 (모두 허용이면 제한 없음)
+        let allowed: Set<string> | null = null;
+        if (!options.acceptAllDevices) {
+            allowed = new Set<string>();
+            (options.optionalServices || []).forEach((u) => allowed!.add(canonicalUUID(u)));
+            filters.forEach((f: any) => (f.services || []).forEach((u: string) => allowed!.add(u)));
+            if (!allowed.size) {
+                allowed = null;
+            }
+        }
+        const old = devices.get(picked.deviceId);
+        if (old && old.gatt.connected) {
+            old.gatt.disconnect();
+        }
+        const device = new Device(picked.deviceId, picked.name, allowed);
+        devices.set(picked.deviceId, device);
+        // 연결 실패도 이유를 보여 준다
+        const connect = device.gatt.connect.bind(device.gatt);
+        device.gatt.connect = async () => {
+            try {
+                return await connect();
+            } catch (e) {
+                toastError(e);
+                throw new DOMException((e && (e as any).message) || 'Connection failed.', 'NetworkError');
+            }
+        };
+        return device;
+    }
+}
+
+/** 안드로이드 앱이면 navigator.bluetooth 를 만든다 → true */
+export function installAndroidBluetooth() {
+    if (!isNative() || (navigator as any).bluetooth) {
+        return !!(navigator as any).bluetooth;
+    }
+    try {
+        Object.defineProperty(navigator, 'bluetooth', { configurable: true, value: new AndroidBluetooth() });
+        return true;
+    } catch (e) {
+        return false;
+    }
+}
+
+export function setBluetoothLang(lang?: string) {
+    if (isNative()) {
+        Ble.setLang({ lang: lang === 'en' ? 'en' : 'ko' }).catch(() => undefined);
+    }
+}
