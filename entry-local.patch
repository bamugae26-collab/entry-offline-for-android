@@ -0,0 +1,68 @@
+/**
+ * [entry-local] 엔트리 계정에 저장하는 동안 보이는 대기 창
+ * 저장 완료 창(saveDoneAlert.ts)·로그인 안내 창과 같은 모양:
+ *   파란 머리띠 "저장" + 진행 표시 + "엔트리 계정에 저장하는 중…" + [취소]
+ * Windows·안드로이드 모두 이 창을 쓴다. (실제 엔트리 작업 화면은 보이지 않는 곳에서 돈다)
+ */
+import { lt } from '../../common/localLang';
+
+const OVERLAY_ID = 'entry-local-saving';
+const STYLE_ID = 'entry-local-saving-style';
+
+const CSS = `
+#${OVERLAY_ID}{position:fixed;inset:0;z-index:100000;display:flex;align-items:center;justify-content:center;background:rgba(0,0,0,.6);font-family:inherit}
+#${OVERLAY_ID} .esv-box{width:388px;max-width:calc(100vw - 32px);background:#fff;border-radius:6px;overflow:hidden;box-shadow:0 6px 24px rgba(0,0,0,.25)}
+#${OVERLAY_ID} .esv-head{display:flex;align-items:center;height:54px;padding:0 26px;background:#4f80ff;color:#fff;font-size:20px;font-weight:bold}
+#${OVERLAY_ID} .esv-body{padding:34px 24px 38px;text-align:center}
+#${OVERLAY_ID} .esv-spin{width:44px;height:44px;margin:0 auto 22px;border:4px solid #dfe7ff;border-top-color:#4f80ff;border-radius:50%;box-sizing:border-box;animation:esv-rot .9s linear infinite}
+@keyframes esv-rot{to{transform:rotate(360deg)}}
+#${OVERLAY_ID} .esv-msg{margin:0 0 8px;color:#333;font-size:17px;font-weight:bold;line-height:1.4}
+#${OVERLAY_ID} .esv-sub{margin:0 0 30px;color:#888;font-size:14px;line-height:1.5}
+#${OVERLAY_ID} .esv-buttons{display:flex;justify-content:center}
+#${OVERLAY_ID} .esv-cancel{width:146px;height:48px;border:1px solid #4f80ff;border-radius:4px;background:#fff;color:#4f80ff;font:inherit;font-size:15px;font-weight:bold;cursor:pointer}
+#${OVERLAY_ID} .esv-cancel:disabled{border-color:#c9d6f7;color:#a9b9e6;cursor:default}
+`;
+
+function ensureStyle() {
+    if (!document.getElementById(STYLE_ID)) {
+        const style = document.createElement('style');
+        style.id = STYLE_ID;
+        style.textContent = CSS;
+        document.head.appendChild(style);
+    }
+}
+
+/** 대기 창을 띄운다. [취소]를 누르면 onCancel 을 부른다. 반환값의 close() 로 닫는다. */
+export function showSavingAlert(options: { onCancel?: () => void } = {}) {
+    ensureStyle();
+    document.getElementById(OVERLAY_ID)?.remove();
+    const overlay = document.createElement('div');
+    overlay.id = OVERLAY_ID;
+    overlay.innerHTML =
+        `<div class="esv-box" role="alertdialog" aria-modal="true" aria-busy="true" aria-label="${lt('저장', 'Save')}">` +
+        `<div class="esv-head">${lt('저장', 'Save')}</div>` +
+        '<div class="esv-body"><div class="esv-spin" aria-hidden="true"></div>' +
+        `<p class="esv-msg">${lt('엔트리 계정에 저장하는 중…', 'Saving to your Entry account…')}</p>` +
+        `<p class="esv-sub">${lt('잠시만 기다려 주세요. 처음에는 30초쯤 걸릴 수 있습니다.', 'Please wait. The first time may take about 30 seconds.')}</p>` +
+        `<div class="esv-buttons"><button class="esv-cancel" type="button">${lt('취소', 'Cancel')}</button></div>` +
+        '</div></div>';
+    const cancel = overlay.querySelector('.esv-cancel') as HTMLButtonElement;
+    const onKey = (e: KeyboardEvent) => {
+        if (e.key === 'Escape') {
+            e.stopPropagation();
+            cancel.click();
+        }
+    };
+    cancel.onclick = () => {
+        cancel.disabled = true;
+        options.onCancel && options.onCancel();
+    };
+    document.addEventListener('keydown', onKey, true);
+    document.body.appendChild(overlay);
+    return {
+        close() {
+            document.removeEventListener('keydown', onKey, true);
+            overlay.remove();
+        },
+    };
+}
diff --git a/src/renderer/helper/touchSliders.ts b/src/renderer/helper/touchSliders.ts
new file mode 100644
index 00000000..f984798f
--- /dev/null
+++ b/src/renderer/helper/touchSliders.ts
@@ -0,0 +1,78 @@
+/**
+ * [entry-local] 소리 편집기 [조정하기]의 크기·빠르기·음높이 슬라이더를 손가락으로도 끌 수 있게 한다.
+ * 엔트리 소리 편집기(vendor/sound-editor.js)의 슬라이더는 마우스 이벤트(mousedown·mousemove·mouseup)만 듣는다.
+ * 태블릿에서 손가락으로 끌면 터치 이벤트만 와서 손잡이가 움직이지 않는다
+ * → 슬라이더 손잡이에서 시작한 터치를 같은 좌표의 마우스 이벤트로 바꿔 보낸다.
+ */
+let installed = false;
+
+function mouse(type: string, touch: Touch, target: EventTarget) {
+    target.dispatchEvent(
+        new MouseEvent(type, {
+            bubbles: true,
+            cancelable: true,
+            view: window,
+            clientX: touch.clientX,
+            clientY: touch.clientY,
+            screenX: touch.screenX,
+            screenY: touch.screenY,
+            button: 0,
+            buttons: type === 'mouseup' ? 0 : 1,
+        })
+    );
+}
+
+export function installTouchSliders() {
+    if (installed || typeof window === 'undefined' || !('ontouchstart' in window || navigator.maxTouchPoints > 0)) {
+        return;
+    }
+    installed = true;
+    let active: { id: number } | null = null;
+
+    document.addEventListener(
+        'touchstart',
+        (e: TouchEvent) => {
+            const target = e.target as Element | null;
+            const knob = target && target.closest && target.closest('#entrySoundEdit [role="slider"]');
+            if (!knob || e.touches.length !== 1) {
+                return;
+            }
+            const touch = e.changedTouches[0];
+            active = { id: touch.identifier };
+            e.preventDefault(); // 화면이 따라 움직이거나 가짜 마우스 이벤트가 두 번 오지 않게
+            mouse('mousedown', touch, knob);
+        },
+        { capture: true, passive: false }
+    );
+
+    document.addEventListener(
+        'touchmove',
+        (e: TouchEvent) => {
+            if (!active) {
+                return;
+            }
+            const touch = Array.from(e.changedTouches).find((t) => t.identifier === active!.id);
+            if (!touch) {
+                return;
+            }
+            e.preventDefault();
+            mouse('mousemove', touch, document);
+        },
+        { capture: true, passive: false }
+    );
+
+    const end = (e: TouchEvent) => {
+        if (!active) {
+            return;
+        }
+        const touch = Array.from(e.changedTouches).find((t) => t.identifier === active!.id);
+        if (!touch) {
+            return;
+        }
+        active = null;
+        e.preventDefault();
+        mouse('mouseup', touch, document);
+    };
+    document.addEventListener('touchend', end, { capture: true, passive: false });
+    document.addEventListener('touchcancel', end, { capture: true, passive: false });
+}
