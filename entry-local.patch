+                current: project.id === options.currentEntryId,
+                thumbnail: entryThumbUrl(project.thumb, entryBase),
+                from: lt('엔트리', 'Entry'),
+                fromName: nick || undefined,
+                avatar: `<img src="${BRAND_ICON}" alt="">`,
+                locked: project.isopen === false,
+                onOpen: open,
+                menu: [
+                    [lt('불러오기', 'Load'), undefined, () => open()],
+                    [
+                        lt('엔트리에서 보기', 'View on Entry'),
+                        undefined,
+                        () => {
+                            accountApi.openExternal(entryProjectPageUrl(project.id)).catch((e) =>
+                                EntryModalHelper.getAlertModal(lt(`페이지를 열지 못했습니다.\n${cloudErrorMessage(e)}`, `Could not open the page.\n${cloudErrorMessage(e)}`))
+                            );
+                        },
+                    ],
+                ],
+            });
+        });
+        if ((entryItems || []).length < entryTotal) {
+            empty(lt(`${(entryItems || []).length} / ${entryTotal}개`, `${(entryItems || []).length} / ${entryTotal}`), { label: entryLoading ? lt('불러오는 중…', 'Loading…') : lt('더 보기', 'Load more'), onClick: () => reloadEntry(true) }, true);
+        }
+    };
+
+    const reloadEntry = async (more = false) => {
+        if (!getCloudState().entry || entryLoading) {
+            render();
+            return;
+        }
+        entryLoading = true;
+        entryError = '';
+        if (!more) {
+            entryItems = undefined;
+        }
+        render();
+        try {
+            entryBase = (await entryApi.base()) || entryBase;
+            const page = await entryApi.projects(more && entryItems ? entryItems.length : 0, 60);
+            entryTotal = page.total || 0;
+            entryItems = more && entryItems ? entryItems.concat(page.list) : page.list;
+        } catch (e) {
+            entryError = cloudErrorMessage(e);
+        } finally {
+            entryLoading = false;
+            updateTabs();
+            if (tab === 'entry') {
+                render();
+            }
+        }
+    };
+
+    const render = () => {
+        closeMenu();
+        body.innerHTML = '';
+        body.classList.remove('is-empty');
+        if (tab === 'entry') {
+            renderEntry();
+        } else if (tab === 'drive') {
+            renderDrive();
+        } else {
+            renderLocal();
+        }
+        // 고른 작품이 지금 목록에 없으면 고르기 해제
+        if (selected && !body.querySelector('.elp-card.selected')) {
+            selected = undefined;
+        }
+        updateOpenBtn();
+        body.appendChild(el('div', 'elp-build', lt(`버전 ${ENTRY_LOCAL_BUILD}`, `Version ${ENTRY_LOCAL_BUILD}`)));
+    };
+
+    const reloadLocal = async () => {
+        localItems = await IpcRendererHelper.localStoreList();
+        if (tab === 'local') {
+            render();
+        }
+    };
+
+    const reloadDrive = async () => {
+        if (!cloudAvailable() || !getCloudState().loggedIn) {
+            render();
+            return;
+        }
+        driveLoading = true;
+        driveError = '';
+        render();
+        try {
+            driveItems = await cloudApi.list();
+        } catch (e) {
+            driveError = cloudErrorMessage(e);
+        } finally {
+            driveLoading = false;
+            updateTabs();
+            if (tab === 'drive') {
+                render();
+            }
+        }
+    };
+
+    const switchTab = (next: Tab) => {
+        tab = next;
+        selected = undefined;
+        updateTabs();
+        render();
+        body.scrollTop = 0;
+        if (next === 'drive' && !driveItems && !driveLoading) {
+            reloadDrive();
+        }
+        if (next === 'entry' && !entryItems && !entryLoading) {
+            reloadEntry();
+        }
+    };
+    tabLocal.onclick = () => switchTab('local');
+    tabDrive.onclick = () => switchTab('drive');
+    tabEntry.onclick = () => switchTab('entry');
+    search.oninput = render;
+    search.onkeydown = (e) => e.stopPropagation();
+    [openSel, sortSel, periodSel].forEach((sel) => (sel.onchange = render));
+
+    try {
+        localDir = await IpcRendererHelper.localStoreDir();
+    } catch (e) {
+        localDir = '';
+    }
+    localItems = await IpcRendererHelper.localStoreList();
+    updateTabs();
+    render();
+    if (tab === 'drive') {
+        reloadDrive();
+    }
+    if (tab === 'entry') {
+        reloadEntry();
+    }
+}
diff --git a/src/renderer/helper/loginAlert.ts b/src/renderer/helper/loginAlert.ts
new file mode 100644
index 00000000..f1c631cf
--- /dev/null
+++ b/src/renderer/helper/loginAlert.ts
@@ -0,0 +1,68 @@
+/**
+ * [entry-local] "로그인 후 이용할 수 있습니다." 알림창
+ * 웹판 엔트리(playentry.org)의 알림창과 같은 모양: 파란 머리띠(알림 · 닫기) + 안내 문구 + 로그인 버튼
+ */
+import { lt } from '../../common/localLang';
+const OVERLAY_ID = 'entry-local-login-alert';
+const STYLE_ID = 'entry-local-login-alert-style';
+
+const CSS = `
+#${OVERLAY_ID}{position:fixed;inset:0;z-index:100000;display:flex;align-items:center;justify-content:center;background:rgba(0,0,0,.6);font-family:inherit}
+#${OVERLAY_ID} .ela-box{width:400px;max-width:calc(100vw - 32px);background:#fff;border-radius:6px;overflow:hidden;box-shadow:0 6px 24px rgba(0,0,0,.25)}
+#${OVERLAY_ID} .ela-head{position:relative;display:flex;align-items:center;height:56px;padding:0 26px;background:#4f80ff;color:#fff;font-size:22px;font-weight:bold}
+#${OVERLAY_ID} .ela-close{position:absolute;top:50%;right:30px;width:26px;height:26px;margin-top:-13px;padding:0;border:0;background:none;cursor:pointer}
+#${OVERLAY_ID} .ela-close:before,#${OVERLAY_ID} .ela-close:after{content:"";position:absolute;top:50%;left:50%;width:26px;height:3px;margin:-1.5px 0 0 -13px;background:#fff;border-radius:2px}
+#${OVERLAY_ID} .ela-close:before{transform:rotate(45deg)}
+#${OVERLAY_ID} .ela-close:after{transform:rotate(-45deg)}
+#${OVERLAY_ID} .ela-body{padding:36px 24px 36px;text-align:center}
+#${OVERLAY_ID} .ela-msg{margin:0 0 36px;color:#333;font-size:20px;font-weight:bold;line-height:1.4}
+#${OVERLAY_ID} .ela-ok{width:152px;height:49px;border:0;border-radius:4px;background:#4f80ff;color:#fff;font-size:19px;font-weight:bold;cursor:pointer}
+#${OVERLAY_ID} .ela-ok:active{background:#3f6fe8}
+`;
+
+function ensureStyle() {
+    if (document.getElementById(STYLE_ID)) {
+        return;
+    }
+    const style = document.createElement('style');
+    style.id = STYLE_ID;
+    style.textContent = CSS;
+    document.head.appendChild(style);
+}
+
+export function closeLoginAlert() {
+    const overlay = document.getElementById(OVERLAY_ID);
+    if (overlay && overlay.parentElement) {
+        overlay.parentElement.removeChild(overlay);
+    }
+    document.removeEventListener('keydown', onKeyDown, true);
+}
+
+function onKeyDown(event: KeyboardEvent) {
+    if (event.key === 'Escape') {
+        closeLoginAlert();
+    }
+}
+
+/** 알림창을 띄운다. 로그인 버튼을 누르면 창을 닫고 onLogin 을 호출한다. */
+export function showLoginAlert(onLogin?: () => void, message = lt('로그인 후 이용할 수 있습니다.', 'Please log in to use this feature.')) {
+    ensureStyle();
+    closeLoginAlert();
+    const overlay = document.createElement('div');
+    overlay.id = OVERLAY_ID;
+    overlay.innerHTML =
+        '<div class="ela-box" role="alertdialog" aria-modal="true">' +
+        '<div class="ela-head">' + lt('알림', 'Notice') + '<button class="ela-close" type="button" aria-label="' + lt('닫기', 'Close') + '"></button></div>' +
+        '<div class="ela-body"><p class="ela-msg"></p><button class="ela-ok" type="button">' + lt('로그인', 'Log in') + '</button></div>' +
+        '</div>';
+    (overlay.querySelector('.ela-msg') as HTMLElement).textContent = message;
+    (overlay.querySelector('.ela-close') as HTMLElement).onclick = closeLoginAlert;
+    (overlay.querySelector('.ela-ok') as HTMLElement).onclick = () => {
+        closeLoginAlert();
+        if (onLogin) {
+            onLogin();
+        }
+    };
+    document.body.appendChild(overlay);
+    document.addEventListener('keydown', onKeyDown, true);
+}
diff --git a/src/renderer/helper/loginChooser.ts b/src/renderer/helper/loginChooser.ts
new file mode 100644
index 00000000..f58c0e20
--- /dev/null
+++ b/src/renderer/helper/loginChooser.ts
@@ -0,0 +1,242 @@
+/**
+ * [entry-local] 로그인 방법 선택 창: 구글 계정 / 엔트리(네이버 계열)
+ * 고르면 'google' | 'entry', 닫으면 null.
+ */
+
+import { lt } from '../../common/localLang';
+import { BRAND_ICON, GOOGLE_ICON } from './brandIcon';
+export type LoginChoice = 'google' | 'entry';
+
+const STYLE_ID = 'entry-local-login-chooser-style';
+const CSS = `
+/* 로그인 안내창(loginAlert.ts)과 같은 모양: 파란 머리띠(제목 · 닫기) + 흰 본문 */
+.elc-backdrop { position: fixed; inset: 0; z-index: 8990; background: rgba(0,0,0,.6);
+  display: flex; align-items: center; justify-content: center; font-family: inherit; }
+.elc-box { display: flex; flex-direction: column; width: min(400px, calc(100vw - 32px)); max-height: calc(100vh - 32px);
+  background: #fff; border-radius: 6px; overflow: hidden; box-shadow: 0 6px 24px rgba(0,0,0,.25); box-sizing: border-box; }
+.elc-head { position: relative; flex: none; display: flex; align-items: center; height: 56px; padding: 0 70px 0 26px;
+  box-sizing: border-box; background: #4f80ff; color: #fff; font-size: 22px; font-weight: bold; }
+.elc-x { position: absolute; top: 50%; right: 30px; width: 26px; height: 26px; margin-top: -13px; padding: 0; border: 0;
+  background: none; cursor: pointer; }
+.elc-x:before, .elc-x:after { content: ""; position: absolute; top: 50%; left: 50%; width: 26px; height: 3px;
+  margin: -1.5px 0 0 -13px; background: #fff; border-radius: 2px; }
+.elc-x:before { transform: rotate(45deg); }
+.elc-x:after { transform: rotate(-45deg); }
+.elc-body { flex: 1; min-height: 0; overflow-y: auto; padding: 32px 24px 28px; box-sizing: border-box; }
+.elc-desc { margin: 0 0 24px; font-size: 18px; font-weight: bold; color: #333; text-align: center; line-height: 1.4; }
+.elc-btn { display: flex; align-items: center; gap: 14px; width: 100%; box-sizing: border-box; margin: 0 0 10px;
+  padding: 14px 16px; border-radius: 4px; border: 1px solid #dadce0; background: #fff; cursor: pointer; text-align: left;
+  font: inherit; color: #222; transition: background .15s, border-color .15s; }
+.elc-btn:hover, .elc-btn:focus-visible { background: #f5f8ff; border-color: #4f80ff; outline: none; }
+.elc-btn.elc-opt-entry { border-color: #16d8a3; }
+.elc-btn.elc-opt-entry:hover, .elc-btn.elc-opt-entry:focus-visible { background: #effcf7; border-color: #10b98a; }
+.elc-icon { flex: none; width: 36px; height: 36px; border-radius: 50%; display: flex; align-items: center; justify-content: center;
+  font-weight: 800; font-size: 18px; }
+.elc-icon.elc-opt-google { background: #fff; border: 1px solid #e0e0e0; color: #4285f4; }
+.elc-icon.elc-opt-entry { background: none; border-radius: 0; }
+.elc-icon img { width: 36px; height: 36px; display: block; object-fit: contain; }
+.elc-icon.elc-opt-google img { width: 20px; height: 20px; }
+.elc-label { display: block; font-size: 15px; font-weight: 700; }
+.elc-sub { display: block; margin-top: 3px; font-size: 12px; color: #888; }
+.elc-note { margin: 14px 0 0; font-size: 12px; color: #888; text-align: center; line-height: 1.5; }
+`;
+
+function ensureStyle() {
+    if (!document.getElementById(STYLE_ID)) {
+        const style = document.createElement('style');
+        style.id = STYLE_ID;
+        style.textContent = CSS;
+        document.head.appendChild(style);
+    }
+}
+
+function el<K extends keyof HTMLElementTagNameMap>(tag: K, className: string, text?: string) {
+    const node = document.createElement(tag);
+    node.className = className;
+    if (text !== undefined) {
+        node.textContent = text;
+    }
+    return node;
+}
+
+let open = false;
+
+export function chooseLoginMethod(options: { google: boolean; entry: boolean }): Promise<LoginChoice | null> {
+    if (open) {
+        return Promise.resolve(null);
+    }
+    open = true;
+    ensureStyle();
+    return new Promise((resolve) => {
+        const backdrop = el('div', 'elc-backdrop');
+        const box = el('div', 'elc-box');
+        box.setAttribute('role', 'dialog');
+        box.setAttribute('aria-modal', 'true');
+        box.setAttribute('aria-label', lt('로그인 방법 선택', 'Choose a login method'));
+        const head = el('div', 'elc-head', lt('로그인', 'Log in'));
+        const x = el('button', 'elc-x');
+        x.type = 'button';
+        x.setAttribute('aria-label', lt('닫기', 'Close'));
+        head.appendChild(x);
+        box.appendChild(head);
+        const body = el('div', 'elc-body');
+        box.appendChild(body);
+        body.appendChild(el('p', 'elc-desc', lt('어떤 계정으로 로그인할까요?', 'Which account would you like to log in with?')));
+
+        const close = (choice: LoginChoice | null) => {
+            document.removeEventListener('keydown', onKey, true);
+            backdrop.remove();
+            open = false;
+            resolve(choice);
+        };
+        const onKey = (e: KeyboardEvent) => {
+            if (e.key === 'Escape') {
+                e.stopPropagation();
+                close(null);
+            }
+        };
+
+        const addButton = (choice: LoginChoice, icon: string, label: string, sub: string) => {
+            const btn = el('button', `elc-btn elc-opt-${choice}`);
+            btn.type = 'button';
+            // 엔트리: 앱 아이콘과 같은 엔트리 로고 / 구글: 구글 'G' 로고
+            const logo = choice === 'entry' ? BRAND_ICON : choice === 'google' ? GOOGLE_ICON : '';
+            const iconEl = el('span', `elc-icon elc-opt-${choice}`, logo ? undefined : icon);
+            if (logo) {
+                const img = document.createElement('img');
+                img.src = logo;
+                img.alt = '';
+                iconEl.appendChild(img);
+            }
+            btn.appendChild(iconEl);
+            const text = el('span', '');
+            text.appendChild(el('span', 'elc-label', label));
+            text.appendChild(el('span', 'elc-sub', sub));
+            btn.appendChild(text);
+            btn.addEventListener('click', () => close(choice));
+            body.appendChild(btn);
+            return btn;
+        };
+
+        const first: HTMLButtonElement[] = [];
+        if (options.google) {
+            first.push(addButton('google', 'G', lt('Google 계정', 'Google account'), lt('작품을 내 구글 드라이브에 저장', 'Save projects to your Google Drive')));
+        }
+        if (options.entry) {
+            first.push(addButton('entry', 'e', lt('엔트리 · 네이버 계열', 'Entry · Naver accounts'), lt('엔트리 아이디 · 네이버 · 웨일 스페이스', 'Entry ID · Naver · Whale Space')));
+            body.appendChild(el('p', 'elc-note', lt('엔트리 공식 로그인 화면이 열립니다. 비밀번호는 이 앱에 저장되지 않습니다.', 'The official Entry login page will open. Your password is not stored in this app.')));
+        }
+        x.addEventListener('click', () => close(null));
+
+        backdrop.addEventListener('mousedown', (e) => {
+            if (e.target === backdrop) {
+                close(null);
+            }
+        });
+        document.addEventListener('keydown', onKey, true);
+        backdrop.appendChild(box);
+        document.body.appendChild(backdrop);
+        if (first[0]) {
+            first[0].focus();
+        }
+    });
+}
+
+/* ------------------------------------------------------------------ */
+/* 안내 창: 제목 + 번호 매긴 단계 + [취소] [확인]  → true / false        */
+/* ------------------------------------------------------------------ */
+const GUIDE_CSS = `
+.elg-box { width: min(480px, calc(100vw - 32px)); }
+.elg-intro { margin: 0 0 16px; font-size: 15px; color: #555; text-align: center; line-height: 1.6; }
+.elg-steps { list-style: none; margin: 0 0 20px; padding: 0; }
+.elg-step { display: flex; gap: 12px; align-items: flex-start; padding: 10px 0; border-top: 1px solid #eef0f3; }
+.elg-step:first-child { border-top: 0; }
+.elg-num { flex: none; width: 26px; height: 26px; border-radius: 50%; background: #4f80ff; color: #fff;
+  font-size: 14px; font-weight: 700; display: flex; align-items: center; justify-content: center; }
+.elg-head { display: block; font-size: 15px; font-weight: 700; color: #222; }
+.elg-text { display: block; margin-top: 3px; font-size: 13px; color: #777; line-height: 1.5; }
+.elg-buttons { display: flex; gap: 10px; }
+.elg-buttons button { flex: 1; height: 49px; border-radius: 4px; font: inherit; font-size: 17px; font-weight: bold; cursor: pointer; }
+.elg-cancel { border: 1px solid #4f80ff; background: #fff; color: #4f80ff; }
+.elg-ok { border: 1px solid #4f80ff; background: #4f80ff; color: #fff; }
+.elg-ok:active { background: #3f6fe8; }
+`;
+
+export function showGuideDialog(options: {
+    title: string;
+    intro?: string;
+    steps: [string, string][];
+    okLabel?: string;
+    cancelLabel?: string;
+}): Promise<boolean> {
+    ensureStyle();
+    if (!document.getElementById(`${STYLE_ID}-guide`)) {
+        const style = document.createElement('style');
+        style.id = `${STYLE_ID}-guide`;
+        style.textContent = GUIDE_CSS;
+        document.head.appendChild(style);
+    }
+    return new Promise((resolve) => {
+        const backdrop = el('div', 'elc-backdrop');
+        const box = el('div', 'elc-box elg-box');
+        box.setAttribute('role', 'dialog');
+        box.setAttribute('aria-modal', 'true');
+        box.setAttribute('aria-label', options.title);
+        const head = el('div', 'elc-head', options.title);
+        const x = el('button', 'elc-x');
+        x.type = 'button';
+        x.setAttribute('aria-label', lt('닫기', 'Close'));
+        head.appendChild(x);
+        box.appendChild(head);
+        const body = el('div', 'elc-body');
+        box.appendChild(body);
+        if (options.intro) {
+            body.appendChild(el('p', 'elg-intro', options.intro));
+        }
+        const list = el('ol', 'elg-steps');
+        options.steps.forEach(([head, text], i) => {
+            const item = el('li', 'elg-step');
+            item.appendChild(el('span', 'elg-num', String(i + 1)));
+            const body = el('span', '');
+            body.appendChild(el('span', 'elg-head', head));
+            if (text) {
+                body.appendChild(el('span', 'elg-text', text));
+            }
+            item.appendChild(body);
+            list.appendChild(item);
+        });
+        body.appendChild(list);
+
+        const buttons = el('div', 'elg-buttons');
+        const cancel = el('button', 'elg-cancel', options.cancelLabel || lt('취소', 'Cancel'));
+        const ok = el('button', 'elg-ok', options.okLabel || lt('확인', 'OK'));
+        cancel.type = 'button';
+        ok.type = 'button';
+        buttons.append(cancel, ok);
+        body.appendChild(buttons);
+
+        const close = (value: boolean) => {
+            document.removeEventListener('keydown', onKey, true);
+            backdrop.remove();
+            resolve(value);
+        };
+        const onKey = (e: KeyboardEvent) => {
+            if (e.key === 'Escape') {
+                e.stopPropagation();
+                close(false);
+            }
+        };
+        cancel.addEventListener('click', () => close(false));
+        x.addEventListener('click', () => close(false));
+        ok.addEventListener('click', () => close(true));
+        backdrop.addEventListener('mousedown', (e) => {
+            if (e.target === backdrop) {
+                close(false);
+            }
+        });
+        document.addEventListener('keydown', onKey, true);
+        backdrop.appendChild(box);
+        document.body.appendChild(backdrop);
+        ok.focus();
+    });
+}
diff --git a/src/renderer/helper/namePrompt.ts b/src/renderer/helper/namePrompt.ts
