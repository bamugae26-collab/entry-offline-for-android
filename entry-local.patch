+                        return;
+                    }
+                    started[0] = true;
+                    String wrapped = "Promise.resolve().then(() => " + script + ")" +
+                        ".then((v) => EntryLocalBridge.done('" + token + "', JSON.stringify({ ok: true, json: JSON.stringify(v === undefined ? null : v) })))" +
+                        ".catch((e) => EntryLocalBridge.done('" + token + "', JSON.stringify({ ok: false, error: String((e && e.message) || e) })));";
