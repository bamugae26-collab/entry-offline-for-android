+import { lt, setMainLang } from '../common/localLang';
+import { app, BrowserWindow, ipcMain, session, shell } from 'electron';
+import path from 'path';
+import fs from 'fs-extra';
+import createLogger from './utils/functions/createLogger';
+import MainUtils from './mainUtils';
+import {
+    ENTRY_ORIGIN,
+    EntryStatus,
+    EntryUser,
+    SHARE_SCRIPT,
+    USER_SCRIPT,
+    autoImportScript,
+    entryProfileUrl,
+    entryWorkspaceUrl,
+    exportProjectScript,
+    isAllowedExternalUrl,
+    isEntryPageAfterLogin,
+    listProjectsScript,
+    normalizeEntryUser,
+    projectIdFromWorkspaceUrl,
+    overwriteScript,
+} from '../common/entryAccount';
+
+/**
+ * [entry-local] 엔트리(playentry.org) 계정 로그인 — Windows(Electron)
+ *
+ * 엔트리 공식 로그인 페이지를 별도 창(전용 세션 'persist:entry-account')에 띄운다.
+ * 로그인이 끝나 엔트리 페이지로 이동하면 사용자 정보만 읽고 창을 닫는다.
+ * 비밀번호·토큰은 앱이 읽거나 저장하지 않는다 (세션 쿠키는 전용 세션 안에만).
+ */
+
+const logger = createLogger('main/entryAccount.ts');
+const PARTITION = 'persist:entry-account';
+// 시험용: 가짜 엔트리 서버 주소 (평소에는 비어 있음)
+const BASE = (process.env.ENTRY_LOCAL_ENTRY_BASE || ENTRY_ORIGIN).replace(/\/$/, '');
+const storeFile = () => path.join(app.getPath('userData'), 'entry-account.json');
+
+let user: EntryUser | undefined;
+let loaded = false;
+let loginInProgress: Promise<EntryUser> | undefined;
+
+function ensureLoaded() {
+    if (loaded) {
+        return;
+    }
+    loaded = true;
+    try {
+        user = normalizeEntryUser(fs.readJsonSync(storeFile(), { throws: false }));
+    } catch (e) {
+        user = undefined;
+    }
+}
+
+function saveUser(value?: EntryUser) {
+    user = value;
+    try {
+        if (value) {
+            fs.outputJsonSync(storeFile(), value);
+        } else {
+            fs.removeSync(storeFile());
+        }
+    } catch (e) {
+        logger.warn(`entry-account 저장 실패: ${(e as Error).message}`);
+    }
+    notifyStatus();
+}
+
+function status(): EntryStatus {
+    ensureLoaded();
+    return { loggedIn: !!user, user };
+}
+
+function notifyStatus() {
+    BrowserWindow.getAllWindows().forEach((w) => {
+        if (!w.isDestroyed()) {
+            w.webContents.send('entry:status', status());
+        }
+    });
+}
+
+function mainWindow() {
+    return BrowserWindow.getAllWindows().find((w) => !w.isDestroyed() && w.isVisible() && !w.getParentWindow());
+}
+
+async function readUser(win: BrowserWindow): Promise<EntryUser | undefined> {
+    try {
+        return normalizeEntryUser(await win.webContents.executeJavaScript(USER_SCRIPT, true));
+    } catch (e) {
+        return undefined;
+    }
+}
+
+function login(): Promise<EntryUser> {
+    if (loginInProgress) {
+        return loginInProgress;
+    }
+    loginInProgress = new Promise<EntryUser>((resolve, reject) => {
+        const parent = mainWindow();
+        const win = new BrowserWindow({
+            parent,
+            modal: !!parent,
+            width: 560,
+            height: 780,
+            title: lt('엔트리 로그인', 'Entry login'),
+            autoHideMenuBar: true,
+            backgroundColor: '#ffffff',
+            webPreferences: {
+                partition: PARTITION,
+                contextIsolation: true,
+                nodeIntegration: false,
+                sandbox: true,
+            },
+        });
+        win.setMenuBarVisibility(false);
+        let done = false;
+        let reloadedHome = false;
+
+        const finish = (result?: EntryUser, error?: Error) => {
+            if (done) {
+                return;
+            }
+            done = true;
+            if (!win.isDestroyed()) {
+                win.close();
+            }
+            if (result) {
+                saveUser(result);
+                // 로그인 쿠키를 바로 디스크에 기록 (앱이 갑자기 꺼져도 로그인 유지)
+                session
+                    .fromPartition(PARTITION)
+                    .cookies.flushStore()
+                    .catch(() => undefined);
+                if (parent && !parent.isDestroyed()) {
+                    parent.focus();
+                }
+                resolve(result);
+            } else {
+                reject(error || new Error(lt('로그인 창을 닫았습니다.', 'The login window was closed.')));
+            }
+        };
+
+        const check = async () => {
+            if (done || win.isDestroyed()) {
+                return;
+            }
+            const url = win.webContents.getURL();
+            if (!isEntryPageAfterLogin(url, BASE)) {
+                return;
+            }
+            const found = await readUser(win);
+            if (found) {
+                finish(found);
+            } else if (!reloadedHome) {
+                // 화면 전환만 된 경우 사용자 정보가 페이지에 없을 수 있어 첫 화면을 한 번 새로 연다
+                reloadedHome = true;
+                win.loadURL(`${BASE}/`).catch(() => undefined);
+            } else if (!win.isDestroyed() && !win.isVisible() && !win.webContents.isLoading()) {
+                // 로그인되지 않은 채 다른 페이지로 갔다 → 창을 다시 보여 준다
+                win.show();
+            }
+        };
+        // 로그인 직후 엔트리 첫 화면은 보여 주지 않는다: 창을 숨기고 사용자 정보를 읽는 즉시 닫는다
+        win.webContents.on('did-navigate', (_e, url) => {
+            if (!done && isEntryPageAfterLogin(url, BASE) && win.isVisible()) {
+                win.hide();
+            }
+        });
+        win.webContents.on('dom-ready', check);
+
+        // 네이버·웨일 스페이스 로그인 같은 팝업은 같은 세션의 작은 창으로
+        win.webContents.setWindowOpenHandler(() => ({
+            action: 'allow',
+            overrideBrowserWindowOptions: { parent: win, autoHideMenuBar: true, width: 520, height: 720 },
+        }));
+        win.webContents.on('did-finish-load', check);
+        win.webContents.on('did-navigate-in-page', () => setTimeout(check, 300));
+        win.on('closed', () => finish(undefined));
+        win.loadURL(`${BASE}/signin`).catch((e) => {
+            logger.warn(`엔트리 로그인 페이지 열기 실패: ${e.message}`);
+            finish(undefined, new Error(lt('엔트리 로그인 페이지를 열 수 없습니다. 인터넷 연결을 확인해 주세요.', 'Cannot open the Entry login page. Please check your internet connection.')));
+        });
+    }).finally(() => {
+        loginInProgress = undefined;
+    });
+    return loginInProgress;
+}
+
+async function logout() {
+    saveUser(undefined);
+    destroyWarm();
+    try {
+        await session.fromPartition(PARTITION).clearStorageData();
+    } catch (e) {
+        logger.warn(`엔트리 세션 정리 실패: ${(e as Error).message}`);
+    }
+}
+
+/** 앱 시작 후 한 번: 엔트리 세션이 아직 유효한지 조용히 확인 (만료되면 로그아웃 상태로) */
+let verified = false;
+async function verify() {
+    ensureLoaded();
+    if (verified || !user) {
+        return status();
+    }
+    verified = true;
+    const win = new BrowserWindow({
+        show: false,
+        webPreferences: { partition: PARTITION, contextIsolation: true, nodeIntegration: false, sandbox: true },
+    });
+    try {
+        await Promise.race([
+            win.loadURL(`${BASE}/`),
+            new Promise((_, reject) => setTimeout(() => reject(new Error('timeout')), 20000)),
+        ]);
+        const found = await readUser(win);
+        if (found) {
+            saveUser(found); // 닉네임이 바뀌었으면 갱신
+        } else {
+            logger.info('엔트리 세션 만료 — 로그아웃 상태로');
+            saveUser(undefined);
+        }
+    } catch (e) {
+        // 인터넷 끊김 등: 상태를 바꾸지 않는다
+        verified = false;
+    } finally {
+        if (!win.isDestroyed()) {
+            win.destroy();
+        }
+    }
+    return status();
+}
+
+/* ---------------- 엔트리 계정 작품 ---------------- */
+const tmpDir = () => path.join(app.getPath('userData'), 'entry-tmp');
+
+function requireUser(): EntryUser {
+    ensureLoaded();
+    if (!user) {
+        throw new Error(lt('엔트리 계정으로 로그인해 주세요.', 'Please log in with your Entry account.'));
+    }
+    return user;
+}
+
+/** 엔트리 페이지를 보이지 않는 창에 열고 스크립트(Promise 를 돌려주는 식)를 실행 */
+async function runInEntry<T>(url: string, script: string, timeoutMs = 90000): Promise<T> {
+    const win = new BrowserWindow({
+        show: false,
+        width: 1280,
+        height: 800,
+        webPreferences: {
+            partition: PARTITION,
+            contextIsolation: true,
+            nodeIntegration: false,
+            sandbox: true,
+            backgroundThrottling: false,
+        },
+    });
+    let timer: ReturnType<typeof setTimeout> | undefined;
+    try {
+        return await Promise.race([
+            (async () => {
+                await win.loadURL(url);
+                if (!isEntryPageAfterLogin(win.webContents.getURL(), BASE)) {
+                    // 로그인 화면으로 돌려보내졌다 = 세션 만료
+                    saveUser(undefined);
+                    throw new Error(lt('엔트리 로그인이 만료되었습니다. 다시 로그인해 주세요.', 'Your Entry login has expired. Please log in again.'));
+                }
+                return (await win.webContents.executeJavaScript(script, true)) as T;
+            })(),
+            new Promise<T>((_, reject) => {
+                timer = setTimeout(() => reject(new Error(lt('엔트리 응답이 없습니다. 인터넷 연결을 확인해 주세요.', 'No response from Entry. Please check your internet connection.'))), timeoutMs);
+            }),
+        ]);
+    } finally {
+        if (timer) {
+            clearTimeout(timer);
+        }
+        if (!win.isDestroyed()) {
+            win.destroy();
+        }
+    }
+}
+
+async function listProjects(start = 0, display = 60) {
+    const me = requireUser();
+    return runInEntry<{ total: number; list: any[] }>(`${BASE}/`, listProjectsScript(me.id, start, display), 30000);
+}
+
+async function loadProject(projectId: string, name: string) {
+    requireUser();
+    // [1.1] 작업 화면 창(warm)에서 받아 오고 창은 그대로 둔다 → 이 작품을 다시 계정에 저장할 때 바로 저장
+    let result: { name: string; base64: string };
+    if (saveInProgress) {
+        result = await runInEntry<{ name: string; base64: string }>(
+            entryWorkspaceUrl(projectId, BASE),
+            exportProjectScript(name || lt('엔트리 작품', 'Entry project'))
+        );
+    } else {
+        const ok = await loadWarm(entryWorkspaceUrl(projectId, BASE));
+        const w = warm;
+        if (!ok || !w || w.win.isDestroyed()) {
+            const signedOut = !!w && !w.win.isDestroyed() && !isEntryPageAfterLogin(w.win.webContents.getURL(), BASE);
+            destroyWarm();
+            if (signedOut) {
+                saveUser(undefined);
+                throw new Error(lt('엔트리 로그인이 만료되었습니다. 다시 로그인해 주세요.', 'Your Entry login has expired. Please log in again.'));
+            }
+            throw new Error(lt('엔트리 응답이 없습니다. 인터넷 연결을 확인해 주세요.', 'No response from Entry. Please check your internet connection.'));
+        }
+        try {
+            result = await Promise.race([
+                w.win.webContents.executeJavaScript(exportProjectScript(name || lt('엔트리 작품', 'Entry project')), true),
+                new Promise<never>((_, reject) =>
+                    setTimeout(() => reject(new Error(lt('엔트리 응답이 없습니다. 인터넷 연결을 확인해 주세요.', 'No response from Entry. Please check your internet connection.'))), 90000)
+                ),
+            ]);
+            setWarmActive(w, false);
+        } catch (e) {
+            destroyWarm();
+            throw e;
+        }
+    }
+    const tmp = path.join(tmpDir(), `${projectId.replace(/[^a-z0-9]/gi, '')}.ent`);
+    await fs.outputFile(tmp, Buffer.from(result.base64, 'base64'));
+    try {
+        const project = await MainUtils.loadProject(tmp);
+        project.entryProjectId = projectId;
+        project.name = result.name || name || project.name;
+        delete project.savedPath;
+        delete project.cloudFileId;
+        return project;
+    } finally {
+        fs.remove(tmp).catch(() => undefined);
+    }
+}
+
+/**
+ * 엔트리 계정에 저장 (완전 자동, 화면에 보이지 않음)
+ * 보이지 않는 창에 엔트리 새 작업 화면(/ws/new)을 열고, 사이트의 [file] → [오프라인 작품 불러오기]에
+ * 지금 작품(.ent)을 직접 넣는다. 엔트리는 그 파일로 계정에 새 작품을 만들고 /ws/<새 id> 로 이동한다 → 완료.
+ * 결과: { projectId, saved, failed }
+ */
+let saveInProgress: Promise<{ projectId?: string; saved?: boolean; failed?: boolean }> | undefined;
+
+/* ------------------------------------------------------------------ */
+/* [1.1] 계정 저장 가속 — 엔트리 작업 화면 창을 다시 쓴다                  */
+/* 저장할 때마다 보이지 않는 창에 엔트리 작업 화면(수 MB)을 새로 불러오던 것이 */
+/* 시간의 대부분이었다. 저장이 끝난 창을 닫지 않고 그 작품 화면 그대로 두었다가 */
+/* 같은 작품을 다시 저장하면 불러오기 없이 바로 저장한다.                    */
+/*  - 계정 작품을 열었거나 저장 메뉴를 열면 미리 불러 둔다 (prewarm)          */
+/*  - 10분 동안 저장이 없거나, 로그아웃·실패·취소·앱 종료 때 닫는다          */
+/*  - 쉬는 동안은 창의 동작을 늦춰(throttle) 컴퓨터 자원을 거의 쓰지 않는다   */
+/* ------------------------------------------------------------------ */
+const WARM_IDLE_MS = 10 * 60 * 1000;
+type Warm = {
+    win: BrowserWindow;
+    url?: string; // 다 불러온 작업 화면 주소
+    loading?: Promise<boolean>;
+    idleTimer?: ReturnType<typeof setTimeout>;
+};
+let warm: Warm | undefined;
+
+function destroyWarm() {
+    const w = warm;
+    warm = undefined;
+    if (w) {
+        w.idleTimer && clearTimeout(w.idleTimer);
+        if (!w.win.isDestroyed()) {
+            w.win.destroy();
+        }
+    }
+}
+app.on('before-quit', destroyWarm);
+
+function warmWindow(): Warm {
+    if (warm && !warm.win.isDestroyed()) {
+        return warm;
+    }
+    const win = new BrowserWindow({
+        show: false,
+        width: 1280,
+        height: 800,
+        webPreferences: { partition: PARTITION, contextIsolation: true, nodeIntegration: false, sandbox: true, backgroundThrottling: false },
+    });
+    const w: Warm = { win };
+    win.on('closed', () => {
+        if (warm === w) {
+            warm = undefined;
+        }
+    });
+    // 다 불러온 주소를 기억 (엔트리가 다른 작품 화면으로 이동해도 그 주소로)
+    win.webContents.on('did-finish-load', () => {
+        if (warm === w && !win.isDestroyed()) {
+            w.url = win.webContents.getURL();
+        }
+    });
+    win.webContents.on('did-start-navigation', (_e, _url, isInPlace, isMainFrame) => {
+        if (isMainFrame && !isInPlace && warm === w) {
+            w.url = undefined; // 새로 불러오는 중
+        }
+    });
+    warm = w;
+    return w;
+}
+
+function setWarmActive(w: Warm, active: boolean) {
+    w.idleTimer && clearTimeout(w.idleTimer);
+    w.idleTimer = undefined;
+    if (w.win.isDestroyed()) {
+        return;
+    }
+    try {
+        w.win.webContents.setBackgroundThrottling(!active);
+    } catch (e) {
+        // 지원하지 않는 버전
+    }
+    if (!active) {
+        w.idleTimer = setTimeout(() => warm === w && destroyWarm(), WARM_IDLE_MS);
+    }
+}
+
+const sameWs = (a?: string, b?: string) => {
+    const ia = a && projectIdFromWorkspaceUrl(a);
+    const ib = b && projectIdFromWorkspaceUrl(b);
+    return !!ia && ia === ib;
+};
+
+/** 작업 화면 창에 url 을 (이미 열려 있지 않으면) 불러온다 → 다 불러왔으면 true */
+function loadWarm(url: string, timeoutMs = 90000): Promise<boolean> {
+    const w = warmWindow();
+    setWarmActive(w, true);
+    if (w.url && sameWs(w.url, url) && isEntryPageAfterLogin(w.url, BASE)) {
+        return Promise.resolve(true);
+    }
+    if (w.loading && w.win.webContents.getURL() && sameWs(w.win.webContents.getURL(), url)) {
+        return w.loading;
+    }
+    const p = new Promise<boolean>((resolve) => {
+        let done = false;
+        const finish = (ok: boolean) => {
+            if (done) {
+                return;
+            }
+            done = true;
+            clearTimeout(timer);
+            w.win.isDestroyed() || w.win.webContents.removeListener('did-finish-load', onLoad);
+            resolve(ok);
+        };
+        const onLoad = () => finish(!w.win.isDestroyed() && isEntryPageAfterLogin(w.win.webContents.getURL(), BASE));
+        const timer = setTimeout(() => finish(false), timeoutMs);
+        w.win.webContents.on('did-finish-load', onLoad);
+        w.win.loadURL(url).catch(() => undefined);
+        w.win.once('closed', () => finish(false));
+    }).finally(() => {
+        if (w.loading === p) {
+            w.loading = undefined;
+        }
+    });
+    w.loading = p;
+    return p;
+}
+
+/** [1.1] 저장 메뉴를 열었거나 계정 작품을 열었을 때 작업 화면을 미리 불러 둔다 */
+async function prewarm(projectId?: string) {
+    ensureLoaded();
+    if (!user || saveInProgress) {
+        return;
+    }
+    const url = entryWorkspaceUrl(projectId && /^[0-9a-f]{24}$/i.test(projectId) ? projectId : undefined, BASE);
+    const ok = await loadWarm(url);
+    if (warm && !saveInProgress) {
+        if (!ok && warm.win && !warm.win.isDestroyed() && !isEntryPageAfterLogin(warm.win.webContents.getURL(), BASE)) {
+            saveUser(undefined); // 엔트리 세션 만료
+            destroyWarm();
+            return;
+        }
+        setWarmActive(warm, false);
+    }
+}
+
+/** 엔트리 계정 작품(projectId)에 덮어쓰기 — 작업 화면 창에서 그 작품을 열고(이미 열려 있으면 그대로) overwriteScript 실행 */
+async function overwriteOnSite(
+    entBase64: string,
+    projectId: string
+): Promise<{ saved?: boolean; fallback?: boolean; cancelled?: boolean; reason?: string }> {
+    const started = Date.now();
+    const result = await new Promise<{ saved?: boolean; fallback?: boolean; cancelled?: boolean; reason?: string }>((resolve) => {
+        let finished = false;
+        const finish = (r: { saved?: boolean; fallback?: boolean; cancelled?: boolean; reason?: string }) => {
+            if (finished) {
+                return;
+            }
+            finished = true;
+            clearTimeout(timer);
+            resolve(r);
+        };
+        const timer = setTimeout(() => finish({ reason: 'timeout' }), 120000);
+        cancelCurrentSave = () => finish({ cancelled: true });
+        if (cancelRequested) {
+            finish({ cancelled: true });
+            return;
+        }
+        (async () => {
+            const ok = await loadWarm(entryWorkspaceUrl(projectId, BASE));
+            const w = warm;
+            if (finished) {
+                return;
+            }
+            if (!ok || !w || w.win.isDestroyed()) {
+                if (w && !w.win.isDestroyed() && !isEntryPageAfterLogin(w.win.webContents.getURL(), BASE)) {
+                    saveUser(undefined); // 엔트리 세션 만료
+                    finish({ reason: 'signed-out' });
+                } else {
+                    finish({ reason: 'load' });
+                }
+                return;
+            }
+            try {
+                const r = await w.win.webContents.executeJavaScript(overwriteScript(entBase64, projectId), true);
+                logger.info(`엔트리 계정 덮어쓰기: ${JSON.stringify(r)} (${Date.now() - started}ms)`);
+                finish({ saved: !!(r && r.saved), fallback: !!(r && r.fallback), reason: r && r.reason });
+            } catch (e) {
+                logger.warn(`엔트리 계정 덮어쓰기 실패: ${(e as Error).message}`);
+                finish({ reason: 'script' });
+            }
+        })();
+    });
+    if (result.saved && warm) {
+        setWarmActive(warm, false); // 다음 저장을 위해 그대로 둔다
+    } else {
+        destroyWarm(); // 실패·취소: 하던 일을 멈추고 다음에는 새로
+    }
+    return result;
+}
+
+/** [entry-local] 진행 중인 계정 저장을 멈춘다 (대기 창의 [취소]) */
+let cancelCurrentSave: (() => void) | undefined;
+let cancelRequested = false; // 숨은 창이 준비되기 전에 [취소]를 누른 경우
+
+function saveViaSite(project: any, options: { entryProjectId?: string; name: string }) {
+    requireUser();
+    if (saveInProgress) {
+        return saveInProgress;
+    }
+    cancelRequested = false;
+    saveInProgress = (async () => {
+        const tmp = path.join(tmpDir(), `${Date.now()}`, 'entry-local-project.ent');
+        await fs.ensureDir(path.dirname(tmp));
+        project.name = options.name || project.name;
+        await MainUtils.saveProject(project, tmp);
+        const entBase64 = (await fs.readFile(tmp)).toString('base64');
+        fs.remove(path.dirname(tmp)).catch(() => undefined);
+
+        // 계정에서 불러온(또는 이미 계정에 저장한) 작품이면 그 작품에 덮어쓴다
+        if (options.entryProjectId && /^[0-9a-f]{24}$/i.test(options.entryProjectId)) {
+            const over = await overwriteOnSite(entBase64, options.entryProjectId);
+            if (over.saved || over.cancelled || !over.fallback) {
+                return over.saved
+                    ? { projectId: options.entryProjectId, saved: true }
+                    : over.cancelled
+                    ? {}
+                    : { failed: true };
+            }
+            // 덮어쓸 수 없는 작품(지워졌거나 남의 작품) → 아래에서 새 작품으로 저장
+        }
+        if (cancelRequested) {
+            return {};
+        }
+
+        // 새 작품으로 저장: 작업 화면 창(미리 불러 둔 /ws/new 가 있으면 그대로)에서 '오프라인 작품 불러오기'
+        const result = await new Promise<{ projectId?: string; saved?: boolean; failed?: boolean }>((resolve) => {
+            let finished = false;
+            const w = warmWindow();
+            const wc = w.win.webContents;
+            const finish = (r: { projectId?: string; saved?: boolean; failed?: boolean }) => {
+                if (finished) {
+                    return;
+                }
+                finished = true;
+                clearTimeout(timer);
+                if (!w.win.isDestroyed()) {
+                    wc.removeListener('did-navigate', onNav);
+                    wc.removeListener('did-navigate-in-page', onNav);
+                }
+                resolve(r);
+            };
+            const timer = setTimeout(() => finish({ failed: true }), 90000);
+            cancelCurrentSave = () => finish({}); // 취소: 저장도 실패도 아님
+            if (cancelRequested) {
+                finish({});
+                return;
+            }
+            let startId: string | undefined;
+            let started = false;
+            const onUrl = (url: string) => {
+                if (!isEntryPageAfterLogin(url, BASE)) {
+                    // 로그인 화면으로 돌려보내짐 = 엔트리 세션 만료
+                    saveUser(undefined);
+                    finish({ failed: true });
+                    return;
+                }
+                const id = projectIdFromWorkspaceUrl(url);
+                if (started && id && id !== startId) {
+                    // 엔트리가 새 작품을 만들고 그 작업 화면으로 이동함 = 저장 완료
+                    finish({ projectId: id, saved: true });
+                }
+            };
+            const onNav = (_e: any, url: string) => onUrl(url);
+            wc.on('did-navigate', onNav);
+            wc.on('did-navigate-in-page', onNav);
+            (async () => {
+                const newUrl = entryWorkspaceUrl(undefined, BASE);
+                // 미리 불러 둔 창이 이미 '새 작품' 화면이면 그대로, 아니면 새로 불러온다
+                const cur = w.url || '';
+                let ok = true;
+                if (!(cur && !projectIdFromWorkspaceUrl(cur) && /\/ws\/new/.test(cur))) {
+                    ok = await new Promise<boolean>((res) => {
+                        const onLoad = () => res(true);
+                        wc.once('did-finish-load', onLoad);
+                        setWarmActive(w, true);
+                        w.win.loadURL(newUrl).catch(() => res(false));
+                    });
+                } else {
+                    setWarmActive(w, true);
+                }
+                if (finished) {
+                    return;
+                }
+                if (!ok) {
+                    finish({ failed: true });
+                    return;
+                }
+                startId = projectIdFromWorkspaceUrl(wc.getURL());
+                started = true;
+                try {
+                    const r = await wc.executeJavaScript(autoImportScript(entBase64), true);
+                    if (!r || !r.fed) {
+                        logger.warn('엔트리 오프라인 작품 불러오기를 찾지 못함');
+                        finish({ failed: true });
+                    }
+                } catch (e) {
+                    // 불러오기 직후 페이지가 이동하면 스크립트가 끊긴다 (정상) — 이동으로 완료를 판단
+                }
+            })();
+        });
+        cancelCurrentSave = undefined;
+        if (result.saved && warm) {
+            // 창은 새 작품 화면으로 옮겨 가는 중 → 다 불러오면 다음 저장(덮어쓰기)에 그대로 쓴다
+            setWarmActive(warm, false);
+        } else {
+            destroyWarm();
+        }
+        return result;
+    })().finally(() => {
+        cancelCurrentSave = undefined;
+        saveInProgress = undefined;
+    });
+    return saveInProgress;
+}
+
+/**
+ * [작품 공유하기] — 웹판 저장 완료 창의 버튼과 같은 동작.
+ * 작품의 엔트리 작업 화면을 앱 안 창에 열고 엔트리 자체의 '작품 공유하기' 패널을 띄운다.
+ * 사용자가 공유를 마치거나(엔트리가 다른 페이지로 이동) 취소하면 창을 닫는다. 결과 { shared }
+ */
+let shareInProgress: Promise<{ shared: boolean }> | undefined;
+function shareProject(projectId: string) {
+    requireUser();
+    if (shareInProgress) {
+        return shareInProgress;
+    }
+    shareInProgress = new Promise<{ shared: boolean }>((resolve, reject) => {
+        const parent = mainWindow();
+        const win = new BrowserWindow({
+            parent,
+            modal: !!parent,
+            width: 1280,
+            height: 820,
+            title: lt('작품 공유하기', 'Share project'),
+            autoHideMenuBar: true,
+            backgroundColor: '#ffffff',
+            webPreferences: { partition: PARTITION, contextIsolation: true, nodeIntegration: false, sandbox: true },
+        });
+        win.setMenuBarVisibility(false);
+        let shared = false;
+        let poll: ReturnType<typeof setInterval> | undefined;
+        const done = () => {
+            if (poll) {
+                clearInterval(poll);
+                poll = undefined;
+            }
+            if (!win.isDestroyed()) {
+                win.close();
+            }
+        };
+        win.on('closed', () => {
+            if (poll) {
+                clearInterval(poll);
+            }
+            if (parent && !parent.isDestroyed()) {
+                parent.focus();
+            }
+            resolve({ shared });
+        });
+        const onUrl = (url: string) => {
+            // 공유를 마치면 엔트리가 작업 화면을 떠난다 (공유한 작품 페이지 등)
+            try {
+                const p = new URL(url).pathname;
+                if (p.startsWith('/signin')) {
+                    saveUser(undefined); // 엔트리 세션 만료
+                    done();
+                } else if (!p.startsWith('/ws/')) {
+                    shared = true;
+                    setTimeout(done, 1500);
+                }
+            } catch (e) {
+                // 무시
+            }
+        };
+        win.webContents.on('did-navigate', (_e, url) => onUrl(url));
+        win.webContents.on('did-navigate-in-page', (_e, url) => onUrl(url));
+        win.webContents.once('did-finish-load', async () => {
+            try {
+                const r = await win.webContents.executeJavaScript(SHARE_SCRIPT, true);
+                if (!r || !r.opened) {
+                    logger.warn('엔트리 작품 공유하기 패널을 열지 못함');
+                    return; // 창은 그대로 둔다 (사용자가 엔트리 화면에서 직접 할 수 있게)
+                }
+            } catch (e) {
+                return;
+            }
+            poll = setInterval(async () => {
+                if (win.isDestroyed()) {
+                    return;
+                }
+                const state = await win.webContents.executeJavaScript('window.__elShare || ""').catch(() => '');
+                if (state === 'cancel') {
+                    done();
+                } else if (state === 'shared') {
+                    shared = true;
+                    setTimeout(done, 1500);
+                }
+            }, 600);
+        });
+        win.loadURL(entryWorkspaceUrl(projectId, BASE)).catch(() => {
+            if (!win.isDestroyed()) {
+                win.destroy();
+            }
+            reject(new Error(lt('엔트리 작업 화면을 열 수 없습니다. 인터넷 연결을 확인해 주세요.', 'Cannot open the Entry workspace. Please check your internet connection.')));
+        });
+    }).finally(() => {
+        shareInProgress = undefined;
+    });
+    return shareInProgress;
+}
+
+const wrap = (fn: (...args: any[]) => any) => async (event: any, ...args: any[]) => {
+    try {
+        return await fn(...args);
+    } catch (e) {
+        throw new Error((e as Error).message);
+    }
+};
+
+ipcMain.handle('entry:status', wrap(() => status()));
+ipcMain.handle('entry:verify', wrap(() => verify()));
+ipcMain.handle('entry:login', wrap(() => login()));
+ipcMain.handle('entry:logout', wrap(() => logout()));
+ipcMain.handle('entry:projects', wrap((start, display) => listProjects(start, display)));
+ipcMain.handle('entry:load', wrap((projectId, name) => loadProject(projectId, name)));
+ipcMain.handle('entry:saveViaSite', wrap((project, options) => saveViaSite(project, options)));
+ipcMain.handle('entry:share', wrap((projectId) => shareProject(projectId)));
+ipcMain.handle('entry:prewarm', wrap((projectId) => prewarm(projectId).catch(() => undefined)));
+ipcMain.handle(
+    'entry:cancelSave',
+    wrap(async () => {
+        cancelRequested = true;
+        cancelCurrentSave && cancelCurrentSave();
+    })
+);
+ipcMain.handle('entry:base', wrap(() => BASE));
+ipcMain.handle('entryLocal:setLang', wrap((lang) => setMainLang(lang)));
+ipcMain.handle(
+    'entry:profileUrl',
+    wrap(() => {
+        ensureLoaded();
+        return user ? entryProfileUrl(user).replace(ENTRY_ORIGIN, BASE) : `${BASE}/`;
+    })
+);
+ipcMain.handle(
+    'app:openExternal',
+    wrap(async (url: string) => {
+        if (!isAllowedExternalUrl(url) && !(BASE !== ENTRY_ORIGIN && url.startsWith(BASE))) {
+            throw new Error(lt('열 수 없는 주소입니다.', 'This address cannot be opened.'));
+        }
+        await shell.openExternal(url);
+    })
+);
