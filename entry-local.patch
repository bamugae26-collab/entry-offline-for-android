+/**
+ * [entry-local] 엔트리(playentry.org) 계정 — Windows·안드로이드 공통 상수
+ *
+ * 공식 API 가 없으므로 앱 안에 엔트리 **공식 로그인 페이지**를 띄우고,
+ * 로그인 후 엔트리 페이지에 들어 있는 사용자 정보(Next.js __NEXT_DATA__)만 읽는다.
+ * - 비밀번호는 엔트리 페이지에만 입력되고 앱은 받거나 저장하지 않는다.
+ * - 로그인 세션(쿠키)은 엔트리 로그인 창 전용 저장소에만 남는다 (작품 화면과 분리).
+ * - 앱이 기억하는 것: 사용자 id, 아이디(username), 닉네임.
+ * 엔트리 사이트 구조가 바뀌면 USER_SCRIPT 만 고치면 된다.
+ */
+
+import { lt } from './localLang';
+
+export type EntryUser = { id: string; username: string; nickname: string; canShare?: boolean };
+export type EntryStatus = { loggedIn: boolean; user?: EntryUser };
+
+export const ENTRY_ORIGIN = 'https://playentry.org';
+export const ENTRY_SIGNIN_URL = `${ENTRY_ORIGIN}/signin`;
+export const ENTRY_HOME_URL = `${ENTRY_ORIGIN}/`;
+
+export const entryProfileUrl = (user: EntryUser) => `${ENTRY_ORIGIN}/profile/${encodeURIComponent(user.id)}`;
+
+/**
+ * 엔트리 페이지 안에서 실행: 로그인한 사용자 { id, username, nickname } 또는 null (Promise)
+ * 엔트리는 로그인 후 주소만 바꾸고 페이지 데이터(__NEXT_DATA__)는 로그인 화면 것 그대로 두므로,
+ * 지금 페이지 데이터가 로그인 화면 것이면 첫 화면(/)을 직접 받아 그 안의 사용자 정보를 읽는다.
+ * (실제 사이트 확인: props.pageProps.initialState.common.user = { id, username, nickname, xToken, … })
+ */
+export const USER_SCRIPT = `(async () => {
+  const pick = (d) => {
+    try {
+      const p = (d && d.props) || {};
+      const s = (x) => x && x.common && x.common.user;
+      const u = s(p.pageProps && p.pageProps.initialState) || s(p.initialState);
+      const id = u && (u.id || u._id);
+      if (!id) return null;
+      // 웹판과 같은 기준: 이메일 인증 + 학생 계정 아님 → 저장 완료 창에 [작품 공유하기]
+      return { id: String(id), username: String(u.username || ''), nickname: String(u.nickname || u.username || ''), canShare: !!(u.isEmailAuth && u.role !== 'student') };
+    } catch (e) { return null; }
+  };
+  try {
+    const el = document.getElementById('__NEXT_DATA__');
+    const d = el ? JSON.parse(el.textContent || '{}') : null;
+    if (d && d.page !== '/signin') { const u = pick(d); if (u) return u; }
+  } catch (e) {}
+  try {
+    const res = await fetch('/', { credentials: 'include', cache: 'no-store' });
+    const html = await res.text();
+    const m = /<script id="__NEXT_DATA__"[^>]*>([\\s\\S]*?)<\\/script>/.exec(html);
+    return m ? pick(JSON.parse(m[1])) : null;
+  } catch (e) { return null; }
+})()`;
+
+/** 로그인 페이지가 아닌 엔트리 페이지인가 (로그인 완료 후 이동한 곳) */
+export function isEntryPageAfterLogin(url: string, base = ENTRY_ORIGIN) {
+    try {
+        const u = new URL(url);
+        const b = new URL(base);
+        const sameSite = u.host === b.host || (b.hostname === 'playentry.org' && u.hostname === 'www.playentry.org');
+        return sameSite && !u.pathname.startsWith('/signin');
+    } catch (e) {
+        return false;
+    }
+}
+
+export function normalizeEntryUser(value: any): EntryUser | undefined {
+    if (!value || typeof value !== 'object' || !value.id) {
+        return undefined;
+    }
+    return {
+        id: String(value.id),
+        username: String(value.username || ''),
+        nickname: String(value.nickname || value.username || ''),
+        canShare: value.canShare === undefined ? true : !!value.canShare,
+    };
+}
+
+/** 앱 밖 브라우저로 열어도 되는 주소 (그 외는 열지 않음) */
+export function isAllowedExternalUrl(url: string) {
+    try {
+        const u = new URL(url);
+        return (
+            u.protocol === 'https:' &&
+            ['playentry.org', 'www.playentry.org', 'drive.google.com', 'myaccount.google.com'].includes(u.hostname)
+        );
+    } catch (e) {
+        return false;
+    }
+}
+
+/* ------------------------------------------------------------------ */
+/* 엔트리 계정 작품 — 엔트리 페이지 안에서 실행하는 스크립트            */
+/* (엔트리 로그인 세션·CSRF 토큰을 그대로 쓰려고 엔트리 페이지 안에서 요청) */
+/* ------------------------------------------------------------------ */
+
+export type EntryProjectMeta = {
+    id: string;
+    name: string;
+    thumb?: string;
+    created?: string;
+    updated?: string;
+    isopen?: boolean;
+};
+
+export const entryWorkspaceUrl = (projectId?: string, base = ENTRY_ORIGIN) =>
+    projectId ? `${base}/ws/${encodeURIComponent(projectId)}` : `${base}/ws/new`;
+export const entryProjectPageUrl = (projectId: string) => `${ENTRY_ORIGIN}/project/${encodeURIComponent(projectId)}`;
+export const entryThumbUrl = (thumb?: string, base = ENTRY_ORIGIN) =>
+    !thumb ? undefined : /^https?:/.test(thumb) ? thumb : `${base}${thumb.startsWith('/') ? '' : '/'}${thumb}`;
+
+/** 작업 화면 주소에서 작품 id (/ws/<24자리 hex>) */
+export function projectIdFromWorkspaceUrl(url: string) {
+    const m = /\/ws\/([0-9a-f]{24})(?:[/?#]|$)/i.exec(url || '');
+    return m ? m[1] : undefined;
+}
+
+// 엔트리 페이지의 CSRF·x-token 헤더
+const HEADERS_FN = `function __entryHeaders() {
+  const h = { 'Content-Type': 'application/json', 'Accept': 'application/json', 'X-Client-Type': 'Client' };
+  const meta = document.querySelector('meta[name="csrf-token"]');
+  if (meta && meta.content) h['CSRF-Token'] = meta.content;
+  try {
+    const d = JSON.parse((document.getElementById('__NEXT_DATA__') || {}).textContent || '{}');
+    const p = (d && d.props) || {};
+    const s = (x) => x && x.common && x.common.user;
+    const u = s(p.pageProps && p.pageProps.initialState) || s(p.initialState);
+    const x = (u && u.xToken) || localStorage.getItem('playentry_token');
+    if (x) h['x-token'] = x;
+  } catch (e) {}
+  return h;
+}`;
+
+/** 내 작품 목록 (최근 수정 순) → { total, list } */
+export function listProjectsScript(userId: string, start: number, display: number) {
+    const query =
+        'query SELECT_USER_PROJECTS($user: String!, $pageParam: PageParam, $isOpen: String, $term: String) {' +
+        ' userProjectList(user: $user, pageParam: $pageParam, isOpen: $isOpen, term: $term) {' +
+        ' total list { id name thumb created updated isopen } } }';
+    const body = JSON.stringify({
+        operationName: 'SELECT_USER_PROJECTS',
+        query,
+        variables: { user: userId, pageParam: { display, sort: 'updated', start, order: 'desc' }, isOpen: 'all', term: 'all' },
+    });
+    return `(async () => {
+  ${HEADERS_FN}
+  const res = await fetch('/graphql/SELECT_USER_PROJECTS', { method: 'POST', credentials: 'include', headers: __entryHeaders(), body: ${JSON.stringify(body)} });
+  if (res.status === 401 || res.status === 403) throw new Error(${JSON.stringify(lt('엔트리 로그인이 만료되었습니다. 다시 로그인해 주세요.', 'Your Entry login has expired. Please log in again.'))});
+  if (!res.ok) throw new Error(${JSON.stringify(lt('엔트리 작품 목록을 받지 못했습니다', 'Could not get the Entry project list'))} + ' (' + res.status + ')');
+  const j = await res.json();
+  if (j.errors && j.errors.length) throw new Error(${JSON.stringify(lt('엔트리 작품 목록 오류: ', 'Entry project list error: '))} + (j.errors[0].message || ''));
+  const d = j.data && j.data.userProjectList;
+  return { total: d ? d.total : 0, list: d && d.list ? d.list : [] };
+})()`;
+}
+
+/**
+ * 작업 화면(/ws/<id>)에 열린 작품을 .ent 로 받아 base64 로 돌려준다.
+ * 엔트리가 작품을 다 불러올 때까지 기다린 뒤 Entry.exportProject() → POST /rest/project/download
+ */
+export function exportProjectScript(fallbackName: string) {
+    return `(async () => {
+  ${HEADERS_FN}
+  const sleep = (ms) => new Promise((r) => setTimeout(r, ms));
+  const started = Date.now();
+  let project;
+  while (Date.now() - started < 60000) {
+    try {
+      const E = window.Entry;
+      if (E && typeof E.exportProject === 'function' && E.container && E.playground && E.engine) {
+        const p = E.exportProject();
+        if (p && Array.isArray(p.objects) && (p.objects.length || Date.now() - started > 15000)) { project = p; break; }
+      }
+    } catch (e) {}
+    await sleep(500);
+  }
+  if (!project) throw new Error(${JSON.stringify(lt('엔트리 작업 화면에서 작품을 불러오지 못했습니다.', 'Could not load the project in the Entry workspace.'))});
+  const name = project.name || ${JSON.stringify(fallbackName)};
+  const res = await fetch('/rest/project/download', { method: 'POST', credentials: 'include', headers: __entryHeaders(), body: JSON.stringify({ content: project, name }) });
+  if (!res.ok) throw new Error(${JSON.stringify(lt('엔트리 작품 파일을 받지 못했습니다', 'Could not get the Entry project file'))} + ' (' + res.status + ')');
+  let buf = new Uint8Array(await res.arrayBuffer());
+  if (!(buf[0] === 0x1f && buf[1] === 0x8b)) {
+    // 파일 대신 주소를 돌려주는 경우
+    let link = '';
+    try { const j = JSON.parse(new TextDecoder().decode(buf)); link = j.url || j.path || j.filename || ''; } catch (e) {}
+    if (!link) throw new Error(${JSON.stringify(lt('엔트리 작품 파일 형식이 다릅니다.', 'The Entry project file format is different.'))});
+    const r2 = await fetch(link, { credentials: 'include' });
+    buf = new Uint8Array(await r2.arrayBuffer());
+    if (!(buf[0] === 0x1f && buf[1] === 0x8b)) throw new Error(${JSON.stringify(lt('엔트리 작품 파일 형식이 다릅니다.', 'The Entry project file format is different.'))});
+  }
+  let bin = '';
+  for (let i = 0; i < buf.length; i += 0x8000) bin += String.fromCharCode.apply(null, buf.subarray(i, i + 0x8000));
+  return { name, base64: btoa(bin) };
+})()`;
+}
+
+/* ------------------------------------------------------------------ */
+/* 계정 저장 (완전 자동) — 실제 엔트리 작업 화면 구조 기준 (2026-10-22 확인)  */
+/*  - 상단 아이콘 버튼 글자: file / save / help (아이콘 이름)                  */
+/*  - file 메뉴: 새로 만들기 · 작품 불러오기 · 오프라인 작품 불러오기 (약 1초 뒤 표시) */
+/*  - 오프라인 작품 불러오기 = .ent 를 올려 계정에 새 작품을 만들고 /ws/<새 id> 로 이동 */
+/* 파일 선택 창을 띄우지 않고 파일을 직접 넣는다 (input.click 을 가로채 DataTransfer). */
+/* ------------------------------------------------------------------ */
+
+export const ENTRY_IMPORT_LABEL = '오프라인 작품 불러오기';
+
+/**
+ * 작품 파일(.ent) 내용을 스크립트에 넣는 방법
+ *  - 글자 그대로(base64): Windows
+ *  - 식(expression): 안드로이드 — 큰 작품을 스크립트에 몇 번씩 넣어 보내지 않도록, 페이지가 앱에서 직접 받아 온다
+ */
+export type EntSource = string | { expr: string };
+const entJs = (src: EntSource) => (typeof src === 'string' ? JSON.stringify(src) : src.expr);
+
+/** 작업 화면에서 실행: 작품(.ent, base64)을 '오프라인 작품 불러오기'로 넣는다 → { fed, how } (Promise) */
+export function autoImportScript(entBase64: EntSource) {
+    return `(async () => {
+  const sleep = (ms) => new Promise((r) => setTimeout(r, ms));
+  const started = Date.now();
+  while (Date.now() - started < 60000) {
+    const E = window.Entry;
+    if (E && E.container && E.playground && E.engine && typeof E.exportProject === 'function') break;
+    await sleep(400);
+  }
+  await sleep(1500); // 편집기가 준비된 직후에는 메뉴 버튼이 아직 반응하지 않기도 한다
+  const bin = atob(${entJs(entBase64)});
+  const bytes = new Uint8Array(bin.length);
+  for (let i = 0; i < bin.length; i++) bytes[i] = bin.charCodeAt(i);
+  const file = new File([bytes], 'entry-local-project.ent', { type: 'application/octet-stream' });
+  const st = (window.__elImport = { fed: false, how: '' });
+  const c0 = HTMLInputElement.prototype.click;
+  HTMLInputElement.prototype.click = function () {
+    if (this.type === 'file' && !st.fed && /\\.ent/.test(this.accept || '.ent')) {
+      st.fed = true;
+      const dt = new DataTransfer();
+      dt.items.add(file);
+      this.files = dt.files;
+      this.dispatchEvent(new Event('change', { bubbles: true }));
+      return;
+    }
+    return c0.apply(this, arguments);
+  };
+  const vis = (e) => { const r = e.getBoundingClientRect(); return r.width > 0 && r.height > 0; };
+  const item = () => [...document.querySelectorAll('body *')].find((e) => !e.children.length && (e.textContent || '').trim() === ${JSON.stringify(ENTRY_IMPORT_LABEL)} && vis(e));
+  const fileBtn = () => [...document.querySelectorAll('button')].find((b) => /^(file|파일)$/.test((b.textContent || '').trim()) && vis(b));
+  for (let tries = 0; tries < 6 && !st.fed; tries++) {
+    let it = item();
+    if (!it) {
+      const b = fileBtn();
+      if (b) b.click();
+      // 실제 사이트는 페이지가 열린 직후 메뉴가 3초 넘게 걸리기도 한다 → 다시 누르면 닫히므로 6초까지 기다린다
+      for (let i = 0; i < 24 && !(it = item()); i++) await sleep(250);
+    }
+    if (it) { st.how = 'menu'; it.click(); await sleep(800); }
+    else await sleep(500);
+  }
+  if (!st.fed) {
+    // 메뉴를 못 찾음: 작업 화면에 늘 있는 .ent 입력칸으로 직접
+    const input = document.querySelector('input[type=file][accept*=".ent"]');
+    if (input) { st.how = 'input'; input.click(); }
+  }
+  return { fed: st.fed, how: st.how };
+})()`;
+}
+
+
+/* ------------------------------------------------------------------ */
+/* [작품 공유하기] — 웹판 저장 완료 창의 버튼과 같은 동작                    */
+/* 작업 화면(/ws/<id>)의 작업 공간 관리자(React 컨텍스트 값)의 openShareProject(id) 를 불러  */
+/* 엔트리 자체의 '작품 공유하기' 패널(제목·카테고리·미리보기·공유하기)을 연다.            */
+/* window.__elShare: 'open' → 'cancel'(취소·닫기) / 공유가 끝나면 엔트리가 다른 페이지로 이동 */
+/* ------------------------------------------------------------------ */
+/**
+ * 엔트리 계정 작품에 '덮어쓰기' 저장 — 작업 화면(/ws/<targetId>)에서 실행한다. 페이지를 옮기지 않는다.
+ *  1) .ent 를 엔트리 '오프라인 작품 불러오기'와 같은 주소(/rest/project/upload)로 올린다 → 모양·소리가 엔트리에 올라간다
+ *     (로그인 상태면 엔트리가 임시 작품을 하나 만든다)
+ *  2) 임시 작품 내용을 읽어 지금 열린 작품(targetId)에 넣고(reloadEntry) 엔트리 자체 [저장하기](saveProject → UPDATE_PROJECT)
+ *  3) 임시 작품은 지운다 (DELETE_PROJECT)
+ * 결과 { fed, saved, reason? } — fallback: true 면 덮어쓸 수 없는 작품(남의 작품·없어진 작품) → 새 작품으로 저장
+ */
+export function overwriteScript(entBase64: EntSource, targetId: string) {
+    return `(async () => {
+  ${HEADERS_FN}
+  const sleep = (ms) => new Promise((r) => setTimeout(r, ms));
+  const gql = async (name, query, variables) => {
+    const res = await fetch('/graphql/' + name, { method: 'POST', credentials: 'include', headers: __entryHeaders(), body: JSON.stringify({ operationName: name, query, variables }) });
+    const j = await res.json().catch(() => ({}));
+    if (!res.ok || (j.errors && j.errors.length)) throw new Error(name + ' ' + res.status + ' ' + ((j.errors && j.errors[0] && j.errors[0].message) || ''));
+    return j.data || {};
+  };
+  const updatedOf = async (id) => {
+    try { const d = await gql('SELECT_PROJECT', 'query SELECT_PROJECT($id: ID! $groupId: ID) { project(id: $id, groupId: $groupId) { id updated } }', { id }); return d.project && d.project.updated; } catch (e) { return undefined; }
+  };
+  const findCtrl = () => {
+    const root = document.getElementById('__next');
+    const key = root && Object.keys(root).find((k) => k.startsWith('__reactContainer'));
+    let start = key && root[key];
+    if (start && start.stateNode && start.stateNode.current) start = start.stateNode.current;
+    const stack = [start];
+    for (let n = 0; stack.length && n < 50000; n++) {
+      const f = stack.pop();
+      if (!f) continue;
+      const v = f.memoizedProps && f.memoizedProps.value;
+      if (v && typeof v === 'object' && typeof v.saveProject === 'function' && typeof v.reloadEntry === 'function') return v;
+      if (f.child) stack.push(f.child);
+      if (f.sibling) stack.push(f.sibling);
+    }
+    return null;
+  };
+  const target = ${JSON.stringify(targetId)};
+  // [1.1] 빠르게: 정해진 시간(1.5초)을 기다리지 않고, 작업 화면 관리자가 준비되는 즉시 시작한다
+  //       (이미 열려 있는 작업 화면을 다시 쓰면 바로 시작) — 작품 id 가 아직 바뀌는 중이면 잠깐 더 기다린다
+  const t0 = Date.now();
+  let ctrl = null;
+  while (Date.now() - t0 < 60000) {
+    const E = window.Entry;
+    if (E && E.container && E.playground && E.engine) {
+      ctrl = findCtrl();
+      if (ctrl && ctrl.isLogined !== undefined && (ctrl.projectId === target || Date.now() - t0 > 8000)) break;
+    }
+    await sleep(200);
+  }
+  document.querySelectorAll('.tooltipGuide .close').forEach((c) => { try { c.click(); } catch (e) {} });
+  if (!ctrl) return { fed: false, reason: 'no-workspace' };
+  if (!ctrl.isLogined) return { fed: false, reason: 'login' };
+  // 지금 열린 작품이 내 작품(targetId)인지 확인 — 아니면 덮어쓰지 않고 새 작품으로 저장
+  if (ctrl.projectId !== target) return { fed: false, fallback: true, reason: 'not-found' };
+  const owner = ctrl.projectData && ctrl.projectData.user;
+  const me = ctrl.user;
+  if (owner && me && (owner.id || owner._id) && (owner.id || owner._id) !== (me.id || me._id)) return { fed: false, fallback: true, reason: 'not-mine' };
+  // 저장 전 수정 시각은 올리기와 동시에 받아 둔다 (기다리는 시간 줄이기)
+  const beforeP = updatedOf(target);
+
+  // 1) 올리기
+  const bin = atob(${entJs(entBase64)});
+  const bytes = new Uint8Array(bin.length);
+  for (let i = 0; i < bin.length; i++) bytes[i] = bin.charCodeAt(i);
+  const form = new FormData();
+  form.append('projects', new File([bytes], 'entry-local-project.ent', { type: 'application/octet-stream' }));
+  const h = __entryHeaders();
+  delete h['Content-Type'];
+  const up = await fetch('/rest/project/upload', { method: 'POST', credentials: 'include', headers: h, body: form });
+  if (!up.ok) return { fed: false, reason: 'upload-' + up.status };
+  const s = await up.json();
+  if (!s || s.errors) return { fed: false, reason: 'upload-error' };
+  let tempId = s._id || s.id && s.objects === undefined && s.id;
+  let content = s.objects ? s : null;
+  const removeTemp = async () => {
+    if (!tempId || tempId === target) return;
+    try { await gql('DELETE_PROJECT', 'mutation DELETE_PROJECT($id: ID!) { deleteProject(id: $id) { status result } }', { id: tempId }); } catch (e) {}
+  };
+  try {
+    // 2) 임시 작품 내용 읽기 (엔트리가 올린 모양·소리 주소가 들어 있다)
+    if (!content && tempId) {
+      const full = 'id name speed objects variables messages functions tables scenes cloudVariable learning expansionBlocks aiUtilizeBlocks hardwareLiteBlocks';
+      const basic = 'id name speed objects variables messages functions scenes';
+      for (const fields of [full, basic]) {
+        try {
+          const d = await gql('SELECT_PROJECT', 'query SELECT_PROJECT($id: ID! $groupId: ID) { project(id: $id, groupId: $groupId) { ' + fields + ' } }', { id: tempId });
+          if (d.project && d.project.objects) { content = d.project; break; }
+        } catch (e) {}
+      }
+    }
+    if (!content) return { fed: false, reason: 'no-content' };
+    content = Object.assign({}, content, { id: target });
+    // 3) 지금 작품에 넣고 엔트리 자체 저장 (내 작품 → 덮어쓰기)
+    let saveError = false;
+    const alert0 = ctrl.alertProjectSaveError;
+    ctrl.alertProjectSaveError = function () { saveError = true; return alert0 && alert0.apply(this, arguments); };
+    await ctrl.reloadEntry(content);
+    await sleep(400);
+    await ctrl.saveProject();
+    ctrl.alertProjectSaveError = alert0;
+    const before = await beforeP;
+    // 저장 확인과 임시 작품 지우기를 동시에
+    const [after] = await Promise.all([updatedOf(target), removeTemp()]);
+    tempId = undefined;
+    const saved = !saveError && (before === undefined || after === undefined || after !== before);
+    return { fed: true, saved, reason: saved ? undefined : 'save-failed' };
+  } finally {
+    await removeTemp();
+  }
+})()`;
+}
+
+export const SHARE_SCRIPT = `(async () => {
+  const sleep = (ms) => new Promise((r) => setTimeout(r, ms));
+  const t0 = Date.now();
+  while (Date.now() - t0 < 60000) {
+    const E = window.Entry;
+    if (E && E.container && E.playground && E.engine) break;
+    await sleep(400);
+  }
+  await sleep(1200);
+  document.querySelectorAll('.tooltipGuide .close').forEach((c) => { try { c.click(); } catch (e) {} }); // 첫 방문 안내 닫기
+  const root = document.getElementById('__next');
+  const key = root && Object.keys(root).find((k) => k.startsWith('__reactContainer'));
+  let start = key && root[key];
+  if (start && start.stateNode && start.stateNode.current) start = start.stateNode.current;
+  let ctrl = null;
+  const stack = [start];
+  for (let n = 0; stack.length && n < 50000 && !ctrl; n++) {
+    const f = stack.pop();
+    if (!f) continue;
+    const v = f.memoizedProps && f.memoizedProps.value;
+    if (v && typeof v === 'object' && typeof v.openShareProject === 'function') ctrl = v;
+    if (f.child) stack.push(f.child);
+    if (f.sibling) stack.push(f.sibling);
+  }
+  if (!ctrl) return { opened: false };
+  const id = location.pathname.split('/')[2];
+  const hide0 = ctrl.hideShareProject;
+  ctrl.hideShareProject = function (e) {
+    window.__elShare = e && e.href ? 'shared' : 'cancel';
+    return hide0.apply(this, arguments);
+  };
+  window.__elShare = 'open';
+  ctrl.openShareProject(id);
+  return { opened: true };
+})()`;
