+/**
+ * [entry-local/web] 안드로이드(WebView)·브라우저용 렌더러 빌드
+ * Electron 렌더러와 같은 소스를 target: web 으로 묶고, preload 대신 src/web/shim.ts 를 붙인다.
+ */
+const path = require('path');
+const ExtractTextPlugin = require('extract-text-webpack-plugin');
+const { CleanWebpackPlugin } = require('clean-webpack-plugin');
+
+const root = path.resolve(__dirname, '..');
+const production = process.env.NODE_ENV === 'production';
+
+module.exports = {
+    mode: production ? 'production' : 'development',
+    devtool: production ? false : 'source-map',
+    target: 'web',
+    entry: {
+        shim: './src/web/shim.ts',
+        init: './src/renderer/initEntry.ts',
+        render: './src/renderer/renderEntry.tsx',
+    },
+    output: {
+        path: path.resolve(root, 'src', 'renderer_build_web'),
+        filename: '[name].bundle.js',
+        publicPath: '../../renderer_build_web/',
+    },
+    resolve: {
+        extensions: ['.ts', '.tsx', '.js', '.json'],
+        modules: [path.resolve(root, 'node_modules'), path.resolve(root, 'mobile', 'node_modules'), 'node_modules'],
+    },
+    externals: {
+        '@entrylabs/tool': 'EntryTool',
+        '@entrylabs/tool/component': 'EntryTool.Component',
+        'entry-paint': 'EntryPaint',
+    },
+    node: {
+        fs: 'empty',
+        net: 'empty',
+        tls: 'empty',
+        child_process: 'empty',
+    },
+    module: {
+        rules: [
+            {
+                test: /\.tsx?$/,
+                exclude: /node_modules/,
+                loader: 'ts-loader',
+                options: { configFile: path.resolve(root, 'tsconfig.web.json') },
+            },
+            {
+                test: /\.m?js$/,
+                include: /mobile[\\/]node_modules/,
+                type: 'javascript/auto',
+            },
+            {
+                test: /\.scss$/,
+                use: ExtractTextPlugin.extract({
+                    fallback: 'style-loader',
+                    use: [
+                        { loader: 'css-loader', options: { importLoaders: 1, url: false } },
+                        { loader: 'sass-loader', options: { sourceMap: false } },
+                    ],
+                }),
+            },
+            {
+                test: /\.css$/,
+                use: ExtractTextPlugin.extract({ fallback: 'style-loader', use: 'css-loader' }),
+            },
+            {
+                test: /\.(ico|png|jpg|jpeg|gif|svg|woff|woff2|ttf|eot|cur)(\?v=[0-9]\.[0-9]\.[0-9])?$/,
+                loader: 'url-loader',
+                options: { name: '[hash].[ext]', limit: 10000 },
+            },
+        ],
+    },
+    performance: { hints: false },
+    plugins: [new CleanWebpackPlugin(), new ExtractTextPlugin('bundle.css')],
+};
