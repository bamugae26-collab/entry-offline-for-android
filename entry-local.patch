@@ -0,0 +1,334 @@
+/**
+ * [entry-local] 구글 드라이브 클라이언트 (Drive API v3, 범위: drive.file)
+ *
+ * Electron 메인 프로세스와 웹/안드로이드 양쪽에서 쓰므로 HTTP 는 주입받는다.
+ * drive.file 범위라서 이 앱이 만든 파일과 폴더만 보이고 다룰 수 있다.
+ *
+ * 저장 구조: 내 드라이브 / 엔트리 로컬 / <작품 이름>.ent
+ */
+
+import { lt } from './localLang';
+export type GoogleConfig = {
+    /** Windows(Electron) 용 '데스크톱 앱' OAuth 클라이언트 */
+    desktopClientId?: string;
+    desktopClientSecret?: string;
+    /** 안드로이드·웹용 '웹 애플리케이션' OAuth 클라이언트 ID (안드로이드는 Credential Manager 가 사용) */
+    webClientId?: string;
+    /** 아래는 기본값이 구글 주소. 시험용 가짜 서버로 바꿀 때만 지정 */
+    authUrl?: string;
+    tokenUrl?: string;
+    revokeUrl?: string;
+    userInfoUrl?: string;
+    apiBase?: string;
+    uploadBase?: string;
+    folderName?: string;
+};
+
+export const GOOGLE_DEFAULTS = {
+    authUrl: 'https://accounts.google.com/o/oauth2/v2/auth',
+    tokenUrl: 'https://oauth2.googleapis.com/token',
+    revokeUrl: 'https://oauth2.googleapis.com/revoke',
+    userInfoUrl: 'https://www.googleapis.com/oauth2/v3/userinfo',
+    apiBase: 'https://www.googleapis.com/drive/v3',
+    uploadBase: 'https://www.googleapis.com/upload/drive/v3',
+    folderName: '엔트리 로컬',
+};
+
+export const DRIVE_SCOPES = ['openid', 'email', 'profile', 'https://www.googleapis.com/auth/drive.file'];
+
+export type HttpRequest = {
+    method: string;
+    url: string;
+    headers?: { [key: string]: string };
+    body?: Uint8Array | string;
+};
+export type HttpResponse = {
+    status: number;
+    headers: { [key: string]: string }; // 소문자 키
+    body: Uint8Array;
+};
+export type HttpFn = (req: HttpRequest) => Promise<HttpResponse>;
+
+export type CloudFile = {
+    id: string;
+    name: string; // 화면에 보일 작품 이름
+    fileName: string;
+    modifiedTime: number;
+    createdTime: number;
+    size: number;
+    thumbnailLink?: string;
+};
+
+export class DriveError extends Error {
+    constructor(message: string, public status: number) {
+        super(message);
+        this.name = 'DriveError';
+    }
+}
+
+const FOLDER_MIME = 'application/vnd.google-apps.folder';
+const ENT_MIME = 'application/x-entry-project';
+const enc = new TextEncoder();
+const dec = new TextDecoder();
+
+function base64UrlFromDataUrl(dataUrl?: string) {
+    if (!dataUrl) {
+        return undefined;
+    }
+    const b64 = dataUrl.replace(/^data:[^;]*;base64,/, '');
+    return b64.replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
+}
+
+function escapeQuery(value: string) {
+    return value.replace(/\\/g, '\\\\').replace(/'/g, "\\'");
+}
+
+export function safeFileName(name: string) {
+    return `${(name || lt('작품', 'Project')).replace(/[\\/:*?"<>|\n\r\t]/g, '_').slice(0, 120)}.ent`;
+}
+
+export class DriveClient {
+    private folderId?: string;
+    private readonly cfg: Required<Pick<GoogleConfig, 'apiBase' | 'uploadBase' | 'folderName'>>;
+
+    /**
+     * @param http        HTTP 구현
+     * @param getToken    유효한 액세스 토큰을 돌려준다. forceRefresh 이면 새로 받아야 한다.
+     */
+    constructor(
+        private readonly http: HttpFn,
+        private readonly getToken: (forceRefresh?: boolean) => Promise<string>,
+        config: GoogleConfig = {}
+    ) {
+        this.cfg = {
+            apiBase: config.apiBase || GOOGLE_DEFAULTS.apiBase,
+            uploadBase: config.uploadBase || GOOGLE_DEFAULTS.uploadBase,
+            folderName: config.folderName || GOOGLE_DEFAULTS.folderName,
+        };
+    }
+
+    resetCache() {
+        this.folderId = undefined;
+    }
+
+    /** 인증 헤더를 붙여 요청. 401 이면 토큰을 새로 받아 한 번 더 시도 */
+    private async call(req: HttpRequest, expect: number[] = [200]): Promise<HttpResponse> {
+        let token = await this.getToken(false);
+        let res = await this.http({ ...req, headers: { ...(req.headers || {}), Authorization: `Bearer ${token}` } });
+        if (res.status === 401) {
+            token = await this.getToken(true);
+            res = await this.http({ ...req, headers: { ...(req.headers || {}), Authorization: `Bearer ${token}` } });
+        }
+        if (expect.indexOf(res.status) === -1) {
+            let message = `HTTP ${res.status}`;
+            try {
+                const err = JSON.parse(dec.decode(res.body));
+                message = (err.error && (err.error.message || err.error)) || message;
+            } catch (e) {
+                // 본문이 JSON 이 아님
+            }
+            throw new DriveError(String(message), res.status);
+        }
+        return res;
+    }
+
+    private async json(req: HttpRequest, expect?: number[]) {
+        const res = await this.call(req, expect);
+        return res.body.length ? JSON.parse(dec.decode(res.body)) : {};
+    }
+
+    async ensureFolder(): Promise<string> {
+        if (this.folderId) {
+            return this.folderId;
+        }
+        const q = `name='${escapeQuery(this.cfg.folderName)}' and mimeType='${FOLDER_MIME}' and trashed=false and 'root' in parents`;
+        const found = await this.json({
+            method: 'GET',
+            url: `${this.cfg.apiBase}/files?q=${encodeURIComponent(q)}&fields=${encodeURIComponent('files(id,name)')}&spaces=drive&pageSize=10`,
+        });
+        if (found.files && found.files.length) {
+            this.folderId = found.files[0].id as string;
+            return this.folderId;
+        }
+        const created = await this.json({
+            method: 'POST',
+            url: `${this.cfg.apiBase}/files?fields=id`,
+            headers: { 'Content-Type': 'application/json; charset=UTF-8' },
+            body: JSON.stringify({ name: this.cfg.folderName, mimeType: FOLDER_MIME, parents: ['root'] }),
+        });
+        this.folderId = created.id as string;
+        return this.folderId;
+    }
+
+    async list(): Promise<CloudFile[]> {
+        const folder = await this.ensureFolder();
+        const q = `'${escapeQuery(folder)}' in parents and trashed=false and mimeType!='${FOLDER_MIME}'`;
+        const fields = 'nextPageToken,files(id,name,modifiedTime,createdTime,size,thumbnailLink,appProperties)';
+        const files: CloudFile[] = [];
+        let pageToken = '';
+        do {
+            const res = await this.json({
+                method: 'GET',
+                url:
+                    `${this.cfg.apiBase}/files?q=${encodeURIComponent(q)}&fields=${encodeURIComponent(fields)}` +
+                    `&orderBy=${encodeURIComponent('modifiedTime desc')}&pageSize=200&spaces=drive` +
+                    (pageToken ? `&pageToken=${encodeURIComponent(pageToken)}` : ''),
+            });
+            (res.files || []).forEach((f: any) => {
+                if (!/\.ent$/i.test(f.name || '')) {
+                    return;
+                }
+                files.push({
+                    id: f.id,
+                    name: (f.appProperties && f.appProperties.title) || String(f.name).replace(/\.ent$/i, ''),
+                    fileName: f.name,
+                    modifiedTime: Date.parse(f.modifiedTime) || 0,
+                    createdTime: Date.parse(f.createdTime) || 0,
+                    size: Number(f.size) || 0,
+                    thumbnailLink: f.thumbnailLink,
+                });
+            });
+            pageToken = res.nextPageToken || '';
+        } while (pageToken);
+        return files;
+    }
+
+    /** 새로 만들거나(fileId 없음) 덮어쓴다. 재개 가능 업로드(크기 제한 없음) 사용 */
+    async upload(bytes: Uint8Array, options: { fileId?: string; name: string; thumbnail?: string }): Promise<CloudFile> {
+        const folder = await this.ensureFolder();
+        const metadata: any = {
+            name: safeFileName(options.name),
+            mimeType: ENT_MIME,
+            appProperties: { entryLocal: '1', title: options.name.slice(0, 100) },
+        };
+        const thumb = base64UrlFromDataUrl(options.thumbnail);
+        if (thumb) {
+            metadata.contentHints = { thumbnail: { image: thumb, mimeType: 'image/png' } };
+        }
+        let session: HttpResponse;
+        if (options.fileId) {
+            session = await this.call({
+                method: 'PATCH',
+                url: `${this.cfg.uploadBase}/files/${encodeURIComponent(options.fileId)}?uploadType=resumable`,
+                headers: { 'Content-Type': 'application/json; charset=UTF-8', 'X-Upload-Content-Type': ENT_MIME },
+                body: JSON.stringify(metadata),
+            });
+        } else {
+            metadata.parents = [folder];
+            session = await this.call({
+                method: 'POST',
+                url: `${this.cfg.uploadBase}/files?uploadType=resumable`,
+                headers: { 'Content-Type': 'application/json; charset=UTF-8', 'X-Upload-Content-Type': ENT_MIME },
+                body: JSON.stringify(metadata),
+            });
+        }
+        const location = session.headers.location;
+        if (!location) {
+            throw new DriveError(lt('업로드 주소를 받지 못했습니다.', 'Could not get an upload address.'), session.status);
+        }
+        const done = await this.call(
+            { method: 'PUT', url: location, headers: { 'Content-Type': ENT_MIME }, body: bytes },
+            [200, 201]
+        );
+        const f = JSON.parse(dec.decode(done.body));
+        return {
+            id: f.id,
+            name: options.name,
+            fileName: f.name || metadata.name,
+            modifiedTime: Date.now(),
+            createdTime: Date.now(),
+            size: bytes.length,
+        };
+    }
+
+    async download(fileId: string): Promise<Uint8Array> {
+        const res = await this.call({
+            method: 'GET',
+            url: `${this.cfg.apiBase}/files/${encodeURIComponent(fileId)}?alt=media`,
+        });
+        return res.body;
+    }
+
+    async getName(fileId: string): Promise<string> {
+        const f = await this.json({
+            method: 'GET',
+            url: `${this.cfg.apiBase}/files/${encodeURIComponent(fileId)}?fields=${encodeURIComponent('name,appProperties')}`,
+        });
+        return (f.appProperties && f.appProperties.title) || String(f.name || '').replace(/\.ent$/i, '');
+    }
+
+    async rename(fileId: string, name: string) {
+        await this.json({
+            method: 'PATCH',
+            url: `${this.cfg.apiBase}/files/${encodeURIComponent(fileId)}?fields=id`,
+            headers: { 'Content-Type': 'application/json; charset=UTF-8' },
+            body: JSON.stringify({ name: safeFileName(name), appProperties: { title: name.slice(0, 100) } }),
+        });
+    }
+
+    /** 휴지통으로 이동 (드라이브에서 30일 안에 복구 가능) */
+    async trash(fileId: string) {
+        await this.json({
+            method: 'PATCH',
+            url: `${this.cfg.apiBase}/files/${encodeURIComponent(fileId)}?fields=id`,
+            headers: { 'Content-Type': 'application/json; charset=UTF-8' },
+            body: JSON.stringify({ trashed: true }),
+        });
+    }
+
+    /** 썸네일을 data URL 로 (없거나 실패하면 undefined) */
+    async thumbnail(link?: string): Promise<string | undefined> {
+        if (!link) {
+            return undefined;
+        }
+        try {
+            const res = await this.call({ method: 'GET', url: link });
+            const type = res.headers['content-type'] || 'image/png';
+            let binary = '';
+            const chunk = 0x8000;
+            for (let i = 0; i < res.body.length; i += chunk) {
+                binary += String.fromCharCode.apply(null, res.body.subarray(i, i + chunk) as any);
+            }
+            const b64 = typeof btoa === 'function' ? btoa(binary) : Buffer.from(res.body).toString('base64');
+            return `data:${type.split(';')[0]};base64,${b64}`;
+        } catch (e) {
+            return undefined;
+        }
+    }
+}
+
+/* ------------------------------------------------------------------ */
+/* OAuth 보조 (PKCE)                                                    */
+/* ------------------------------------------------------------------ */
+export function randomString(bytes: Uint8Array) {
+    const chars = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-._~';
+    let s = '';
+    bytes.forEach((b) => {
+        s += chars[b % chars.length];
+    });
+    return s;
+}
+
+export function base64UrlEncode(bytes: Uint8Array) {
+    let binary = '';
+    bytes.forEach((b) => {
+        binary += String.fromCharCode(b);
+    });
+    const b64 = typeof btoa === 'function' ? btoa(binary) : Buffer.from(bytes).toString('base64');
+    return b64.replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
+}
+
+export function formBody(params: { [key: string]: string | undefined }) {
+    return Object.keys(params)
+        .filter((k) => params[k] !== undefined)
+        .map((k) => `${encodeURIComponent(k)}=${encodeURIComponent(params[k] as string)}`)
+        .join('&');
+}
+
+export function decodeText(bytes: Uint8Array) {
+    return dec.decode(bytes);
+}
+
+export function encodeText(text: string) {
+    return enc.encode(text);
+}
