+ *
+ * 실제 구글과 같게 검사하는 것: client_id/secret, redirect_uri 일치, PKCE(S256), state 전달,
+ * Bearer 토큰(20초 만료 → 갱신 필요), drive.file 범위 요구, 재개 가능 업로드, 페이지 나눔, CORS
+ */
+const http = require('http');
+const crypto = require('crypto');
+
+const PORT = Number(process.argv[2] || 8200);
+const BASE = `http://127.0.0.1:${PORT}`;
+const CLIENTS = {
+    'desktop-test.apps.googleusercontent.com': { secret: 'desktop-secret', type: 'desktop' },
+    'web-test.apps.googleusercontent.com': { secret: 'web-secret', type: 'web' },
+};
+const TOKEN_TTL = Number(process.env.MOCK_TOKEN_TTL || 20);
+const PAGE_SIZE_CAP = 2; // 목록 페이지 나눔을 시험하려고 작게
+
+let db;
+function reset() {
+    db = {
+        codes: {}, // code -> {client, redirect, challenge, scope}
+        refresh: {}, // token -> {client, scope, email}
+        access: {}, // token -> {expires, scope, email}
+        files: {}, // id -> {id,name,mimeType,parents,appProperties,trashed,content,thumb,created,modified}
+        sessions: {}, // sid -> {fileId|null, metadata}
+        log: [],
+        counters: { tokenRefresh: 0, unauthorized: 0, uploads: 0 },
+    };
+}
+reset();
+
+const USER = { email: 'tester@example.com', name: '테스트 선생님', picture: '' };
+const id = () => crypto.randomBytes(9).toString('base64url');
+const b64url = (buf) => Buffer.from(buf).toString('base64url');
+
+function send(res, status, body, headers = {}) {
+    const isBuf = Buffer.isBuffer(body);
+    const data = isBuf ? body : typeof body === 'string' ? body : JSON.stringify(body);
+    res.writeHead(status, {
+        'Access-Control-Allow-Origin': '*',
+        'Access-Control-Expose-Headers': 'Location, Content-Type',
+        'Content-Type': isBuf ? headers['Content-Type'] || 'application/octet-stream' : typeof body === 'string' ? 'text/html; charset=utf-8' : 'application/json; charset=UTF-8',
+        ...headers,
+    });
+    res.end(data);
+}
+
+function readBody(req) {
+    return new Promise((resolve) => {
+        const chunks = [];
+        req.on('data', (c) => chunks.push(c));
+        req.on('end', () => resolve(Buffer.concat(chunks)));
+    });
+}
+
+function auth(req, res, needDrive = true) {
