+/**
+ * [entry-local 1.2] 안드로이드: 웹 시리얼(navigator.serial) 대신
+ *
+ * 엔트리의 '하드웨어 웹 연결(Hardware Lite)'은 크롬 PC 의 Web Serial 로 기기(아두이노·마이크로비트·햄스터 등)와
+ * 직접 통신한다. 안드로이드 웹뷰에는 Web Serial 이 없어서, 같은 모양의 navigator.serial 을 만들고
+ * 실제 USB 통신은 앱 플러그인(EntrySerialPlugin.java, USB OTG)에 맡긴다.
+ * 엔트리가 쓰는 부분만 만든다: requestPort / getPorts · port.open / close / readable / writable / getInfo / setSignals
+ */
+import { registerPlugin, PluginListenerHandle } from '@capacitor/core';
+import { isNative } from './platform';
+
+type PortInfo = { portId: string; name: string; usbVendorId: number; usbProductId: number };
+
+interface EntrySerialPlugin {
+    list(): Promise<{ ports: PortInfo[] }>;
+    requestPort(): Promise<PortInfo>;
+    open(options: { portId: string; baudRate: number; dataBits?: number; stopBits?: number; parity?: string }): Promise<void>;
+    write(options: { portId: string; data: string }): Promise<void>;
+    setSignals(options: { portId: string; dataTerminalReady?: boolean; requestToSend?: boolean }): Promise<void>;
+    close(options: { portId: string }): Promise<void>;
+    setLang(options: { lang: string }): Promise<void>;
+    addListener(event: 'data', fn: (e: { portId: string; data: string }) => void): Promise<PluginListenerHandle>;
+    addListener(event: 'disconnect', fn: (e: { portId: string }) => void): Promise<PluginListenerHandle>;
+}
+
+const Serial = registerPlugin<EntrySerialPlugin>('EntrySerial');
+
+/** 실패 이유를 엔트리 알림으로 (취소는 조용히) — 엔트리는 '연결 실패'만 보여 준다 */
+function toastError(e: any) {
+    const code = e && e.code;
+    const message = e && e.message;
+    const Entry = (window as any).Entry;
+    if (!message || code === 'CANCELLED' || !Entry || !Entry.toast) {
+        return;
+    }
+    const ko = (window as any).Lang && (window as any).Lang.type === 'ko';
+    Entry.toast.alert(ko ? '하드웨어 연결' : 'Hardware connection', message);
+}
+
+function toBase64(bytes: Uint8Array) {
+    let bin = '';
+    for (let i = 0; i < bytes.length; i += 0x8000) {
+        bin += String.fromCharCode.apply(null, Array.from(bytes.subarray(i, i + 0x8000)));
+    }
+    return btoa(bin);
+}
+
+function fromBase64(b64: string) {
+    const bin = atob(b64);
+    const out = new Uint8Array(bin.length);
+    for (let i = 0; i < bin.length; i++) {
+        out[i] = bin.charCodeAt(i);
+    }
+    return out;
+}
+
+function toBytes(chunk: any): Uint8Array {
+    if (chunk instanceof Uint8Array) {
+        return chunk;
+    }
+    if (chunk instanceof ArrayBuffer) {
+        return new Uint8Array(chunk);
+    }
+    if (ArrayBuffer.isView(chunk)) {
+        return new Uint8Array(chunk.buffer, chunk.byteOffset, chunk.byteLength);
+    }
+    if (typeof chunk === 'string') {
+        return new TextEncoder().encode(chunk);
+    }
+    if (Array.isArray(chunk)) {
+        return Uint8Array.from(chunk);
+    }
+    return new Uint8Array(0);
+}
+
+class AndroidSerialPort extends EventTarget {
+    readable: ReadableStream<Uint8Array> | null = null;
+    writable: WritableStream<Uint8Array> | null = null;
+    private listeners: PluginListenerHandle[] = [];
+    private readController?: ReadableStreamDefaultController<Uint8Array>;
+    private opened = false;
+
+    constructor(private info: PortInfo) {
+        super();
+    }
+
+    getInfo() {
+        return { usbVendorId: this.info.usbVendorId, usbProductId: this.info.usbProductId };
+    }
+
+    async open(options: { baudRate: number; dataBits?: number; stopBits?: number; parity?: string; bufferSize?: number }) {
+        if (this.opened) {
+            throw new DOMException('The port is already open.', 'InvalidStateError');
+        }
+        const portId = this.info.portId;
+        this.readable = new ReadableStream<Uint8Array>({
+            start: (controller) => {
+                this.readController = controller;
+            },
+            cancel: () => {
+                this.readController = undefined;
+            },
+        });
+        this.writable = new WritableStream<Uint8Array>({
+            write: async (chunk) => {
+                const bytes = toBytes(chunk);
+                if (bytes.length) {
+                    await Serial.write({ portId, data: toBase64(bytes) });
+                }
+            },
+        });
+        this.listeners.push(
+            await Serial.addListener('data', (e) => {
+                if (e.portId === portId && this.readController) {
+                    try {
+                        this.readController.enqueue(fromBase64(e.data));
+                    } catch (err) {
+                        // 읽기를 이미 닫음
+                    }
+                }
+            })
+        );
+        this.listeners.push(
+            await Serial.addListener('disconnect', (e) => {
+                if (e.portId === portId) {
+                    this.handleLost();
+                }
+            })
+        );
+        try {
+            await Serial.open({
+                portId,
+                baudRate: options.baudRate || 9600,
+                dataBits: options.dataBits || 8,
+                stopBits: options.stopBits || 1,
+                parity: options.parity || 'none',
+            });
+        } catch (e) {
+            this.cleanup();
+            toastError(e);
+            throw e;
+        }
+        this.opened = true;
+    }
+
+    async setSignals(signals: { dataTerminalReady?: boolean; requestToSend?: boolean }) {
+        await Serial.setSignals({ portId: this.info.portId, ...signals });
+    }
+
+    async close() {
+        await Serial.close({ portId: this.info.portId }).catch(() => undefined);
+        this.cleanup();
+    }
+
+    async forget() {
+        await this.close();
+    }
+
+    /** 선이 빠짐: 읽던 쪽에 오류를 알리고 disconnect 이벤트 */
+    private handleLost() {
+        try {
+            this.readController && this.readController.error(new DOMException('The device has been lost.', 'NetworkError'));
+        } catch (e) {
+            // 이미 닫힘
+        }
+        this.cleanup();
+        this.dispatchEvent(new Event('disconnect'));
+        const serial = (navigator as any).serial;
+        serial && serial.dispatchEvent && serial.dispatchEvent(new Event('disconnect'));
+    }
+
+    private cleanup() {
+        this.opened = false;
+        this.listeners.forEach((l) => l.remove());
+        this.listeners = [];
+        try {
+            this.readController && this.readController.close();
+        } catch (e) {
+            // 이미 닫힘
+        }
+        this.readController = undefined;
+        this.readable = null;
+        this.writable = null;
+    }
+}
+
+const ports = new Map<string, AndroidSerialPort>();
+
+class AndroidSerial extends EventTarget {
+    async requestPort() {
+        let info: PortInfo;
+        try {
+            info = await Serial.requestPort();
+        } catch (e) {
+            toastError(e);
+            throw new DOMException((e && (e as any).message) || 'No port selected by the user.', 'NotFoundError');
+        }
+        let port = ports.get(info.portId);
+        if (!port) {
+            port = new AndroidSerialPort(info);
+            ports.set(info.portId, port);
+        }
+        return port;
+    }
+
+    async getPorts() {
+        return Array.from(ports.values());
+    }
+}
+
+/** 안드로이드 앱이면 navigator.serial 을 만든다 → true */
+export function installAndroidSerial() {
+    if (!isNative() || (navigator as any).serial) {
+        return !!(navigator as any).serial;
+    }
+    try {
+        Object.defineProperty(navigator, 'serial', { configurable: true, value: new AndroidSerial() });
+        return true;
+    } catch (e) {
+        return false;
+    }
+}
+
+export function setSerialLang(lang?: string) {
+    if (isNative()) {
+        Serial.setLang({ lang: lang === 'en' ? 'en' : 'ko' }).catch(() => undefined);
+    }
+}
