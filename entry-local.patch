+                    main.removeCallbacks(fail[0]);
+                    main.postDelayed(finish, 300);
+                }
+
+                @Override
+                public void onLoaded(String loaded) {
+                    if (autoStarted[0] || closed[0]) return;
+                    if (isEntrySignin(loaded)) {
+                        fail[0].run();
+                        return;
+                    }
+                    if (overwriting[0]) runOverwrite.run();
+                    else if (!importScript.isEmpty()) runImport.run();
+                }
+            };
+            if (warmReadyFor(url)) {
+                // 이미 열려 있는 작업 화면 → 불러오기 없이 바로
+                if (overwriting[0]) runOverwrite.run();
