+/**
+ * [entry-local] 이름 입력 창 (다른 이름으로 저장)
+ * 엔트리 알림창과 같은 모양: 파란 머리띠(제목 · 닫기) + 입력칸 + [취소] [저장]
+ * 결과: 입력한 이름, 취소하면 null
+ */
+import { lt } from '../../common/localLang';
+
+const OVERLAY_ID = 'entry-local-name-prompt';
+const STYLE_ID = 'entry-local-name-prompt-style';
+
+const CSS = `
+#${OVERLAY_ID}{position:fixed;inset:0;z-index:100000;display:flex;align-items:center;justify-content:center;background:rgba(0,0,0,.6);font-family:inherit}
+#${OVERLAY_ID} .enp-box{width:388px;max-width:calc(100vw - 32px);background:#fff;border-radius:6px;overflow:hidden;box-shadow:0 6px 24px rgba(0,0,0,.25)}
+#${OVERLAY_ID} .enp-head{position:relative;display:flex;align-items:center;height:54px;padding:0 26px;background:#4f80ff;color:#fff;font-size:20px;font-weight:bold}
+#${OVERLAY_ID} .enp-close{position:absolute;top:50%;right:26px;width:26px;height:26px;margin-top:-13px;padding:0;border:0;background:none;cursor:pointer}
+#${OVERLAY_ID} .enp-close:before,#${OVERLAY_ID} .enp-close:after{content:"";position:absolute;top:50%;left:50%;width:24px;height:3px;margin:-1.5px 0 0 -12px;background:#fff;border-radius:2px}
+#${OVERLAY_ID} .enp-close:before{transform:rotate(45deg)}
+#${OVERLAY_ID} .enp-close:after{transform:rotate(-45deg)}
+#${OVERLAY_ID} .enp-body{padding:30px 24px 32px}
+#${OVERLAY_ID} .enp-label{display:block;margin:0 0 10px;color:#333;font-size:15px;font-weight:bold}
+#${OVERLAY_ID} .enp-input{width:100%;height:44px;box-sizing:border-box;padding:0 12px;border:1px solid #c9d3e6;border-radius:4px;font:inherit;font-size:15px;color:#222}
+#${OVERLAY_ID} .enp-input:focus{outline:none;border-color:#4f80ff;box-shadow:0 0 0 2px rgba(79,128,255,.2)}
+#${OVERLAY_ID} .enp-hint{min-height:18px;margin:6px 0 22px;color:#e0473e;font-size:12px}
+#${OVERLAY_ID} .enp-buttons{display:flex;justify-content:center;gap:10px}
+#${OVERLAY_ID} .enp-buttons button{width:146px;height:48px;border-radius:4px;font:inherit;font-size:15px;font-weight:bold;cursor:pointer}
+#${OVERLAY_ID} .enp-cancel{border:1px solid #4f80ff;background:#fff;color:#4f80ff}
+#${OVERLAY_ID} .enp-ok{border:1px solid #4f80ff;background:#4f80ff;color:#fff}
+`;
+
+function ensureStyle() {
+    if (!document.getElementById(STYLE_ID)) {
+        const style = document.createElement('style');
+        style.id = STYLE_ID;
+        style.textContent = CSS;
+        document.head.appendChild(style);
+    }
+}
+
+export function promptName(options: { title: string; label: string; value: string; okLabel?: string }): Promise<string | null> {
+    ensureStyle();
+    document.getElementById(OVERLAY_ID)?.remove();
+    return new Promise((resolve) => {
+        const overlay = document.createElement('div');
+        overlay.id = OVERLAY_ID;
+        overlay.innerHTML =
+            '<div class="enp-box" role="dialog" aria-modal="true">' +
+            `<div class="enp-head"><span class="enp-title"></span><button class="enp-close" type="button" aria-label="${lt('닫기', 'Close')}"></button></div>` +
+            '<div class="enp-body"><label class="enp-label"></label><input class="enp-input" type="text" maxlength="45"><div class="enp-hint"></div>' +
+            `<div class="enp-buttons"><button class="enp-cancel" type="button">${lt('취소', 'Cancel')}</button><button class="enp-ok" type="button"></button></div></div></div>`;
+        (overlay.querySelector('.enp-title') as HTMLElement).textContent = options.title;
+        (overlay.querySelector('.enp-label') as HTMLElement).textContent = options.label;
+        (overlay.querySelector('.enp-ok') as HTMLElement).textContent = options.okLabel || lt('저장', 'Save');
+        const input = overlay.querySelector('.enp-input') as HTMLInputElement;
+        const hint = overlay.querySelector('.enp-hint') as HTMLElement;
+        input.value = options.value;
+        const close = (result: string | null) => {
+            document.removeEventListener('keydown', onKey, true);
+            overlay.remove();
+            resolve(result);
+        };
+        const submit = () => {
+            const name = input.value.trim();
+            if (!name) {
+                hint.textContent = lt('이름을 입력해 주세요.', 'Please enter a name.');
+                input.focus();
+                return;
+            }
+            close(name);
+        };
+        const onKey = (e: KeyboardEvent) => {
+            if (e.key === 'Escape') {
+                e.stopPropagation();
+                close(null);
+            } else if (e.key === 'Enter') {
+                e.stopPropagation();
+                e.preventDefault();
+                submit();
+            }
+        };
+        (overlay.querySelector('.enp-close') as HTMLElement).onclick = () => close(null);
+        (overlay.querySelector('.enp-cancel') as HTMLElement).onclick = () => close(null);
+        (overlay.querySelector('.enp-ok') as HTMLElement).onclick = submit;
+        document.addEventListener('keydown', onKey, true);
+        document.body.appendChild(overlay);
+        input.focus();
+        input.select();
+    });
+}
diff --git a/src/renderer/helper/paintRoom.ts b/src/renderer/helper/paintRoom.ts
new file mode 100644
index 00000000..9455da1a
--- /dev/null
+++ b/src/renderer/helper/paintRoom.ts
@@ -0,0 +1,77 @@
+/**
+ * [entry-local 1.1] 모양 편집기(그림판)를 열 때 자리가 모자라면 실행 화면을 잠깐 접는다.
+ *
+ * 엔트리 그림판은 가로 920px 보다 좁아지지 않아서, 태블릿·휴대폰에서는 오른쪽 도구(모양 가져오기·확대/축소·회전·반전)와
+ * 그림판 가운데가 화면 밖으로 잘렸다. (웹판도 같음 — 실행 화면 옆 `||` 손잡이를 끌어 접어야 했다)
+ * → 모양 탭을 열 때 그림판이 다 안 들어가면 실행 화면을 접고(엔트리의 접기 기능과 같음), 다른 탭으로 가면 원래 크기로 펼친다.
+ *   사용자가 직접 손잡이로 크기를 바꾸면 그 크기를 그대로 둔다.
+ */
+const PAINT_MIN_WIDTH = 920;
+
+let collapsedFrom: number | undefined; // 접기 전 실행 화면 폭
+let noticeShown = false;
+
+function E(): any {
+    return (window as any).Entry;
+}
+
+function canvasWidth(): number | undefined {
+    const Entry = E();
+    const w = Entry && Entry.interfaceState && Entry.interfaceState.canvasWidth;
+    return typeof w === 'number' ? w : undefined;
+}
+
+function adjust(viewType: string, notice?: () => void) {
+    const Entry = E();
+    if (!Entry || typeof Entry.resizeElement !== 'function') {
+        return;
+    }
+    if (viewType === 'picture') {
+        const painter = document.querySelector('.entryPlaygroundPainter') as HTMLElement | null;
+        if (!painter || !painter.offsetParent || collapsedFrom !== undefined) {
+            return;
+        }
+        const width = canvasWidth();
+        if (painter.clientWidth >= PAINT_MIN_WIDTH || !width || width < Entry.CANVAS_MIN_WIDTH) {
+            return; // 다 들어가거나 이미 접혀 있음
+        }
+        collapsedFrom = width;
+        Entry.resizeElement({ canvasWidth: 1 }); // 엔트리 기준: 최소 폭보다 작으면 실행 화면을 접는다
+        if (!noticeShown && notice) {
+            noticeShown = true;
+            notice();
+        }
+    } else if (collapsedFrom !== undefined) {
+        const restore = collapsedFrom;
+        collapsedFrom = undefined;
+        const now = canvasWidth();
+        // 접은 그대로일 때만 펼친다 (사용자가 직접 크기를 바꿨으면 그대로)
+        if (!now || now < Entry.CANVAS_MIN_WIDTH) {
+            Entry.resizeElement({ canvasWidth: restore });
+        }
+    }
+}
+
+/** 작품을 불러올 때마다 부른다 (Entry.playground 가 새로 만들어질 수 있음) */
+export function installPaintRoom(notice?: () => void) {
+    const Entry = E();
+    const pg = Entry && Entry.playground;
+    if (!pg || pg.__elPaintRoom || typeof pg.changeViewMode !== 'function') {
+        return;
+    }
+    pg.__elPaintRoom = true;
+    collapsedFrom = undefined;
+    const original = pg.changeViewMode;
+    pg.changeViewMode = function (viewType: string, ...rest: any[]) {
+        const result = original.call(this, viewType, ...rest);
+        // 그림판이 화면에 나타난 뒤 폭을 잰다
+        setTimeout(() => {
+            try {
+                adjust(viewType, notice);
+            } catch (e) {
+                // 접기 실패는 무시 (원래대로 잘려 보일 뿐)
+            }
+        }, 60);
+        return result;
+    };
+}
diff --git a/src/renderer/helper/practicalTheme.ts b/src/renderer/helper/practicalTheme.ts
new file mode 100644
index 00000000..34157d7a
--- /dev/null
+++ b/src/renderer/helper/practicalTheme.ts
@@ -0,0 +1,332 @@
+/**
+ * [entry-local] 교과형(실과) 보라 테마
+ *
+ * 웹판 엔트리는 교과형일 때 편집기 몇 곳(위쪽 막대·시작하기 버튼·장면 탭 등)을 보라색(#8274ff)으로 바꾼다.
+ * 그런데 알림창·확인창·오브젝트 추가하기 같은 팝업, 이 앱이 만든 창(저장 중·저장 완료·로그인·내 작품·앱 정보 …)은
+ * 편집기(.ws) 바깥(body 바로 아래)에 붙어서 교과형 표시(.practical_course_mode)가 닿지 않아 파란색 그대로였다.
+ *
+ * → 교과형일 때 body 에 el-practical 표시를 달고, 문서에 실린 모든 스타일 규칙 중 엔트리 파란색을 쓰는 규칙을
+ *   보라색으로 바꾼 복사본을 만들어 "편집기 바깥(.ws 밖)" 요소에만 덧씌운다.
+ *   편집기 안(블록 탭 등 웹판에서도 파란 곳)은 건드리지 않는다.
+ *   새 창이 처음 열리면서 스타일을 더하면(head 에 style 추가) 다시 만든다.
+ */
+
+const BODY_CLASS = 'el-practical';
+const STYLE_ID = 'entry-local-practical-theme';
+
+let enabled = false;
+let observer: MutationObserver | undefined;
+let timer: any;
+let lastSignature = '';
+
+/* ---------- 색 변환: 엔트리 파랑 → 실과 보라 ---------- */
+
+function rgbToHsl(r: number, g: number, b: number) {
+    r /= 255;
+    g /= 255;
+    b /= 255;
+    const max = Math.max(r, g, b);
+    const min = Math.min(r, g, b);
+    const l = (max + min) / 2;
+    let h = 0;
+    let s = 0;
+    if (max !== min) {
+        const d = max - min;
+        s = l > 0.5 ? d / (2 - max - min) : d / (max + min);
+        if (max === r) {
+            h = (g - b) / d + (g < b ? 6 : 0);
+        } else if (max === g) {
+            h = (b - r) / d + 2;
+        } else {
+            h = (r - g) / d + 4;
+        }
+        h *= 60;
+    }
+    return [h, s * 100, l * 100];
+}
+
+function hslToRgb(h: number, s: number, l: number) {
+    s /= 100;
+    l /= 100;
+    const k = (n: number) => (n + h / 30) % 12;
+    const a = s * Math.min(l, 1 - l);
+    const f = (n: number) => l - a * Math.max(-1, Math.min(k(n) - 3, Math.min(9 - k(n), 1)));
+    return [Math.round(f(0) * 255), Math.round(f(8) * 255), Math.round(f(4) * 255)];
+}
+
+/**
+ * 엔트리 파란 계열(색상 210°~235°, 채도 55% 이상)만 보라로 옮긴다.
+ * #4f80ff(223°, 밝기 65.5%) → #8274ff(246°, 밝기 72.7%) 가 정확히 되도록 색상 +23°, 밝기는 흰색 쪽으로 21% 당긴다.
+ * 엔트리의 회청색(블록 꾸러미 바탕 #ecf8ff, 테두리 #aac5d5 등, 채도 낮음·하늘색)은 그대로 둔다.
+ */
+function mapRgb(r: number, g: number, b: number): [number, number, number] | undefined {
+    const [h, s, l] = rgbToHsl(r, g, b);
+    if (h < 210 || h > 235 || s < 55 || l < 20 || l > 98) {
+        return undefined;
+    }
+    if (r === 0x4f && g === 0x80 && b === 0xff) {
+        return [0x82, 0x74, 0xff];
+    }
+    const nl = l + (100 - l) * 0.21;
+    const [nr, ng, nb] = hslToRgb(h + 23, s, Math.min(nl, 99));
+    return [nr, ng, nb];
+}
+
+const hex2 = (n: number) => n.toString(16).padStart(2, '0');
+
+function convertValue(value: string): string {
+    let changed = value.replace(/#([0-9a-f]{3,8})\b/gi, (m, hex: string) => {
+        let full = hex;
+        if (hex.length === 3 || hex.length === 4) {
+            full = hex
+                .split('')
+                .map((c) => c + c)
+                .join('');
+        }
+        if (full.length !== 6 && full.length !== 8) {
+            return m;
+        }
+        const r = parseInt(full.slice(0, 2), 16);
+        const g = parseInt(full.slice(2, 4), 16);
+        const b = parseInt(full.slice(4, 6), 16);
+        const to = mapRgb(r, g, b);
+        return to ? `#${hex2(to[0])}${hex2(to[1])}${hex2(to[2])}${full.slice(6)}` : m;
+    });
+    changed = changed.replace(/rgba?\(\s*(\d+)[\s,]+(\d+)[\s,]+(\d+)\s*(?:[,/]\s*([\d.]+%?)\s*)?\)/gi, (m, r, g, b, a) => {
+        const to = mapRgb(+r, +g, +b);
+        if (!to) {
+            return m;
+        }
+        return a !== undefined ? `rgba(${to[0]}, ${to[1]}, ${to[2]}, ${a})` : `rgb(${to[0]}, ${to[1]}, ${to[2]})`;
+    });
+    return changed;
+}
+
+/* ---------- 선택자: 편집기(.ws) 바깥 요소에만 ---------- */
+
+const PSEUDO_ELEMENT = /(::?(?:before|after|placeholder|selection|first-line|first-letter|marker|backdrop|-webkit-[\w-]+|-moz-[\w-]+))+$/i;
+
+function splitSelectors(text: string): string[] {
+    const out: string[] = [];
+    let depth = 0;
+    let current = '';
+    for (const ch of text) {
+        if (ch === '(' || ch === '[') {
+            depth++;
+        } else if (ch === ')' || ch === ']') {
+            depth--;
+        }
+        if (ch === ',' && depth === 0) {
+            out.push(current.trim());
+            current = '';
+        } else {
+            current += ch;
+        }
+    }
+    if (current.trim()) {
+        out.push(current.trim());
+    }
+    return out;
+}
+
+function scopeSelector(selector: string): string | undefined {
+    // 편집기 안을 가리키는 규칙(.ws, 교과형 표시, 위쪽 막대)은 건너뛴다
+    if (/\.ws\b|practical_course_mode|common_gnb|\.el-practical/.test(selector)) {
+        return undefined;
+    }
+    let sel = selector.trim();
+    let pseudo = '';
+    const m = sel.match(PSEUDO_ELEMENT);
+    if (m) {
+        pseudo = m[0];
+        sel = sel.slice(0, -pseudo.length);
+    }
+    sel = sel.replace(/^(?:html|:root)\s*/i, '');
+    let prefix = `body.${BODY_CLASS} `;
+    if (/^body\b/i.test(sel)) {
+        sel = sel.replace(/^body/i, '');
+        prefix = `body.${BODY_CLASS}`;
+    }
+    if (!sel.trim()) {
+        return undefined; // body 자체 규칙은 바꿀 필요 없음
+    }
+    // 마지막 단위(대상 요소)가 .ws 밖일 때만
+    return `${prefix}${sel}:not(.ws *)${pseudo}`;
+}
+
+/* ---------- 규칙 복사 ---------- */
+
+/*
+ * 바뀐 색만 덧씌우면 원래 규칙끼리의 우선순위가 깨진다
+ * (예: 확인창 버튼 = 파란 바탕, 그중 [취소] = 흰 바탕 → 파란 바탕만 보라로 덧씌우면 [취소]까지 보라가 됨).
+ * 그래서 ① 한 번이라도 색이 바뀌는 속성(배경색·글자색·테두리색 …)을 모은 뒤
+ *        ② 그 속성을 쓰는 모든 규칙을 (바꿀 색은 바꾸고, 나머지는 그대로) 같은 순서로 복사한다.
+ *        복사본은 모두 같은 만큼 우선순위가 올라가므로 원래 순서·우선순위 관계가 그대로 유지된다.
+ */
+function walk(rules: CSSRuleList, visit: (rule: CSSStyleRule) => string | undefined, out: string[]) {
+    Array.from(rules).forEach((rule) => {
+        if (rule instanceof CSSStyleRule) {
+            const text = visit(rule);
+            text && out.push(text);
+        } else if (typeof CSSMediaRule !== 'undefined' && rule instanceof CSSMediaRule) {
+            const inner: string[] = [];
+            walk(rule.cssRules, visit, inner);
+            inner.length && out.push(`@media ${rule.conditionText || rule.media.mediaText}{${inner.join('')}}`);
+        } else if (typeof CSSSupportsRule !== 'undefined' && rule instanceof CSSSupportsRule) {
+            const inner: string[] = [];
+            walk(rule.cssRules, visit, inner);
+            inner.length && out.push(`@supports ${rule.conditionText}{${inner.join('')}}`);
+        }
+    });
+}
+
+const TOKEN = /[.#][\w-]+/g;
+
+function collectChangedProps(rule: CSSStyleRule, props: Set<string>, tokens: Set<string>) {
+    const style = rule.style;
+    let changed = false;
+    for (let i = 0; i < style.length; i++) {
+        const prop = style[i];
+        const value = style.getPropertyValue(prop);
+        if (value && /#|rgb/i.test(value) && convertValue(value) !== value) {
+            props.add(prop);
+            changed = true;
+        }
+    }
+    if (changed) {
+        (rule.selectorText.match(TOKEN) || []).forEach((t) => tokens.add(t));
+    }
+    return undefined;
+}
+
+function copyRule(rule: CSSStyleRule, props: Set<string>, tokens: Set<string>) {
+    const style = rule.style;
+    const decls: string[] = [];
+    let changed = false;
+    for (let i = 0; i < style.length; i++) {
+        const prop = style[i];
+        if (!props.has(prop)) {
+            continue;
+        }
+        const value = style.getPropertyValue(prop);
+        if (!value) {
+            continue;
+        }
+        const next = convertValue(value);
+        if (next === value && value.length > 200) {
+            continue; // 바뀌지 않는 긴 값(그림 data URL 등)은 복사하지 않는다 — 테마 크기를 작게
+        }
+        changed = changed || next !== value;
+        const important = style.getPropertyPriority(prop) ? ' !important' : '';
+        decls.push(`${prop}:${next}${important}`);
+    }
+    if (!decls.length) {
+        return undefined;
+    }
+    // 색이 안 바뀌는 규칙은, 색이 바뀌는 규칙과 같은 이름(class/id)을 쓰는 것만 (같은 요소에 겹칠 수 있는 것만) 복사
+    if (!changed && !(rule.selectorText.match(TOKEN) || []).some((t) => tokens.has(t))) {
+        return undefined;
+    }
+    const selectors = splitSelectors(rule.selectorText)
+        .map(scopeSelector)
+        .filter(Boolean);
+    if (!selectors.length) {
+        return undefined;
+    }
+    return `${selectors.join(',')}{${decls.join(';')}}`;
+}
+
+function sheetsSignature() {
+    return Array.from(document.styleSheets)
+        .map((s) => {
+            try {
+                return `${(s.ownerNode as Element)?.id || ''}:${s.cssRules.length}`;
+            } catch (e) {
+                return 'x';
+            }
+        })
+        .join('|');
+}
+
+function build() {
+    timer = undefined;
+    if (!enabled) {
+        return;
+    }
+    const signature = sheetsSignature();
+    if (signature === lastSignature && document.getElementById(STYLE_ID)) {
+        return;
+    }
+    const started = Date.now();
+    const sheets: CSSRuleList[] = [];
+    Array.from(document.styleSheets).forEach((sheet) => {
+        const owner = sheet.ownerNode as Element | null;
+        if (owner && owner.id === STYLE_ID) {
+            return;
+        }
+        try {
+            sheets.push(sheet.cssRules);
+        } catch (e) {
+            // 다른 출처 스타일은 읽을 수 없음
+        }
+    });
+    const props = new Set<string>();
+    const tokens = new Set<string>();
+    sheets.forEach((rules) => walk(rules, (rule) => collectChangedProps(rule, props, tokens), []));
+    const out: string[] = [];
+    if (props.size) {
+        sheets.forEach((rules) => walk(rules, (rule) => copyRule(rule, props, tokens), out));
+    }
+    let style = document.getElementById(STYLE_ID) as HTMLStyleElement | null;
+    if (!style) {
+        style = document.createElement('style');
+        style.id = STYLE_ID;
+    }
+    style.textContent = out.join('\n');
+    // 항상 맨 뒤에 둔다 (같은 우선순위면 뒤가 이김)
+    document.head.appendChild(style);
+    lastSignature = sheetsSignature();
+    (window as any).__elPracticalThemeMs = Date.now() - started; // 확인용
+}
+
+function schedule() {
+    if (!timer) {
+        timer = setTimeout(build, 30);
+    }
+}
+
+/** 교과형이면 true. 모드가 바뀔 때마다 부른다 */
+export function setPracticalTheme(on: boolean) {
+    if (typeof document === 'undefined') {
+        return;
+    }
+    enabled = !!on;
+    document.body.classList.toggle(BODY_CLASS, enabled);
+    if (!enabled) {
+        return; // 만든 규칙은 body 표시가 없으면 아무 데도 안 맞는다
+    }
+    build();
+    if (!observer && typeof MutationObserver !== 'undefined') {
+        // 새 창이 스타일을 더하면 다시 만든다 (실제로 바뀌었는지는 build 가 규칙 수로 가볍게 확인)
+        observer = new MutationObserver((records) => {
+            if (!enabled) {
+                return;
+            }
+            const ours = records.every((r) => {
+                const t = r.target as Element;
+                return t.id === STYLE_ID || (t.parentNode as Element | null)?.id === STYLE_ID;
+            });
+            if (!ours) {
+                schedule();
+            }
+        });
+        observer.observe(document.head, { childList: true, subtree: true, characterData: true });
+        observer.observe(document.body, { childList: true });
+        // 스타일을 글 대신 insertRule 로 더하는 꾸러미도 있어서, 가끔 규칙 수를 확인한다
+        setInterval(() => enabled && schedule(), 1500);
+    }
+}
+
+export function isPracticalTheme() {
+    return enabled;
+}
