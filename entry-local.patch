+            FrameLayout.LayoutParams lp = new FrameLayout.LayoutParams(dp(1280), dp(800));
+            host.addView(web, 0, lp);
+            main.postDelayed(timeout, timeoutMs);
+            web.loadUrl(url);
+        });
+    }
+
+    /* ------------------------------------------------------------------ */
+    /* [1.1] 계정 저장 가속 — 엔트리 작업 화면 웹뷰(warm)를 다시 쓴다             */
+    /* 저장할 때마다 엔트리 작업 화면(수 MB)을 새로 불러오던 것이 시간의 대부분이었다. */
+    /* 저장이 끝난 웹뷰를 버리지 않고 그 작품 화면 그대로 앱 화면 뒤에 두었다가,       */
+    /* 같은 작품을 다시 저장하면 불러오기 없이 바로 저장한다.                        */
+    /*  - 계정 작품을 열거나(run keepWarm) 저장 메뉴를 열면(prewarm) 미리 불러 둔다    */
+    /*  - 쉬는 동안은 그리기를 멈추고(onPause·INVISIBLE), 5분 동안 안 쓰면 없앤다      */
+    /*  - 작품 파일은 스크립트에 넣지 않고 페이지가 EntryLocalSave.getEnt() 로 받아 간다 */
+    /* ------------------------------------------------------------------ */
+    private static final long WARM_IDLE_MS = 5 * 60 * 1000;
+    private static final java.util.regex.Pattern WS_ID = java.util.regex.Pattern.compile("/ws/([0-9a-fA-F]{24})");
+
+    private interface WarmListener {
+        void onUrl(String url);
+
+        void onLoaded(String url);
+    }
+
+    private WebView warmWeb;
+    private String warmUrl; // 다 불러온 주소
+    private String warmLoadingUrl; // 불러오는 중인 주소
+    private WarmListener warmListener;
+    private ValueCallback<String> warmOnDone;
+    private ValueCallback<String> warmOnDoneOverwrite;
+    private volatile String warmEnt; // 지금 저장하는 작품 (.ent, base64)
+    private File warmFile;
+    private final java.util.Map<String, ValueCallback<String>> warmRuns = new java.util.concurrent.ConcurrentHashMap<>();
+    private final Runnable warmIdleKill = this::destroyWarm;
+
+    /** 두 주소가 같은 작업 화면인가 (/ws/<같은 id> 또는 둘 다 /ws/new) */
+    private static boolean sameWs(String a, String b) {
+        if (a == null || b == null) return false;
+        java.util.regex.Matcher ma = WS_ID.matcher(a);
+        java.util.regex.Matcher mb = WS_ID.matcher(b);
+        boolean ha = ma.find();
+        boolean hb = mb.find();
+        if (ha && hb) return ma.group(1).equalsIgnoreCase(mb.group(1));
+        if (ha || hb) return false;
+        String pa = Uri.parse(a).getPath();
+        String pb = Uri.parse(b).getPath();
+        return pa != null && pb != null && pa.startsWith("/ws/new") && pb.startsWith("/ws/new");
+    }
+
+    private WebView warmWeb() {
+        if (warmWeb != null) return warmWeb;
+        final WebView appWeb = getBridge().getWebView();
+        final ViewGroup host = (ViewGroup) appWeb.getParent();
+        final WebView web = new WebView(getContext());
+        configure(web);
+        web.getSettings().setUserAgentString(web.getSettings().getUserAgentString().replace("; wv", ""));
+        web.setWebChromeClient(new WebChromeClient() {
+            @Override
+            public boolean onShowFileChooser(WebView view, ValueCallback<Uri[]> callback, FileChooserParams params) {
+                // 엔트리 '오프라인 작품 불러오기' 등 파일 선택 → 지금 작품 파일을 바로 넣어 준다
+                File f = warmFile;
+                callback.onReceiveValue(f != null ? new Uri[] { Uri.fromFile(f) } : null);
+                return true;
+            }
+        });
+        web.addJavascriptInterface(new Object() {
+            @JavascriptInterface
+            public String getEnt() {
+                String e = warmEnt;
+                return e == null ? "" : e;
+            }
+
+            @JavascriptInterface
+            public void done(String json) {
+                main.post(() -> {
+                    ValueCallback<String> cb = warmOnDone;
+                    if (cb != null) cb.onReceiveValue(json);
+                });
+            }
+
+            @JavascriptInterface
+            public void doneOverwrite(String json) {
+                main.post(() -> {
+                    ValueCallback<String> cb = warmOnDoneOverwrite;
+                    if (cb != null) cb.onReceiveValue(json);
+                });
+            }
+        }, "EntryLocalSave");
+        web.addJavascriptInterface(new Object() {
+            @JavascriptInterface
+            public void done(String token, String payload) {
+                final ValueCallback<String> cb = warmRuns.remove(token);
+                if (cb != null) main.post(() -> cb.onReceiveValue(payload));
+            }
+        }, "EntryLocalBridge");
+        web.setWebViewClient(new WebViewClient() {
+            @Override
+            public boolean shouldOverrideUrlLoading(WebView view, WebResourceRequest request) {
+                String scheme = request.getUrl().getScheme();
+                return !("http".equals(scheme) || "https".equals(scheme));
+            }
+
+            @Override
+            public void onPageStarted(WebView view, String started, android.graphics.Bitmap favicon) {
+                if (view != warmWeb) return;
+                warmUrl = null;
+                WarmListener l = warmListener;
+                if (l != null) l.onUrl(started);
+            }
+
+            @Override
+            public void doUpdateVisitedHistory(WebView view, String visited, boolean isReload) {
+                if (view != warmWeb) return;
+                WarmListener l = warmListener;
+                if (l != null) l.onUrl(visited);
+            }
+
+            @Override
+            public void onPageFinished(WebView view, String loaded) {
+                if (view != warmWeb || loaded == null || loaded.startsWith("about:")) return;
+                warmUrl = loaded;
+                warmLoadingUrl = null;
+                WarmListener l = warmListener;
+                if (l != null) l.onLoaded(loaded);
+            }
+        });
+        // 앱 화면 아래(맨 뒤)에 같은 크기로 붙인다 → 사용자에게는 앱 화면만 보인다
+        if (appWeb.getBackground() == null) appWeb.setBackgroundColor(Color.WHITE);
+        host.addView(web, 0, new ViewGroup.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.MATCH_PARENT));
+        warmWeb = web;
+        return web;
+    }
+
+    private void loadWarm(String url) {
+        WebView web = warmWeb();
+        warmUrl = null;
+        warmLoadingUrl = url;
+        web.loadUrl(url);
+    }
+
+    /** 쓰는 중: 다시 그리기 시작 */
+    private void warmActive() {
+        main.removeCallbacks(warmIdleKill);
+        if (warmWeb != null) {
+            warmWeb.setVisibility(View.VISIBLE);
+            warmWeb.onResume();
+        }
+    }
+
+    /** 쉬는 중: 그리기를 멈추고, 오래 안 쓰면 없앤다 */
+    private void warmIdle() {
+        warmListener = null;
+        warmOnDone = null;
+        warmOnDoneOverwrite = null;
+        warmEnt = null;
+        if (warmFile != null) {
+            warmFile.delete();
+            warmFile = null;
+        }
+        main.removeCallbacks(warmIdleKill);
+        if (warmWeb != null) {
+            warmWeb.onPause();
+            warmWeb.setVisibility(View.INVISIBLE);
+            main.postDelayed(warmIdleKill, WARM_IDLE_MS);
+        }
+    }
+
+    private void destroyWarm() {
+        main.removeCallbacks(warmIdleKill);
+        warmListener = null;
+        warmOnDone = null;
+        warmOnDoneOverwrite = null;
+        warmEnt = null;
+        warmUrl = null;
+        warmLoadingUrl = null;
+        warmRuns.clear();
+        if (warmFile != null) {
+            warmFile.delete();
+            warmFile = null;
+        }
+        WebView web = warmWeb;
+        warmWeb = null;
+        if (web != null) {
+            try {
+                web.stopLoading();
+                ViewGroup parent = (ViewGroup) web.getParent();
+                if (parent != null) parent.removeView(web);
+            } catch (Exception ignored) {
+                // 이미 떨어짐
+            }
+            web.destroy();
+        }
+    }
+
+    /** 작업 화면이 url 로 이미 다 열려 있으면 true */
+    private boolean warmReadyFor(String url) {
+        return warmWeb != null && warmUrl != null && isAfterLogin(warmUrl) && sameWs(warmUrl, url);
+    }
+
+    /** [1.1] 저장 메뉴를 열었을 때 등: 작업 화면을 미리 불러 둔다 (저장 중이면 아무것도 안 함) */
+    @PluginMethod
+    public void prewarm(final PluginCall call) {
+        final String url = call.getString("url", "");
+        Uri target = Uri.parse(url);
+        if (!"https".equals(target.getScheme()) || !isEntryHost(target)) {
+            call.resolve();
+            return;
+        }
+        main.post(() -> {
+            if (currentSaveCancel != null || warmListener != null) {
+                call.resolve();
+                return;
+            }
+            if (warmReadyFor(url) || (warmLoadingUrl != null && sameWs(warmLoadingUrl, url))) {
+                call.resolve();
+                return;
+            }
+            warmWeb();
+            warmActive();
+            warmListener = new WarmListener() {
+                @Override
+                public void onUrl(String visited) {
+                    if (isEntrySignin(visited)) destroyWarm(); // 세션 만료: 다음 저장 때 다시
+                }
+
+                @Override
+                public void onLoaded(String loaded) {
+                    warmListener = null;
+                    // 엔트리가 작품을 다 꺼낼 시간을 조금 준 뒤 쉬게 한다
+                    main.postDelayed(() -> {
+                        if (warmListener == null && currentSaveCancel == null && warmWeb != null) warmIdle();
+                    }, 6000);
+                }
+            };
+            loadWarm(url);
+            call.resolve();
+        });
+    }
+
+    /**
+     * 엔트리 계정에 저장 (자동): 엔트리 작업 화면을 앱 화면 뒤에 열고(이미 열려 있으면 그대로)
+     *  - 덮어쓰기: overwriteScript (계정 작품 id 가 있을 때) → 안 되면 newUrl 에서 새 작품으로 저장
+     *  - 새 작품: importScript 가 [file] → [오프라인 작품 불러오기]에 작품 파일을 직접 넣는다
+     * 결과 { projectId, saved, failed }.
+     */
+    @PluginMethod
+    public void openWorkspace(final PluginCall call) {
+        final String url = call.getString("url", "");
+        final String base64 = call.getString("ent", "");
+        final String fileName = call.getString("fileName", "project.ent").replaceAll("[\\\\/:*?\"<>|]", "_");
+        final String importScript = call.getString("importScript", "");
+        final String overwriteScript = call.getString("overwriteScript", "");
+        final String newUrl = call.getString("newUrl", "");
+        Uri target = Uri.parse(url);
+        if (!"https".equals(target.getScheme()) || !isEntryHost(target)) {
+            call.reject(tr("엔트리 주소가 아닙니다.", "This is not an Entry address."));
+            return;
+        }
+        cancelPending = false;
+        final File dir = new File(getContext().getCacheDir(), "entry-save");
+        final File file = new File(dir, fileName);
+        try {
+            dir.mkdirs();
+            try (FileOutputStream out = new FileOutputStream(file)) {
+                out.write(Base64.decode(base64, Base64.DEFAULT));
+            }
+        } catch (Exception e) {
+            call.reject(tr("작품 파일을 준비하지 못했습니다.", "Could not prepare the project file."));
+            return;
+        }
+        main.post(() -> {
+            if (cancelPending) {
+                // 준비가 끝나기 전에 [취소]를 누름
+                cancelPending = false;
+                file.delete();
+                call.resolve(new JSObject());
+                return;
+            }
+            final String[] projectId = { call.getString("projectId", "") };
+            final boolean[] closed = { false };
+            final boolean[] saved = { false };
+            final boolean[] autoStarted = { false };
+            final boolean[] failed = { false };
+            final String[] startId = { null };
+            final boolean[] overwriting = { !overwriteScript.isEmpty() };
+            final Runnable[] fail = { null };
+            final WebView web = warmWeb();
+            warmActive();
+            if (warmFile != null && warmFile != file) warmFile.delete();
+            warmFile = file;
+            warmEnt = base64;
+            final Runnable finish = () -> {
+                if (closed[0]) return;
+                closed[0] = true;
+                if (fail[0] != null) main.removeCallbacks(fail[0]);
+                currentSaveCancel = null;
+                if (saved[0]) {
+                    // 다음 저장(덮어쓰기)에 그대로 쓴다. 새 작품으로 저장한 경우 엔트리가 새 작품 화면을 불러오는 중
+                    warmListener = null;
+                    warmOnDone = null;
+                    warmOnDoneOverwrite = null;
+                    main.postDelayed(() -> {
+                        if (warmListener == null && currentSaveCancel == null && warmWeb != null) warmIdle();
+                    }, overwriting[0] ? 0 : 8000);
+                    warmEnt = null;
+                } else {
+                    destroyWarm(); // 실패·취소: 하던 일을 멈추고 다음에는 새로
+                }
+                file.delete();
+                CookieManager.getInstance().flush();
+                JSObject r = new JSObject();
+                r.put("projectId", projectId[0]);
+                r.put("saved", saved[0]);
+                r.put("failed", failed[0] && !saved[0]);
+                call.resolve(r);
+            };
+            fail[0] = () -> {
+                if (closed[0] || saved[0]) return;
+                failed[0] = true;
+                finish.run();
+            };
+            main.postDelayed(fail[0], overwriteScript.isEmpty() ? 90000 : 180000);
+            currentSaveCancel = finish; // [취소]: 저장도 실패도 아님
+            final Runnable runOverwrite = () -> {
+                autoStarted[0] = true;
+                web.evaluateJavascript(
+                    "Promise.resolve().then(() => " + overwriteScript + ")" +
+                    ".then((r) => EntryLocalSave.doneOverwrite(JSON.stringify(r || {})))" +
+                    ".catch(() => EntryLocalSave.doneOverwrite('{}'));",
+                    null
+                );
+            };
+            final Runnable runImport = () -> {
+                autoStarted[0] = true;
+                String cur = web.getUrl();
+                java.util.regex.Matcher m = WS_ID.matcher(cur == null ? "" : cur);
+                startId[0] = m.find() ? m.group(1) : null;
+                web.evaluateJavascript(
+                    "Promise.resolve().then(() => " + importScript + ")" +
+                    ".then((r) => EntryLocalSave.done(JSON.stringify(r || {})))" +
+                    ".catch(() => EntryLocalSave.done('{\"fed\":false}'));",
+                    null
+                );
+            };
+            warmOnDone = (json) -> {
+                if (closed[0]) return;
+                try {
+                    if (!new JSONObject(json).optBoolean("fed")) fail[0].run(); // 불러오기 메뉴를 못 찾음
+                } catch (Exception ignored) {
+                    // 페이지가 이동하며 끊긴 경우 등: 이동 감지로 판단
+                }
+            };
+            warmOnDoneOverwrite = (json) -> {
+                if (closed[0]) return;
+                JSONObject o;
+                try {
+                    o = new JSONObject(json);
+                } catch (Exception e) {
+                    o = new JSONObject();
+                }
+                if (o.optBoolean("saved")) {
+                    // 같은 작품에 덮어씀
+                    saved[0] = true;
+                    finish.run();
+                } else if (o.optBoolean("fallback") && !newUrl.isEmpty() && !importScript.isEmpty()) {
+                    // 덮어쓸 수 없는 작품 → 새 작품으로 저장
+                    overwriting[0] = false;
+                    autoStarted[0] = false;
+                    projectId[0] = "";
+                    loadWarm(newUrl);
+                } else {
+                    fail[0].run();
+                }
+            };
+            warmListener = new WarmListener() {
+                @Override
+                public void onUrl(String visited) {
+                    if (closed[0] || saved[0] || visited == null) return;
+                    if (isEntrySignin(visited)) {
+                        fail[0].run(); // 엔트리 세션 만료
+                        return;
+                    }
+                    if (overwriting[0]) return; // 덮어쓰기는 페이지를 옮기지 않는다 (결과는 doneOverwrite 로)
