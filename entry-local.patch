+
+/**
+ * [entry-local 1.2] 하드웨어 연결 — 블루투스 LE (마이크로비트 BLE 등)
+ *
+ * 엔트리의 '하드웨어 웹 연결'은 BLE 하드웨어와 크롬의 Web Bluetooth(navigator.bluetooth)로 통신한다.
+ * 안드로이드 웹뷰에는 Web Bluetooth 가 없으므로 앱 화면(src/web/webBluetooth.ts)이 같은 모양을 만들고
+ * 실제 통신은 이 플러그인이 한다.
+ *
+ * requestDevice({ filters:[{namePrefix,name,services}], acceptAllDevices }) → { deviceId, name }  (찾는 창)
+ * connect({ deviceId }) → { services:[{ uuid, characteristics:[{ uuid, properties }] }] }
+ * read / write / startNotifications / stopNotifications ({ deviceId, service, characteristic, … })
+ * 알림: 'notify' { deviceId, service, characteristic, value(base64) } · 'disconnected' { deviceId }
+ * GATT 요청은 한 번에 하나씩만 보낼 수 있어 차례로 처리한다.
+ */
+@CapacitorPlugin(
+    name = "EntryBle",
+    permissions = {
+        @Permission(alias = "ble", strings = { Manifest.permission.BLUETOOTH_SCAN, Manifest.permission.BLUETOOTH_CONNECT }),
+        @Permission(alias = "location", strings = { Manifest.permission.ACCESS_FINE_LOCATION })
+    }
+)
+public class EntryBlePlugin extends Plugin {
+
+    private static final UUID CCCD = UUID.fromString("00002902-0000-1000-8000-00805f9b34fb");
+    private static final long SCAN_MS = 20000;
+    private static final long OP_TIMEOUT_MS = 8000;
+    private static final long CONNECT_TIMEOUT_MS = 20000;
+
+    private final Handler main = new Handler(Looper.getMainLooper());
+    private static volatile String lang = "ko";
+
+    private static String tr(String ko, String en) {
+        return "en".equals(lang) ? en : ko;
+    }
+
+    /** 연결된 기기 하나 */
+    private class Conn {
+        final String id;
+        BluetoothGatt gatt;
+        PluginCall connectCall;
+        boolean ready;
+        final ArrayDeque<Op> queue = new ArrayDeque<>();
+        Op current;
+
+        Conn(String id) {
+            this.id = id;
+        }
+    }
+
+    /** GATT 요청 하나 (읽기·쓰기·알림 켜기) */
+    private abstract static class Op {
+        PluginCall call;
+        Runnable timeout;
+
+        /** 보내기. 보내지 못하면 false */
+        abstract boolean start(BluetoothGatt gatt);
+    }
+
+    private final Map<String, Conn> conns = new ConcurrentHashMap<>();
+
+    // ── 권한 · 어댑터 ─────────────────────────────────────────────
+
+    private BluetoothAdapter adapter() {
+        try {
+            BluetoothManager m = (BluetoothManager) getContext().getSystemService(Context.BLUETOOTH_SERVICE);
+            return m == null ? null : m.getAdapter();
+        } catch (Exception e) {
+            return null;
+        }
+    }
+
+    private String permAlias() {
+        return Build.VERSION.SDK_INT >= 31 ? "ble" : "location";
+    }
+
+    private boolean permitted() {
+        return getPermissionState(permAlias()) == PermissionState.GRANTED;
+    }
+
+    @PluginMethod
+    public void setLang(PluginCall call) {
+        lang = "en".equals(call.getString("lang", "ko")) ? "en" : "ko";
+        call.resolve();
+    }
+
+    @PluginMethod
+    public void getAvailability(PluginCall call) {
+        JSObject r = new JSObject();
+        r.put("available", adapter() != null);
+        call.resolve(r);
+    }
+
+    // ── 기기 찾기 ─────────────────────────────────────────────────
+
+    @PluginMethod
+    public void requestDevice(final PluginCall call) {
+        if (adapter() == null) {
+            call.reject(tr("이 기기에는 블루투스가 없습니다.", "This device has no Bluetooth."), "NO_BLUETOOTH");
+            return;
+        }
+        if (!permitted()) {
+            requestPermissionForAlias(permAlias(), call, "afterPermission");
+            return;
+        }
+        scanAndChoose(call);
+    }
+
+    @PermissionCallback
+    private void afterPermission(PluginCall call) {
+        if (!permitted()) {
+            call.reject(
+                Build.VERSION.SDK_INT >= 31
+                    ? tr("'근처 기기' 권한을 허용해야 블루투스 하드웨어를 찾을 수 있습니다.", "Allow the 'Nearby devices' permission to find Bluetooth hardware.")
+                    : tr("'위치' 권한을 허용해야 블루투스 하드웨어를 찾을 수 있습니다.", "Allow the location permission to find Bluetooth hardware."),
+                "DENIED"
+            );
+            return;
+        }
+        scanAndChoose(call);
+    }
+
+    private static class Filter {
+        String name;
+        String namePrefix;
+        List<UUID> services = new ArrayList<>();
+    }
+
+    private static List<Filter> parseFilters(PluginCall call) {
+        List<Filter> out = new ArrayList<>();
+        try {
+            JSONArray arr = call.getArray("filters");
+            if (arr == null) return out;
+            for (int i = 0; i < arr.length(); i++) {
+                JSONObject o = arr.getJSONObject(i);
+                Filter f = new Filter();
+                f.name = o.has("name") ? o.getString("name") : null;
+                f.namePrefix = o.has("namePrefix") ? o.getString("namePrefix") : null;
+                JSONArray sv = o.optJSONArray("services");
+                if (sv != null) {
+                    for (int j = 0; j < sv.length(); j++) f.services.add(UUID.fromString(sv.getString(j)));
+                }
+                out.add(f);
+            }
+        } catch (Exception ignored) {
+            // 잘못된 필터는 무시
+        }
+        return out;
+    }
+
+    private static boolean matches(List<Filter> filters, boolean acceptAll, String name, ScanRecord record) {
+        if (acceptAll || filters.isEmpty()) return true;
+        for (Filter f : filters) {
+            if (f.name != null && !f.name.equals(name)) continue;
+            if (f.namePrefix != null && (name == null || !name.startsWith(f.namePrefix))) continue;
+            if (!f.services.isEmpty()) {
+                List<ParcelUuid> ad = record == null ? null : record.getServiceUuids();
+                boolean all = ad != null;
+                if (ad != null) {
+                    for (UUID u : f.services) {
+                        if (!ad.contains(new ParcelUuid(u))) {
+                            all = false;
+                            break;
+                        }
+                    }
+                }
+                if (!all) continue;
+            }
+            return true;
+        }
+        return false;
+    }
+
+    @SuppressWarnings("MissingPermission")
+    private void scanAndChoose(final PluginCall call) {
+        final BluetoothAdapter adapter = adapter();
+        try {
+            if (!adapter.isEnabled()) {
+                try {
+                    getActivity().startActivity(new Intent(BluetoothAdapter.ACTION_REQUEST_ENABLE));
+                } catch (Exception ignored) {
+                    // 켜기 창 없음
+                }
+                call.reject(tr("블루투스가 꺼져 있습니다. 켠 뒤 다시 연결해 주세요.", "Bluetooth is off. Turn it on and connect again."), "BT_OFF");
+                return;
+            }
+        } catch (Exception e) {
+            call.reject(e.getMessage(), "DENIED");
+            return;
+        }
+        final BluetoothLeScanner scanner = adapter.getBluetoothLeScanner();
+        if (scanner == null) {
+            call.reject(tr("블루투스가 꺼져 있습니다. 켠 뒤 다시 연결해 주세요.", "Bluetooth is off. Turn it on and connect again."), "BT_OFF");
+            return;
+        }
+        final List<Filter> filters = parseFilters(call);
+        final boolean acceptAll = Boolean.TRUE.equals(call.getBoolean("acceptAllDevices", false));
+        main.post(() -> {
+            final List<BluetoothDevice> found = new ArrayList<>();
+            final List<String> names = new ArrayList<>();
+            final ArrayAdapter<String> list = new ArrayAdapter<>(getActivity(), android.R.layout.simple_list_item_1, names);
+            final boolean[] done = { false };
+            final AlertDialog[] dialog = { null };
+            final ScanCallback cb = new ScanCallback() {
+                @Override
+                public void onScanResult(int callbackType, final ScanResult result) {
+                    final BluetoothDevice d = result.getDevice();
+                    ScanRecord rec = result.getScanRecord();
+                    String n = rec != null && rec.getDeviceName() != null ? rec.getDeviceName() : null;
+                    if (n == null) {
+                        try {
+                            n = d.getName();
+                        } catch (Exception ignored) {
+                            // 권한 없음
+                        }
+                    }
+                    if (!matches(filters, acceptAll, n, rec)) return;
+                    final String label = (n == null || n.isEmpty() ? d.getAddress() : n);
+                    main.post(() -> {
+                        for (BluetoothDevice x : found) {
+                            if (x.getAddress().equals(d.getAddress())) return;
+                        }
+                        found.add(d);
+                        names.add(label);
+                        list.notifyDataSetChanged();
+                        if (dialog[0] != null) dialog[0].setTitle(tr("연결할 블루투스 하드웨어 선택", "Choose Bluetooth hardware"));
+                    });
+                }
+
+                @Override
+                public void onScanFailed(int errorCode) {
+                    main.post(() -> {
+                        if (dialog[0] != null && found.isEmpty()) dialog[0].setTitle(tr("블루투스 찾기 실패 (" + errorCode + ")", "Bluetooth scan failed (" + errorCode + ")"));
+                    });
+                }
+            };
+            final Runnable stop = () -> {
+                try {
+                    scanner.stopScan(cb);
+                } catch (Exception ignored) {
+                    // 이미 멈춤
+                }
+            };
+            dialog[0] = new AlertDialog.Builder(getActivity())
+                .setTitle(tr("블루투스 하드웨어 찾는 중…", "Looking for Bluetooth hardware…"))
+                .setAdapter(list, (dlg, which) -> {
+                    done[0] = true;
+                    stop.run();
+                    BluetoothDevice d = found.get(which);
+                    JSObject r = new JSObject();
+                    r.put("deviceId", d.getAddress());
+                    r.put("name", names.get(which));
+                    call.resolve(r);
+                })
+                .setNegativeButton(tr("취소", "Cancel"), null)
+                .setOnDismissListener((dlg) -> {
+                    stop.run();
+                    if (!done[0]) {
+                        done[0] = true;
+                        call.reject(tr("하드웨어 선택을 취소했습니다.", "Hardware selection was cancelled."), "CANCELLED");
+                    }
+                })
+                .show();
+            try {
+                ScanSettings settings = new ScanSettings.Builder().setScanMode(ScanSettings.SCAN_MODE_LOW_LATENCY).build();
+                scanner.startScan(null, settings, cb);
+            } catch (Exception e) {
+                dialog[0].setTitle(tr("블루투스 찾기 실패", "Bluetooth scan failed"));
+            }
+            // 오래 찾으면 배터리를 쓰므로 멈춘다 (창은 그대로)
+            main.postDelayed(() -> {
+                stop.run();
+                if (!done[0] && dialog[0] != null && dialog[0].isShowing() && found.isEmpty()) {
+                    dialog[0].setTitle(tr(
+                        "하드웨어를 찾지 못했습니다 — 전원·거리를 확인해 주세요",
+                        "No hardware found — check power and distance"
+                    ));
+                }
+            }, SCAN_MS);
+        });
+    }
+
+    // ── 연결 ───────────────────────────────────────────────────
+
+    @PluginMethod
+    @SuppressWarnings("MissingPermission")
+    public void connect(final PluginCall call) {
+        final String id = call.getString("deviceId", "");
+        BluetoothAdapter adapter = adapter();
+        if (adapter == null || !permitted()) {
+            call.reject(tr("블루투스 권한이 없습니다.", "No Bluetooth permission."), "DENIED");
+            return;
+        }
+        Conn old = conns.remove(id);
+        if (old != null) closeConn(old);
+        final Conn c = new Conn(id);
+        c.connectCall = call;
+        conns.put(id, c);
+        try {
+            BluetoothDevice device = adapter.getRemoteDevice(id);
+            c.gatt = Build.VERSION.SDK_INT >= 23
+                ? device.connectGatt(getContext(), false, callback(c), BluetoothDevice.TRANSPORT_LE)
+                : device.connectGatt(getContext(), false, callback(c));
+        } catch (Exception e) {
+            conns.remove(id);
+            call.reject(tr("블루투스 하드웨어에 연결하지 못했습니다.", "Could not connect to the Bluetooth hardware."), "CONNECT_FAILED");
+            return;
+        }
+        main.postDelayed(() -> {
+            if (c.connectCall != null) {
+                PluginCall pc = c.connectCall;
+                c.connectCall = null;
+                conns.remove(id);
+                closeConn(c);
+                pc.reject(tr(
+                    "블루투스 하드웨어가 응답하지 않습니다. 전원과 펌웨어를 확인해 주세요.",
+                    "The Bluetooth hardware is not responding. Check its power and firmware."
+                ), "TIMEOUT");
+            }
+        }, CONNECT_TIMEOUT_MS);
+    }
+
+    @PluginMethod
+    public void disconnect(PluginCall call) {
+        Conn c = conns.remove(call.getString("deviceId", ""));
+        if (c != null) closeConn(c);
+        call.resolve();
+    }
+
+    @SuppressWarnings("MissingPermission")
+    private void closeConn(Conn c) {
+        synchronized (c) {
+            for (Op op : c.queue) op.call.reject("disconnected", "DISCONNECTED");
+            c.queue.clear();
+            if (c.current != null) {
+                main.removeCallbacks(c.current.timeout);
+                c.current.call.reject("disconnected", "DISCONNECTED");
+                c.current = null;
+            }
+        }
+        try {
+            if (c.gatt != null) {
+                c.gatt.disconnect();
+                c.gatt.close();
+            }
+        } catch (Exception ignored) {
+            // 이미 닫힘
+        }
+    }
+
+    private static JSObject props(BluetoothGattCharacteristic ch) {
+        int p = ch.getProperties();
+        JSObject o = new JSObject();
+        o.put("broadcast", (p & BluetoothGattCharacteristic.PROPERTY_BROADCAST) != 0);
+        o.put("read", (p & BluetoothGattCharacteristic.PROPERTY_READ) != 0);
+        o.put("writeWithoutResponse", (p & BluetoothGattCharacteristic.PROPERTY_WRITE_NO_RESPONSE) != 0);
+        o.put("write", (p & BluetoothGattCharacteristic.PROPERTY_WRITE) != 0);
+        o.put("notify", (p & BluetoothGattCharacteristic.PROPERTY_NOTIFY) != 0);
+        o.put("indicate", (p & BluetoothGattCharacteristic.PROPERTY_INDICATE) != 0);
+        o.put("authenticatedSignedWrites", (p & BluetoothGattCharacteristic.PROPERTY_SIGNED_WRITE) != 0);
+        return o;
+    }
+
+    private static String uuid(UUID u) {
+        return u.toString().toLowerCase(Locale.ROOT);
+    }
+
+    private BluetoothGattCallback callback(final Conn c) {
+        return new BluetoothGattCallback() {
+            @Override
+            @SuppressWarnings("MissingPermission")
+            public void onConnectionStateChange(BluetoothGatt gatt, int status, int newState) {
+                if (newState == BluetoothProfile.STATE_CONNECTED && status == BluetoothGatt.GATT_SUCCESS) {
+                    // 마이크로비트처럼 데이터가 많은 기기를 위해 연결 간격을 짧게
+                    try {
+                        gatt.requestConnectionPriority(BluetoothGatt.CONNECTION_PRIORITY_HIGH);
+                    } catch (Exception ignored) {
+                        // 지원 안 함
+                    }
+                    main.postDelayed(() -> {
+                        try {
+                            gatt.discoverServices();
+                        } catch (Exception ignored) {
+                            // 끊김
+                        }
+                    }, 300);
+                    return;
+                }
+                if (newState == BluetoothProfile.STATE_DISCONNECTED) {
+                    boolean wasMine = conns.get(c.id) == c;
+                    conns.remove(c.id);
+                    PluginCall pc = c.connectCall;
+                    c.connectCall = null;
+                    closeConn(c);
+                    if (pc != null) {
+                        pc.reject(tr("블루투스 하드웨어에 연결하지 못했습니다 (" + status + ").", "Could not connect to the Bluetooth hardware (" + status + ")."), "CONNECT_FAILED");
+                    } else if (wasMine && c.ready) {
+                        JSObject r = new JSObject();
+                        r.put("deviceId", c.id);
+                        notifyListeners("disconnected", r);
+                    }
+                }
+            }
+
+            @Override
+            public void onServicesDiscovered(BluetoothGatt gatt, int status) {
+                PluginCall pc = c.connectCall;
+                if (pc == null) return;
+                c.connectCall = null;
+                if (status != BluetoothGatt.GATT_SUCCESS) {
+                    conns.remove(c.id);
+                    closeConn(c);
+                    pc.reject(tr("블루투스 하드웨어의 기능을 읽지 못했습니다.", "Could not read the Bluetooth hardware's services."), "DISCOVER_FAILED");
+                    return;
+                }
+                JSArray services = new JSArray();
+                for (BluetoothGattService s : gatt.getServices()) {
+                    JSObject so = new JSObject();
+                    so.put("uuid", uuid(s.getUuid()));
+                    JSArray chars = new JSArray();
+                    for (BluetoothGattCharacteristic ch : s.getCharacteristics()) {
+                        JSObject co = new JSObject();
+                        co.put("uuid", uuid(ch.getUuid()));
+                        co.put("properties", props(ch));
+                        chars.put(co);
+                    }
+                    so.put("characteristics", chars);
+                    services.put(so);
+                }
+                c.ready = true;
+                JSObject r = new JSObject();
+                r.put("services", services);
+                pc.resolve(r);
+            }
+
+            // 안드로이드 13 이상은 값을 함께 넘기는 새 함수, 그 아래는 예전 함수가 불린다 (둘 중 하나만)
+            @Override
+            public void onCharacteristicChanged(BluetoothGatt gatt, BluetoothGattCharacteristic ch, byte[] value) {
+                emitNotify(c, ch, value);
+            }
+
+            @Override
+            @SuppressWarnings("deprecation")
+            public void onCharacteristicChanged(BluetoothGatt gatt, BluetoothGattCharacteristic ch) {
+                emitNotify(c, ch, ch.getValue());
+            }
+
+            @Override
+            public void onCharacteristicRead(BluetoothGatt gatt, BluetoothGattCharacteristic ch, byte[] value, int status) {
+                finishOp(c, status, value);
+            }
+
+            @Override
+            @SuppressWarnings("deprecation")
+            public void onCharacteristicRead(BluetoothGatt gatt, BluetoothGattCharacteristic ch, int status) {
+                finishOp(c, status, ch.getValue());
+            }
+
+            @Override
+            public void onCharacteristicWrite(BluetoothGatt gatt, BluetoothGattCharacteristic ch, int status) {
+                finishOp(c, status, null);
+            }
+
+            @Override
+            public void onDescriptorWrite(BluetoothGatt gatt, BluetoothGattDescriptor d, int status) {
+                finishOp(c, status, null);
+            }
+        };
+    }
+
+    private void emitNotify(Conn c, BluetoothGattCharacteristic ch, byte[] value) {
+        JSObject r = new JSObject();
+        r.put("deviceId", c.id);
+        r.put("service", uuid(ch.getService().getUuid()));
+        r.put("characteristic", uuid(ch.getUuid()));
+        r.put("value", Base64.encodeToString(value == null ? new byte[0] : value, Base64.NO_WRAP));
+        notifyListeners("notify", r);
+    }
+
+    // ── 차례로 보내기 ────────────────────────────────────────────
+
+    private void enqueue(final Conn c, final Op op) {
+        synchronized (c) {
+            c.queue.add(op);
+        }
+        pump(c);
+    }
+
+    private void pump(final Conn c) {
+        Op next;
+        synchronized (c) {
+            if (c.current != null || c.queue.isEmpty()) return;
+            next = c.queue.poll();
+            c.current = next;
+        }
+        final Op op = next;
+        op.timeout = () -> {
+            synchronized (c) {
+                if (c.current != op) return;
+                c.current = null;
+            }
+            op.call.reject(tr("블루투스 하드웨어가 응답하지 않습니다.", "The Bluetooth hardware is not responding."), "TIMEOUT");
+            pump(c);
+        };
+        main.postDelayed(op.timeout, OP_TIMEOUT_MS);
+        boolean sent;
+        try {
+            sent = c.gatt != null && op.start(c.gatt);
+        } catch (Exception e) {
+            sent = false;
+        }
+        if (!sent) {
+            main.removeCallbacks(op.timeout);
+            synchronized (c) {
+                if (c.current == op) c.current = null;
+            }
+            op.call.reject(tr("블루투스 하드웨어에 보내지 못했습니다.", "Could not send to the Bluetooth hardware."), "GATT_BUSY");
+            pump(c);
+        }
+    }
+
+    private void finishOp(Conn c, int status, byte[] value) {
+        Op op;
+        synchronized (c) {
+            op = c.current;
+            c.current = null;
+        }
+        if (op != null) {
+            main.removeCallbacks(op.timeout);
+            if (status == BluetoothGatt.GATT_SUCCESS) {
+                JSObject r = new JSObject();
+                if (value != null) r.put("value", Base64.encodeToString(value, Base64.NO_WRAP));
+                op.call.resolve(r);
+            } else {
+                op.call.reject(tr("블루투스 통신 오류 (" + status + ")", "Bluetooth error (" + status + ")"), "GATT_ERROR");
+            }
+        }
+        pump(c);
+    }
+
+    private BluetoothGattCharacteristic findChar(PluginCall call, Conn c) {
+        if (c == null || c.gatt == null) return null;
+        try {
+            BluetoothGattService s = c.gatt.getService(UUID.fromString(call.getString("service", "")));
+            if (s == null) return null;
+            return s.getCharacteristic(UUID.fromString(call.getString("characteristic", "")));
+        } catch (Exception e) {
+            return null;
+        }
+    }
+
+    private Conn connOrReject(PluginCall call) {
+        Conn c = conns.get(call.getString("deviceId", ""));
+        if (c == null || !c.ready) {
+            call.reject(tr("블루투스 하드웨어가 연결되어 있지 않습니다.", "The Bluetooth hardware is not connected."), "NOT_CONNECTED");
+            return null;
+        }
+        return c;
+    }
+
+    @PluginMethod
+    public void read(final PluginCall call) {
+        final Conn c = connOrReject(call);
+        if (c == null) return;
+        final BluetoothGattCharacteristic ch = findChar(call, c);
+        if (ch == null) {
+            call.reject("characteristic not found", "NOT_FOUND");
+            return;
+        }
+        Op op = new Op() {
+            @Override
+            @SuppressWarnings("MissingPermission")
+            boolean start(BluetoothGatt gatt) {
+                return gatt.readCharacteristic(ch);
+            }
+        };
+        op.call = call;
+        enqueue(c, op);
+    }
+
+    @PluginMethod
+    public void write(final PluginCall call) {
+        final Conn c = connOrReject(call);
+        if (c == null) return;
+        final BluetoothGattCharacteristic ch = findChar(call, c);
+        if (ch == null) {
+            call.reject("characteristic not found", "NOT_FOUND");
+            return;
+        }
+        final byte[] value = Base64.decode(call.getString("value", ""), Base64.DEFAULT);
+        final int type = Boolean.TRUE.equals(call.getBoolean("withResponse", true))
+            ? BluetoothGattCharacteristic.WRITE_TYPE_DEFAULT
+            : BluetoothGattCharacteristic.WRITE_TYPE_NO_RESPONSE;
+        Op op = new Op() {
+            @Override
+            @SuppressWarnings({ "MissingPermission", "deprecation" })
+            boolean start(BluetoothGatt gatt) {
+                if (Build.VERSION.SDK_INT >= 33) {
+                    return gatt.writeCharacteristic(ch, value, type) == 0;
+                }
+                ch.setWriteType(type);
+                ch.setValue(value);
+                return gatt.writeCharacteristic(ch);
+            }
+        };
+        op.call = call;
+        enqueue(c, op);
+    }
+
+    @PluginMethod
+    public void startNotifications(PluginCall call) {
+        setNotify(call, true);
+    }
+
+    @PluginMethod
+    public void stopNotifications(PluginCall call) {
+        setNotify(call, false);
+    }
+
+    private void setNotify(final PluginCall call, final boolean on) {
+        final Conn c = connOrReject(call);
+        if (c == null) return;
+        final BluetoothGattCharacteristic ch = findChar(call, c);
+        if (ch == null) {
+            call.reject("characteristic not found", "NOT_FOUND");
+            return;
+        }
+        Op op = new Op() {
+            @Override
+            @SuppressWarnings({ "MissingPermission", "deprecation" })
+            boolean start(BluetoothGatt gatt) {
+                if (!gatt.setCharacteristicNotification(ch, on)) return false;
+                BluetoothGattDescriptor d = ch.getDescriptor(CCCD);
+                if (d == null) {
+                    // 설명자가 없는 기기: 알림 설정만으로 끝
+                    main.post(() -> finishOp(c, BluetoothGatt.GATT_SUCCESS, null));
+                    return true;
+                }
+                boolean indicate = (ch.getProperties() & BluetoothGattCharacteristic.PROPERTY_INDICATE) != 0
+                    && (ch.getProperties() & BluetoothGattCharacteristic.PROPERTY_NOTIFY) == 0;
+                byte[] v = !on
+                    ? BluetoothGattDescriptor.DISABLE_NOTIFICATION_VALUE
+                    : indicate ? BluetoothGattDescriptor.ENABLE_INDICATION_VALUE : BluetoothGattDescriptor.ENABLE_NOTIFICATION_VALUE;
+                if (Build.VERSION.SDK_INT >= 33) {
+                    return gatt.writeDescriptor(d, v) == 0;
+                }
+                d.setValue(v);
+                return gatt.writeDescriptor(d);
+            }
+        };
+        op.call = call;
+        enqueue(c, op);
+    }
+
+    @Override
+    protected void handleOnDestroy() {
+        for (Conn c : new ArrayList<>(conns.values())) closeConn(c);
+        conns.clear();
+    }
+}
