+
+    const overlay = document.createElement('div');
+    overlay.id = OVERLAY_ID;
+    overlay.innerHTML =
+        `<div class="eai-box" role="dialog" aria-modal="true" aria-label="${esc(lt('앱 정보', 'App info'))}">` +
+        `<div class="eai-head">${esc(lt('앱 정보', 'App info'))}<button class="eai-close" type="button" aria-label="${esc(lt('닫기', 'Close'))}"></button></div>` +
+        '<div class="eai-body">' +
+        `<div class="eai-app"><img class="eai-logo" alt="" src="${BRAND_ICON}"><div><div class="eai-name">${esc(appName)}</div><div class="eai-ver">v${esc(APP_VERSION)} · ${esc(lt('패치', 'Patch'))} ${esc(ENTRY_LOCAL_BUILD)}</div></div></div>` +
+        '<table>' +
+        `<tr><th>${esc(lt('앱 이름', 'App name'))}</th><td>${esc(appName)}</td></tr>` +
+        `<tr><th>${esc(lt('버전', 'Version'))}</th><td>v${esc(APP_VERSION)} <span class="eai-note">(${esc(lt('패치', 'patch'))} ${esc(ENTRY_LOCAL_BUILD)})</span></td></tr>` +
+        `<tr><th>${esc(lt('개발자', 'Developer'))}</th><td>${esc(lt(APP_DEVELOPER, APP_DEVELOPER_EN))}</td></tr>` +
+        '</table>' +
+        `<h3>[ ${esc(lt('오픈소스 및 저작권 안내', 'Open source & copyright notice'))} ]</h3>` +
+        `<p>${esc(
+            lt(
+                "본 애플리케이션은 네이버 커넥트재단의 'entry-offline' 및 '엔티피(Entify)' 오픈소스 프로젝트를 활용하여 제작되었습니다.",
+                "This application was built using NAVER Connect Foundation's 'entry-offline' and the 'Entify' open source projects."
+            )
+        )}</p>` +
+        '<ul>' +
+        item('Entry Platform', ['Copyright ⓒ NAVER Connect Foundation.', 'https://playentry.org']) +
+        item('entry-offline', ['Copyright ⓒ NAVER Connect Foundation (entrylabs) · MIT License', 'https://github.com/entrylabs/entry-offline']) +
+        item(lt('엔티피 (Entify) — 엔트리 비공식 로그인 방식 참고', 'Entify — reference for the unofficial Entry login'), [
+            'Copyright ⓒ axolotl-rosi · Entify Source-Available License v1.0',
+            'https://github.com/axolotl-rosi/Entify',
+        ]) +
+        (android
+            ? item(lt('usb-serial-for-android — USB 하드웨어 연결', 'usb-serial-for-android — USB hardware connection'), [
+                  'Copyright ⓒ 2011-2013 Google Inc., 2013 Mike Wakerly · MIT License',
+                  'https://github.com/mik3y/usb-serial-for-android',
+              ])
+            : '') +
+        '</ul>' +
+        `<p class="eai-note">${esc(
+            lt(
+                `본 앱은 ${runtime} 및 오픈소스 기술을 활용하고 있습니다.`,
+                `This app uses ${runtime} and open source technologies.`
+            )
+        )}</p>` +
+        `<p class="eai-note">${esc(
+            lt(
+                '본 앱은 네이버 커넥트재단의 공식 앱이 아니며, 엔트리 계정 기능은 엔트리 공식 로그인 화면을 그대로 사용합니다. 비밀번호는 앱에 저장되지 않습니다.',
+                'This is not an official app of NAVER Connect Foundation. Entry account features use the official Entry login page, and your password is not stored in this app.'
+            )
+        )}</p>` +
+        `<div class="eai-copy">Copyright ${esc(COPYRIGHT_YEAR)}. ${esc(lt(COPYRIGHT_HOLDER, COPYRIGHT_HOLDER_EN))}. All rights reserved.</div>` +
+        '</div>' +
+        `<div class="eai-buttons"><button class="eai-ok" type="button">${esc(lt('확인', 'OK'))}</button></div>` +
+        '</div>';
+
+    const close = () => {
+        document.removeEventListener('keydown', onKey, true);
+        overlay.remove();
+    };
+    const onKey = (e: KeyboardEvent) => {
+        if (e.key === 'Escape' || e.key === 'Enter') {
+            e.stopPropagation();
+            close();
+        }
+    };
+    (overlay.querySelector('.eai-close') as HTMLElement).onclick = close;
+    (overlay.querySelector('.eai-ok') as HTMLElement).onclick = close;
+    overlay.addEventListener('mousedown', (e) => {
+        if (e.target === overlay) {
+            close();
+        }
+    });
+    document.addEventListener('keydown', onKey, true);
+    document.body.appendChild(overlay);
+    (overlay.querySelector('.eai-ok') as HTMLElement).focus();
+}
diff --git a/src/renderer/helper/backpack.ts b/src/renderer/helper/backpack.ts
new file mode 100644
index 00000000..b711a037
--- /dev/null
+++ b/src/renderer/helper/backpack.ts
@@ -0,0 +1,238 @@
+/**
+ * [entry-local] 나의 보관함 (백팩) — 웹판 엔트리와 같은 동작, 저장은 이 기기(앱 저장소)
+ *
+ * 엔트리 코어가 보관함 화면(오른쪽 패널)을 그리고 아래 이벤트를 보낸다. 웹판은 서버(/rest/backpack)에,
+ * 여기서는 앱 저장소(backpack:* IPC)에 저장한다. 웹판 코드(2026-10 확인)와 같은 순서·같은 데이터로 처리한다.
+ *   openBackPack          → 목록 불러와 보관함 열기
+ *   closeBackPack         → 닫기
+ *   addStorage            → (블록·오브젝트를 끌어다 놓거나 오른쪽 메뉴 '나의 보관함에 추가하기') 저장
+ *   removeBackPackItem    → 삭제 (확인 창)
+ *   changeBackPackTitle   → 이름 바꾸기
+ *   addBackPackToEntry    → 보관함 항목을 작업 화면(블록) / 오브젝트 목록(오브젝트)으로 끌어다 놓기
+ */
+import { lt } from '../../common/localLang';
+
+type BackpackItem = { _id: string; type: 'block' | 'object'; title: string; imgPath?: string };
+
+const invoke = <T>(channel: string, ...args: any[]) => (window as any).ipcInvoke(channel, ...args) as Promise<T>;
+const E = () => (window as any).Entry;
+
+/** 미리보기 그림이 없을 때 쓰는 기본 그림 (블록 / 오브젝트) */
+const FALLBACK: { [type: string]: string } = {
+    block:
+        'data:image/svg+xml;charset=utf-8,' +
+        encodeURIComponent(
+            '<svg xmlns="http://www.w3.org/2000/svg" width="120" height="60" viewBox="0 0 120 60"><path d="M6 14h22l6 6h10l6-6h64a4 4 0 0 1 4 4v24a4 4 0 0 1-4 4H50l-6 6H34l-6-6H6a4 4 0 0 1-4-4V18a4 4 0 0 1 4-4z" fill="#4f80ff"/><rect x="14" y="27" width="70" height="6" rx="3" fill="#fff" opacity=".85"/></svg>'
+        ),
+    object:
+        'data:image/svg+xml;charset=utf-8,' +
+        encodeURIComponent(
+            '<svg xmlns="http://www.w3.org/2000/svg" width="80" height="80" viewBox="0 0 80 80"><rect x="8" y="8" width="64" height="64" rx="12" fill="#e9eefb"/><circle cx="40" cy="34" r="12" fill="#4f80ff"/><rect x="22" y="50" width="36" height="10" rx="5" fill="#4f80ff"/></svg>'
+        ),
+};
+
+/** 그림 주소 → 작은 PNG data URL (보관함 목록용, 최대 160px) */
+function toThumbnail(src: string | undefined, max = 160): Promise<string | undefined> {
+    return new Promise((resolve) => {
+        if (!src) {
+            resolve(undefined);
+            return;
+        }
+        const img = new Image();
+        img.crossOrigin = 'anonymous';
+        const timer = setTimeout(() => resolve(undefined), 5000);
+        img.onload = () => {
+            clearTimeout(timer);
+            try {
+                const scale = Math.min(1, max / Math.max(img.naturalWidth || 1, img.naturalHeight || 1));
+                const w = Math.max(1, Math.round((img.naturalWidth || max) * scale));
+                const h = Math.max(1, Math.round((img.naturalHeight || max) * scale));
+                const canvas = document.createElement('canvas');
+                canvas.width = w;
+                canvas.height = h;
+                const ctx = canvas.getContext('2d');
+                ctx && ctx.drawImage(img, 0, 0, w, h);
+                resolve(canvas.toDataURL('image/png'));
+            } catch (e) {
+                resolve(undefined);
+            }
+        };
+        img.onerror = () => {
+            clearTimeout(timer);
+            resolve(undefined);
+        };
+        img.src = src;
+    });
+}
+
+/** 웹판 ey(): 블록 목록이 쓰는 변수·리스트·신호·함수·표·확장 블록 */
+function usedData(script: any, index?: number) {
+    const Entry = E();
+    const blocks = script.getBlockList(undefined, undefined, index);
+    const data: any = { ...Entry.variableContainer.getObjectVariables(blocks) };
+    try {
+        data.tables = Entry.playground.dataTable.getTables(blocks);
+    } catch (e) {
+        data.tables = [];
+    }
+    try {
+        data.learning = Entry.aiLearning && Entry.aiLearning.toJSON();
+    } catch (e) {
+        // 인공지능 학습 모델이 없으면 넘어감
+    }
+    try {
+        data.expansionBlocks = Entry.expansion.getExpansions(blocks);
+    } catch (e) {
+        data.expansionBlocks = [];
+    }
+    try {
+        data.aiUtilizeBlocks = Entry.aiUtilize.getAIUtilizes(blocks);
+    } catch (e) {
+        data.aiUtilizeBlocks = [];
+    }
+    return data;
+}
+
+async function showBackPack() {
+    const Entry = E();
+    try {
+        Entry.playground.showBackPack({ isLoading: true });
+        const items = await invoke<BackpackItem[]>('backpack:list');
+        Entry.playground.showBackPack({
+            items: (items || []).map((item) => ({ ...item, imgPath: item.imgPath || FALLBACK[item.type] })),
+            isLoading: false,
+        });
+    } catch (e) {
+        console.error('[backpack] list failed', e);
+        Entry.playground.showBackPack({ items: [], isLoading: false });
+    }
+}
+
+async function addStorage({ type, data, view }: { type: 'block' | 'object'; data: any; view?: any }) {
+    const Entry = E();
+    try {
+        Entry.playground.showBackPack({ isLoading: true });
+        let item: any;
+        let title = '';
+        let imgPath: string | undefined;
+        if (type === 'object') {
+            // 웹판과 같은 데이터: { ...쓰는 변수 등, objects: [오브젝트] }
+            item = { ...usedData(data.script), objects: [data.toJSON()] };
+            item = JSON.parse(JSON.stringify(item));
+            title = data.name;
+            const picture = data.selectedPicture || (data.pictures && data.pictures[0]);
+            imgPath = await toThumbnail(picture && (picture.thumbUrl || picture.fileurl));
+        } else if (type === 'block') {
+            data.data.x = 50;
+            data.data.y = 30;
+            const thread = data.thread;
+            const index = thread.getBlockIndex(data);
+            const blockView = data.view || view;
+            item = { ...usedData(thread, index), script: thread.stringify(undefined, true, index) };
+            item = JSON.parse(JSON.stringify(item));
+            title = (window as any).Lang.Workspace.my_block;
+            try {
+                if (blockView && blockView.getDataUrl) {
+                    const image: any = await blockView.getDataUrl();
+                    const raw = typeof image === 'string' ? image : image && (image.data || image.src);
+                    // 엔트리는 블록 그림을 SVG 글(<svg …>)로 준다 → 그대로 data URL 로 쓴다
+                    imgPath =
+                        typeof raw === 'string' && raw.trim().startsWith('<')
+                            ? `data:image/svg+xml;charset=utf-8,${encodeURIComponent(raw)}`
+                            : await toThumbnail(raw, 240);
+                }
+            } catch (e) {
+                imgPath = undefined;
+            }
+        } else {
+            return;
+        }
+        await invoke('backpack:add', { type, title, imgPath }, item);
+    } catch (e) {
+        console.error('[backpack] add failed', e);
+        Entry.modal && Entry.modal.alert
+            ? Entry.modal.alert(lt('나의 보관함에 추가하지 못했습니다.', 'Could not add to My Storage.'))
+            : alert(lt('나의 보관함에 추가하지 못했습니다.', 'Could not add to My Storage.'));
+    } finally {
+        showBackPack();
+    }
+}
+
+async function removeBackPackItem(id: string) {
+    const ok = await (window as any).EntryModal.confirm(
+        lt('나의 보관함에서 삭제할까요?', 'Delete this item from My Storage?'),
+        lt('나의 보관함', 'My Storage')
+    );
+    if (!ok) {
+        return;
+    }
+    try {
+        await invoke('backpack:remove', id);
+    } finally {
+        showBackPack();
+    }
+}
+
+async function changeBackPackTitle(id: string, title: string) {
+    try {
+        await invoke('backpack:rename', id, title);
+    } finally {
+        showBackPack();
+    }
+}
+
+async function addBackPackToEntry(type: 'block' | 'object', id: string) {
+    const Entry = E();
+    if (!id) {
+        return;
+    }
+    try {
+        const found = await invoke<{ type: string; item: any } | undefined>('backpack:get', id);
+        if (!found || !found.item) {
+            return;
+        }
+        if (type === 'block' && found.type === type) {
+            Entry.Utils.addNewBlock(found.item);
+        } else if (found.type === type) {
+            Entry.Utils.addNewObject(found.item);
+        }
+    } catch (e) {
+        console.error('[backpack] get failed', e);
+        Entry.modal && Entry.modal.alert && Entry.modal.alert(lt('보관함 항목을 꺼내지 못했습니다.', 'Could not take the item out of My Storage.'));
+    }
+}
+
+/** 엔트리 이벤트 등록 — Entry.init 이 이벤트를 비우므로 작품을 불러올 때마다 부른다 */
+export function installBackpack() {
+    const Entry = E();
+    if (!Entry || !Entry.addEventListener) {
+        return;
+    }
+    Entry.addEventListener('openBackPack', showBackPack);
+    Entry.addEventListener('closeBackPack', () => Entry.playground && Entry.playground.hideBackPack());
+    Entry.addEventListener('addStorage', addStorage);
+    Entry.addEventListener('removeBackPackItem', removeBackPackItem);
+    Entry.addEventListener('changeBackPackTitle', changeBackPackTitle);
+    Entry.addEventListener('addBackPackToEntry', addBackPackToEntry);
+}
+
+/**
+ * 오른쪽 클릭 메뉴의 '나의 보관함에 추가하기'는 엔트리가 웹 로그인(window.user)일 때만 켠다.
+ * 이 앱은 기기에 저장하므로 로그인 없이 켠다 (블록: 복사할 수 있을 때 / 오브젝트: 실행 중이 아닐 때).
+ */
+export function enableStorageMenuItems(options: any[]) {
+    const Lang: any = (window as any).Lang || {};
+    const label = Lang.Blocks && Lang.Blocks.add_my_storage;
+    if (!label || !Array.isArray(options)) {
+        return options;
+    }
+    const copyItem = options.find((o) => o && Lang.Blocks && o.text === Lang.Blocks.CONTEXT_COPY_option);
+    const running = !!(E() && E().engine && E().engine.isState && E().engine.isState('run'));
+    return options.map((o) => {
+        if (o && o.text === label && !o.enable) {
+            const enable = copyItem ? copyItem.enable !== false : !running;
+            return { ...o, enable };
+        }
+        return o;
+    });
+}
diff --git a/src/renderer/helper/blockMenuOrder.ts b/src/renderer/helper/blockMenuOrder.ts
new file mode 100644
index 00000000..fff99d0e
--- /dev/null
+++ b/src/renderer/helper/blockMenuOrder.ts
@@ -0,0 +1,38 @@
+/**
+ * [entry-local] 블록 오른쪽 클릭 메뉴 순서: 코드 복사하기 → 코드 복제하기 → 코드 잘라내기 → 코드 삭제하기
+ * (엔트리는 '복제하기'가 '복사하기'보다 위에 있다 → 메뉴를 띄우기 직전에 두 줄의 순서만 바꾼다)
+ */
+import { enableStorageMenuItems } from './backpack';
+
+let installed = false;
+
+export function installBlockMenuOrder() {
+    const E: any = (window as any).Entry;
+    if (installed || !E || !E.ContextMenu || typeof E.ContextMenu.show !== 'function') {
+        return;
+    }
+    installed = true;
+    const show = E.ContextMenu.show;
+    E.ContextMenu.show = function (options: any[], ...rest: any[]) {
+        try {
+            const L: any = (window as any).Lang || {};
+            const B = L.Blocks || {};
+            if (Array.isArray(options)) {
+                const dup = options.findIndex((o) => o && o.text === B.Duplication_option);
+                const copy = options.findIndex((o) => o && o.text === B.CONTEXT_COPY_option);
+                if (dup >= 0 && copy === dup + 1) {
+                    options = options.slice();
+                    options[dup] = options.splice(copy, 1, options[dup])[0];
+                }
+            }
+        } catch (e) {
+            // 순서를 못 바꿔도 메뉴는 그대로 뜬다
+        }
+        try {
+            options = enableStorageMenuItems(options); // '나의 보관함에 추가하기' 켜기 (로그인 없이 기기에 저장)
+        } catch (e) {
+            // 그대로 둔다
+        }
+        return show.call(this, options, ...rest);
+    };
+}
