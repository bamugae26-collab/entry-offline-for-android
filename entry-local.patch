+            LinearLayout root = new LinearLayout(getContext());
+            root.setOrientation(LinearLayout.VERTICAL);
+            root.setBackgroundColor(Color.WHITE);
+            LinearLayout bar = new LinearLayout(getContext());
+            bar.setOrientation(LinearLayout.HORIZONTAL);
+            bar.setGravity(Gravity.CENTER_VERTICAL);
+            bar.setPadding(dp(16), dp(6), dp(8), dp(6));
+            bar.setBackgroundColor(Color.parseColor("#4F80FF"));
+            TextView title = new TextView(getContext());
+            title.setText(tr("작품 공유하기", "Share project"));
+            title.setTextColor(Color.WHITE);
+            title.setTextSize(TypedValue.COMPLEX_UNIT_SP, 17);
+            bar.addView(title, new LinearLayout.LayoutParams(0, ViewGroup.LayoutParams.WRAP_CONTENT, 1f));
+            Button close = new Button(getContext(), null, android.R.attr.borderlessButtonStyle);
+            close.setText(tr("닫기", "Close"));
+            close.setTextColor(Color.WHITE);
+            bar.addView(close);
+            root.addView(bar, new LinearLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.WRAP_CONTENT));
+            final WebView web = new WebView(getContext());
+            configure(web);
+            web.getSettings().setUserAgentString(web.getSettings().getUserAgentString().replace("; wv", ""));
+            root.addView(web, new LinearLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, 0, 1f));
+
+            final Runnable[] poll = new Runnable[1];
+            final Runnable finishShared = () -> {
+                if (closed[0]) return;
+                shared[0] = true;
+                main.removeCallbacks(poll[0]);
+                main.postDelayed(dialog::dismiss, 1500);
+            };
+            poll[0] = () -> {
+                if (closed[0]) return;
+                web.evaluateJavascript("window.__elShare || ''", (value) -> {
+                    if (closed[0]) return;
+                    if (value != null && value.contains("cancel")) {
+                        dialog.dismiss();
+                    } else if (value != null && value.contains("shared")) {
+                        finishShared.run();
+                    } else {
+                        main.postDelayed(poll[0], 600);
+                    }
+                });
+            };
+            final java.util.function.Consumer<String> onUrl = (visited) -> {
+                if (closed[0] || !started[0] || visited == null) return;
+                Uri u = Uri.parse(visited);
+                String path = u.getPath() == null ? "" : u.getPath();
+                if (!isEntryHost(u)) return;
+                if (path.startsWith("/signin")) {
+                    dialog.dismiss(); // 엔트리 세션 만료
+                } else if (!path.startsWith("/ws/")) {
+                    finishShared.run(); // 공유를 마치고 작업 화면을 떠남
+                }
+            };
+            web.setWebViewClient(new WebViewClient() {
+                @Override
+                public boolean shouldOverrideUrlLoading(WebView view, WebResourceRequest request) {
+                    String scheme = request.getUrl().getScheme();
+                    return !("http".equals(scheme) || "https".equals(scheme));
+                }
+
+                @Override
+                public void onPageStarted(WebView view, String startedUrl, android.graphics.Bitmap favicon) {
+                    onUrl.accept(startedUrl);
+                }
+
+                @Override
+                public void doUpdateVisitedHistory(WebView view, String visited, boolean isReload) {
+                    onUrl.accept(visited);
+                }
+
+                @Override
+                public void onPageFinished(WebView view, String loaded) {
+                    if (started[0] || closed[0] || script.isEmpty()) return;
+                    started[0] = true;
+                    view.evaluateJavascript(script, null);
+                    main.postDelayed(poll[0], 1500);
+                }
+            });
+            close.setOnClickListener((v) -> dialog.dismiss());
+            dialog.setOnKeyListener((d, keyCode, event) -> {
+                if (keyCode == KeyEvent.KEYCODE_BACK && event.getAction() == KeyEvent.ACTION_UP) {
+                    dialog.dismiss();
+                    return true;
+                }
+                return keyCode == KeyEvent.KEYCODE_BACK;
+            });
+            dialog.setOnDismissListener((d) -> {
+                closed[0] = true;
+                main.removeCallbacks(poll[0]);
+                web.stopLoading();
+                web.destroy();
+                CookieManager.getInstance().flush();
+                JSObject r = new JSObject();
+                r.put("shared", shared[0]);
+                call.resolve(r);
+            });
+            dialog.setContentView(root);
+            Window w = dialog.getWindow();
+            if (w != null) {
