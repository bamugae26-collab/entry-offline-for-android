index 00000000..75a0dbf2
--- /dev/null
+++ b/src/renderer/helper/entry/performance.ts
@@ -0,0 +1,177 @@
+import StorageManager from '../storageManager';
+
+import { lt } from '../../../common/localLang';
+/**
+ * [entry-local] 성능 설정
+ *
+ * 부스트 모드 : 엔트리 공식 기능. 무대를 GPU(WebGL, PIXI)로 그린다.
+ *              '부스트모드가 켜져 있는가?' 블록이 이 값을 읽는다.
+ *              엔진 초기화 때 한 번만 정해지므로 바꾸면 화면을 다시 불러온다.
+ * 터보 모드   : 한 프레임 시간 안에 블록 실행(틱)을 여러 번 돌린다 (Scratch 터보 모드와 같은 방식).
+ *              계산이 많은 3D·레이캐스팅 작품이 빨라지지만, 프레임마다 움직이는 작품은 그만큼 빨라진다.
+ */
+
+export type PerformanceSettings = {
+    boost: boolean;
+    turbo: boolean;
+    /** 엔진 최적화 (engineBoost.ts) — 계산 결과는 원본과 같음 */
+    fastEngine: boolean;
+};
+
+const KEY = 'entryLocalPerformance';
+const DEFAULTS: PerformanceSettings = { boost: true, turbo: false, fastEngine: true };
+/** 터보 모드에서 한 틱 간격 중 실행에 쓸 비율 (나머지는 화면 그리기·입력 처리용) */
+const TURBO_BUDGET = 0.75;
+/** 터보 모드 한 번에 돌릴 최대 틱 수 (무한 반복 작품에서 화면이 멈추지 않도록) */
+const TURBO_MAX_STEPS = 500;
+
+let cached: PerformanceSettings | undefined;
+
+export function getPerformanceSettings(): PerformanceSettings {
+    if (cached) {
+        return cached;
+    }
+    let stored: Partial<PerformanceSettings> = {};
+    try {
+        stored = JSON.parse(localStorage.getItem(KEY) || '{}') || {};
+    } catch (e) {
+        stored = {};
+    }
+    cached = { ...DEFAULTS, ...stored };
+    if (cached.boost && !isWebGLAvailable()) {
+        // GPU 를 쓸 수 없는 기기면 자동으로 일반 렌더링
+        console.warn('[entry-local] WebGL 사용 불가: 부스트 모드 끔');
+        cached.boost = false;
+    }
+    return cached;
+}
+
+function saveSettings(settings: PerformanceSettings) {
+    cached = settings;
+    try {
+        localStorage.setItem(KEY, JSON.stringify(settings));
+    } catch (e) {
+        // 저장이 막힌 환경이면 이번 실행에만 적용
+    }
+}
+
+let webglAvailable: boolean | undefined;
+export function isWebGLAvailable() {
+    if (webglAvailable === undefined) {
+        try {
+            const canvas = document.createElement('canvas');
+            webglAvailable = !!(canvas.getContext('webgl2') || canvas.getContext('webgl'));
+        } catch (e) {
+            webglAvailable = false;
+        }
+    }
+    return webglAvailable;
+}
+
+/** Entry.init 에 넘길 옵션 */
+export function performanceInitOptions() {
+    return { useWebGL: getPerformanceSettings().boost };
+}
+
+/** 브라우저가 화면을 한 번 그릴 때마다 false 로 돌아간다 */
+let burstSinceLastFrame = false;
+let watchingFrames = false;
+function watchFrames() {
+    if (watchingFrames) {
+        return;
+    }
+    watchingFrames = true;
+    const onFrame = () => {
+        burstSinceLastFrame = false;
+        requestAnimationFrame(onFrame);
+    };
+    requestAnimationFrame(onFrame);
+}
+
+/**
+ * 터보 모드 설치. Entry.init 뒤마다 호출한다 (엔진이 새로 만들어질 수 있으므로).
+ * 엔진은 setInterval(engine.update, 1000 / FPS) 로 블록을 실행하므로 update 를 감싼다.
+ */
+export function installTurbo() {
+    const engine: any = (window as any).Entry && (window as any).Entry.engine;
+    if (!engine || engine.__entryLocalTurbo) {
+        return;
+    }
+    const original = engine.update;
+    if (typeof original !== 'function') {
+        return;
+    }
+    engine.__entryLocalTurbo = true;
+    watchFrames();
+    engine.update = function() {
+        if (!getPerformanceSettings().turbo) {
+            original();
+            return;
+        }
+        // 지난 몰아 실행 뒤 화면이 아직 한 번도 안 그려졌으면 한 번만 실행 (화면 멈춤 방지)
+        if (burstSinceLastFrame) {
+            original();
+            return;
+        }
+        burstSinceLastFrame = true;
+        const tickTime = (window as any).Entry.tickTime || 16;
+        const budget = tickTime * TURBO_BUDGET;
+        const start = performance.now();
+        let steps = 0;
+        do {
+            original();
+            steps++;
+        } while (
+            steps < TURBO_MAX_STEPS &&
+            engine.isState('run') &&
+            performance.now() - start < budget
+        );
+    };
+    // 이미 실행 중이면 새 update 로 타이머를 다시 건다
+    if (engine.ticker) {
+        clearInterval(engine.ticker);
+        engine.ticker = setInterval(engine.update, (window as any).Entry.tickTime);
+    }
+}
+
+export function setTurbo(turbo: boolean) {
+    saveSettings({ ...getPerformanceSettings(), turbo });
+    const Entry: any = (window as any).Entry;
+    if (Entry && Entry.toast) {
+        Entry.toast.success(
+            turbo ? lt('터보 모드 켜짐', 'Turbo mode on') : lt('터보 모드 꺼짐', 'Turbo mode off'),
+            turbo
+                ? lt(
+                      '블록을 한 프레임에 여러 번 실행합니다. 프레임마다 움직이는 작품은 빨라질 수 있습니다.',
+                      'Blocks run several times per frame. Projects that move every frame may run faster.'
+                  )
+                : lt('블록을 프레임마다 한 번씩 실행합니다.', 'Blocks run once per frame.')
+        );
+    }
+}
+
+/** 엔진 최적화 전환: 원본 함수로 되돌리려면 다시 불러와야 한다 */
+export function setFastEngine(fastEngine: boolean, currentProject: any) {
+    saveSettings({ ...getPerformanceSettings(), fastEngine });
+    if (currentProject) {
+        StorageManager.saveTempProject(currentProject);
+    }
+    location.reload();
+}
+
+/**
+ * 부스트 모드 전환: 지금 작품을 임시 보관하고 화면을 다시 불러온다.
+ * (임시 보관본은 다시 열릴 때 바로 복원된다 — entryUtils.getSavedProject)
+ */
+export function setBoost(boost: boolean, currentProject: any) {
+    if (boost && !isWebGLAvailable()) {
+        const Entry: any = (window as any).Entry;
+        Entry && Entry.toast && Entry.toast.alert(lt('부스트 모드', 'Boost mode'), lt('이 기기에서는 GPU 렌더링(WebGL)을 사용할 수 없습니다.', 'GPU rendering (WebGL) is not available on this device.'));
+        return;
+    }
+    saveSettings({ ...getPerformanceSettings(), boost });
+    if (currentProject) {
+        StorageManager.saveTempProject(currentProject);
+    }
+    location.reload();
+}
diff --git a/src/renderer/helper/hardwareLite.ts b/src/renderer/helper/hardwareLite.ts
new file mode 100644
index 00000000..4600091a
--- /dev/null
+++ b/src/renderer/helper/hardwareLite.ts
@@ -0,0 +1,210 @@
+/**
+ * [entry-local 1.2] 하드웨어 연결 (안드로이드) — 엔트리 '하드웨어 웹 연결(Hardware Lite)'을 앱에서 쓰기
+ *
+ * 엔트리에는 연결 프로그램(entry-hw) 없이 브라우저가 기기와 직접 통신하는 '하드웨어 웹 연결'이 들어 있다
+ * (아두이노 우노·마이크로비트·햄스터·네오·핑퐁·로보티즈 등 약 30종, 블록·통신 코드 모두 엔트리 코어 안에 있음).
+ * 원래는 PC 크롬에서만 켜지는데(Web Serial), 안드로이드 앱은 USB OTG 로 같은 일을 하는 navigator.serial 을
+ * 만들어 두었으므로(src/web/webSerial.ts) 여기서 켠다.
+ *  - 블록 꾸러미 하드웨어 칸: [하드웨어 연결하기] → 하드웨어 고르기 창 → 고른 하드웨어의 블록 + [연결하기]
+ *  - PC 용 '연결 프로그램 열기/다운로드' 버튼은 안드로이드에서 쓸 수 없으므로 숨긴다
+ *  - 블루투스: 아두이노+HC-05/06 같은 블루투스 시리얼은 USB 와 같은 목록에서 고르고(webSerial.ts),
+ *    블루투스 LE 하드웨어(마이크로비트 BLE)는 navigator.bluetooth 대신(webBluetooth.ts)으로 연결한다
+ * 아두이노는 엔트리 펌웨어가 올라가 있어야 한다 (PC 의 엔트리 하드웨어 프로그램으로 미리 설치).
+ */
+import _ from 'lodash';
+
+const E = () => (window as any).Entry;
+
+/** 안드로이드 앱이고 USB 시리얼(navigator.serial)이 준비됨 */
+export function hardwareLiteAvailable() {
+    const cap = (window as any).Capacitor;
+    const android = !!(cap && cap.isNativePlatform && cap.isNativePlatform() && cap.getPlatform && cap.getPlatform() === 'android');
+    // __EL_HW_TEST__: PC 크롬에서 안드로이드 화면을 흉내 내 시험할 때만 (navigator.serial 가짜를 함께 넣음)
+    return (android || !!(window as any).__EL_HW_TEST__) && !!(navigator as any).serial;
+}
+
+/** 고를 수 있는 하드웨어 (블루투스 LE 하드웨어는 navigator.bluetooth 가 있을 때만) */
+function liteModules(): any[] {
+    const Entry = E();
+    const list: any[] = _.uniq(Object.values(Entry.HARDWARE_LITE_LIST || {}));
+    const ble = !!(navigator as any).bluetooth;
+    return list.filter((m) => m && (m.webapiType === 'ble' ? ble && m.bluetoothInfo : m.portData));
+}
+
+/** 엔트리 문구: '브라우저로 연결하기' → 앱에 맞게 */
+export function supplementHardwareLiteLang(Lang: any, langType?: string) {
+    if (!Lang || !hardwareLiteAvailable()) {
+        return;
+    }
+    const en = (langType || Lang.type) !== 'ko';
+    const lt = (ko: string, eng: string) => (en ? eng : ko);
+    Lang.Blocks = Lang.Blocks || {};
+    Lang.Workspace = Lang.Workspace || {};
+    Lang.Blocks.arduino_lite_connect = lt('하드웨어 연결하기', 'Connect hardware');
+    Lang.Workspace.load_hardware_lite_block = lt('하드웨어 불러오기', 'Load hardware');
+    Lang.Blocks.arduino_lite_alert = lt(
+        '하드웨어를 찾을 수 없습니다.\n펌웨어가 설치되어 있는지,\nUSB(OTG)·블루투스로 연결되어\n있는지 다시 확인해 주세요.',
+        'Hardware not found.\nCheck the firmware is installed\nand the USB (OTG) cable\nor Bluetooth is connected.'
+    );
+}
+
+const PROGRAM_CLASSES = ['arduinoDisconnected', 'arduinoConnect', 'arduinoConnected'];
+
+/** PC 연결 프로그램(entry-hw)용 버튼은 숨긴다 — 엔트리가 메뉴를 다시 그릴 때마다 */
+function hideProgramButtons() {
+    const Entry = E();
+    const blockMenu = Entry && Entry.getMainWS && Entry.getMainWS() && Entry.getMainWS().blockMenu;
+    if (!blockMenu) {
+        return;
+    }
+    blockMenu.banClass('arduinoDisconnected', true);
+    blockMenu.banClass('arduinoConnect', true);
+    blockMenu.banClass('arduinoConnected', true);
+}
+
+let popupOpen = false;
+
+async function showHardwareLitePopup(switchPopup: (type: string, events: any, data: any, imageBaseUrl?: string) => Promise<void>) {
+    const Entry = E();
+    if (popupOpen || !Entry || !Entry.hwLite) {
+        return;
+    }
+    popupOpen = true;
+    const current = Entry.hwLite.hwModule;
+    const lang = (window as any).Lang && (window as any).Lang.type === 'en' ? 'en' : 'ko';
+    const data = _.sortBy(
+        liteModules().map((m) => {
+            m.active = !!current && current === m;
+            m.nameByLang = (m.title && (m.title[lang] || m.title.ko)) || m.name;
+            return m;
+        }),
+        (m) => String(m.nameByLang)
+    );
+    try {
+        await switchPopup(
+            'hardwareLite',
+            {
+                submit: async (result: any) => {
+                    const selected = (result && (result.selected || result.data || [])) || [];
+                    // 엔트리 창은 고른 항목과 함께 함수도 넣어 돌려준다 → 객체만, 마지막에 고른 것
+                    const items = (Array.isArray(selected) ? selected : [selected]).filter((x: any) => x && typeof x === 'object');
+                    const picked = items[items.length - 1];
+                    // 창이 돌려주는 값이 복사본일 수 있어 원래 모듈 객체를 찾는다
+                    const module = picked && (data.find((m) => m === picked || (picked.id && m.id === picked.id) || (picked.name && m.name === picked.name)) || null);
+                    if (!module || module === Entry.hwLite.hwModule) {
+                        return;
+                    }
+                    if (Entry.hwLite.hwModule) {
+                        try {
+                            await Entry.hwLite.disconnect();
+                        } catch (e) {
+                            // 이미 끊김
+                        }
+                    }
+                    Entry.hwLite.addHardwareLiteModule(module);
+                },
+                itemon: ({ callback }: { callback?: () => void }) => callback && callback(),
+                itemoff: ({ callback }: { callback?: () => void }) => callback && callback(),
+            },
+            data,
+            '../../../node_modules/entry-js/images/hw_lite/'
+        );
+    } finally {
+        popupOpen = false;
+    }
+}
+
+/**
+ * Entry.init 옵션: 안드로이드판은 원래 하드웨어 칸을 껐다(hardwareEnable: false, 연결 프로그램이 없으므로).
+ * USB 시리얼이 있으면 칸을 켜되, PC 연결 프로그램(127.0.0.1:23518)에 접속하려는 시도는 막는다.
+ */
+export function applyHardwareInitOption(options: any) {
+    const Entry = E();
+    if (!hardwareLiteAvailable()) {
+        return options;
+    }
+    if (Entry && Entry.HW && Entry.HW.prototype && !Entry.HW.prototype.__elNoSocket) {
+        Entry.HW.prototype.__elNoSocket = true;
+        Entry.HW.prototype._initSocket = function () {
+            // 안드로이드에는 연결 프로그램이 없다
+        };
+    }
+    // PC 연결 프로그램용 버튼(연결 프로그램 열기·다운로드·'데스크톱 PC에서만 지원' 안내 등)은 다시 보이지 않게 한다.
+    // 엔트리는 하드웨어 메뉴를 새로 그리는 함수를 처음에 묶어 두고(bind) 이벤트마다 부르므로,
+    // 그 함수를 바꾸는 대신 블록 메뉴의 '보이기(unbanClass)'에서 이 분류들만 막는다.
+    const BlockMenu = Entry && Entry.BlockMenu;
+    if (BlockMenu && BlockMenu.prototype && !BlockMenu.prototype.__elHwPatched) {
+        BlockMenu.prototype.__elHwPatched = true;
+        const unban = BlockMenu.prototype.unbanClass;
+        BlockMenu.prototype.unbanClass = function (className: string, ...rest: any[]) {
+            if (PROGRAM_CLASSES.includes(className)) {
+                return this.banClass(className, ...rest);
+            }
+            return unban.call(this, className, ...rest);
+        };
+    }
+    return Object.assign({}, options, { hardwareEnable: true });
+}
+
+/** 작품을 불러올 때마다(Entry.init 뒤) 부른다 */
+export function installHardwareLite(
+    switchPopup: (type: string, events: any, data: any, imageBaseUrl?: string) => Promise<void>,
+    alert: (message: string) => void
+) {
+    const Entry = E();
+    if (!Entry || !hardwareLiteAvailable()) {
+        return;
+    }
+    const hwLite = Entry.hwLite;
+    if (hwLite && !hwLite.__elPatched) {
+        hwLite.__elPatched = true;
+        // 원래는 PC 크롬만 지원 (모바일·일렉트론 제외) → 이 앱은 USB 시리얼이 있으므로 지원
+        hwLite.isHwLiteSupportAgent = () => true;
+        const refresh = hwLite.refreshHardwareLiteBlockMenu;
+        hwLite.refreshHardwareLiteBlockMenu = function (...args: any[]) {
+            const r = refresh.apply(this, args);
+            hideProgramButtons();
+            return r;
+        };
+    }
+    const hw = Entry.hw;
+    if (hw && !hw.__elPatched && typeof hw._setHardwareDefaultMenu === 'function') {
+        hw.__elPatched = true;
+        const original = hw._setHardwareDefaultMenu;
+        hw._setHardwareDefaultMenu = function (...args: any[]) {
+            const r = original.apply(this, args);
+            hideProgramButtons();
+            return r;
+        };
+    }
+    Entry.addEventListener('openHardwareLiteBlockManager', () => showHardwareLitePopup(switchPopup));
+    // [펌웨어 다운로드] 버튼: 원래 엔트리 웹사이트가 채워 주는 버튼이라 그대로는 아무 일도 안 한다 → 안내
+    if (hwLite && typeof hwLite.setFirmwareDownloadButton === 'function') {
+        try {
+            hwLite.setFirmwareDownloadButton(async () => {
+                const en = !((window as any).Lang && (window as any).Lang.type === 'ko');
+                const m = hwLite.hwModule || {};
+                const arduino = /arduino/i.test(String(m.name || '')) || ['010101', '040201', '080101'].includes(m.id);
+                const ble = m.webapiType === 'ble';
+                let text: string;
+                if (arduino) {
+                    text = en
+                        ? 'Install the firmware once on a PC with the Entry hardware program (entry-hw):\nconnect the board → choose it → [Install firmware].\nThen connect it to the tablet by USB (OTG).\nWith a Bluetooth module (HC-05/06), set its speed to 9600 and pair it in Android settings first.'
+                        : 'PC의 엔트리 하드웨어 연결 프로그램에서 한 번만 설치해 주세요.\n(보드 연결 → 하드웨어 선택 → [펌웨어 설치])\n그다음 태블릿에 USB(OTG)로 연결하면 됩니다.\n블루투스 모듈(HC-05/06)을 쓸 때는 통신 속도를 9600으로 맞추고 안드로이드 설정에서 먼저 등록(페어링)해 주세요.';
+                } else {
+                    text = en
+                        ? `Install the firmware once on a PC: open Entry (playentry.org) in Chrome → Hardware → choose this hardware → [Download firmware].\nThen connect it to the tablet by ${ble ? 'Bluetooth' : 'USB (OTG)'}.`
+                        : `PC에서 한 번만 설치해 주세요: 크롬으로 엔트리(playentry.org) 만들기 → 하드웨어 → 이 하드웨어 선택 → [펌웨어 다운로드].\n그다음 태블릿에 ${ble ? '블루투스' : 'USB(OTG)'}로 연결하면 됩니다.`;
+                }
+                alert(text);
+            });
+        } catch (e) {
+            // 블록 메뉴가 아직 없음
+        }
+    }
+    try {
+        hwLite && hwLite.refreshHardwareLiteBlockMenu();
+    } catch (e) {
+        // 블록 메뉴가 아직 없음
+    }
+}
